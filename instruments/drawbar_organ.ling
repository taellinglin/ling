# Drawbar Organ (GM 17) — additive sine partials, no decay (full sustain), vibrato.
name = "Drawbar Organ"
gm = 17
poly = 12
# four carrier partials at organ footages (16',8',5 1/3',4') summed
op1.wave=sine op1.ratio=0.5 op1.level=0.7 op1.adsr=0.01,0.0,1.0,0.1
op2.wave=sine op2.ratio=1.0 op2.level=1.0 op2.adsr=0.01,0.0,1.0,0.1
op3.wave=sine op3.ratio=1.5 op3.level=0.5 op3.adsr=0.01,0.0,1.0,0.1
op4.wave=sine op4.ratio=2.0 op4.level=0.6 op4.adsr=0.01,0.0,1.0,0.1
lfo.rate=6.5 lfo.pitch=0.04
amp = 0.6
