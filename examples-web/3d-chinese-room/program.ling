# ════════════════════════════════════════════════════════════════════════════
# 3d-chinese-room.ling — 東亞禪寺  East Asian Chan Temple
#
#  A vast lacquer-black meditation hall blending Chinese, Vietnamese,
#  Cambodian, and pan-East-Asian sacred geometry.
#
#    Walls (4)  — East Asian character rain (stroke-script columns).
#    Ceiling    — Bagua/Taiji cosmic disc: hyperbolic Poincaré grid +
#                 Flower of Life (八花) rotating slowly.
#    Floor      — Mandala: tessellated wave field (Đông Sơn drum ripple) +
#                 4-layer yantra + vanishing perspective grid.
#    Centre     — 7-tier pagoda (宝塔) with Taiji yin-yang spinning core
#                 and 4 dragon-arm spirals at cardinal diagonals (naga).
#
#  Framefade: Two temporal echo passes (−48, −24 frames) with a chromatic
#  hue drift create a long-exposure smear — all rotating geometry leaves
#  warm amber → jade trails, implemented purely in the sine-colour system.
#
#  Camera: Very slow pendulum sway — stable, contemplative, never tours.
#
#  Audio: Chinese pentatonic drone 宫商角徵羽 — nine positional sine tones
#  with breath-rate vibrato (LFO 0.12–0.50 Hz) evoke monks chanting.
#
#  Run:  ling run examples/3d-chinese-room.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

令 W  = 9.0     # 半宽  half-width  (side walls x = ±W)
令 H  = 4.5     # 半高  half-height (floor y=-H, ceiling y=+H)
令 FZ = 16.0    # 远壁  far-wall z
令 NZ = 1.4     # 近壁  near-wall z
令 PZ = 8.0     # 宝塔轴 pagoda axis z-centre
令 PR = 1.10    # 宝塔核半径 pagoda core radius


# ════════════════════════════════════════════════════════════════════════════
# 颜色助手  COLOUR HELPERS
# ════════════════════════════════════════════════════════════════════════════

函 col(t, p) {
    สีดินสอ(
        sin(t + p)         * 127 + 128,
        sin(t + p + 2.094) * 127 + 128,
        sin(t + p + 4.189) * 127 + 128
    )
}

函 col_dim(t, p, b) {
    สีดินสอ(
        (sin(t + p)         * 127 + 128) * b,
        (sin(t + p + 2.094) * 127 + 128) * b,
        (sin(t + p + 4.189) * 127 + 128) * b
    )
}


# ════════════════════════════════════════════════════════════════════════════
# 太极核心  TAIJI CORE  (yin-yang counter-rotating ring pair)
# ════════════════════════════════════════════════════════════════════════════

函 draw_taiji(FR, hd) {
    令 bob = sin(FR * 0.022) * 0.30

    # Yang rings — clockwise, warm gold hue
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  4, 32,  PR, 0.0,  FR, 1.2 + hd)
    # Yin rings — counter-clockwise (0-FR), jade-green hue
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  4, 32,  PR, 0.15,  0-FR, 5.8 + hd)
    # Central lotus
    vtex_lotus(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.28, PR * 0.72, 12,  FR, 0.5 + hd)
    # Outer petal crown
    vtex_flower(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.48, 24,  FR, 3.2 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 宝塔层  SINGLE PAGODA TIER  (chakra disc + lotus ring + halo)
# ════════════════════════════════════════════════════════════════════════════

函 tier(y, r, sp, FR, hd) {
    vtex_chakra(0, y, PZ,  1,0,0,  0,0,1,  r, sp,  FR, 1.1 + hd)
    vtex_lotus(0, y, PZ,  1,0,0,  0,0,1,  r * 0.44, r * 0.88, sp,  FR, 0.0 + hd)
    vtex_rings(0, y, PZ,  1,0,0,  0,0,1,  1, 36,  r * 1.08, 0.0,  FR, 4.5 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 宝塔柱  FULL PAGODA COLUMN  (7 tiers + crown + dragon arms)
# ════════════════════════════════════════════════════════════════════════════

函 draw_pagoda(FR, hd) {
    draw_taiji(FR, hd)

    # Grand lotus at floor base
    vtex_lotus(0, 0-H+0.5, PZ,  1,0,0,  0,0,1,  1.1, 2.9, 16,  FR, 0.0 + hd)

    # 7 ascending tiers — (y, radius, spokes)
    tier(0-3.2, 2.20, 8,  FR, hd)
    tier(0-2.0, 1.88, 8,  FR, hd)
    tier(0-0.8, 1.58, 10, FR, hd)
    tier( 0.4,  1.30, 10, FR, hd)
    tier( 1.6,  1.06, 12, FR, hd)
    tier( 2.8,  0.82, 12, FR, hd)
    tier( H-0.6, 0.58, 8, FR, hd)

    # Crown: 8-point star (北极星 North Star) + flower
    vtex_star(0, H-0.3, PZ,  1,0,0,  0,0,1,  8, 1.18, 0.48, 0.038,  FR, 0.6 + hd)
    vtex_flower(0, H-0.3, PZ,  1,0,0,  0,0,1,  0.62, 16,  FR, 2.5 + hd)

    # 4 dragon arm spirals — cardinal diagonals (naga serpent heads)
    vtex_spiral(0-3.5, 0, PZ-2.5,  1,0,0,  0,0,1,  3.0, 2.8, 72,  FR, 0.8 + hd)
    vtex_spiral( 3.5,  0, PZ-2.5,  1,0,0,  0,0,1,  3.0, 2.8, 72,  FR, 0.8 + hd + 3.14159)
    vtex_spiral(0-3.5, 0, PZ+2.5,  1,0,0,  0,0,1,  3.0, 2.8, 72,  FR, 2.0 + hd)
    vtex_spiral( 3.5,  0, PZ+2.5,  1,0,0,  0,0,1,  3.0, 2.8, 72,  FR, 2.0 + hd + 3.14159)

    # Dragon ring stacks (naga scale rings)
    vtex_rings(0-3.5, 0, PZ-2.5,  1,0,0,  0,0,1,  2, 18,  1.6, 0.22,  FR, 1.5 + hd)
    vtex_rings( 3.5,  0, PZ-2.5,  1,0,0,  0,0,1,  2, 18,  1.6, 0.22,  FR, 4.7 + hd)
    vtex_rings(0-3.5, 0, PZ+2.5,  1,0,0,  0,0,1,  2, 18,  1.6, 0.22,  FR, 2.9 + hd)
    vtex_rings( 3.5,  0, PZ+2.5,  1,0,0,  0,0,1,  2, 18,  1.6, 0.22,  FR, 6.1 + hd)

    # Pagoda aura: equatorial lotus halo + ring corona
    vtex_lotus(0, 0, PZ,  1,0,0,  0,1,0,  1.4, 2.2, 12,  FR, 5.2 + hd)
    vtex_rings(0, 0, PZ,  1,0,0,  0,1,0,  3, 40,  2.4, 0.10,  FR, 6.0 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 殿堂面  ROOM SURFACES
# ════════════════════════════════════════════════════════════════════════════

函 draw_floor(FR, hd) {
    令 cy   = 0 - H
    令 fmid = FZ / 2
    # Tessellated wave field — Đông Sơn drum / paddy-field ripple
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  18, 14,  0.70, 0.28, 5.0,  FR, 1.2 + hd)
    # Mandala yantra (bhupura + interlocked triangles)
    vtex_yantra(0, cy, fmid,  1,0,0,  0,0,1,  4, 4.6,  FR, 0.0 + hd)
    # Perspective grid
    vtex_grid(0, cy, fmid,  1,0,0,  0,0,1,  28, 24,  0.64, 0.64,  FR, 3.5 + hd)
}

函 draw_ceiling(FR, hd) {
    令 cy   = H
    令 fmid = FZ / 2
    # Bagua cosmic disc — Poincaré-disc hyperbolic UV
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  6.0, 14, 16,  FR, 2.5 + hd)
    # Flower of Life 八花
    vtex_flower(0, cy, fmid,  1,0,0,  0,0,1,  2.2, 8,  FR, 1.0 + hd)
    # Outer cosmos ring
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  2, 40,  6.4, 0.02,  FR, 4.2 + hd)
}

函 draw_front_wall(FR, hd) {
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.018,  FR, 0.0 + hd)
}

函 draw_back_wall(FR, hd) {
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.024,  FR, 2.1 + hd)
    # Angkor portal glyph
    vtex_chakra(0, 0, FZ,  1,0,0,  0,1,0,  4.0, 10,  FR, 0.3 + hd)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  3, 40,  4.6, 0.03,  FR, 3.3 + hd)
}

函 draw_left_wall(FR, hd) {
    令 cx   = 0 - W
    令 fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.022,  FR, 4.0 + hd)
}

函 draw_right_wall(FR, hd) {
    令 cx   = W
    令 fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.018,  FR, 1.5 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 回声帧  ECHO PASS (structural elements only — cheap, for temporal smear)
# ════════════════════════════════════════════════════════════════════════════

函 draw_echo(FR, hd) {
    令 cy_f = 0 - H
    令 cy_c = H
    令 fm   = FZ / 2

    # Floor: mandala + grid (no expensive tessellation)
    vtex_yantra(0, cy_f, fm,  1,0,0,  0,0,1,  4, 4.6,  FR, 0.0 + hd)
    vtex_grid(0, cy_f, fm,  1,0,0,  0,0,1,  28, 24,  0.64, 0.64,  FR, 3.5 + hd)

    # Ceiling: outer ring + flower
    vtex_rings(0, cy_c, fm,  1,0,0,  0,0,1,  2, 40,  6.4, 0.02,  FR, 4.2 + hd)
    vtex_flower(0, cy_c, fm,  1,0,0,  0,0,1,  2.2, 8,  FR, 1.0 + hd)

    # Back portal
    vtex_chakra(0, 0, FZ,  1,0,0,  0,1,0,  4.0, 10,  FR, 0.3 + hd)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  3, 40,  4.6, 0.03,  FR, 3.3 + hd)

    # Pagoda: sparse tiers + core (no dragon arms)
    draw_taiji(FR, hd)
    tier(0-3.2, 2.20, 8,  FR, hd)
    tier(0-0.8, 1.58, 10, FR, hd)
    tier( 1.6,  1.06, 12, FR, hd)
    tier( H-0.6, 0.58, 8, FR, hd)
    vtex_star(0, H-0.3, PZ,  1,0,0,  0,0,1,  8, 1.18, 0.48, 0.038,  FR, 0.6 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 灯光  LIGHTS
# ════════════════════════════════════════════════════════════════════════════

函 setup_lights(FR) {
    clear_lights()
    # Warm gold key — orbiting above pagoda (蜡烛 temple candle)
    add_light(
        sin(FR * 0.0082) * 4.0,
        3.8,
        cos(FR * 0.0082) * 2.0 + PZ,
        1.0, 0.82, 0.38,
        3.0, 14.0
    )
    # Jade fill — cool green from left (玉石 jade statue glow)
    add_light(0-5.0, 1.5, PZ,  0.22, 0.72, 0.52,  1.4, 11.0)
    # Vermilion rim — right rear (香 incense ember)
    add_light(
        sin(FR * 0.0057) * 3.0,
        0.3,
        0-cos(FR * 0.0057) * 2.0 + PZ,
        0.92, 0.16, 0.10,
        1.0, 9.0
    )
    # Deep indigo under-fill (影 floor shadow)
    add_light(0, 0-3.5, PZ,  0.20, 0.08, 0.58,  0.5, 7.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 音乐  AUDIO — Chinese pentatonic drone ensemble
# 五音: 宫(C) 商(D) 角(E) 徵(G) 羽(A) — tuned to C2 = 65.41 Hz
# LFO 0.12–0.50 Hz = natural breathing — like monks sustaining sine tones
# ════════════════════════════════════════════════════════════════════════════

函 init_audio() {
    # slot   x      y     z     w      freq      amp   lfo_hz  lfo_depth
    audio_tone(0,  0,  0-H,  PZ,  1.5,  130.81,  0.12,  0.18,  0.012)  # 宫C3  floor
    audio_tone(1,  0,  0-H,  FZ,  2.0,   65.41,  0.10,  0.12,  0.008)  # 宫C2  sub-bass
    audio_tone(2, 0-W,  0,   PZ,  2.0,  196.00,  0.09,  0.25,  0.015)  # 徵G3  left
    audio_tone(3,  W,   0,   PZ,  2.0,  220.00,  0.09,  0.30,  0.018)  # 羽A3  right
    audio_tone(4,  0,   H,   PZ,  0.5,  146.83,  0.07,  0.22,  0.013)  # 商D3  ceiling
    audio_tone(5,  0,   0,   FZ,  1.2,  164.81,  0.08,  0.36,  0.020)  # 角E3  portal
    audio_tone(6,  0,   0,   PZ,  1.0,  261.63,  0.07,  0.15,  0.010)  # 宫C4  octave spine
    audio_tone(7, 0-3.5, 0, PZ-2.5, 3.0, 392.00, 0.06,  0.44,  0.022)  # 徵G4  dragon L
    audio_tone(8,  3.5,  0, PZ+2.5, 3.0, 440.00, 0.06,  0.50,  0.025)  # 羽A4  dragon R
    audio_volume(0.60)
}


# ════════════════════════════════════════════════════════════════════════════
# 启动  MAIN
# ════════════════════════════════════════════════════════════════════════════
令 启 = 执 {
    เปิดหน้าต่างเต็มจอ("East Asian Chan Temple — 東亞禪寺")
    set_ambient(0.05)

    init_audio()

    令 帧 = 0

    循 หน้าต่างเปิดอยู่() {
        เติม(2, 0, 1)    # deep lacquer-black (tiny red hint)

        # ── Camera: very slow pendulum sway — stable, meditative ─────────────
        # Horizontal: sin sway  ±0.22 rad (≈13°), period ~2500 frames
        # Vertical:   very subtle nod ±0.08 rad (≈5°), period ~3700 frames
        令 ry  = sin(帧 * 0.00042) * 0.22
        令 rx  = sin(帧 * 0.00028) * 0.08
        令 cry = cos(ry)   令 sry = sin(ry)
        令 crx = cos(rx)   令 srx = sin(rx)
        set_camera(cry, sry, crx, srx)
        audio_listener(cry, sry, crx, srx)

        setup_lights(帧)

        # ── Temporal framefade — 2 echo passes then current frame ────────────
        # Each echo is drawn at an earlier time with a hue shift.
        # The shift maps to a warm amber (+2.0) or transitional (+1.0) tint.
        # On slowly-rotating geometry the echoes nearly overlap, creating
        # a glowing chromatic halo (long-exposure film effect in sine-colour).
        draw_echo(帧 - 48, 2.0)
        draw_echo(帧 - 24, 1.0)

        # Current frame — full scene including letter rain
        draw_floor(帧, 0.0)
        draw_ceiling(帧, 0.0)
        draw_front_wall(帧, 0.0)
        draw_back_wall(帧, 0.0)
        draw_left_wall(帧, 0.0)
        draw_right_wall(帧, 0.0)
        draw_pagoda(帧, 0.0)

        แสดงผล()
        令 帧 = 帧 + 1
    }
}
