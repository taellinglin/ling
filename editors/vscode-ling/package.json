{
  "name": "ling-lang",
  "displayName": "Ling Language",
  "description": "Syntax highlighting for the Ling (灵言) polyglot programming language.",
  "version": "0.1.0",
  "publisher": "ling-lang",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#10203f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taellinglin/ling.git",
    "directory": "editors/vscode-ling"
  },
  "bugs": {
    "url": "https://github.com/taellinglin/ling/issues"
  },
  "homepage": "https://github.com/taellinglin/ling#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ling",
    "灵言",
    "polyglot",
    "syntax highlighting"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "Ling",
      "properties": {
        "ling.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show diagnostics (unbalanced brackets, invalid `let`, unknown function calls)."
        },
        "ling.lint.unknownCalls": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an ASCII-named function call is neither a builtin nor a defined binding (typo catcher). Non-English names are never flagged."
        },
        "ling.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inlay parameter-name hints at builtin call sites."
        }
      }
    },
    "languages": [
      {
        "id": "ling",
        "aliases": [
          "Ling",
          "ling",
          "灵言"
        ],
        "extensions": [
          ".ling"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ling",
        "scopeName": "source.ling",
        "path": "./syntaxes/ling.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ling",
        "path": "./snippets/ling.json"
      }
    ],
    "themes": [
      {
        "label": "Ling Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ling-dark-color-theme.json"
      }
    ]
  }
}
