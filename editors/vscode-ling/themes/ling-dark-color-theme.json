{
  "name": "Ling Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#05070D",
    "editor.foreground": "#CDD6E5",
    "editorLineNumber.foreground": "#2B3A57",
    "editorLineNumber.activeForeground": "#96A6C7",
    "editorCursor.foreground": "#FFE034",
    "editor.selectionBackground": "#FFE03433",
    "editor.lineHighlightBackground": "#0D121F",
    "editorWhitespace.foreground": "#1A2338",
    "editorIndentGuide.background1": "#1A2338",
    "editorBracketMatch.border": "#FFE034",
    "editorBracketMatch.background": "#FFE03422",
    "editorError.foreground": "#FF1744",
    "editorWarning.foreground": "#FFE034",
    "editorInfo.foreground": "#00D4FF",
    "editorGutter.background": "#05070D",
    "sideBar.background": "#030509",
    "activityBar.background": "#030509",
    "statusBar.background": "#030509",
    "titleBar.activeBackground": "#030509"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment.line", "punctuation.definition.comment"],
      "settings": { "foreground": "#96A6C7", "fontStyle": "italic" }
    },
    {
      "name": "Keywords (control & storage)",
      "scope": [
        "keyword.control.ling",
        "keyword.control.i18n.ling",
        "storage.type.ling",
        "storage.type.i18n.ling"
      ],
      "settings": { "foreground": "#FFE034", "fontStyle": "bold" }
    },
    {
      "name": "Types",
      "scope": ["support.type.ling", "support.type.i18n.ling", "entity.name.type"],
      "settings": { "foreground": "#FFE034" }
    },
    {
      "name": "Builtins & function names & calls",
      "scope": [
        "support.function.builtin.ling",
        "entity.name.function.ling",
        "entity.name.function.call.ling"
      ],
      "settings": { "foreground": "#FF1744" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted.double.ling"],
      "settings": { "foreground": "#00D4FF" }
    },
    {
      "name": "Escapes",
      "scope": ["constant.character.escape.ling"],
      "settings": { "foreground": "#FFE034" }
    },
    {
      "name": "Numbers & language constants",
      "scope": [
        "constant.numeric.ling",
        "constant.language.ling",
        "constant.language.boolean.ling"
      ],
      "settings": { "foreground": "#2F8CFF" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator.ling",
        "keyword.operator.arithmetic.ling",
        "keyword.operator.comparison.ling",
        "keyword.operator.logical.ling",
        "keyword.operator.assignment.ling",
        "keyword.operator.arrow.ling",
        "keyword.operator.range.ling",
        "keyword.operator.path.ling"
      ],
      "settings": { "foreground": "#96A6C7" }
    },
    {
      "name": "Variables / identifiers",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#3ECF4A" }
    }
  ]
}
