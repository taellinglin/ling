#!/usr/bin/env ling
// 피보나치 수열 — 한국어 예제 (Fibonacci, in Korean)
// fn → 함수 · if → 만약 · else → 아니면 · for → 위해 · in → 안에 · number → 숫자

함수 피보나치(n: 숫자) -> 숫자 {
    만약 n <= 1 {
        n
    } 아니면 {
        피보나치(n - 1) + 피보나치(n - 2)
    }
}

바인드 시작 = 실행 {
    위해 i 안에 0..10 {
        출력("피보나치(", i, ") = ", 피보나치(i))
    }
}
