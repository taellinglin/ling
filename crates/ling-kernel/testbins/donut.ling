// A crypto-flavored knotwork donut, native ring-3 app in LingOS. Like the
// original crypto_donut_physics, the visible shape is a (p,q) torus KNOT --
// "the knot curve IS the donut" -- rendered as a glowing tube, with a colour
// seeded from a number (the original derives (p,q) and the colour from a
// SHA3-256 hash of a text seed; SHA3 needs a crypto builtin the userspace
// runtime doesn't have yet, so here (p,q) are fixed and the colour comes from
// a plain seed). Trig is pure Ling (a range-reduced Taylor series), since the
// sin/cos/floor builtins mis-lower on the AOT userspace path.

fn mysin(x) {
    bind t = x
    while t > 3.14159265 { bind t = t - 6.28318531 }
    while t < -3.14159265 { bind t = t + 6.28318531 }
    bind t2 = t * t
    return t * (1.0 - t2 * (0.16666667 - t2 * (0.00833333 - t2 * (0.00019841 - t2 * 0.0000027557))))
}

fn mycos(x) {
    return mysin(x + 1.57079633)
}

bind start = do {
    open_window(0.0, 0.0)
    bind cx = 512.0
    bind cy = 384.0
    bind R1 = 1.0
    bind R2 = 2.0
    bind K2 = 5.0
    bind K1 = 470.0
    bind TWO_PI = 6.2831853

    // (p,q) torus knot: major winds P times, tube winds Q times.
    bind P = 2.0
    bind Q = 5.0

    // Seed -> colour (phase-shifted sines, like the original's hash colour).
    bind seed = 2.35
    bind cr = (mysin(seed) * 0.5 + 0.5) * 190.0 + 55.0
    bind cg = (mysin(seed + 2.094) * 0.5 + 0.5) * 190.0 + 55.0
    bind cb = (mysin(seed + 4.188) * 0.5 + 0.5) * 190.0 + 55.0

    bind A = 0.0
    bind B = 0.0
    bind frame = 0.0

    while frame < 100000.0 {
        clear(657944.0)

        bind cA = mycos(A)
        bind sA = mysin(A)
        bind cB = mycos(B)
        bind sB = mysin(B)

        bind t = 0.0
        while t < TWO_PI {
            bind phi = P * t
            bind theta = Q * t
            bind ct = mycos(theta)
            bind st = mysin(theta)
            bind circlex = R2 + R1 * ct
            bind circley = R1 * st
            bind cp = mycos(phi)
            bind sp = mysin(phi)

            bind x = circlex * (cB * cp + sA * sB * sp) - circley * cA * sB
            bind y = circlex * (sB * cp - sA * cB * sp) + circley * cA * cB
            bind z = K2 + cA * circlex * sp + circley * sA
            bind ooz = 1.0 / z

            bind xp = cx + K1 * ooz * x
            bind yp = cy - K1 * ooz * y

            // Rounded-tube shading: torus normal . light, with a glow floor so
            // the whole knot stays visible (it's an emissive crypto donut).
            bind L = cp * ct * sB - cA * ct * sp - sA * st + cB * (cA * st - ct * sA * sp)
            bind lum = L * 0.7071
            if lum < 0.25 { bind lum = 0.25 }
            bind sh = 0.35 + lum * 0.65
            plot_disc(xp, yp, ooz, 3.0, cr * sh, cg * sh, cb * sh)

            bind t = t + 0.0025
        }

        present()
        bind A = A + 0.05
        bind B = B + 0.028
        bind frame = frame + 1.0
        if poll_key() > 0.0 { bind frame = 999999.0 }
    }
}
