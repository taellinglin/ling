// ตัวอย่างภาษาไทย - Thai Language Example

ผูก เริ่ม = ทำ {
    พิมพ์("╔══════════════════════════════╗")
    พิมพ์("║   สวัสดีชาวโลก!   ║")
    พิมพ์("║   Hello, World!   ║")
    พิมพ์("╚══════════════════════════════╝")
    
    ผูก ชื่อ = "ลิน"
    ผูก อายุ = 2030
    
    พิมพ์(&รูปแบบ("ยินดีต้อนรับสู่ {} เวอร์ชัน {}", ชื่อ, อายุ))
    
    // ฟังก์ชันตัวอย่าง
    ถ้า จริง {
        พิมพ์("ภาษาลิงทำงานได้อย่างถูกต้อง!")
    }
}