# ════════════════════════════════════════════════════════════════════════════
# 道场  Dàochǎng — Temple of the Way
#
# A quiet Chinese-Japanese shrine.  Only vector geometry — no pixel fills.
# Slow, dignified motion.  Gold · Jade · Crimson palette.
#
# Layout (top-down):
#   Far end  — torii gate + 5-tier pagoda behind it
#   Centre   — stone altar with dharma-wheel mandala on top
#   Floor    — 8×6 stone-tile grid, 4-layer yantra border
#   Ceiling  — 16-point star with concentric rings (ceiling lantern)
#   4 corners— lathe pillars (6-ring vase profile + spiked cog + lotus)
#   Walls    — sparse letter-rain (ink brushwork), yantra panels
#
# Audio: 5-tone pentatonic bell circle (very quiet)
# Camera: gentle slow orbit, always facing the altar
#
# Performance budget: ≤ 28 vtex calls per frame (no tex_* at all)
# ════════════════════════════════════════════════════════════════════════════

# ── World constants ───────────────────────────────────────────────────────────
令 W   = 9.0      # half-width of room
令 H   = 4.5      # half-height of room
令 FZ  = 16.0     # far-wall z
令 NZ  = 1.2      # near-wall z
令 AZ  = FZ * 0.55  # altar z (mid-back)
令 PI  = 3.14159265
令 PI2 = 1.5708    # π/2
令 PI4 = 0.7854    # π/4

# Hue anchors for cultural palette
令 GOLD    = 1.57    # warm gold / amber
令 JADE    = 3.50    # jade green
令 CRIMSON = 2.10    # deep crimson
令 IVORY   = 0.30    # near-white ivory


# ── Colour helper (dim, fixed tone around a hue anchor) ──────────────────────
函 col(FR, anchor, drift) {
    สีดินสอ(
        (sin(FR * 0.005 + anchor + drift)         * 90 + 165),
        (sin(FR * 0.005 + anchor + drift + 2.094) * 90 + 165),
        (sin(FR * 0.005 + anchor + drift + 4.189) * 90 + 165)
    )
}


# ════════════════════════════════════════════════════════════════════════════
# ALTAR MANDALA — dharma wheel + spiked cog + lotus crown
# Centred on the altar platform, facing outward (vertical disc)
# ════════════════════════════════════════════════════════════════════════════

函 draw_altar_mandala(FR) {
    令 bob = sin(FR * 0.008) * 0.12     # gentle breathing float

    # Outer spiked cog (18 teeth, gold)
    vtex_spiked_cog(0, bob, AZ,  1,0,0,  0,1,0,  18, 1.60, 2.00, 0.28, 9,  FR * 0.0004, GOLD)

    # Dharma wheel inside the cog (jade, counter-slow)
    vtex_chakra(0, bob, AZ,  1,0,0,  0,1,0,  1.30, 8,  0 - FR * 0.0003, JADE)

    # Inner lotus (crimson)
    vtex_lotus(0, bob, AZ,  1,0,0,  0,1,0,  0.38, 1.08, 8,  FR * 0.0005, CRIMSON)

    # Innermost dot rings — the jewel at the centre
    vtex_rings(0, bob, AZ,  1,0,0,  0,1,0,  2, 24,  0.20, 0.0,  0 - FR * 0.0006, IVORY)
}


# ════════════════════════════════════════════════════════════════════════════
# ALTAR PLATFORM — a raised stone dais beneath the mandala
# ════════════════════════════════════════════════════════════════════════════

函 draw_altar_platform(FR) {
    令 dy = 0 - H * 0.65    # altar sits on the floor

    # Stone dais: nested square frames (floor plane)
    vtex_yantra(0, dy, AZ,  1,0,0,  0,0,1,  3, 2.20,  FR * 0.0001, GOLD)

    # Altar top ring (horizontal disc above yantra)
    vtex_rings(0, dy, AZ,  1,0,0,  0,0,1,  2, 32,  1.80, 0.0,  FR * 0.0002, IVORY)
}


# ════════════════════════════════════════════════════════════════════════════
# FOUR PILLARS — corner lathe-turned columns with cog caps
# Positions: four quadrant corners just inside the walls
# ════════════════════════════════════════════════════════════════════════════

函 draw_pillar(FR, px, pz, phase) {
    # Vase silhouette: 6 horizontal rings at varying radii
    vtex_rings(px, 0 - H * 0.85, pz,  1,0,0,  0,0,1,  1, 8,  0.22, 0.0,  FR * 0.0003, GOLD + phase)
    vtex_rings(px, 0 - H * 0.50, pz,  1,0,0,  0,0,1,  1, 8,  0.42, 0.0,  FR * 0.0003, GOLD + phase)
    vtex_rings(px, 0 - H * 0.10, pz,  1,0,0,  0,0,1,  1, 8,  0.52, 0.0,  FR * 0.0003, GOLD + phase)
    vtex_rings(px,  H * 0.10, pz,     1,0,0,  0,0,1,  1, 8,  0.48, 0.0,  FR * 0.0003, GOLD + phase)
    vtex_rings(px,  H * 0.50, pz,     1,0,0,  0,0,1,  1, 8,  0.36, 0.0,  FR * 0.0003, GOLD + phase)
    vtex_rings(px,  H * 0.85, pz,     1,0,0,  0,0,1,  1, 8,  0.20, 0.0,  FR * 0.0003, GOLD + phase)

    # Spiked cog capital (top of pillar)
    vtex_spiked_cog(px, H * 0.88, pz,  1,0,0,  0,0,1,  12, 0.36, 0.52, 0.12, 6,  FR * 0.0005 + phase, JADE + phase)

    # Lotus foot (bottom of pillar)
    vtex_lotus(px, 0 - H * 0.88, pz,  1,0,0,  0,0,1,  0.10, 0.28, 8,  FR * 0.0004, CRIMSON + phase)
}

函 draw_4_pillars(FR) {
    令 px1 =  W * 0.70
    令 px2 = 0 - W * 0.70
    令 pz1 = AZ - W * 0.55
    令 pz2 = AZ + W * 0.55

    draw_pillar(FR,  px1, pz1, 0.0)
    draw_pillar(FR,  px1, pz2, PI4)
    draw_pillar(FR,  px2, pz1, PI2)
    draw_pillar(FR,  px2, pz2, PI)
}


# ════════════════════════════════════════════════════════════════════════════
# TORII GATE + PAGODA — the far wall focal point
# ════════════════════════════════════════════════════════════════════════════

函 draw_far_shrine(FR) {
    # Torii gate on the back wall (vertical plane: U=right, V=up)
    vtex_torii(0, 0, FZ,  1,0,0,  0,1,0,  6.0, H * 1.4,  FR * 0.0001, CRIMSON)

    # 5-tier pagoda behind the gate (slightly recessed, centred)
    vtex_pagoda(0, 0, FZ,  1,0,0,  0,1,0,  5, 2.2, H * 0.38, 0.72, 0.30,  FR * 0.0001, GOLD)

    # Flanking lanterns on back wall (pair of ring clusters)
    vtex_rings(0 - 4.0, 0, FZ,  1,0,0,  0,1,0,  3, 16,  0.50, 0.04,  FR * 0.0004, GOLD)
    vtex_rings( 4.0,    0, FZ,  1,0,0,  0,1,0,  3, 16,  0.50, 0.04,  FR * 0.0004, GOLD)

    # Inscription star at gate apex
    vtex_star(0, H * 0.72, FZ,  1,0,0,  0,1,0,  8, 0.70, 0.32, 0.0002,  FR, IVORY)
}


# ════════════════════════════════════════════════════════════════════════════
# FLOOR — stone-tile grid + yantra border
# ════════════════════════════════════════════════════════════════════════════

函 draw_floor(FR) {
    令 cy  = 0 - H
    令 fmid = FZ / 2

    # Stone-tile grid (8 cols × 6 rows, 2.0 × 2.5 per tile)
    vtex_grid(0, cy, fmid,  1,0,0,  0,0,1,  8, 6,  2.0, 2.5,  FR * 0.0001, IVORY)

    # Yantra border around the floor perimeter
    vtex_yantra(0, cy, fmid,  1,0,0,  0,0,1,  4, W * 0.92,  FR * 0.0001, JADE)
}


# ════════════════════════════════════════════════════════════════════════════
# CEILING — hanging lantern chandelier
# ════════════════════════════════════════════════════════════════════════════

函 draw_ceiling(FR) {
    令 cy   = H
    令 fmid = FZ / 2

    # Central star lantern
    vtex_star(0, cy, fmid,  1,0,0,  0,0,1,  16, W * 0.80, W * 0.38, 0.0001,  FR, GOLD)

    # Three concentric rings (ceiling beams)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  3, 36,  W * 0.72, 0.0,  FR * 0.0002, IVORY)
}


# ════════════════════════════════════════════════════════════════════════════
# SIDE WALLS — brushwork ink panels
# ════════════════════════════════════════════════════════════════════════════

函 draw_walls(FR) {
    令 fmid = (NZ + FZ) / 2

    # Left wall: sparse kanji/brushwork rain + lotus medallion
    vtex_letter_rain(0 - W, 0, fmid,  0,0,1,  0,1,0,  16, 10,  0.68, 0.62,  0.006,  FR, IVORY)
    vtex_lotus(0 - W, 0, fmid,  0,0,1,  0,1,0,  0.8, 2.4, 8,  FR * 0.0003, JADE)

    # Right wall: mirror
    vtex_letter_rain( W, 0, fmid,  0,0,1,  0,1,0,  16, 10,  0.68, 0.62,  0.006,  FR, IVORY)
    vtex_lotus( W, 0, fmid,  0,0,1,  0,1,0,  0.8, 2.4, 8,  FR * 0.0003, CRIMSON)
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO — five-tone pentatonic bell circle (very quiet, slow LFO)
# ════════════════════════════════════════════════════════════════════════════

函 init_audio() {
    # Pentatonic: 宫(C4) 商(D4) 角(E4) 徵(G4) 羽(A4)
    audio_tone(0,  0,       0,  AZ,      1.5,  261.63, 0.06, 0.08, 0.006)
    audio_tone(1,  W*0.7,   0,  AZ,      1.5,  293.66, 0.05, 0.06, 0.005)
    audio_tone(2,  0 - W*0.7, 0, AZ,    1.5,  329.63, 0.05, 0.06, 0.005)
    audio_tone(3,  0,       0,  AZ + 3,  1.5,  392.00, 0.05, 0.10, 0.007)
    audio_tone(4,  0,       H,  FZ / 2,  0.8,  440.00, 0.04, 0.14, 0.008)
    # Sub-bass earth pulse (very faint)
    audio_tone(5,  0, 0 - H,  FZ / 2,  0.3,   65.41, 0.03, 0.04, 0.003)
    audio_volume(0.35)
}


# ════════════════════════════════════════════════════════════════════════════
# LIGHTS — five-element calm lighting
# ════════════════════════════════════════════════════════════════════════════

函 setup_lights(FR) {
    clear_lights()

    # Overhead gold — main shrine lamp, slow orbit
    add_light(
        sin(FR * 0.0025) * 2.0, 4.0, AZ,
        1.0, 0.85, 0.30,  2.8, 18.0
    )

    # Altar glow — warm uplight from the dais
    add_light(0, 0 - H * 0.5, AZ,  0.90, 0.60, 0.10,  1.5, 8.0)

    # Left pillar — jade accent
    令 jb = sin(FR * 0.0088) * 0.12 + 0.88
    add_light(0 - W * 0.6, 0, AZ - 1.0,  0.05 * jb, 0.75 * jb, 0.30 * jb,  1.2, 9.0)

    # Right pillar — crimson accent (mirror)
    add_light( W * 0.6, 0, AZ - 1.0,  0.80, 0.10, 0.06,  1.2, 9.0)

    # Gate lamp (back, high)
    add_light(0, H * 0.8, FZ - 1.0,  1.0, 0.90, 0.40,  1.0, 12.0)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN
# ════════════════════════════════════════════════════════════════════════════

令 启 = 执 {
    เปิดหน้าต่างเต็มจอ("道场 — Dàochǎng  Temple of the Way")
    capture_mouse()
    set_ambient(0.12)
    init_audio()

    令 帧 = 0

    # Slow pendulum camera: gentle arc around the altar
    令 orbit_r   = 6.5
    令 orbit_spd = 0.00025
    令 bob_spd   = 0.00055

    循 หน้าต่างเปิดอยู่() {
        # Deep ink-black background
        เติม(4, 2, 10)

        令 hd = 帧 * 0.003    # very slow global hue drift

        # ── Camera: gentle pendulum arc ──────────────────────────────────────
        令 ry = sin(帧 * orbit_spd) * 0.52   # ±30° swing
        令 rx = sin(帧 * bob_spd)   * 0.14   # slight vertical nod

        令 cam_x = sin(ry) * orbit_r
        令 cam_z = AZ - cos(ry) * orbit_r
        令 cam_y = sin(rx) * 1.5

        set_camera(cos(ry), sin(ry), cos(rx), sin(rx))
        set_camera_pos(cam_x, cam_y, cam_z)
        set_zdist(2.0)
        audio_listener(cos(ry), sin(ry), cos(rx), sin(rx))

        setup_lights(帧)

        # ── Geometry (vector only, no pixel fills) ───────────────────────────
        draw_floor(帧)
        draw_ceiling(帧)
        draw_walls(帧)
        draw_far_shrine(帧)
        draw_4_pillars(帧)
        draw_altar_platform(帧)
        draw_altar_mandala(帧)

        แสดงผล()
        令 帧 = 帧 + 1
    }
}
