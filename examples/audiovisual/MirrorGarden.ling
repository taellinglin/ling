# ════════════════════════════════════════════════════════════════════════════
# MirrorGarden.ling — Garden of 灵: Sun, Moon, and Mirror
#
# A mystical hyperbolic Chinese garden.  At its heart stands a Wild Spirit
# Tree rooted in the Mirror Pond — it grows upward into the sky AND downward
# through the reflective surface into infinite depth.
#
# ── LING SUN ────────────────────────────────────────────────────────────────
#   Golden 8-petal lotus + 8-ray star + hyperbolic halo, orbiting high.
#   Tone: C4 = 261.63 Hz  (宫 gōng — root, warm)
#
# ── LING MOON ───────────────────────────────────────────────────────────────
#   Silver 12-ring lotus + disc + cool hyperbolic glow, opposite arc (+π).
#   Tone: G4 = 392.00 Hz  (徵 zhǐ — fifth, reciprocal to Sun)
#   Sun and Moon are always opposite: yin–yang reciprocity encoded in orbit.
#
# ── WILD CHINESE SPIRIT TREE ────────────────────────────────────────────────
#   6 layers, each pulsing at its own speed (small = fast, large = slow).
#   Layer 0 root:    pulse 0.012 / frame  → C2  = 65.41  Hz  (earth rumble)
#   Layer 1 trunk:   pulse 0.018         → G2  = 98.00  Hz  (wood resonance)
#   Layer 2 branch:  pulse 0.028         → C3  = 130.81 Hz
#   Layer 3 branch:  pulse 0.040         → G3  = 196.00 Hz
#   Layer 4 upper:   pulse 0.055         → C4  → shared with Sun
#   Layer 5 crown:   pulse 0.075         → E5  = 659.25 Hz  (leaf shimmer)
#   Audio LFO depths match visual pulse speeds exactly.
#
# ── MIRROR (the Pond) ───────────────────────────────────────────────────────
#   Surface: hyperbolic UV ripple + 5-ring lotus floats.
#   Reflection: tree redrawn at y_mirror = −2H − y_actual (below ground).
#   Dimmed by +hue offset (+3.5) and 72% scale → cooler, deeper reflection.
#   Because painter's algorithm sorts by z (not y), reflected geometry is
#   visible THROUGH the tessellated pond surface — it appears beneath it.
#
# ── SUPER HYPERBOLIC ────────────────────────────────────────────────────────
#   vtex_hyperbolic_uv everywhere: ground, sky dome, pond, tree bark/crown.
#   Branches use three different orientation planes (XY / YZ / XZ) so the
#   camera sees circles → lines → spokes depending on viewing angle.
#
# ── LING PATH CAMERA ────────────────────────────────────────────────────────
#   ry = sin(t)           horizontal sweep   ±0.38 rad
#   rx = sin(2t) + 0.06   vertical figure-8  ±0.20 rad + upward bias
#   Traces a 灵 figure-eight: left/right also bobs up/down twice per cycle.
#   From the front: tree branches are horizontal discs.
#   From the side:  same branches become thin vertical lines.
#   From above:     pond rings become a full hyperbolic mandala.
#
# ── BALANCE · HARMONY · RECIPROCITY ────────────────────────────────────────
#   Sun ↔ Moon:    C4 ↔ G4  (perfect fifth — Pythagorean reciprocity)
#   Tree ↔ Mirror: growth ↔ reflection  (same form, inverted depth)
#   Left ↔ Right:  branch pairs always equal and opposite
#   Fast ↔ Slow:   crown (fastest pulse) ↔ roots (slowest)
#   Deep ↔ High:   C2=65Hz bass ↔ E5=659Hz shimmer
# ════════════════════════════════════════════════════════════════════════════

ผูก W   = 12.0
ผูก H   = 6.0
ผูก FZ  = 24.0
ผูก NZ  = 1.2
ผูก MZ  = 12.6     # (NZ + FZ) / 2

ผูก PX  = 0.0      # pond / tree centre x
ผูก PZ  = 8.5      # pond / tree centre z

# ── Wide-range pentatonic (C2 … E5, 3+ octaves) ─────────────────────────
ผูก FC2 = 65.41    # C2  — root rumble (earth, deepest)
ผูก FG2 = 98.00    # G2  — trunk bass
ผูก FC3 = 130.81   # C3  — lower branch
ผูก FG3 = 196.00   # G3  — mid branch
ผูก FC4 = 261.63   # C4  — Ling Sun / upper branch (宫 root)
ผูก FG4 = 392.00   # G4  — Ling Moon (徵 fifth — reciprocal)
ผูก FE5 = 659.25   # E5  — crown shimmer (leaf shimmer)
ผูก FB5 = 987.77   # B5  — stellar overtone


# ════════════════════════════════════════════════════════════════════════════
# SM2 HASH
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน sm2_hash(cx, ry, a, b) {
    ผูก p = cx * 2166136261.0 + ry * 16777619.0
    ผูก s = ไซน์(p * 0.0000031 + a) * 0.5 + 0.5
    ผูก c = โคไซน์(p * 0.0000059 - b) * 0.5 + 0.5
    s * 0.618 + c * 0.382
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO  — 8 slots, amplitude LFO depths match per-layer visual pulse speeds
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot  x    y       z      w    freq   amp  lfo_hz  depth
    # Layer 0 roots: very slow pulse = stable deep bass
    เสียงโทน(0,  PX,  0-H,     PZ,   4.0,  FC2,  0.13,  0.012,  0.018)
    # Layer 1 trunk
    เสียงโทน(1,  PX,  0-H+1.5, PZ,   3.0,  FG2,  0.11,  0.018,  0.028)
    # Layer 2 first branch
    เสียงโทน(2,  PX,  0-H+2.6, PZ,   2.5,  FC3,  0.10,  0.028,  0.042)
    # Layer 3 mid branch
    เสียงโทน(3,  PX,  0-H+3.6, PZ,   2.0,  FG3,  0.09,  0.040,  0.058)
    # Ling Sun + upper branch
    เสียงโทน(4,  PX,  H+2.5,   PZ,   5.0,  FC4,  0.09,  0.055,  0.075)
    # Ling Moon (reciprocal)
    เสียงโทน(5,  PX,  H+2.0,   PZ,   5.0,  FG4,  0.08,  0.022,  0.035)
    # Crown shimmer (fastest pulse = deepest LFO depth per unit amplitude)
    เสียงโทน(6,  PX,  0-H+5.8, PZ,   1.5,  FE5,  0.08,  0.075,  0.150)
    # Stellar overtone (pond + sky ambient)
    เสียงโทน(7,  0,   H,       MZ,   6.0,  FB5,  0.06,  0.038,  0.065)
    ระดับเสียง(0.48)
}


# ════════════════════════════════════════════════════════════════════════════
# LIGHTS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()

    ผูก ts  = FR * (1.0 / 520.0) * 6.2832
    ผูก tm  = ts + 3.14159

    # Ling Sun light — warm gold, orbiting high
    เพิ่มแสง(
        โคไซน์(ts) * 9.0,
        H + 3.0 + ไซน์(ts * 0.5) * 1.5,
        PZ + ไซน์(ts) * 5.0,
        1.00, 0.92, 0.52,   5.5, 20.0
    )

    # Ling Moon light — cool silver-blue, opposite orbit
    เพิ่มแสง(
        โคไซน์(tm) * 8.0,
        H + 2.5 + ไซน์(tm * 0.5) * 1.2,
        PZ + ไซน์(tm) * 4.5,
        0.52, 0.72, 1.00,   3.0, 16.0
    )

    # Pond shimmer — upward ripple reflection
    ผูก tp = FR * 0.038
    เพิ่มแสง(
        PX + ไซน์(tp) * 0.8,  0-H + 0.3,  PZ + โคไซน์(tp) * 0.6,
        0.28, 0.62, 0.98,   2.2, 8.0
    )

    # Under-ground fill — makes reflected tree glow
    เพิ่มแสง(PX,  0-H - 2.0,  PZ,   0.12, 0.28, 0.55,   1.0, 7.0)

    # Warm ground bounce
    เพิ่มแสง(0,   0-H + 0.2,  MZ,   0.36, 0.22, 0.12,   0.7, 10.0)
}


# ════════════════════════════════════════════════════════════════════════════
# GROUND  — SM2-hash hyperbolic grass + stone path
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ground(FR, hd) {
    ผูก gy = 0 - H
    ผูก gz = FZ * 0.52

    # Deep hyperbolic grass base
    ผูก h1 = sm2_hash(2.5, 6.5,  FR * 0.0014,  FR * 0.0022)
    ผูก h2 = sm2_hash(6.5, 2.5,  FR * 0.0022,  FR * 0.0014)
    vtex_hyperbolic_uv(0, gy, gz,  1,0,0,  0,0,1,  10.0, 8, 12,  FR * 0.018, hd + 2.0)
    vtex_tessellated(0, gy, gz,  1,0,0,  0,0,1,  28, 22,  0.28 + h1*0.14, 0.07 + h2*0.05, 4.2,  FR, hd + 2.4)

    # Stone path to pond — yantra inlay (LINE tone)
    ลายยันต์(0, gy, gz * 0.64,  1,0,0,  0,0,1,  5, 5.2,  FR * 0.05, hd + 1.0)
    ลายตาราง(0, gy, gz * 0.48,    1,0,0,  0,0,1,  16, 6,  0.60, 0.36,  FR * 0.04, hd + 0.6)

    # Far ground hyperbolic recede
    vtex_hyperbolic_uv(0, gy, gz * 1.22,  1,0,0,  0,0,1,  7.0, 5, 8,  FR * 0.012, hd + 3.0)
}


# ════════════════════════════════════════════════════════════════════════════
# SKY  — infinite hyperbolic dome, many layers of depth
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_sky(FR, hd) {
    ผูก sy = H
    ผูก sz = FZ * 0.50

    # Primary dome — super-hyperbolic (large scale, many rings)
    vtex_hyperbolic_uv(0, sy, sz,     1,0,0,  0,0,1,  12.0, 10, 16,  FR * 0.011, hd + 4.5)
    # Secondary dome layer at slightly different depth
    vtex_hyperbolic_uv(0, sy + 0.8, sz + 2.0,  1,0,0,  0,0,1,  8.0, 7, 12,  FR * 0.016, hd + 3.8)
    # Tertiary far layer
    vtex_hyperbolic_uv(0, sy + 1.5, FZ,  1,0,0,  0,0,1,  9.5, 6, 10,  FR * 0.009, hd + 5.2)

    # Star field — 5-point (pentatonic stars)
    ลายดาว(0-4.5, sy + 2.2, sz - 2.0,   1,0,0,  0,0,1,  5, 0.8, 0.32, 0.02,  FR * 0.40, hd + 0.5)
    ลายดาว( 5.2,  sy + 2.8, sz + 1.5,   1,0,0,  0,0,1,  5, 0.6, 0.24, 0.03,  FR * 0.35, hd + 1.8)
    ลายดาว(0-2.0, sy + 3.2, sz + 3.0,   1,0,0,  0,0,1,  5, 0.5, 0.20, 0.04,  FR * 0.45, hd + 3.5)
    ลายดาว( 3.8,  sy + 3.5, sz - 3.5,   1,0,0,  0,0,1,  5, 0.4, 0.16, 0.05,  FR * 0.50, hd + 5.0)

    # Horizon glow
    ลายดอก(0, sy - 1.6, FZ,  1,0,0,  0,0,1,  9.0, 5,  FR * 0.014, hd + 3.6)
}


# ════════════════════════════════════════════════════════════════════════════
# LING SUN — 8-petal gold lotus + star + hyperbolic corona, orbiting high
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ling_sun(FR, hd) {
    ผูก ts  = FR * (1.0 / 520.0) * 6.2832
    ผูก ssx = โคไซน์(ts) * 9.0
    ผูก ssy = H + 2.8 + ไซน์(ts * 0.5) * 1.5
    ผูก ssz = PZ + ไซน์(ts) * 5.0

    # Hyperbolic corona (seen completely different at each angle)
    vtex_hyperbolic_uv(ssx, ssy, ssz,  1,0,0,  0,1,0,  3.5, 5, 8,  FR * 0.35, hd + 0.6)
    # 8-petal lotus (灵 — 8 strokes of soul)
    ลายดอกบัว(ssx, ssy, ssz,    1,0,0,  0,1,0,  0.55, 1.80, 8,  FR * 0.55, hd + 0.4)
    # 8-point star burst
    ลายดาว(ssx, ssy, ssz,     1,0,0,  0,1,0,  8, 2.60, 1.05, 0.04,  FR * 0.18, hd + 0.8)
    # Radiant rings — outward glow
    ลายวงซ้อน(ssx, ssy, ssz,    1,0,0,  0,1,0,  3, 8,  3.0, 0.0,  FR * 0.55, hd + 1.2)
    # Second halo at 90° — looks completely different from the side
    ลายวงซ้อน(ssx, ssy, ssz,    0,0,1,  0,1,0,  2, 8,  2.4, 0.0,  FR * 0.55, hd + 0.2)
    # Core chakra dot (C4 anchor)
    ลายจักร(ssx, ssy, ssz,   1,0,0,  0,1,0,  0.30, 1,  FR, hd + 0.0)
}


# ════════════════════════════════════════════════════════════════════════════
# LING MOON — 12-ring silver lotus + disc + cool corona, opposite arc
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ling_moon(FR, hd) {
    ผูก ts  = FR * (1.0 / 520.0) * 6.2832
    ผูก tm  = ts + 3.14159              # opposite phase = reciprocity
    ผูก msx = โคไซน์(tm) * 8.0
    ผูก msy = H + 2.2 + ไซน์(tm * 0.5) * 1.2
    ผูก msz = PZ + ไซน์(tm) * 4.5

    # Cool hyperbolic halo (softer than sun, more rings = moon disc suggestion)
    vtex_hyperbolic_uv(msx, msy, msz,  1,0,0,  0,1,0,  3.0, 6, 10,  FR * 0.28, hd + 4.3)
    # 12-petal lotus (lunar — 12 months cycle)
    ลายดอกบัว(msx, msy, msz,    1,0,0,  0,1,0,  0.45, 1.55, 12,  FR * 0.42, hd + 4.5)
    # Moon disc rings
    ลายวงซ้อน(msx, msy, msz,    1,0,0,  0,1,0,  4, 12,  2.20, 0.08,  FR * 0.42, hd + 4.8)
    # Second plane rings — 90° offset (different angle = disc shape)
    ลายวงซ้อน(msx, msy, msz,    0,0,1,  0,1,0,  2, 12,  1.80, 0.0,  FR * 0.42, hd + 3.8)
    # Central lunar core
    ลายดอก(msx, msy, msz,   1,0,0,  0,1,0,  1.10, 12,  FR * 0.35, hd + 5.0)
    ลายจักร(msx, msy, msz,   1,0,0,  0,1,0,  0.22, 1,   FR, hd + 3.5)
}


# ════════════════════════════════════════════════════════════════════════════
# MIRROR POND  — hyperbolic surface, floating lotus, rings, fountain jet
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_pond(FR, hd) {
    ผูก py  = 0 - H + 0.02
    ผูก tx  = PX
    ผูก tz  = PZ

    # Super-hyperbolic water surface (3 layers at slightly different depths)
    ผูก hw = sm2_hash(5.0, 5.0,  FR * 0.0040,  FR * 0.0048)
    vtex_hyperbolic_uv(tx, py, tz,   1,0,0,  0,0,1,  4.5, 6, 12,  FR * (0.10 + hw * 0.05), hd + 4.0)
    vtex_hyperbolic_uv(tx, py, tz,   1,0,0,  0,0,1,  2.8, 4,  8,  FR * (0.16 + hw * 0.04), hd + 4.8)

    # Concentric ripple rings (5 rings = 5-tone pentatonic)
    ลายวงซ้อน(tx, py, tz,   1,0,0,  0,0,1,  5, 5,  4.0, 0.16,  FR, hd + 3.5)

    # Floating lotus — three positions, staggered phase
    ลายดอกบัว(tx,        py + 0.07, tz,           1,0,0,  0,0,1,  0.26, 0.80, 8,  FR * 0.52, hd + 3.8)
    ลายดอกบัว(tx + 1.1,  py + 0.06, tz + 0.8,     1,0,0,  0,0,1,  0.18, 0.54, 6,  FR * 0.58, hd + 5.2)
    ลายดอกบัว(tx - 1.0,  py + 0.06, tz - 0.7,     1,0,0,  0,0,1,  0.16, 0.48, 6,  FR * 0.64, hd + 2.6)

    # Fountain jet — vertical spiral bursting upward
    ลายเกลียว(tx, py + 0.90, tz,  0,1,0,  1,0,0,  0.12, 1.00, 40,  FR * 1.10, hd + 4.6)
    ลายเกลียว(tx, py + 0.45, tz,  0,1,0,  1,0,0,  0.18, 0.50, 28,  FR * 0.80, hd + 4.2)

    # Pond edge chakra
    ลายจักร(tx, py, tz,  1,0,0,  0,0,1,  4.2, 5,  FR * 0.04, hd + 2.8)
}


# ════════════════════════════════════════════════════════════════════════════
# WILD CHINESE SPIRIT TREE — 6 pulsing layers, 3 orientation planes
#
# Each layer uses a different visual pulse speed (small objects = faster).
# Branches use XY, YZ, XZ planes so each viewing angle reveals new geometry.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_chinese_tree(FR, hd) {
    ผูก tx = PX
    ผูก tz = PZ
    ผูก gy = 0 - H

    # ════ LAYER 0: ROOTS / BASE  (pulse 0.012 — slowest) ════
    ผูก br0  = ไซน์(FR * 0.012 + 0.00) * 0.45 + 0.55
    ผูก r0   = 1.30 * br0
    ผูก ty0  = gy + 0.04

    # Root hyperbolic bark (XZ horizontal — looks like floor circle from above)
    vtex_hyperbolic_uv(tx, ty0, tz,  1,0,0,  0,0,1,  r0 * 3.0, 5, 10,  FR * 0.06, hd + 1.8)
    # Root rings — XZ plane (circle from above, line from front)
    ลายวงซ้อน(tx, ty0, tz,  1,0,0,  0,0,1,  4, 8,  r0 * 2.5, 0.10,  FR * 0.07, hd + 1.4)
    # Base chakra XY plane (circle from front, dot from top)
    ลายจักร(tx, gy, tz,  1,0,0,  0,0,1,  r0 * 2.8, 8,  FR * 0.05, hd + 0.8)

    # ════ LAYER 1: LOWER TRUNK  (pulse 0.018) ════
    ผูก br1  = ไซน์(FR * 0.018 + 1.00) * 0.45 + 0.55
    ผูก r1   = 0.70 * br1
    ผูก ty1  = gy + 1.5

    # Trunk rings — YZ plane (circle from side, line from front — key angle change!)
    ลายวงซ้อน(tx, ty1, tz,  0,1,0,  1,0,0,  3, 8,  r1 * 1.3, 0.0,  FR * 0.12, hd + 1.5)
    # Bark hyperbolic — XY plane (rich from front, thin line from side)
    vtex_hyperbolic_uv(tx, ty1, tz,  1,0,0,  0,1,0,  r1 * 2.0, 5, 10,  FR * 0.10, hd + 2.1)
    # Trunk spiral — YZ plane helix
    ลายเกลียว(tx, ty1, tz,  0,1,0,  1,0,0,  r1 * 0.22, r1 * 1.2, 36,  FR * 0.16, hd + 1.2)

    # ════ LAYER 2: FIRST BRANCH JUNCTION  (pulse 0.028) ════
    ผูก br2  = ไซน์(FR * 0.028 + 2.00) * 0.45 + 0.55
    ผูก r2   = 0.58 * br2
    ผูก ty2  = gy + 2.6

    # Centre cluster — XY lotus (vanishes to a line from side view)
    ผูก i2   = r2 * 0.28
    ผูก o2   = r2 * 0.85
    ลายดอกบัว(tx, ty2, tz,  1,0,0,  0,1,0,  i2, o2, 8,  FR, hd + 2.5)
    ลายวงซ้อน(tx, ty2, tz,  0,1,0,  1,0,0,  1, 8,  r2 * 1.5, 0.0,  FR * 0.35, hd + 2.8)

    # Left branch — XZ plane (different plane = looks circular from above)
    ผูก bx2l = tx - 2.0 * br2
    ผูก bx2r = tx + 2.0 * br2
    ลายดอก(bx2l, ty2 + 0.45, tz,  1,0,0,  0,1,0,  r2 * 1.25, 6,  FR * 0.60, hd + 0.5)
    ลายดอกบัว( bx2l, ty2 + 0.45, tz,  1,0,0,  0,1,0,  r2*0.22, r2*0.66, 6,  FR, hd + 0.2)
    # Right branch — reciprocal
    ลายดอก(bx2r, ty2 + 0.45, tz,  1,0,0,  0,1,0,  r2 * 1.25, 6,  FR * 0.60, hd + 3.5)
    ลายดอกบัว( bx2r, ty2 + 0.45, tz,  1,0,0,  0,1,0,  r2*0.22, r2*0.66, 6,  FR, hd + 3.2)
    # Back branch — YZ plane (looks totally different from front vs side)
    ผูก bz2b = tz - 1.6 * br2
    ลายดอก(tx, ty2 + 0.62, bz2b,  0,0,1,  0,1,0,  r2 * 0.96, 5,  FR * 0.70, hd + 1.5)
    vtex_hyperbolic_uv(tx, ty2 + 0.62, bz2b,  0,0,1,  0,1,0,  r2 * 1.4, 3, 6,  FR * 0.40, hd + 2.0)

    # ════ LAYER 3: MID TRUNK + BRANCHES  (pulse 0.040) ════
    ผูก br3  = ไซน์(FR * 0.040 + 3.00) * 0.45 + 0.55
    ผูก r3   = 0.50 * br3
    ผูก ty3  = gy + 3.6

    # Rotating XZ rings (horizontal disc — seen as rings from below/above)
    ลายวงซ้อน(tx, ty3, tz,  0,1,0,  1,0,0,  2, 10,  r3 * 1.5, 0.0,  FR * 0.30, hd + 3.0)
    # Centre lotus XY
    ผูก i3   = r3 * 0.24
    ผูก o3   = r3 * 0.72
    ลายดอกบัว(tx, ty3, tz,  1,0,0,  0,1,0,  i3, o3, 10,  FR, hd + 3.5)
    # Hyperbolic bark cross-section (XZ — major angular change)
    vtex_hyperbolic_uv(tx, ty3, tz,  1,0,0,  0,0,1,  r3 * 2.2, 4, 8,  FR * 0.22, hd + 2.8)

    # Four diagonal branches — front-left, front-right, back-left, back-right
    ผูก bx3l = tx - 1.6 * br3
    ผูก bx3r = tx + 1.6 * br3
    ผูก bz3f = tz + 0.9 * br3
    ผูก bz3b = tz - 0.9 * br3
    # Front pair
    ลายดอก(bx3l, ty3 + 0.52, bz3f,  1,0,0,  0,1,0,  r3 * 1.05, 7,  FR * 0.65, hd + 1.0)
    ลายดอก(bx3r, ty3 + 0.52, bz3f,  1,0,0,  0,1,0,  r3 * 1.05, 7,  FR * 0.65, hd + 4.0)
    # Back pair — in YZ plane (circles from side, lines from front)
    ลายดอก(bx3l, ty3 + 0.52, bz3b,  0,0,1,  0,1,0,  r3 * 0.88, 6,  FR * 0.70, hd + 2.0)
    ลายดอก(bx3r, ty3 + 0.52, bz3b,  0,0,1,  0,1,0,  r3 * 0.88, 6,  FR * 0.70, hd + 5.0)

    # ════ LAYER 4: UPPER BRANCHES  (pulse 0.055) ════
    ผูก br4  = ไซน์(FR * 0.055 + 4.00) * 0.45 + 0.55
    ผูก r4   = 0.40 * br4
    ผูก ty4  = gy + 4.5

    ผูก i4   = r4 * 0.22
    ผูก o4   = r4 * 0.66
    ลายดอกบัว(tx, ty4, tz,  1,0,0,  0,1,0,  i4, o4, 12,  FR, hd + 4.5)
    vtex_hyperbolic_uv(tx, ty4, tz,  1,0,0,  0,1,0,  r4 * 2.5, 5, 10,  FR * 0.30, hd + 4.0)
    ลายเกลียว(tx, ty4, tz,  0,1,0,  1,0,0,  r4 * 0.14, r4 * 0.85, 48,  FR * 0.25, hd + 3.8)

    # Six outer blooms — mix of XY, YZ, XZ planes
    ผูก bx4l = tx - 2.4 * br4
    ผูก bx4r = tx + 2.4 * br4
    # XY plane (front/back — circular from front, invisible from side)
    ลายดอกบัว(bx4l, ty4, tz,  1,0,0,  0,1,0,  r4*0.18, r4*0.54, 8,  FR, hd + 0.0)
    ลายดอกบัว(bx4r, ty4, tz,  1,0,0,  0,1,0,  r4*0.18, r4*0.54, 8,  FR, hd + 2.1)
    # YZ plane (side — circular from side, invisible from front)
    ลายดอก(tx, ty4 + 0.85, tz - 2.2 * br4,  0,0,1,  0,1,0,  r4 * 0.92, 8,  FR * 0.62, hd + 4.2)
    ลายดอก(tx, ty4 + 0.85, tz + 1.4 * br4,  0,0,1,  0,1,0,  r4 * 0.80, 7,  FR * 0.68, hd + 1.4)
    # XZ plane (horizontal — visible from above, invisible from front)
    ลายดอกบัว(bx4l, ty4 + 0.85, tz - 1.0 * br4,  1,0,0,  0,0,1,  r4*0.14, r4*0.42, 6,  FR*0.5, hd + 3.2)
    ลายดอกบัว(bx4r, ty4 + 0.85, tz + 1.0 * br4,  1,0,0,  0,0,1,  r4*0.14, r4*0.42, 6,  FR*0.5, hd + 5.3)

    # ════ LAYER 5: CROWN  (pulse 0.075 — fastest shimmer) ════
    ผูก br5  = ไซน์(FR * 0.075 + 5.00) * 0.45 + 0.55
    ผูก r5   = 0.30 * br5
    ผูก ty5  = gy + 5.8
    ผูก tystar = ty5 + r5 * 1.4

    # Crown hyperbolic burst (sky-hyperbolic seen from below = completely different)
    vtex_hyperbolic_uv(tx, ty5, tz,  1,0,0,  0,1,0,  r5 * 3.0, 5, 10,  FR * 0.22, hd + 4.8)
    vtex_hyperbolic_uv(tx, ty5, tz,  1,0,0,  0,0,1,  r5 * 2.2, 4,  8,  FR * 0.28, hd + 5.4)
    # Crown lotus
    ผูก i5   = r5 * 0.24
    ผูก o5   = r5 * 0.74
    ลายดอกบัว(tx, ty5, tz,  1,0,0,  0,1,0,  i5, o5, 12,  FR, hd + 5.5)
    # Star tip (highest tone anchor — E5)
    ลายดาว(tx, tystar, tz,  1,0,0,  0,1,0,  6, r5 * 1.1, r5 * 0.44, 0.06,  FR * 0.55, hd + 0.0)
    ลายดาว(tx, tystar, tz,  0,0,1,  0,1,0,  6, r5 * 0.9, r5 * 0.36, 0.07,  FR * 0.55, hd + 2.0)

    # Crown blooms — 8 directions, mixed planes
    ผูก bx5l = tx - 1.6 * br5
    ผูก bx5r = tx + 1.6 * br5
    ผูก bz5b = tz - 1.6 * br5
    ผูก bz5f = tz + 1.2 * br5
    ลายดอก(bx5l, ty5 + 0.35, tz,   1,0,0,  0,1,0,  r5 * 1.05, 8,  FR * 0.80, hd + 0.8)
    ลายดอก(bx5r, ty5 + 0.35, tz,   1,0,0,  0,1,0,  r5 * 1.05, 8,  FR * 0.80, hd + 2.9)
    ลายดอก(tx, ty5 + 0.35, bz5b,   0,0,1,  0,1,0,  r5 * 1.05, 8,  FR * 0.80, hd + 5.0)
    ลายดอก(tx, ty5 + 0.35, bz5f,   0,0,1,  0,1,0,  r5 * 0.88, 7,  FR * 0.80, hd + 3.5)

    # Tiny leaf dots (fast pulse matches E5 audio shimmer)
    ลายจักร(bx5l, ty5 + 0.68, tz,   1,0,0,  0,1,0,  r5 * 0.09, 1,  FR, hd + 0.0)
    ลายจักร(bx5r, ty5 + 0.68, tz,   1,0,0,  0,1,0,  r5 * 0.09, 1,  FR, hd + 0.0)
    ลายจักร(tx, ty5 + 0.68, bz5b,   1,0,0,  0,1,0,  r5 * 0.09, 1,  FR, hd + 0.0)
    ลายจักร(tx, ty5 + 0.68, bz5f,   1,0,0,  0,1,0,  r5 * 0.09, 1,  FR, hd + 0.0)
}


# ════════════════════════════════════════════════════════════════════════════
# MIRROR TREE — reflected at y_mirror = −2H − y_actual
#               (below ground — visible through pond tessellation gaps)
#               Dimmed: ×0.72 scale, hue +3.5 (cooler, deeper colour)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_mirror_tree(FR, hd) {
    ผูก tx   = PX
    ผูก tz   = PZ
    ผูก gy   = 0 - H
    ผูก mb   = 0 - H - H    # = −2H = −12 (mirror base)
    ผูก hdm  = hd + 3.5     # cooler hue band for reflection
    ผูก dm   = 0.72         # dimness scale

    # ── Mirror Layer 0 (just below surface) ──
    ผูก br0  = ไซน์(FR * 0.012 + 0.00) * 0.45 + 0.55
    ผูก r0m  = 1.30 * br0 * dm
    ผูก my0  = mb - gy              # = −12 − (−6) = −6
    ลายวงซ้อน(tx, my0 - 0.04, tz,  1,0,0,  0,0,1,  3, 8,  r0m * 2.2, 0.10,  FR * 0.07, hdm + 1.4)
    ลายจักร(tx, my0, tz,  1,0,0,  0,0,1,  r0m * 2.6, 8,  FR * 0.05, hdm + 0.8)

    # ── Mirror Layer 1 ──
    ผูก br1  = ไซน์(FR * 0.018 + 1.00) * 0.45 + 0.55
    ผูก r1m  = 0.70 * br1 * dm
    ผูก ty1  = gy + 1.5
    ผูก my1  = mb - ty1             # = −12 − (−4.5) = −7.5
    ลายวงซ้อน(tx, my1, tz,  0,1,0,  1,0,0,  3, 8,  r1m * 1.3, 0.0,  FR * 0.12, hdm + 1.5)
    ลายเกลียว(tx, my1, tz,  0,1,0,  1,0,0,  r1m * 0.20, r1m * 1.1, 30,  FR * 0.16, hdm + 1.2)

    # ── Mirror Layer 2 ──
    ผูก br2  = ไซน์(FR * 0.028 + 2.00) * 0.45 + 0.55
    ผูก r2m  = 0.58 * br2 * dm
    ผูก ty2  = gy + 2.6
    ผูก my2  = mb - ty2             # = −12 − (−3.4) = −8.6
    ผูก i2m  = r2m * 0.28
    ผูก o2m  = r2m * 0.85
    ลายดอกบัว(tx, my2, tz,  1,0,0,  0,1,0,  i2m, o2m, 8,  FR, hdm + 2.5)
    ผูก bx2l = tx - 2.0 * br2 * dm
    ผูก bx2r = tx + 2.0 * br2 * dm
    ลายดอก(bx2l, my2 - 0.45, tz,  1,0,0,  0,1,0,  r2m * 1.15, 6,  FR * 0.60, hdm + 0.5)
    ลายดอก(bx2r, my2 - 0.45, tz,  1,0,0,  0,1,0,  r2m * 1.15, 6,  FR * 0.60, hdm + 3.5)

    # ── Mirror Layer 3 ──
    ผูก br3  = ไซน์(FR * 0.040 + 3.00) * 0.45 + 0.55
    ผูก r3m  = 0.50 * br3 * dm
    ผูก ty3  = gy + 3.6
    ผูก my3  = mb - ty3             # = −12 − (−2.4) = −9.6
    ผูก i3m  = r3m * 0.24
    ผูก o3m  = r3m * 0.72
    ลายดอกบัว(tx, my3, tz,  1,0,0,  0,1,0,  i3m, o3m, 10,  FR, hdm + 3.5)
    ผูก bx3l = tx - 1.6 * br3 * dm
    ผูก bx3r = tx + 1.6 * br3 * dm
    ลายดอก(bx3l, my3 - 0.52, tz,  1,0,0,  0,1,0,  r3m * 0.96, 7,  FR * 0.65, hdm + 1.0)
    ลายดอก(bx3r, my3 - 0.52, tz,  1,0,0,  0,1,0,  r3m * 0.96, 7,  FR * 0.65, hdm + 4.0)

    # ── Mirror Layer 4 ──
    ผูก br4  = ไซน์(FR * 0.055 + 4.00) * 0.45 + 0.55
    ผูก r4m  = 0.40 * br4 * dm
    ผูก ty4  = gy + 4.5
    ผูก my4  = mb - ty4             # = −12 − (−1.5) = −10.5
    ผูก i4m  = r4m * 0.22
    ผูก o4m  = r4m * 0.66
    ลายดอกบัว(tx, my4, tz,  1,0,0,  0,1,0,  i4m, o4m, 12,  FR, hdm + 4.5)
    ผูก bx4l = tx - 2.4 * br4 * dm
    ผูก bx4r = tx + 2.4 * br4 * dm
    ลายดอกบัว(bx4l, my4, tz,  1,0,0,  0,1,0,  r4m*0.16, r4m*0.48, 8,  FR, hdm + 0.0)
    ลายดอกบัว(bx4r, my4, tz,  1,0,0,  0,1,0,  r4m*0.16, r4m*0.48, 8,  FR, hdm + 2.1)

    # ── Mirror Layer 5 (crown, deepest reflection) ──
    ผูก br5  = ไซน์(FR * 0.075 + 5.00) * 0.45 + 0.55
    ผูก r5m  = 0.30 * br5 * dm
    ผูก ty5  = gy + 5.8
    ผูก my5  = mb - ty5             # = −12 − (−0.2) = −11.8
    ผูก i5m  = r5m * 0.22
    ผูก o5m  = r5m * 0.68
    ลายดอกบัว(tx, my5, tz,  1,0,0,  0,1,0,  i5m, o5m, 12,  FR, hdm + 5.5)
    ผูก mytip = my5 - r5m * 1.4
    ลายดาว(tx, mytip, tz,  1,0,0,  0,1,0,  6, r5m * 1.0, r5m * 0.40, 0.06,  FR * 0.55, hdm + 0.0)
    ผูก bx5l = tx - 1.6 * br5 * dm
    ผูก bx5r = tx + 1.6 * br5 * dm
    ลายดอก(bx5l, my5 - 0.35, tz,  1,0,0,  0,1,0,  r5m * 0.95, 8,  FR * 0.80, hdm + 0.8)
    ลายดอก(bx5r, my5 - 0.35, tz,  1,0,0,  0,1,0,  r5m * 0.95, 8,  FR * 0.80, hdm + 2.9)
}


# ════════════════════════════════════════════════════════════════════════════
# GARDEN FLORA  — surrounding plants, not part of the tree
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_garden_flora(FR, hd) {
    ผูก fy = 0 - H + 0.05

    # Left cluster
    ลายดอก(0-5.5, fy + 0.55, 6.5,  1,0,0,  0,1,0,  0.40, 6,  FR * 0.58, hd + 0.5)
    ลายดอกบัว( 0-5.5, fy + 0.33, 6.5,  1,0,0,  0,1,0,  0.12, 0.36, 8,  FR, hd + 0.2)
    ลายดอก(0-6.2, fy + 0.44, 7.5,  1,0,0,  0,1,0,  0.30, 5,  FR * 0.68, hd + 1.0)
    ลายจักร(0-5.0, fy + 0.20, 5.8,  1,0,0,  0,1,0,  0.07, 1,  FR, hd + 0.0)

    # Right cluster
    ลายดอก( 5.2,  fy + 0.52, 6.8,  1,0,0,  0,1,0,  0.36, 6,  FR * 0.54, hd + 3.8)
    ลายดอกบัว(  5.2,  fy + 0.30, 6.8,  1,0,0,  0,1,0,  0.11, 0.32, 8,  FR, hd + 3.5)
    ลายดอก( 6.0,  fy + 0.42, 7.8,  1,0,0,  0,1,0,  0.28, 5,  FR * 0.62, hd + 4.4)
    ลายจักร( 4.8,  fy + 0.18, 6.2,  1,0,0,  0,1,0,  0.07, 1,  FR, hd + 3.0)

    # Back left tree
    ผูก br_l = ไซน์(FR * 0.022 + 1.5) * 0.45 + 0.55
    ผูก tyl1 = fy + 1.2 * br_l
    ผูก tyl2 = fy + 2.3 * br_l
    ลายวงซ้อน(0-7.5, tyl1, 14.5,  0,1,0,  1,0,0,  2, 4,  0.30 * br_l, 0.0,  FR * 0.08, hd + 1.8)
    ลายดอก(0-7.5, tyl2, 14.5, 1,0,0,  0,1,0,  1.10 * br_l, 8,  FR * 0.22, hd + 2.5)
    ลายดอกบัว( 0-7.5, tyl2, 14.5, 1,0,0,  0,1,0,  0.32 * br_l, 0.95 * br_l, 8,  FR * 0.25, hd + 2.0)

    # Back right tree
    ผูก br_r = ไซน์(FR * 0.022 + 4.2) * 0.45 + 0.55
    ผูก tyr1 = fy + 1.0 * br_r
    ผูก tyr2 = fy + 2.1 * br_r
    ลายวงซ้อน( 7.0,   tyr1, 13.5,  0,1,0,  1,0,0,  2, 4,  0.28 * br_r, 0.0,  FR * 0.08, hd + 4.8)
    ลายดอก( 7.0,  tyr2, 13.5,  1,0,0,  0,1,0,  0.98 * br_r, 7,  FR * 0.20, hd + 5.5)
    ลายดอกบัว(  7.0,  tyr2, 13.5,  1,0,0,  0,1,0,  0.28 * br_r, 0.85 * br_r, 7,  FR * 0.22, hd + 5.0)
}


# ════════════════════════════════════════════════════════════════════════════
# ECHO PASS  — ghost trail (anchor shapes only, no full tree redrawn)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก gy  = 0 - H
    ผูก gz  = FZ * 0.52
    ผูก ts  = FR * (1.0 / 520.0) * 6.2832
    ผูก ssx = โคไซน์(ts) * 9.0
    ผูก ssy = H + 2.8 + ไซน์(ts * 0.5) * 1.5
    ผูก ssz = PZ + ไซน์(ts) * 5.0
    ผูก tm  = ts + 3.14159
    ผูก msx = โคไซน์(tm) * 8.0
    ผูก msy = H + 2.2 + ไซน์(tm * 0.5) * 1.2
    ผูก msz = PZ + ไซน์(tm) * 4.5

    # Ground echo
    vtex_hyperbolic_uv(0, gy, gz,  1,0,0,  0,0,1,  8.0, 6, 10,  FR * 0.015, hd + 2.2)

    # Sun echo
    ลายดาว(ssx, ssy, ssz,  1,0,0,  0,1,0,  8, 2.20, 0.88, 0.04,  FR * 0.18, hd + 0.8)

    # Moon echo
    ลายวงซ้อน(msx, msy, msz,  1,0,0,  0,1,0,  2, 12,  1.60, 0.08,  FR * 0.42, hd + 4.8)

    # Pond echo
    ลายวงซ้อน(PX, gy, PZ,  1,0,0,  0,0,1,  3, 5,  3.2, 0.16,  FR, hd + 3.5)

    # Tree root echo
    ผูก br0e = ไซน์(FR * 0.012 + 0.00) * 0.45 + 0.55
    ลายจักร(PX, gy, PZ,  1,0,0,  0,0,1,  br0e * 2.5, 8,  FR * 0.05, hd + 0.8)

    # Crown star echo
    ผูก br5e = ไซน์(FR * 0.075 + 5.00) * 0.45 + 0.55
    ผูก ty5e = gy + 5.8
    ผูก tipe = ty5e + br5e * 0.42
    ลายดาว(PX, tipe, PZ,  1,0,0,  0,1,0,  6, br5e*0.33, br5e*0.13, 0.06,  FR * 0.55, hd + 0.0)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN — Floating Hyperspace Camera (always points to garden center)
# ════════════════════════════════════════════════════════════════════════════

ผูก สร้าง = ทำ {
    เปิดหน้าต่างเต็มจอ("灵 Mirror Garden — Sun · Moon · Tree · Hyperbolic Orbit")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.06)
    init_audio()

    ผูก 帧 = 0

    # Camera target — center of the garden (the tree heart)
    ผูก target_x = PX
    ผูก target_y = 0.0
    ผูก target_z = PZ

    # Floating orbit parameters (exaggerated hyperbolic)
    ผูก orbit_radius_horiz = 16.0      # Wide horizontal sweep
    ผูก orbit_radius_vert  = 8.0       # Extreme vertical range
    ผูก orbit_speed_horiz  = 0.0009    # Slow horizontal drift
    ผูก orbit_speed_vert   = 0.0014    # Faster vertical figure-8
    ผูก roll_amplitude     = 0.12      # Slight camera roll (radians)
    ผูก roll_speed         = 0.0007

    # Manual control disabled — pure autonomous floating
    # (Remove WASD controls for meditative viewing)

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(1, 2, 8)     # near-black midnight indigo

        # Hue cycling — full spectrum
        ผูก hd = 帧 * 0.055

        # ── HYPERBOLIC FLOATING CAMERA PATH ────────────────────────────────
        # Creates a lemniscate / figure-8 orbit in 3D space
        # The camera traces a hyperbolic curve around the garden
        
        ผูก t1 = 帧 * orbit_speed_horiz
        ผูก t2 = 帧 * orbit_speed_vert
        
        # Hyperbolic position: sin(t) * cos(2t) creates infinity symbol in XZ
        ผูก cam_px = target_x + ไซน์(t1) * orbit_radius_horiz * (0.8 + 0.2 * โคไซน์(t1 * 1.3))
        ผูก cam_pz = target_z + ไซน์(t1 * 2.0) * orbit_radius_horiz * 0.7
        
        # Vertical motion: figure-8 in Y axis, exaggerated
        ผูก cam_py = target_y + 2.0 + ไซน์(t2 * 1.7) * orbit_radius_vert * 0.6 + โคไซน์(t2 * 0.9) * 2.0
        
        # Add hyperbolic spiral component for extra depth
        ผูก เกลียว = 帧 * 0.0003
        ผูก cam_px = cam_px + ไซน์(เกลียว * 3.0) * 1.2
        ผูก cam_pz = cam_pz + โคไซน์(เกลียว * 2.0) * 1.2
        ผูก cam_py = cam_py + ไซน์(เกลียว * 4.0) * 0.8
        
        # ── LOOK-AT: Always point to garden center ─────────────────────────
        # Compute direction from camera to target
        ผูก dx = target_x - cam_px
        ผูก dy = target_y - cam_py
        ผูก dz = target_z - cam_pz
        ผูก ความยาว = รากที่สอง(dx*dx + dy*dy + dz*dz)
        
        ถ้า ความยาว > 0.0001 {
            ผูก dx = dx / ความยาว
            ผูก dy = dy / ความยาว
            ผูก dz = dz / ความยาว
        }
        
        # Convert to yaw (ry) and pitch (rx)
        ผูก ry = atan2(dx, dz)           # Horizontal angle
        ผูก rx = asin(dy)                # Vertical angle (clamped to -pi/2..pi/2)
        
        # ── SLIGHT ROLL (tilt) for cinematic feel ──────────────────────────
        # Roll is applied as a rotation around the forward axis
        ผูก roll_angle = ไซน์(帧 * roll_speed) * roll_amplitude
        # In this framework, roll is typically applied via camera up vector
        # We'll simulate by slightly modifying the orientation basis
        # (Assuming set_camera expects forward direction only, roll is visual)
        
        # For frameworks that support roll, you would set up vector:
        # up_x = -sin(roll) * right_x, up_y = cos(roll), up_z = -sin(roll) * right_z
        
        # Set camera orientation (yaw + pitch, roll handled separately)
        ตั้งกล้อง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))
        
        # Add roll if supported by your framework
        ถ้า roll_supported() {
            set_camera_roll(roll_angle)
        }
        
        # Set camera position
        ตั้งตำแหน่งกล้อง(cam_px, cam_py, cam_pz)
        
        # Fixed zoom distance (no manual zoom)
        ตั้งระยะห่าง(2.0)
        
        # Update audio listener orientation
        ผู้ฟัง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))
        
        # ── LIGHTS ─────────────────────────────────────────────────────────
        setup_lights(帧)
        
        # ── ECHO TRAILS ───────────────────────────────────────────────────
        draw_echo(帧 - 12, hd + 1.8)
        draw_echo(帧 - 24, hd + 3.6)
        draw_echo(帧 - 36, hd + 5.4)
        
        # ── FULL SCENE ─────────────────────────────────────────────────────
        draw_ground(帧, hd)
        draw_sky(帧, hd)
        draw_pond(帧, hd)
        draw_mirror_tree(帧, hd)
        draw_chinese_tree(帧, hd)
        draw_ling_sun(帧, hd)
        draw_ling_moon(帧, hd)
        draw_garden_flora(帧, hd)
        
        แสดงผล()
        ผูก 帧 = 帧 + 1
    }
}

# Helper function to check if roll is supported (if needed)
ฟังก์ชัน roll_supported() {
    # Return true if framework supports camera roll
    จริง
