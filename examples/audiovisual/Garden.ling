# ════════════════════════════════════════════════════════════════════════════
# Garden.ling — The Synesthetic Garden
#
# An open outdoor garden — no walls, no ceiling.  Ground, open sky, living
# geometry.  A reflective pond at centre, two foreground trees, scattered
# flower beds, a backdrop tree line, and a wooden garden shed.
#
# Shape → Tone mapping (pentatonic G major: G A B D E):
#   DOT   (tiny chakra, single ring)          → G3 = 196.00 Hz  (earth pulse)
#   LINE  (grid, yantra, flat rings)           → A3 = 220.00 Hz  (wind chime)
#   CURVE (spiral, lotus, flower)              → B3 = 246.94 Hz  (bird / water)
#   BLOOM (flower + rings together)            → D4 = 293.66 Hz  (sunlight shimmer)
#   SKY   (hyperbolic, star)                   → E4 = 329.63 Hz  (sky drone)
#
# SM2-inspired hash: ground patches and shed planks each get independent
# hash seeds — every surface has its own pseudo-random detail density.
#
# Camera: slow panoramic yaw + slight upward tilt, 520-frame period.
# ════════════════════════════════════════════════════════════════════════════

ผูก W   = 10.0
ผูก H   = 5.5
ผูก FZ  = 20.0
ผูก NZ  = 1.5
ผูก MZ  = 10.75    # (NZ + FZ) / 2

ผูก PX  = 0.0      # pond centre x
ผูก PZ  = 9.0      # pond centre z

ผูก SX  = 5.8      # shed centre x
ผูก SZ  = 14.5     # shed centre z

# Pentatonic G major frequencies
ผูก PG3 = 196.00   # G3 — earth / ground
ผูก PA3 = 220.00   # A3 — wind / path
ผูก PB3 = 246.94   # B3 — water / bird
ผูก PD4 = 293.66   # D4 — sunlight / bloom
ผูก PE4 = 329.63   # E4 — sky drone


# ════════════════════════════════════════════════════════════════════════════
# SM2-INSPIRED HASH  (ground and shed surface seeding)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน sm2_hash(cx, ry, a, b) {
    ผูก p = cx * 2166136261.0 + ry * 16777619.0
    ผูก s = ไซน์(p * 0.0000031 + a) * 0.5 + 0.5
    ผูก c = โคไซน์(p * 0.0000059 - b) * 0.5 + 0.5
    s * 0.618 + c * 0.382
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO  — five pentatonic voices
#   earth hum · water ripple · sky drone · bird chirp · wind breeze
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot  x          y         z      w    freq  amp  lfo_hz  depth
    เสียงโทน(0,  PX,       0-H,     PZ,   3.0,  PG3, 0.09, 0.04, 0.002)
    เสียงโทน(1,  PX,       0,       PZ,   2.5,  PB3, 0.10, 0.28, 0.030)
    เสียงโทน(2,  0,        H,       MZ,   4.0,  PE4, 0.08, 0.07, 0.005)
    เสียงโทน(3,  0-W*0.4,  H*0.5,  MZ*0.75, 2.0, PD4, 0.09, 3.20, 0.180)
    เสียงโทน(4,  SX,       0,       SZ,   2.0,  PA3, 0.08, 0.34, 0.038)
    เสียงโทน(5,  0,        H*0.4,   MZ,   3.5,  PB3, 0.07, 0.17, 0.018)
    ระดับเสียง(0.48)
}


# ════════════════════════════════════════════════════════════════════════════
# LIGHTS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()

    # Sun — warm bright, slow arc overhead
    ผูก ts = FR * 0.0026
    เพิ่มแสง(
        โคไซน์(ts) * 8.0,
        H + 2.2 + ไซน์(ts) * 1.4,
        MZ + ไซน์(ts * 0.5) * 4.0,
        1.00, 0.94, 0.70,   5.2, 18.0
    )

    # Sky fill — soft blue from above
    เพิ่มแสง(0, H + 1.0, MZ,   0.30, 0.50, 0.92,   1.2, 16.0)

    # Pond shimmer — cool reflection ripple
    ผูก tp = FR * 0.040
    เพิ่มแสง(
        PX + ไซน์(tp) * 0.6,  0-H + 0.4,  PZ + โคไซน์(tp) * 0.5,
        0.26, 0.66, 0.98,   1.6, 7.0
    )

    # Shed lantern — warm amber, slight flicker
    ผูก tl = FR * 0.058
    เพิ่มแสง(
        SX + ไซน์(tl) * 0.14,  0-H + 1.9,  SZ - 0.4,
        1.00, 0.68, 0.20,   1.8, 5.5
    )

    # Ground bounce — warm fill from below
    เพิ่มแสง(0,  0-H + 0.1,  MZ,   0.38, 0.26, 0.14,   0.6, 9.0)
}


# ════════════════════════════════════════════════════════════════════════════
# GROUND  — grass, stone path, flower-bed patches
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ground(FR, hd) {
    ผูก gy = 0 - H
    ผูก gz = FZ * 0.50

    # Grass — SM2-hash tessellation (earth/green hue band)
    ผูก h1 = sm2_hash(2.0, 6.0,  FR * 0.0018,  FR * 0.0024)
    ผูก h2 = sm2_hash(6.0, 2.0,  FR * 0.0024,  FR * 0.0018)
    vtex_tessellated(0, gy, gz,  1,0,0,  0,0,1,  26, 22,  0.30 + h1*0.12, 0.08 + h2*0.04, 4.0,  FR, hd + 2.2)

    # Stone path — central yantra + grid (LINE → A3)
    ลายยันต์(0, gy, gz * 0.68,  1,0,0,  0,0,1,  4, 4.2,  FR * 0.06, hd + 1.0)
    ลายตาราง(0, gy, gz * 0.52,    1,0,0,  0,0,1,  18, 8,  0.56, 0.38,  FR * 0.04, hd + 0.6)

    # Flower-bed ground patches — SM2-seeded chakra base (DOT → G3)
    ผูก h3 = sm2_hash(4.0, 8.0,  FR * 0.0015,  FR * 0.0032)
    ผูก h4 = sm2_hash(8.0, 4.0,  FR * 0.0032,  FR * 0.0015)
    ลายจักร(0-3.5, gy, gz * 0.52,  1,0,0,  0,0,1,  2.6, 5,  FR, hd + 0.0 + h3 * 1.5)
    ลายจักร( 2.8,  gy, gz * 0.60,  1,0,0,  0,0,1,  2.2, 5,  FR, hd + 2.0 + h4 * 1.5)

    # Back ground fade
    ลายตาราง(0, gy, gz * 1.18,  1,0,0,  0,0,1,  20, 14,  0.58, 0.52,  FR * 0.03, hd + 2.8)
}


# ════════════════════════════════════════════════════════════════════════════
# SKY  — open dome: sun disc, drifting clouds, horizon glow
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_sky(FR, hd) {
    ผูก sy = H
    ผูก sz = FZ * 0.50

    # Sky dome — hyperbolic Poincaré field (slow = drifting clouds)
    vtex_hyperbolic_uv(0, sy, sz,  1,0,0,  0,0,1,  9.0, 6, 10,  FR * 0.014, hd + 4.5)

    # Sun disc — 5-point star + radiant rings (SKY → E4)
    ลายดาว(0, sy + 1.8, sz - 3.5,   1,0,0,  0,0,1,  5, 1.3, 0.52, 0.03,  FR * 0.50, hd + 0.7)
    ลายวงซ้อน(0, sy + 1.8, sz - 3.5,  1,0,0,  0,0,1,  2, 5,  2.0, 0.0,    FR * 0.50, hd + 1.1)

    # Cloud banks — slow, large, soft rings (LINE → A3)
    ลายวงซ้อน(0-3.5, sy + 0.6, sz + 1.2,  1,0,0,  0,0,1,  1, 5,  3.4, 0.0,  FR * 0.007, hd + 4.0)
    ลายวงซ้อน( 4.0,  sy + 0.9, sz - 1.8,  1,0,0,  0,0,1,  1, 5,  2.7, 0.0,  FR * 0.009, hd + 4.6)

    # Horizon glow — large flower silhouette at FZ back
    ลายดอก(0, sy - 1.4, FZ,  1,0,0,  0,0,1,  7.5, 5,  FR * 0.016, hd + 3.8)
}


# ════════════════════════════════════════════════════════════════════════════
# TREE  — spiral trunk rings + layered flower/lotus crown
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_tree(x, z, สเกล, FR, hd) {
    ผูก ty_mid   = 0 - H + สเกล * 1.1
    ผูก ty_top   = 0 - H + สเกล * 2.2
    ผูก ty_crown = 0 - H + สเกล * 2.85

    # Trunk rings — horizontal circles stacked in XZ plane (DOT → G3)
    ลายวงซ้อน(x, ty_mid, z,  0,1,0,  1,0,0,  3, 4,  สเกล * 0.22, 0.0,  FR * 0.04, hd + 1.8)
    # Bark spiral — vertical twist (CURVE → B3)
    ลายเกลียว(x, ty_mid, z,  0,1,0,  1,0,0,  สเกล * 0.07, สเกล * 1.1, 30,  FR * 0.07, hd + 1.5)

    # Lower crown flower (BLOOM → D4)
    ลายดอก(x, ty_top, z,    1,0,0,  0,1,0,  สเกล * 1.05, 8,  FR * 0.20, hd + 2.5)
    # Crown lotus (CURVE → B3)
    ลายดอกบัว(x, ty_top, z,     1,0,0,  0,1,0,  สเกล * 0.28, สเกล * 0.86, 10,  FR * 0.24, hd + 2.0)
    # Upper crown tip flower
    ลายดอก(x, ty_crown, z,  1,0,0,  0,1,0,  สเกล * 0.58, 6,  FR * 0.32, hd + 3.0)
    # Crown star (SKY → E4)
    ลายดาว(x, ty_crown + สเกล * 0.32, z,  1,0,0,  0,1,0,  5, สเกล * 0.28, สเกล * 0.11, 0.04,  FR, hd + 0.5)
}


# ════════════════════════════════════════════════════════════════════════════
# TREES  — two foreground + tree-line backdrop
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_trees(FR, hd) {
    # Left foreground — tall oak
    draw_tree(0-5.8, 7.5,  2.0,  FR, hd + 0.0)
    # Right foreground — medium birch
    draw_tree( 3.2,  6.8,  1.7,  FR, hd + 1.2)
    # Back left
    draw_tree(0-6.5, 15.0, 1.4,  FR, hd + 2.4)
    # Back right
    draw_tree( 5.5,  13.5, 1.3,  FR, hd + 3.6)
    # Distant tree line
    draw_tree(0-3.0, 18.0, 1.0,  FR, hd + 0.8)
    draw_tree( 0.8,  19.0, 0.9,  FR, hd + 1.6)
    draw_tree( 4.5,  17.5, 1.1,  FR, hd + 2.8)
}


# ════════════════════════════════════════════════════════════════════════════
# FLOWERS  — scattered beds, left, right, path edges
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_flowers(FR, hd) {
    ผูก fy = 0 - H + 0.05

    # Left bed — warm reds / golds
    ลายดอก(0-4.0, fy + 0.55, 5.5,   1,0,0,  0,1,0,  0.36, 6,  FR * 0.60, hd + 0.5)
    ลายดอกบัว( 0-4.0, fy + 0.34, 5.5,   1,0,0,  0,1,0,  0.11, 0.32, 8,  FR,        hd + 0.2)
    ลายดอก(0-4.8, fy + 0.44, 6.2,   1,0,0,  0,1,0,  0.28, 5,  FR * 0.70, hd + 1.0)
    ลายดอก(0-3.4, fy + 0.48, 4.8,   1,0,0,  0,1,0,  0.30, 7,  FR * 0.50, hd + 1.5)
    # DOT accents (G3 tone)
    ลายจักร(0-3.8, fy + 0.20, 5.2,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 0.0)
    ลายจักร(0-4.4, fy + 0.18, 6.8,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 0.8)

    # Right bed — blues / purples
    ลายดอก( 3.8,  fy + 0.50, 5.2,   1,0,0,  0,1,0,  0.33, 6,  FR * 0.55, hd + 3.8)
    ลายดอกบัว(  3.8,  fy + 0.30, 5.2,   1,0,0,  0,1,0,  0.10, 0.30, 8,  FR,        hd + 3.5)
    ลายดอก( 4.5,  fy + 0.44, 5.9,   1,0,0,  0,1,0,  0.26, 5,  FR * 0.65, hd + 4.2)
    ลายดอก( 3.2,  fy + 0.46, 4.6,   1,0,0,  0,1,0,  0.28, 7,  FR * 0.45, hd + 4.8)
    ลายจักร( 3.6,  fy + 0.18, 5.0,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 3.0)
    ลายจักร( 4.2,  fy + 0.16, 6.5,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 3.8)

    # Path-edge accent flowers
    ลายดอกบัว( 0-1.2, fy + 0.42, 8.5,   1,0,0,  0,1,0,  0.14, 0.42, 6,  FR * 0.80, hd + 2.0)
    ลายดอก(  1.4, fy + 0.38, 8.8,   1,0,0,  0,1,0,  0.24, 5,  FR * 0.70, hd + 5.0)

    # Scattered singles
    ลายจักร(0-5.5, fy + 0.14, 9.5,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 0.8)
    ลายจักร(  4.8, fy + 0.14, 7.5,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 4.0)
    ลายจักร(0-2.5, fy + 0.12, 12.0,  1,0,0,  0,1,0,  0.05, 1,  FR, hd + 1.5)
    ลายดอก(  2.0, fy + 0.35, 11.5,  1,0,0,  0,1,0,  0.20, 5,  FR * 0.55, hd + 2.8)
    ลายดอกบัว( 0-3.0, fy + 0.30, 11.0,  1,0,0,  0,1,0,  0.09, 0.28, 6,  FR * 0.60, hd + 1.8)
}


# ════════════════════════════════════════════════════════════════════════════
# POND  — reflective basin, floating lotus, fountain jet, ripple rings
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_pond(FR, hd) {
    ผูก py = 0 - H + 0.02

    # Water surface — SM2-hash hyperbolic ripple (CURVE → B3)
    ผูก hw = sm2_hash(5.0, 5.0,  FR * 0.0038,  FR * 0.0044)
    vtex_hyperbolic_uv(PX, py, PZ,  1,0,0,  0,0,1,  2.8, 5, 10,  FR * (0.08 + hw * 0.04), hd + 4.2)

    # Concentric ripple rings (LINE → A3)
    ลายวงซ้อน(PX, py, PZ,  1,0,0,  0,0,1,  4, 5,  3.0, 0.14,  FR, hd + 4.8)

    # Floating lotus (CURVE → B3)
    ลายดอกบัว(PX,          py + 0.06, PZ,           1,0,0,  0,0,1,  0.20, 0.65, 8,  FR * 0.54, hd + 3.6)
    ลายดอกบัว(PX + 0.9,    py + 0.05, PZ + 0.7,     1,0,0,  0,0,1,  0.15, 0.46, 6,  FR * 0.59, hd + 5.0)
    ลายดอกบัว(PX - 0.8,    py + 0.05, PZ - 0.6,     1,0,0,  0,0,1,  0.13, 0.40, 6,  FR * 0.64, hd + 2.5)

    # Fountain jet — vertical spiral (CURVE)
    ลายเกลียว(PX, py + 0.85, PZ,  0,1,0,  1,0,0,  0.09, 0.82, 32,  FR * 0.88, hd + 4.6)

    # Pond edge — 5-spoke ring border (DOT → G3)
    ลายจักร(PX, py, PZ,  1,0,0,  0,0,1,  3.2, 5,  FR * 0.05, hd + 3.0)
}


# ════════════════════════════════════════════════════════════════════════════
# SHED  — wooden garden shed
#
# Front wall (faces viewer, z ≈ SZ−1.8): grid planks, door, window
# Left side  (x ≈ SX−1.8):               grid planks
# Roof       (y ≈ −H+3.2):               yantra + chakra + ridge star
# Interior   (seen through open door):    tools, flower pot, shelf lantern
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_shed(FR, hd) {
    ผูก swy  = 0 - H + 1.55    # wall mid-height
    ผูก sfz  = SZ - 1.8        # front wall z
    ผูก sxl  = SX - 1.85       # left side wall x
    ผูก sry  = 0 - H + 3.18    # roof y

    # SM2-hash seeds for plank textures
    ผูก hp = sm2_hash(7.0, 3.0,  FR * 0.0012,  FR * 0.0018)
    ผูก hs = sm2_hash(3.0, 7.0,  FR * 0.0018,  FR * 0.0012)

    # FRONT WALL — wood plank grid (LINE → A3)
    ลายตาราง(SX, swy, sfz,   1,0,0,  0,1,0,  14, 10,  0.25 + hp * 0.04, 0.33,  FR * 0.02, hd + 1.5)

    # DOOR — flower frame + ring surround (BLOOM → D4)
    ลายดอก(SX - 0.5, swy - 0.18, sfz - 0.06,  1,0,0,  0,1,0,  0.70, 4,  FR * 0.14, hd + 1.2)
    ลายวงซ้อน( SX - 0.5, swy - 0.18, sfz - 0.06,  1,0,0,  0,1,0,  1, 4,  0.73, 0.0,  FR * 0.14, hd + 0.8)
    # Door handle DOT (G3)
    ลายจักร(SX - 0.14, swy - 0.24, sfz - 0.07,  1,0,0,  0,1,0,  0.05, 1,  FR, hd + 0.2)

    # WINDOW — eight-petal flower lattice (BLOOM)
    ลายดอก(SX + 0.72, swy + 0.44, sfz - 0.05,  1,0,0,  0,1,0,  0.40, 8,  FR * 0.18, hd + 2.8)
    ลายวงซ้อน( SX + 0.72, swy + 0.44, sfz - 0.05,  1,0,0,  0,1,0,  1, 4,  0.43, 0.0,  FR * 0.09, hd + 2.4)

    # LEFT SIDE WALL (LINE)
    ลายตาราง(sxl, swy, SZ,   0,0,1,  0,1,0,  10, 10,  0.26 + hs * 0.04, 0.33,  FR * 0.02, hd + 1.8)

    # ROOF — yantra base + chakra + ridge star (LINE / DOT)
    ลายยันต์(SX, sry, SZ,       1,0,0,  0,0,1,  3, 2.18,  FR * 0.03, hd + 1.2)
    ลายจักร(SX, sry + 0.12, SZ,  1,0,0,  0,0,1,  1.90, 4,  FR * 0.03, hd + 1.0)
    ลายวงซ้อน( SX, sry, SZ,       1,0,0,  0,0,1,  1, 4,  2.26, 0.0,  FR * 0.03, hd + 0.4)
    # Ridge crest star
    ลายดาว(SX, sry + 0.30, SZ,  1,0,0,  0,0,1,  4, 0.36, 0.14, 0.02,  FR * 0.08, hd + 0.6)

    # ── Interior (seen through open door) ──
    ผูก iz = SZ + 0.55

    # Garden tools — two LINE grid shapes (rake / shovel silhouettes)
    ลายตาราง(SX + 0.62, swy + 0.22, iz,  1,0,0,  0,1,0,  1, 7,  0.06, 0.28,  FR * 0.01, hd + 2.0)
    ลายตาราง(SX + 0.82, swy + 0.22, iz,  1,0,0,  0,1,0,  1, 7,  0.06, 0.28,  FR * 0.01, hd + 3.0)

    # Flower pot — DOT base + small lotus (G3 → B3)
    ผูก poty = 0 - H + 0.78
    ลายจักร(SX - 0.7, poty,        iz,  1,0,0,  0,1,0,  0.17, 4,  FR * 0.05, hd + 2.4)
    ลายดอกบัว( SX - 0.7, poty + 0.36, iz,  1,0,0,  0,1,0,  0.07, 0.20, 6,  FR * 0.40, hd + 2.1)

    # Wall shelf (LINE grid slab)
    ลายตาราง(SX, 0-H+1.90, iz + 0.45,  1,0,0,  0,0,1,  4, 1,  0.72, 0.07,  FR * 0.01, hd + 1.4)
    # Lantern on shelf — DOT + glow rings (G3)
    ลายจักร(SX, 0-H+2.04, iz + 0.45,  1,0,0,  0,1,0,  0.07, 1,  FR, hd + 0.8)
    ลายวงซ้อน( SX, 0-H+2.04, iz + 0.45,  1,0,0,  0,1,0,  1, 6,  0.21, 0.0,  FR * 0.58, hd + 1.0)
}


# ════════════════════════════════════════════════════════════════════════════
# ECHO PASS  — temporal ghost (no letter-rain, no tessellation)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก gy = 0 - H
    ผูก gz = FZ * 0.50

    # Ground compass ghost
    ลายจักร(0, gy, gz * 0.68,  1,0,0,  0,0,1,  5.8, 5,  FR, hd + 0.8)

    # Pond ripple ghost
    ลายวงซ้อน(PX, gy, PZ,  1,0,0,  0,0,1,  4, 5,  3.0, 0.14,  FR, hd + 4.8)

    # Sun ghost
    ลายดาว(0, H + 1.8, FZ * 0.32,  1,0,0,  0,0,1,  5, 1.3, 0.52, 0.03,  FR * 0.50, hd + 0.7)

    # Left tree crown ghost
    ลายดอก(0-5.8, 0-H+2.0*2.2, 7.5,  1,0,0,  0,1,0,  2.0*1.05, 8,  FR * 0.20, hd + 2.5)

    # Shed roof ghost
    ลายจักร(SX, 0-H+3.30, SZ,  1,0,0,  0,0,1,  1.90, 4,  FR * 0.03, hd + 1.0)

    # Pond lotus ghost
    ลายดอกบัว(PX, gy + 0.06, PZ,   1,0,0,  0,0,1,  0.20, 0.65, 8,  FR * 0.54, hd + 3.6)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN
# ════════════════════════════════════════════════════════════════════════════

ผูก สร้าง = ทำ {
    เปิดหน้าต่างเต็มจอ("Garden — The Synesthetic Garden")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.14)
    init_audio()

    ผูก 帧 = 0

    # Camera target — pond / garden centre, slight upward gaze
    ผูก target_x = PX
    ผูก target_y = 1.4
    ผูก target_z = PZ

    # Hyperbolic orbit: open outdoor space — slow panoramic sweep
    ผูก orbit_h  = 9.0
    ผูก orbit_v  = 4.5
    ผูก speed_h1 = 0.00095
    ผูก speed_h2 = 0.00155
    ผูก speed_v  = 0.00130

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(6, 10, 20)   # deep twilight-blue sky

        # Hue cycling — full spectrum every ~126 frames (~2.1 s @ 60 fps)
        ผูก hd = 帧 * 0.05

        # ── Hyperbolic floating orbit around garden centre ────────────────
        ผูก t1 = 帧 * speed_h1
        ผูก t2 = 帧 * speed_h2
        ผูก t3 = 帧 * speed_v
        ผูก cam_px = target_x + ไซน์(t1) * orbit_h * 0.85 + ไซน์(t2 * 1.6) * orbit_h * 0.22
        ผูก cam_pz = target_z + ไซน์(t1 * 1.8) * orbit_h * 0.65 + โคไซน์(t2 * 1.3) * orbit_h * 0.20
        ผูก cam_py = target_y + ไซน์(t3 * 1.5) * orbit_v * 0.65 + โคไซน์(t3 * 0.8) * orbit_v * 0.28

        # ── Look-at: always face garden centre ────────────────────────────
        ผูก dx = target_x - cam_px
        ผูก dy = target_y - cam_py
        ผูก dz = target_z - cam_pz
        ผูก dist = รากที่สอง(dx*dx + dy*dy + dz*dz)
        ถ้า dist > 0.0001 {
            ผูก dx = dx / dist
            ผูก dy = dy / dist
            ผูก dz = dz / dist
        }
        ผูก ry = atan2(dx, dz)
        ผูก rx = asin(dy)

        ตั้งกล้อง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))
        ตั้งตำแหน่งกล้อง(cam_px, cam_py, cam_pz)
        ตั้งระยะห่าง(2.5)
        ผู้ฟัง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))

        setup_lights(帧)

        # Two echo trails — offset by +1.5 and +3.0 hue
        draw_echo(帧 - 18, hd + 1.5)
        draw_echo(帧 - 36, hd + 3.0)

        # Full scene
        draw_ground(帧, hd)
        draw_sky(帧, hd)
        draw_trees(帧, hd)
        draw_pond(帧, hd)
        draw_flowers(帧, hd)
        draw_shed(帧, hd)

        แสดงผล()
        ผูก 帧 = 帧 + 1
    }
}
