# ════════════════════════════════════════════════════════════════════════════════════
# 🎵 พิหารเสียงวิเศษ — Hall of Mystical Sounds 🎵
# ════════════════════════════════════════════════════════════════════════════════════
# Interactive sonic + visual + physics playground in Thai
#
# Features:
#   • Gravity-based physics with bouncing spheres
#   • Harmonious pentatonic sound generation
#   • Cryptographic hash-inspired patterns
#   • Mouse-controlled camera
#   • Real-time audio synthesis
#
# ════════════════════════════════════════════════════════════════════════════════════

ผูก PI = 3.14159265
ผูก PI2 = 1.5708
ผูก ความพื้นฐาน_เสียง = 440.0    # A4 frequency
ผูก ขนาด_ลูก = 2.0               # sphere radius
ผูก ความเร่ง = 32.0              # gravity
ผูก ความโซดับพัฒนา = 0.985      # damping
ผูก ความเยื้อง = 0.88           # elasticity

# ── ดนตรี / Musical Scale ─────────────────────────────────────────────────────────
# Pentatonic: DO RE MI SOL LA (frequency ratios)
ผูก อัตราส่วน_1 = 1.0
ผูก อัตราส่วน_2 = 1.125
ผูก อัตราส่วน_3 = 1.25
ผูก อัตราส่วน_4 = 1.5
ผูก อัตราส่วน_5 = 1.875

# ── ฟังก์ชันช่วย / Helper Functions ────────────────────────────────────────────────

ฟังก์ชัน แฮช_ง่าย(เลข) {
    # Pseudo-hash for color/pattern generation
    ผูก ผล = เลข
    ผล = (ผล * 73856093) % 19349663
    ผล = ผล ^ (ผล >> 16)
    กลับ ผล
}

ฟังก์ชัน เลขสี(ค่า) {
    # Generate hue from value
    ผูก h = แฮช_ง่าย(ค่า)
    กลับ (h % 360)
}

ฟังก์ชัน กำหนดสีจากฮิว(เฉดสี) {
    ผูก r = ไซน์(เฉดสี * PI / 180.0 + 0.0) * 127 + 128
    ผูก g = ไซน์(เฉดสี * PI / 180.0 + 2.094) * 127 + 128
    ผูก b = ไซน์(เฉดสี * PI / 180.0 + 4.189) * 127 + 128
    สีดินสอ(r, g, b)
}

ฟังก์ชัน เล่นโน้ต(ดัชนี, ความแรง) {
    # Play note based on pentatonic scale
    ผูก อัตรา = 0.0
    ถ้า ดัชนี % 5 == 0 { ผูก อัตรา = อัตราส่วน_1 }
    ถ้า ดัชนี % 5 == 1 { ผูก อัตรา = อัตราส่วน_2 }
    ถ้า ดัชนี % 5 == 2 { ผูก อัตรา = อัตราส่วน_3 }
    ถ้า ดัชนี % 5 == 3 { ผูก อัตรา = อัตราส่วน_4 }
    ถ้า ดัชนี % 5 == 4 { ผูก อัตรา = อัตราส่วน_5 }

    ผูก ความถี่ = ความพื้นฐาน_เสียง * อัตรา
    ระดับเสียง(ความแรง * 0.3)
    เสียงโทน(0, ความถี่, 0.0, 0.0, 2.0, 0.15, 0.05, 0.4, 0.02)
}

ฟังก์ชัน วาดลูก(x, y, z, โทนสี) {
    กำหนดสีจากฮิว(โทนสี)
    วาดทรงกลม(x, y, z, ขนาด_ลูก)
}

ฟังก์ชัน วาดรูปแบบ(x, y, z, เฟส) {
    # Draw concentric ring pattern (yantra-inspired)
    ผูก i = 0
    ขณะที่ i < 5 {
        ผูก รัศมี = 1.0 + i * 0.5
        ผูก มุม = (i * PI2) + เฟส * 0.01

        ผูก px = x + รัศมี * โคไซน์(มุม)
        ผูก pz = z + รัศมี * ไซน์(มุม)

        กำหนดสีจากฮิว(เลขสี(i + เฟส))
        วาดสี่เหลี่ยมจัตุรัส(px, y, pz, 0.3)

        ผูก i = i + 1
    }
}

# ════════════════════════════════════════════════════════════════════════════════════
# โปรแกรมหลัก / Main Program
# ════════════════════════════════════════════════════════════════════════════════════

ผูก เริ่ม = ทำ {
    เปิดหน้าต่างเต็มจอ("🎵 พิหารเสียงวิเศษ — Mystical Sounds")
    จับเมาส์()
    กำหนดเสียงลอย(0.15)

    # Ambient tone
    ระดับเสียง(0.4)
    เสียงโทน(0, ความพื้นฐาน_เสียง * 0.5, 0.0, 0.0, 3.0, 0.5, 0.1, 0.6, 0.03)

    # Lighting
    กำหนดไฟสำหรับ(0.3)

    # ตัวแปรสถานะลูก / Sphere state (up to 8 spheres)
    ผูก x0 = 0.0  ผูก y0 = 20.0  ผูก z0 = 0.0  ผูก vx0 = 0.0  ผูก vy0 = 0.0  ผูก vz0 = 0.0
    ผูก x1 = 0.0  ผูก y1 = 15.0  ผูก z1 = 0.0  ผูก vx1 = 0.0  ผูก vy1 = 0.0  ผูก vz1 = 0.0
    ผูก x2 = 0.0  ผูก y2 = 10.0  ผูก z2 = 0.0  ผูก vx2 = 0.0  ผูก vy2 = 0.0  ผูก vz2 = 0.0
    ผูก x3 = 0.0  ผูก y3 = 5.0   ผูก z3 = 0.0  ผูก vx3 = 0.0  ผูก vy3 = 0.0  ผูก vz3 = 0.0

    ผูก หลักเวลา = 0
    ผูก ความเร็วหมุน = 0.0

    # Real-time loop
    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(30, 50, 120)

        # ─ Input ───────────────────────────────────────────────────────────────
        ผูก เมาส์x = ได้ตำแหน่งเมาส์_x()
        ผูก เมาส์y = ได้ตำแหน่งเมาส์_y()
        ผูก ความเร็วหมุน = เมาส์x * 0.002

        # Spawn new sphere
        ถ้า กดคีย์("space") {
            ผูก x0 = (เมาส์x - 512) * 0.1
            ผูก y0 = 30.0
            ผูก z0 = (เมาส์y - 384) * 0.1
            ผูก vx0 = (เมาส์x - 512) * 0.01
            ผูก vy0 = -5.0
            ผูก vz0 = (เมาส์y - 384) * 0.01
            เล่นโน้ต(หลักเวลา % 5, 0.8)
        }

        # Reset
        ถ้า กดคีย์("r") {
            ผูก x0 = 0.0  ผูก y0 = 20.0  ผูก z0 = 0.0  ผูก vx0 = 0.0  ผูก vy0 = 0.0  ผูก vz0 = 0.0
            ผูก x1 = 0.0  ผูก y1 = 15.0  ผูก z1 = 0.0  ผูก vx1 = 0.0  ผูก vy1 = 0.0  ผูก vz1 = 0.0
            ผูก x2 = 0.0  ผูก y2 = 10.0  ผูก z2 = 0.0  ผูก vx2 = 0.0  ผูก vy2 = 0.0  ผูก vz2 = 0.0
            ผูก x3 = 0.0  ผูก y3 = 5.0   ผูก z3 = 0.0  ผูก vx3 = 0.0  ผูก vy3 = 0.0  ผูก vz3 = 0.0
        }

        # ═══════════════════════════════════════════════════════════════════════
        # Physics Update for Sphere 0
        # ═══════════════════════════════════════════════════════════════════════

        ผูก vy0 = vy0 + ความเร่ง * 0.016
        ผูก vx0 = vx0 * ความโซดับพัฒนา
        ผูก vy0 = vy0 * ความโซดับพัฒนา
        ผูก vz0 = vz0 * ความโซดับพัฒนา
        ผูก x0 = x0 + vx0 * 0.016
        ผูก y0 = y0 + vy0 * 0.016
        ผูก z0 = z0 + vz0 * 0.016

        # Collisions
        ถ้า x0 < -20.0 + ขนาด_ลูก { ผูก x0 = -20.0 + ขนาด_ลูก  ผูก vx0 = 0.0 - vx0 * ความเยื้อง  เล่นโน้ต(0, 0.5) }
        ถ้า x0 > 20.0 - ขนาด_ลูก { ผูก x0 = 20.0 - ขนาด_ลูก  ผูก vx0 = 0.0 - vx0 * ความเยื้อง  เล่นโน้ต(4, 0.5) }
        ถ้า z0 < -25.0 + ขนาด_ลูก { ผูก z0 = -25.0 + ขนาด_ลูก  ผูก vz0 = 0.0 - vz0 * ความเยื้อง  เล่นโน้ต(1, 0.5) }
        ถ้า z0 > 25.0 - ขนาด_ลูก { ผูก z0 = 25.0 - ขนาด_ลูก  ผูก vz0 = 0.0 - vz0 * ความเยื้อง  เล่นโน้ต(3, 0.5) }
        ถ้า y0 < 0.0 + ขนาด_ลูก { ผูก y0 = 0.0 + ขนาด_ลูก  ผูก vy0 = 0.0 - vy0 * ความเยื้อง  เล่นโน้ต(0, 0.6) }

        # Physics Update for Sphere 1
        ผูก vy1 = vy1 + ความเร่ง * 0.016
        ผูก vx1 = vx1 * ความโซดับพัฒนา
        ผูก vy1 = vy1 * ความโซดับพัฒนา
        ผูก vz1 = vz1 * ความโซดับพัฒนา
        ผูก x1 = x1 + vx1 * 0.016
        ผูก y1 = y1 + vy1 * 0.016
        ผูก z1 = z1 + vz1 * 0.016

        ถ้า x1 < -20.0 + ขนาด_ลูก { ผูก x1 = -20.0 + ขนาด_ลูก  ผูก vx1 = 0.0 - vx1 * ความเยื้อง }
        ถ้า x1 > 20.0 - ขนาด_ลูก { ผูก x1 = 20.0 - ขนาด_ลูก  ผูก vx1 = 0.0 - vx1 * ความเยื้อง }
        ถ้า z1 < -25.0 + ขนาด_ลูก { ผูก z1 = -25.0 + ขนาด_ลูก  ผูก vz1 = 0.0 - vz1 * ความเยื้อง }
        ถ้า z1 > 25.0 - ขนาด_ลูก { ผูก z1 = 25.0 - ขนาด_ลูก  ผูก vz1 = 0.0 - vz1 * ความเยื้อง }
        ถ้า y1 < 0.0 + ขนาด_ลูก { ผูก y1 = 0.0 + ขนาด_ลูก  ผูก vy1 = 0.0 - vy1 * ความเยื้อง }

        # Physics Update for Sphere 2
        ผูก vy2 = vy2 + ความเร่ง * 0.016
        ผูก vx2 = vx2 * ความโซดับพัฒนา
        ผูก vy2 = vy2 * ความโซดับพัฒนา
        ผูก vz2 = vz2 * ความโซดับพัฒนา
        ผูก x2 = x2 + vx2 * 0.016
        ผูก y2 = y2 + vy2 * 0.016
        ผูก z2 = z2 + vz2 * 0.016

        ถ้า x2 < -20.0 + ขนาด_ลูก { ผูก x2 = -20.0 + ขนาด_ลูก  ผูก vx2 = 0.0 - vx2 * ความเยื้อง }
        ถ้า x2 > 20.0 - ขนาด_ลูก { ผูก x2 = 20.0 - ขนาด_ลูก  ผูก vx2 = 0.0 - vx2 * ความเยื้อง }
        ถ้า z2 < -25.0 + ขนาด_ลูก { ผูก z2 = -25.0 + ขนาด_ลูก  ผูก vz2 = 0.0 - vz2 * ความเยื้อง }
        ถ้า z2 > 25.0 - ขนาด_ลูก { ผูก z2 = 25.0 - ขนาด_ลูก  ผูก vz2 = 0.0 - vz2 * ความเยื้อง }
        ถ้า y2 < 0.0 + ขนาด_ลูก { ผูก y2 = 0.0 + ขนาด_ลูก  ผูก vy2 = 0.0 - vy2 * ความเยื้อง }

        # Physics Update for Sphere 3
        ผูก vy3 = vy3 + ความเร่ง * 0.016
        ผูก vx3 = vx3 * ความโซดับพัฒนา
        ผูก vy3 = vy3 * ความโซดับพัฒนา
        ผูก vz3 = vz3 * ความโซดับพัฒนา
        ผูก x3 = x3 + vx3 * 0.016
        ผูก y3 = y3 + vy3 * 0.016
        ผูก z3 = z3 + vz3 * 0.016

        ถ้า x3 < -20.0 + ขนาด_ลูก { ผูก x3 = -20.0 + ขนาด_ลูก  ผูก vx3 = 0.0 - vx3 * ความเยื้อง }
        ถ้า x3 > 20.0 - ขนาด_ลูก { ผูก x3 = 20.0 - ขนาด_ลูก  ผูก vx3 = 0.0 - vx3 * ความเยื้อง }
        ถ้า z3 < -25.0 + ขนาด_ลูก { ผูก z3 = -25.0 + ขนาด_ลูก  ผูก vz3 = 0.0 - vz3 * ความเยื้อง }
        ถ้า z3 > 25.0 - ขนาด_ลูก { ผูก z3 = 25.0 - ขนาด_ลูก  ผูก vz3 = 0.0 - vz3 * ความเยื้อง }
        ถ้า y3 < 0.0 + ขนาด_ลูก { ผูก y3 = 0.0 + ขนาด_ลูก  ผูก vy3 = 0.0 - vy3 * ความเยื้อง }

        # ═══════════════════════════════════════════════════════════════════════
        # Camera Setup
        # ═══════════════════════════════════════════════════════════════════════

        ผูก กล้อง_ระยะ = 50.0 + ไซน์(หลักเวลา * 0.003) * 10.0
        ผูก กล้อง_สูง = 15.0 + โคไซน์(หลักเวลา * 0.002) * 5.0
        ผูก กล้อง_x = โคไซน์(ความเร็วหมุน) * กล้อง_ระยะ
        ผูก กล้อง_z = ไซน์(ความเร็วหมุน) * กล้อง_ระยะ

        กำหนดกล้อง(กล้อง_x, กล้อง_สูง, กล้อง_z, 0.0, 5.0, 0.0, 0.0, 1.0, 0.0)

        # ═══════════════════════════════════════════════════════════════════════
        # Render Floor
        # ═══════════════════════════════════════════════════════════════════════

        กำหนดสีจากฮิว(เลขสี(หลักเวลา * 0.5))
        ผูก px = 0
        ขณะที่ px < 8 {
            ผูก pz = 0
            ขณะที่ pz < 10 {
                ผูก ตำแหน่ง_x = px * 5.0 - 17.5
                ผูก ตำแหน่ง_z = pz * 5.0 - 22.5
                วาดสี่เหลี่ยมจัตุรัส(ตำแหน่ง_x, 0, ตำแหน่ง_z, 2.0)
                ผูก pz = pz + 1
            }
            ผูก px = px + 1
        }

        # ═══════════════════════════════════════════════════════════════════════
        # Render Spheres
        # ═══════════════════════════════════════════════════════════════════════

        วาดลูก(x0, y0, z0, เลขสี(0 + หลักเวลา))
        วาดลูก(x1, y1, z1, เลขสี(1 + หลักเวลา))
        วาดลูก(x2, y2, z2, เลขสี(2 + หลักเวลา))
        วาดลูก(x3, y3, z3, เลขสี(3 + หลักเวลา))

        # ═══════════════════════════════════════════════════════════════════════
        # Render Center Pattern
        # ═══════════════════════════════════════════════════════════════════════

        วาดรูปแบบ(0.0, 8.0, 0.0, หลักเวลา)

        # ═══════════════════════════════════════════════════════════════════════
        # Render Corner Pillars
        # ═══════════════════════════════════════════════════════════════════════

        กำหนดสีจากฮิว(เลขสี(0 + หลักเวลา))
        วาดลูก(-18.0, 12.0, -22.0, เลขสี(0 + หลักเวลา))
        วาดลูก(18.0, 12.0, -22.0, เลขสี(1 + หลักเวลา))
        วาดลูก(-18.0, 12.0, 22.0, เลขสี(2 + หลักเวลา))
        วาดลูก(18.0, 12.0, 22.0, เลขสี(3 + หลักเวลา))

        # ═══════════════════════════════════════════════════════════════════════
        # Loop Update
        # ═══════════════════════════════════════════════════════════════════════

        ผูก หลักเวลา = หลักเวลา + 1

        # Status log
        ถ้า หลักเวลา % 60 == 0 {
            พิมพ์(&รูปแบบ("🎵 เวลา: {} | ตำแหน่ง: ({}, {}, {})", หลักเวลา, x0, y0, z0))
        }
    }
}
