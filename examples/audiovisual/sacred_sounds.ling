# ════════════════════════════════════════════════════════════════════════════════════
# 🎵 Sacred Sounds — Thai Interactive Musical Physics Demo 🎵
# ════════════════════════════════════════════════════════════════════════════════════
# Real-time synthesis of audio + graphics + physics in Ling
#
# Features:
#   • Gravity-based physics with bouncing spheres
#   • Harmonious pentatonic sound generation (Thai scale)
#   • Cryptographic hash-inspired color patterns
#   • Mouse-controlled camera orbit
#   • Interactive spacebar sphere spawning
#
# ════════════════════════════════════════════════════════════════════════════════════

令 PI = 3.14159265
令 PI2 = 1.5708
令 BASE_FREQ = 440.0             # A4 - base frequency for pentatonic scale
令 SPHERE_RADIUS = 2.0           # visual radius of bouncing spheres
令 GRAVITY = 32.0                # world gravity acceleration
令 DAMPING = 0.985               # velocity damping per frame
令 ELASTICITY = 0.88             # collision bounce elasticity

# ── Pentatonic Scale Ratios (Thai: DO RE MI SOL LA) ─────────────────────────────
# These ratios create harmonious intervals
令 RATIO_1 = 1.0                 # DO (fundamental)
令 RATIO_2 = 1.125               # RE (major second)
令 RATIO_3 = 1.25                # MI (major third)
令 RATIO_4 = 1.5                 # SOL (perfect fifth)
令 RATIO_5 = 1.875               # LA (major sixth)

# ── Hash Function for Pseudo-Random Colors ────────────────────────────────────────

fn hash_simple(n) {
    令 h = n
    令 h = (h * 73856093) % 19349663
    令 h = (h * 19349663 + 1) % 19349663
    กลับ h
}

fn color_from_value(v) {
    # Generate hue (0-360) from a value using hash
    令 h = hash_simple(v)
    กลับ (h % 360)
}

fn set_color_from_hue(hue) {
    # Convert HSV hue to RGB and set pen color
    令 r = ไซน์(hue * PI / 180.0 + 0.0) * 127 + 128
    令 g = ไซน์(hue * PI / 180.0 + 2.094) * 127 + 128
    令 b = ไซน์(hue * PI / 180.0 + 4.189) * 127 + 128
    สีดินสอ(r, g, b)
}

# ── Sound Synthesis ────────────────────────────────────────────────────────────────

fn play_pentatonic_note(degree, amplitude) {
    # Play a note from the pentatonic scale
    令 ratio = 0.0

    if degree % 5 == 0 { 令 ratio = RATIO_1 }
    if degree % 5 == 1 { 令 ratio = RATIO_2 }
    if degree % 5 == 2 { 令 ratio = RATIO_3 }
    if degree % 5 == 3 { 令 ratio = RATIO_4 }
    if degree % 5 == 4 { 令 ratio = RATIO_5 }

    令 freq = BASE_FREQ * ratio
    ระดับเสียง(amplitude * 0.3)
    เสียงโทน(0, freq, 0.0, 0.0, 2.0, 0.15, 0.05, 0.4, 0.02)
}

# ── Rendering Helpers ──────────────────────────────────────────────────────────────

fn draw_sphere_colored(x, y, z, hue) {
    set_color_from_hue(hue)
    วาดทรงกลม(x, y, z, SPHERE_RADIUS)
}

fn draw_yantra_rings(cx, cy, cz, phase) {
    # Draw concentric rings pattern (mandala/yantra-inspired)
    令 i = 0
    ขณะที่ i < 5 {
        令 radius = 1.0 + i * 0.5
        令 angle = (i * PI2) + phase * 0.01

        令 px = cx + radius * โคไซน์(angle)
        令 pz = cz + radius * ไซน์(angle)

        set_color_from_hue(color_from_value(i + phase))
        วาดสี่เหลี่ยมจัตุรัส(px, cy, pz, 0.3)

        令 i = i + 1
    }
}

# ════════════════════════════════════════════════════════════════════════════════════
# MAIN PROGRAM — Interactive Musical Physics Playground
# ════════════════════════════════════════════════════════════════════════════════════

令 เริ่ม = ทำ {
    # Window setup
    เปิดหน้าต่างเต็มจอ("🎵 Sacred Sounds — Thai Physics & Audio")
    จับเมาส์()
    กำหนดเสียงลอย(0.15)

    # Background ambient tone
    ระดับเสียง(0.4)
    เสียงโทน(0, BASE_FREQ * 0.5, 0.0, 0.0, 3.0, 0.5, 0.1, 0.6, 0.03)

    # Lighting
    กำหนดไฟสำหรับ(0.3)

    # ─────────────────────────────────────────────────────────────────────────────
    # Sphere State Variables (4 bouncing spheres)
    # ─────────────────────────────────────────────────────────────────────────────

    令 x0 = 0.0   令 y0 = 20.0  令 z0 = 0.0   令 vx0 = 0.0  令 vy0 = 0.0  令 vz0 = 0.0
    令 x1 = 5.0   令 y1 = 15.0  令 z1 = 0.0   令 vx1 = 0.0  令 vy1 = 0.0  令 vz1 = 0.0
    令 x2 = -5.0  令 y2 = 10.0  令 z2 = 0.0   令 vx2 = 0.0  令 vy2 = 0.0  令 vz2 = 0.0
    令 x3 = 0.0   令 y3 = 5.0   令 z3 = 5.0   令 vx3 = 0.0  令 vy3 = 0.0  令 vz3 = 0.0

    令 frame = 0
    令 cam_rotation = 0.0

    # ─────────────────────────────────────────────────────────────────────────────
    # Real-Time Main Loop
    # ─────────────────────────────────────────────────────────────────────────────

    ขณะที่ หน้าต่างเปิดอยู่() {
        # Clear screen with deep blue
        เติม(30, 50, 120)

        # ───────────────────────────────────────────────────────────────────────
        # INPUT HANDLING
        # ───────────────────────────────────────────────────────────────────────

        令 mx = ได้ตำแหน่งเมาส์_x()
        令 my = ได้ตำแหน่งเมาส์_y()
        令 cam_rotation = mx * 0.002

        # Spacebar: spawn new sphere
        if กดคีย์("space") {
            令 x0 = (mx - 512) * 0.1
            令 y0 = 30.0
            令 z0 = (my - 384) * 0.1
            令 vx0 = (mx - 512) * 0.01
            令 vy0 = -5.0
            令 vz0 = (my - 384) * 0.01
            play_pentatonic_note(frame % 5, 0.8)
        }

        # R key: reset spheres
        if กดคีย์("r") {
            令 x0 = 0.0   令 y0 = 20.0  令 z0 = 0.0   令 vx0 = 0.0  令 vy0 = 0.0  令 vz0 = 0.0
            令 x1 = 5.0   令 y1 = 15.0  令 z1 = 0.0   令 vx1 = 0.0  令 vy1 = 0.0  令 vz1 = 0.0
            令 x2 = -5.0  令 y2 = 10.0  令 z2 = 0.0   令 vx2 = 0.0  令 vy2 = 0.0  令 vz2 = 0.0
            令 x3 = 0.0   令 y3 = 5.0   令 z3 = 5.0   令 vx3 = 0.0  令 vy3 = 0.0  令 vz3 = 0.0
        }

        # ───────────────────────────────────────────────────────────────────────
        # PHYSICS UPDATE — Sphere 0
        # ───────────────────────────────────────────────────────────────────────

        令 vy0 = vy0 + GRAVITY * 0.016
        令 vx0 = vx0 * DAMPING  令 vy0 = vy0 * DAMPING  令 vz0 = vz0 * DAMPING
        令 x0 = x0 + vx0 * 0.016  令 y0 = y0 + vy0 * 0.016  令 z0 = z0 + vz0 * 0.016

        # Wall collisions
        if x0 < -20.0 + SPHERE_RADIUS { 令 x0 = -20.0 + SPHERE_RADIUS  令 vx0 = 0.0 - vx0 * ELASTICITY  play_pentatonic_note(0, 0.5) }
        if x0 > 20.0 - SPHERE_RADIUS { 令 x0 = 20.0 - SPHERE_RADIUS  令 vx0 = 0.0 - vx0 * ELASTICITY  play_pentatonic_note(4, 0.5) }
        if z0 < -25.0 + SPHERE_RADIUS { 令 z0 = -25.0 + SPHERE_RADIUS  令 vz0 = 0.0 - vz0 * ELASTICITY  play_pentatonic_note(1, 0.5) }
        if z0 > 25.0 - SPHERE_RADIUS { 令 z0 = 25.0 - SPHERE_RADIUS  令 vz0 = 0.0 - vz0 * ELASTICITY  play_pentatonic_note(3, 0.5) }
        if y0 < 0.0 + SPHERE_RADIUS { 令 y0 = 0.0 + SPHERE_RADIUS  令 vy0 = 0.0 - vy0 * ELASTICITY  play_pentatonic_note(0, 0.6) }

        # ───────────────────────────────────────────────────────────────────────
        # PHYSICS UPDATE — Sphere 1
        # ───────────────────────────────────────────────────────────────────────

        令 vy1 = vy1 + GRAVITY * 0.016
        令 vx1 = vx1 * DAMPING  令 vy1 = vy1 * DAMPING  令 vz1 = vz1 * DAMPING
        令 x1 = x1 + vx1 * 0.016  令 y1 = y1 + vy1 * 0.016  令 z1 = z1 + vz1 * 0.016

        if x1 < -20.0 + SPHERE_RADIUS { 令 x1 = -20.0 + SPHERE_RADIUS  令 vx1 = 0.0 - vx1 * ELASTICITY }
        if x1 > 20.0 - SPHERE_RADIUS { 令 x1 = 20.0 - SPHERE_RADIUS  令 vx1 = 0.0 - vx1 * ELASTICITY }
        if z1 < -25.0 + SPHERE_RADIUS { 令 z1 = -25.0 + SPHERE_RADIUS  令 vz1 = 0.0 - vz1 * ELASTICITY }
        if z1 > 25.0 - SPHERE_RADIUS { 令 z1 = 25.0 - SPHERE_RADIUS  令 vz1 = 0.0 - vz1 * ELASTICITY }
        if y1 < 0.0 + SPHERE_RADIUS { 令 y1 = 0.0 + SPHERE_RADIUS  令 vy1 = 0.0 - vy1 * ELASTICITY }

        # ───────────────────────────────────────────────────────────────────────
        # PHYSICS UPDATE — Sphere 2
        # ───────────────────────────────────────────────────────────────────────

        令 vy2 = vy2 + GRAVITY * 0.016
        令 vx2 = vx2 * DAMPING  令 vy2 = vy2 * DAMPING  令 vz2 = vz2 * DAMPING
        令 x2 = x2 + vx2 * 0.016  令 y2 = y2 + vy2 * 0.016  令 z2 = z2 + vz2 * 0.016

        if x2 < -20.0 + SPHERE_RADIUS { 令 x2 = -20.0 + SPHERE_RADIUS  令 vx2 = 0.0 - vx2 * ELASTICITY }
        if x2 > 20.0 - SPHERE_RADIUS { 令 x2 = 20.0 - SPHERE_RADIUS  令 vx2 = 0.0 - vx2 * ELASTICITY }
        if z2 < -25.0 + SPHERE_RADIUS { 令 z2 = -25.0 + SPHERE_RADIUS  令 vz2 = 0.0 - vz2 * ELASTICITY }
        if z2 > 25.0 - SPHERE_RADIUS { 令 z2 = 25.0 - SPHERE_RADIUS  令 vz2 = 0.0 - vz2 * ELASTICITY }
        if y2 < 0.0 + SPHERE_RADIUS { 令 y2 = 0.0 + SPHERE_RADIUS  令 vy2 = 0.0 - vy2 * ELASTICITY }

        # ───────────────────────────────────────────────────────────────────────
        # PHYSICS UPDATE — Sphere 3
        # ───────────────────────────────────────────────────────────────────────

        令 vy3 = vy3 + GRAVITY * 0.016
        令 vx3 = vx3 * DAMPING  令 vy3 = vy3 * DAMPING  令 vz3 = vz3 * DAMPING
        令 x3 = x3 + vx3 * 0.016  令 y3 = y3 + vy3 * 0.016  令 z3 = z3 + vz3 * 0.016

        if x3 < -20.0 + SPHERE_RADIUS { 令 x3 = -20.0 + SPHERE_RADIUS  令 vx3 = 0.0 - vx3 * ELASTICITY }
        if x3 > 20.0 - SPHERE_RADIUS { 令 x3 = 20.0 - SPHERE_RADIUS  令 vx3 = 0.0 - vx3 * ELASTICITY }
        if z3 < -25.0 + SPHERE_RADIUS { 令 z3 = -25.0 + SPHERE_RADIUS  令 vz3 = 0.0 - vz3 * ELASTICITY }
        if z3 > 25.0 - SPHERE_RADIUS { 令 z3 = 25.0 - SPHERE_RADIUS  令 vz3 = 0.0 - vz3 * ELASTICITY }
        if y3 < 0.0 + SPHERE_RADIUS { 令 y3 = 0.0 + SPHERE_RADIUS  令 vy3 = 0.0 - vy3 * ELASTICITY }

        # ───────────────────────────────────────────────────────────────────────
        # CAMERA SETUP — Orbiting view
        # ───────────────────────────────────────────────────────────────────────

        令 cam_dist = 50.0 + ไซน์(frame * 0.003) * 10.0
        令 cam_height = 15.0 + โคไซน์(frame * 0.002) * 5.0
        令 cam_x = โคไซน์(cam_rotation) * cam_dist
        令 cam_z = ไซน์(cam_rotation) * cam_dist

        กำหนดกล้อง(cam_x, cam_height, cam_z, 0.0, 5.0, 0.0, 0.0, 1.0, 0.0)

        # ───────────────────────────────────────────────────────────────────────
        # RENDER FLOOR — Checkerboard pattern
        # ───────────────────────────────────────────────────────────────────────

        set_color_from_hue(color_from_value(frame * 0.5))
        令 px = 0
        ขณะที่ px < 8 {
            令 pz = 0
            ขณะที่ pz < 10 {
                令 fx = px * 5.0 - 17.5
                令 fz = pz * 5.0 - 22.5
                วาดสี่เหลี่ยมจัตุรัส(fx, 0, fz, 2.0)
                令 pz = pz + 1
            }
            令 px = px + 1
        }

        # ───────────────────────────────────────────────────────────────────────
        # RENDER SPHERES
        # ───────────────────────────────────────────────────────────────────────

        draw_sphere_colored(x0, y0, z0, color_from_value(0 + frame))
        draw_sphere_colored(x1, y1, z1, color_from_value(1 + frame))
        draw_sphere_colored(x2, y2, z2, color_from_value(2 + frame))
        draw_sphere_colored(x3, y3, z3, color_from_value(3 + frame))

        # ───────────────────────────────────────────────────────────────────────
        # RENDER CENTER MANDALA
        # ───────────────────────────────────────────────────────────────────────

        draw_yantra_rings(0.0, 8.0, 0.0, frame)

        # ───────────────────────────────────────────────────────────────────────
        # RENDER CORNER PILLARS
        # ───────────────────────────────────────────────────────────────────────

        draw_sphere_colored(-18.0, 12.0, -22.0, color_from_value(0 + frame))
        draw_sphere_colored(18.0, 12.0, -22.0, color_from_value(1 + frame))
        draw_sphere_colored(-18.0, 12.0, 22.0, color_from_value(2 + frame))
        draw_sphere_colored(18.0, 12.0, 22.0, color_from_value(3 + frame))

        # ───────────────────────────────────────────────────────────────────────
        # FRAME UPDATE
        # ───────────────────────────────────────────────────────────────────────

        令 frame = frame + 1

        # Status logging
        if frame % 60 == 0 {
            พิมพ์(&รูปแบบ("🎵 Frame: {} | Sphere0: ({}, {}, {})", frame, x0, y0, z0))
        }
    }
}
