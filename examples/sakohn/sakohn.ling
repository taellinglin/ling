ผูก W = 16.0
ผูก H = 10.0
ผูก D = 30.0
ผูก cx = 0.0
ผูก cz = D * 0.45

ผูก FC4 = 261.63

ฟังก์ชัน hash(i x y) {
    p = i * 16777619.0 + x * 2166136261.0 + y * 3094850098.0
    s = บาป(p * 0.0000031 + x * 0.01) * 0.5 + 0.5
    c = โคส(p * 0.0000059 - y * 0.013) * 0.5 + 0.5
    (s * 0.618 + c * 0.382) * 360.0
}

ฟังก์ชัน init_audio() {
    เสียงโทน(0 0 0 cz 8.0 FC4 0.25 0.000 0.000)
    ระดับเสียง(0.55)
}

ฟังก์ชัน setup_lights(fr) {
    ล้างแสง()
    t = fr * 0.008
    เพิ่มแสง(0 2.5 cz-1.0 0.95 0.65 0.35 4.5 18.0)
    เพิ่มแสง(บาป(t)*5.0 1.5 cz+1.0 0.45 0.55 0.85 3.2 14.0)
    เพิ่มแสง(บาป(t+2.1)*4.0 -1.2 cz-0.5 0.65 0.35 0.75 2.8 12.0)
    เพิ่มแสง(0 -2.0 cz+2.0 0.25 0.45 0.65 1.8 20.0)
}

ฟังก์ชัน draw_floor(fr hue) {
    y = 0 - H
    z = D * 0.45
    br = บาป(fr * 0.012) * 0.25 + 0.75
    ลายไฮเพอร์โบลิก(0 y z 1 0 0 0 0 1 12.0*br 12 18 fr*0.018 hue+180)
    ลายตาข่าย(0 y z 1 0 0 0 0 1 32 24 0.55 0.28 5.2 fr hue+220)
    ลายจักร(0 y+0.2 z 1 0 0 0 0 1 6.5*br 8 fr*0.012 hue+160)
    ลายวงซ้อน(0 y+0.1 z 1 0 0 0 0 1 5 12 5.2*br 0.12 fr*0.03 hue+200)
}

ฟังก์ชัน draw_ceiling(fr hue) {
    y = H
    z = D * 0.42
    op = บาป(fr * 0.006) * 0.3 + 0.7
    ลายไฮเพอร์โบลิก(0 y z 1 0 0 0 0 1 14.0 16 24 fr*0.012 hue+60)
    ลายดอกบัว(0 y-0.5 z 1 0 0 0 0 1 0.85 2.8 12 fr hue+80)
    ลายวงซ้อน(0 y-0.3 z 1 0 0 0 0 1 6 16 5.0 0.06 fr*0.02 hue+100)
    ลายดาว(0 y-0.8 z 1 0 0 0 0 1 8 2.2*op 0.88*op 0.05 fr*0.35 hue+120)
}

ฟังก์ชัน draw_left_wall(fr hue) {
    x = 0 - W
    z = D * 0.48
    p = บาป(fr * 0.01) * 0.4 + 0.6
    ลายไฮเพอร์โบลิก(x 0 z 0 0 1 0 1 0 7.0*p 8 14 fr*0.024 hue+280)
    ลายเกลียว(x 0.5 z 0 1 0 1 0 0 0.18 2.2*p 32 fr*0.18 hue+300)
    ลายดอก(x -1.0 z 0 0 1 0 1 0 1.6*p 8 fr*0.45 hue+320)
    ลายวงซ้อน(x 1.8 z 0 0 1 0 1 0 5 12 2.0*p 0.08 fr*0.03 hue+340)
}

ฟังก์ชัน draw_right_wall(fr hue) {
    x = W
    z = D * 0.48
    p = โคส(fr * 0.012) * 0.4 + 0.6
    ลายไฮเพอร์โบลิก(x 0 z 0 0 1 0 1 0 7.5*p 10 16 fr*0.022 hue+40)
    ลายเกลียว(x -0.3 z 0 1 0 1 0 0 0.22 2.4*p 28 fr*0.22 hue+20)
    ลายดอก(x 1.2 z 0 0 1 0 1 0 1.8*p 10 fr*0.52 hue+0)
    ลายจักร(x -1.5 z 0 0 1 0 1 0 2.2*p 6 fr*0.028 hue+350)
}

ฟังก์ชัน draw_back_wall(fr hue) {
    z = D
    a = บาป(fr * 0.007) * 0.35 + 0.65
    b = บาป(fr * 0.009 + 1.5) * 0.35 + 0.65
    ลายไฮเพอร์โบลิก(0 0 z 1 0 0 0 1 0 9.0*a 14 20 fr*0.016 hue+120)
    ลายไฮเพอร์โบลิก(0 0.5 z 1 0 0 0 1 0 6.5*b 10 16 fr*0.024 hue+140)
    ลายอักษรไหล(0 -1.0 z 1 0 0 0 1 0 36 24 0.55 0.42 0.024 fr*0.8 hue+160)
    ลายยันต์(0 0 z 1 0 0 0 1 0 6 5.2*a fr*0.008 hue+100)
}

ฟังก์ชัน draw_floaters(fr hue) {
    t = fr * 0.005
    x = บาป(t) * 5.0
    y = บาป(t * 1.3) * 2.5 + 1.0
    z = cz - 1.5 + บาป(t * 0.7) * 1.2
    s = บาป(fr * 0.02) * 0.3 + 0.7
    ลายดอกบัว(x y z 1 0 0 0 1 0 0.38*s 1.25*s 8 fr hue+180)
    ลายวงซ้อน(x y z 1 0 0 0 1 0 3 16 1.8*s 0.04 fr*0.06 hue+200)
    ลายจักร(x y z 1 0 0 0 1 0 0.42*s 1 fr*0.15 hue+220)
}

ฟังก์ชัน draw_particles(fr hue strength) {
    n = 50 + strength * 80
    วน (i = 0; i < n; i = i + 1) {
        px = -6.0 + hash(i fr*0.01 0) * 0.017 * 12.0
        py = -3.0 + (strength * 6.0) + hash(i+100 fr*0.02 1) * 0.017 * 4.0
        pz = cz - 2.0 + hash(i+200 fr*0.015 2) * 0.017 * 4.0
        sz = 0.04 + strength * 0.08 + hash(i+300 fr*0.025 3) * 0.017 * 0.06
        ลายจักร(px py pz 1 0 0 0 1 0 sz 1 fr*0.12 hue+hash(i fr 4)*0.5)
    }
}

ฟังก์ชัน draw_waves(fr hue) {
    t = fr * 0.025
    วน (i = 0; i < 24; i = i + 1) {
        a = i * 15.0
        x = บาป(a + t) * 5.5
        z = cz - 2.0 + โคส(a*0.7 + t*1.5) * 3.0
        y = บาป(a*2.0 + t*3.0) * 1.2
        s = บาป(fr*0.03 + i) * 0.15 + 0.35
        ลายดอก(x y z 1 0 0 0 1 0 s 6 fr*0.3 hue+i*15)
        ลายดาว(x y+0.2 z 1 0 0 0 1 0 5 s*0.6 s*0.24 0.02 fr*0.5 hue+i*15+60)
    }
}

ฟังก์ชัน get_breath(fr) {
    cycle = fr % 180
    ถ้า cycle < 60 {
        b = cycle / 60.0
        o = b * 0.5
    } มิฉะนั้น ถ้า cycle < 75 {
        b = 1.0
        o = 0.08
    } มิฉะนั้น ถ้า cycle < 135 {
        e = (cycle - 75) / 60.0
        b = 1.0 - e
        o = 0.25 + e * 0.35
    } มิฉะนั้น {
        b = 0.0
        o = 0.0
    }
    b, o
}
เริ่ม = {
    เปิดหน้าต่างเต็มจอ("GlowRoom")
    จับเมาส์()
    ตั้งแสงรอบข้าง(0.05)
    init_audio()
    frame = 0
    ตั้งกล้อง(0.0 0.0 1.0 0.0)
    ตั้งตำแหน่งกล้อง(0.0 0.0 -10.0)
    ตั้งระยะห่าง(2.0)
    
    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(0 0 0)
        hue = frame * 0.8
        breath open = get_breath(frame)
        
        setup_lights(frame)
        
        draw_back_wall(frame hue)
        draw_left_wall(frame hue)
        draw_right_wall(frame hue)
        draw_floor(frame hue)
        draw_ceiling(frame hue)
        
        draw_floaters(frame hue)
        draw_waves(frame hue)
        draw_particles(frame hue breath)
        
        t = frame * 0.01
        r = บาป(t) * 1.2 + 2.5
        ลายจักร(0 0 cz-1.2 1 0 0 0 1 0 r 12 frame*0.02 hue+180)
        ลายวงซ้อน(0 0 cz-1.2 1 0 0 0 1 0 4 8 r*0.8 0.05 frame*0.04 hue+200)
        
        cycle = frame % 180
        ถ้า cycle < 60 {
            ลายไฮเพอร์โบลิก(0 -2.0 + breath*4 cz-1.8 1 0 0 0 1 0 2.5 5 8 frame*0.08 hue+300)
        } มิฉะนั้น ถ้า cycle < 75 {
            ลายดอกบัว(0 1.5 cz-1.5 1 0 0 0 1 0 0.45 1.4 12 frame hue+320)
        } มิฉะนั้น ถ้า cycle < 135 {
            ลายไฮเพอร์โบลิก(0 2.5 - breath*2 cz-1.5 1 0 0 0 1 0 3.0*breath 6 10 frame*0.12 hue+280)
        } มิฉะนั้น {
            ลายจักร(0 -1.2 cz-1.5 1 0 0 0 1 0 0.35 1 frame*0.08 hue+260)
        }
        
        แสดงผล()
        frame = frame + 1
    }
}