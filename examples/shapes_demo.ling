# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 3-D Shape Gallery — the Ling primitive library ("Inkscape for 3-D")
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Every primitive shares the same call shape:
#   name(cx,cy,cz,  sx,sy,sz,  rx,ry,rz,  mode,  e0,e1,e2)
#     • cx,cy,cz  centre position
#     • sx,sy,sz  per-axis scale (non-uniform cubes, ellipsoids, …)
#     • rx,ry,rz  Euler rotation in radians
#     • mode      0 = filled · 1 = wireframe · 2 = both
#     • e0,e1,e2  shape-specific (segments / sides / ratio …)
#
# Camera stays at the origin (no set_camera_pos); shapes live in front at +Z.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind start = do {
    open_fullscreen("3-D Shape Gallery")
    capture_mouse()
    set_ambient(0.22)

    令 FR = 0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(4, 5, 12)

        # spin everything slowly
        令 a = FR * 0.012

        # moving key light + cool fill
        clear_lights()
        add_light(cos(a) * 6.0, 3.0, 8.0 + sin(a) * 3.0, 4.0, 1.0, 0.96, 0.9)
        add_light(-5.0, -2.0, 5.0, 2.0, 0.4, 0.6, 1.0)

        # gentle camera sway, anchored at origin
        令 ry = sin(FR * 0.006) * 0.12
        set_camera(cos(ry), sin(ry), 1.0, 0.0)
        set_zdist(2.0)

        # ── Row 1 (upper) — FILLED solids ─────────────────────────────────────
        set_color(230, 110, 90)
        cube(-4.5, -1.6, 9.0,  0.7,0.7,0.7,  a,a*0.7,0,  0)
        set_color(110, 210, 130)
        sphere(-2.7, -1.6, 9.0,  0.8,0.8,0.8,  0,a,0,  0,  18,14)
        set_color(120, 170, 240)
        cylinder(-0.9, -1.6, 9.0,  0.6,0.8,0.6,  a,0,a*0.5,  0,  24)
        set_color(240, 200, 90)
        cone(0.9, -1.6, 9.0,  0.7,0.8,0.7,  a*0.6,a,0,  0,  24)
        set_color(200, 120, 230)
        torus(2.9, -1.6, 9.0,  0.8,0.8,0.8,  a,a*0.8,0,  0,  32,14, 0.35)
        set_color(240, 240, 150)
        capsule(4.8, -1.6, 9.0,  0.5,0.8,0.5,  a*0.5,0,a,  0,  16,6)

        # ── Row 2 (lower) — DICE (Platonic solids), WIREFRAME + FILL ──────────
        set_color(255, 90, 120)
        tetrahedron(-4.5, 1.4, 9.0,  0.8,0.8,0.8,  a,a,0,  2)        # d4
        set_color(120, 255, 180)
        cube(-2.7, 1.4, 9.0,  0.7,0.7,0.7,  a,a*0.6,a*0.3,  2)       # d6
        set_color(120, 200, 255)
        octahedron(-0.9, 1.4, 9.0,  0.85,0.85,0.85,  a,a,0,  2)      # d8
        set_color(255, 200, 120)
        dodecahedron(0.9, 1.4, 9.0,  0.8,0.8,0.8,  a*0.7,a,0,  2)    # d12
        set_color(220, 140, 255)
        icosahedron(2.9, 1.4, 9.0,  0.85,0.85,0.85,  a,a*0.8,0,  2)  # d20

        # ── a spinning gear + a gyro to show mechanical/architectural shapes ──
        set_color(190, 190, 200)
        gear(4.8, 1.4, 9.0,  0.7,0.25,0.7,  1.57,a*2.0,0,  0,  14, 0.3)

        set_color(150, 230, 230)
        gyro(0.0, 0.0, 6.2,  0.7,0.7,0.7,  a,a*1.3,a*0.6,  1,  3)

        แสดงผล()
        令 FR = FR + 1
    }
}
