# ling_map.ling — convert any .ling source file into a cryptographic SVG map
# Usage:  cargo run examples/ling_map.ling [path/to/file.ling]
# Each line of source becomes a visual region; pattern and color are derived
# from FNV-1a hashes of the line content, mirroring the Python AI_PatternCryptoFill.

ผูก สร้าง = ทำ {
    ผูก 参数 = get_args()
    ผูก 路径 = "examples/3d-family-room.ling"
    ถ้า ความยาว(参数) > 2 {
        ผูก 路径 = list_get(参数, 2)
    }
    ผูก เอาต์พุต = str_replace(路径, ".ling", "_map.svg")

    ผูก ต้นฉบับ = read_file(路径)
    ผูก 行列 = split(ต้นฉบับ, "\n")
    ผูก 行数 = ความยาว(行列)

    ผูก 宽 = 900.0
    ผูก 行高 = 14.0
    ผูก 高 = 行数 * 行高 + 50.0
    ถ้า 高 < 400.0 {
        ผูก 高 = 400.0
    }

    พิมพ์("Mapping: ")
    พิมพ์(路径)
    พิมพ์(" → ")
    พิมพ์(เอาต์พุต)

    svg_begin(เอาต์พุต, 宽, 高)

    ผูก i = 0
    ขณะที่ i < 行数 {
        ผูก 行 = list_get(行列, i)
        ผูก 修剪行 = trim(行)

        ผูก 色调 = hash_int(行, 360)
        ผูก 图案 = hash_int(行, 6)
        ผูก 动态 = hash_str(行)
        ผูก 调和 = hash_int(行, 12)
        ผูก สี = สีHSL(色调, 75.0, 50.0)
        ผูก 暗色 = สีHSL(色调, 40.0, 30.0)

        ผูก y = i * 行高 + 30.0

        # Pattern 0 — rhythmic grid dots (encodes timing)
        ถ้า 图案 == 0 {
            ผูก j = 0
            ขณะที่ j < 16 {
                ผูก x = 30.0 + j * 52.5
                ผูก 偏移 = 动态 * 10.0 - 5.0
                ผูก 半径 = 1.5 + 动态 * 2.0
                svg_circle(x + 偏移, y, 半径, สี)
                ผูก j = j + 1
            }
        }

        # Pattern 1 — waveform (encodes melody)
        ถ้า 图案 == 1 {
            ผูก 振幅 = 3.0 + 动态 * 4.0
            ผูก 频率 = 1.0 + hash_int(行, 4)
            ผูก 点串 = ""
            ผูก k = 0
            ขณะที่ k < 17 {
                ผูก t = k / 16.0
                ผูก x = 30.0 + t * 840.0
                ผูก oy = ไซน์(t * pi * 2.0 * 频率) * 振幅
                ผูก px = ปัดลง(x * 10.0) / 10.0
                ผูก py = ปัดลง((y + oy) * 10.0) / 10.0
                ผูก 点串 = 点串 + to_str(px) + "," + to_str(py) + " "
                ผูก k = k + 1
            }
            svg_polyline(点串, สี, 1.0 + 动态 * 1.5)
        }

        # Pattern 2 — spectral harmonic grid (encodes chords)
        ถ้า 图案 == 2 {
            ผูก j = 0
            ขณะที่ j < 8 {
                ถ้า (调和 + j) % 12 < 6 {
                    ผูก x = 30.0 + j * 105.0
                    svg_rect(x, y - 4.0, 90.0, 8.0, สี)
                }
                ผูก j = j + 1
            }
        }

        # Pattern 3 — radial rings (encodes spatial position)
        ถ้า 图案 == 3 {
            ผูก cx = 30.0 + 动态 * 840.0
            ผูก วงแหวน = 1
            ขณะที่ วงแหวน < 4 {
                ผูก 半径 = วงแหวน * 4.0 + 动态 * 3.0
                ผูก 点数 = วงแหวน * 6
                ผูก k = 0
                ขณะที่ k < 点数 {
                    ผูก 角 = k / 点数 * pi * 2.0
                    svg_circle(cx + โคไซน์(角) * 半径, y + ไซน์(角) * 半径 * 0.4, 1.2, สี)
                    ผูก k = k + 1
                }
                ผูก วงแหวน = วงแหวน + 1
            }
        }

        # Pattern 4 — hash barcode (raw entropy)
        ถ้า 图案 == 4 {
            ผูก j = 0
            ขณะที่ j < 30 {
                ผูก 位 = hash_int(行 + to_str(j), 2)
                ผูก x = 30.0 + j * 28.0
                ผูก 宽度 = 12.0 + 位 * 15.0
                svg_rect(x, y - 4.5, 宽度, 9.0, สี)
                ผูก j = j + 1
            }
        }

        # Pattern 5 — line-length bar (structural density)
        ถ้า 图案 == 5 {
            ผูก ความยาว = ความยาว(修剪行) * 9.0
            ถ้า ความยาว > 840.0 {
                ผูก ความยาว = 840.0
            }
            ถ้า ความยาว > 0.0 {
                svg_rect(30.0, y - 2.5, ความยาว, 5.0, สี)
                # Accent dot at start showing dynamic level
                svg_circle(30.0, y, 2.0 + 动态 * 2.0, 暗色)
            }
        }

        ผูก i = i + 1
    }

    # Title bar
    svg_rect(0.0, 0.0, 宽, 22.0, "#111111")
    svg_text(30.0, 15.0, 路径, "#FFD700", 11.0)
    svg_text(宽 - 160.0, 15.0, to_str(行数) + " lines", "#888888", 9.0)

    # Registration marks at corners
    ผูก m = 8.0
    svg_circle(m, m, 3.5, "#FFD700")
    svg_line(m - 12.0, m, m + 12.0, m, "#FFD700", 0.6)
    svg_line(m, m - 12.0, m, m + 12.0, "#FFD700", 0.6)

    svg_circle(宽 - m, m, 3.5, "#FFD700")
    svg_line(宽 - m - 12.0, m, 宽 - m + 12.0, m, "#FFD700", 0.6)
    svg_line(宽 - m, m - 12.0, 宽 - m, m + 12.0, "#FFD700", 0.6)

    svg_circle(m, 高 - m, 3.5, "#FFD700")
    svg_line(m - 12.0, 高 - m, m + 12.0, 高 - m, "#FFD700", 0.6)
    svg_line(m, 高 - m - 12.0, m, 高 - m + 12.0, "#FFD700", 0.6)

    svg_circle(宽 - m, 高 - m, 3.5, "#FFD700")
    svg_line(宽 - m - 12.0, 高 - m, 宽 - m + 12.0, 高 - m, "#FFD700", 0.6)
    svg_line(宽 - m, 高 - m - 12.0, 宽 - m, 高 - m + 12.0, "#FFD700", 0.6)

    svg_end()
    พิมพ์("\nDone: ")
    พิมพ์(เอาต์พุต)
}
