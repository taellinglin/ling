// 中文示例 — Chinese Language Example
// bind → 令 · start → 开始 · do → 执 · print → 打印 · format → 格式 · if → 若 · true → 真

令 开始 = 执 {
    打印("╔══════════════════════════════╗")
    打印("║       你好，世界！       ║")
    打印("║       Hello, World!      ║")
    打印("╚══════════════════════════════╝")

    令 名字 = "灵"
    令 年份 = 2030

    打印(&格式("欢迎使用 {} 版本 {}", 名字, 年份))

    若 真 {
        打印("灵语运行正常！")
    }
}
