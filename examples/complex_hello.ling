// complex_hello.ling - A sophisticated hello world demonstration

灵符 สร้าง = ทำ {
    // 1. Basic Hello World
    印("\n╔══════════════════════════════════════════════════════════════╗")
    印("║              🌊  COMPLEX HELLO WORLD  🌊                      ║")
    印("║           A Demonstration of Ling's Capabilities              ║")
    印("╚══════════════════════════════════════════════════════════════╝")

    印("\n📌 [1] Basic Hello World:")
    印("   Hello, World!")

    // 2. Polyglot Hello World
    印("\n📌 [2] Polyglot Hello World (Ling's core feature):")
    印("   🇺🇸 English:    Hello, World!")

    ผูก 中文问候 = "你好，世界！"
    印(&格式("   🇨🇳 Chinese:    {}", 中文问候))

    ผูก 日本語挨拶 = "こんにちは、世界！"
    印(&格式("   🇯🇵 Japanese:   {}", 日本語挨拶))

    ผูก 한국어인사 = "안녕, 세계!"
    印(&格式("   🇰🇷 Korean:     {}", 한국어인사))

    ผูก русский = "Привет, мир!"
    印(&格式("   🇷🇺 Russian:    {}", русский))

    // 3. Formatted Output
    印("\n📌 [3] Formatted Output:")
    ผูก 名称 = "Ling"
    ผูก 版本 = 2030
    ผูก 评分 = 4.9

    印(&格式("   语言: {} v{}", 名称, 版本))
    印(&格式("   评分: {:.1} / 5.0 ⭐", 评分))

    // 4. Conditional Greeting
    印("\n📌 [4] Conditional Greeting:")
    ผูก 当前小时 = 计时::获取当前小时()

    ผูก 问候 = ถ้า 当前小时 < 12 {
        "🌅 早安！Good Morning!"
    } มิฉะนั้น ถ้า 当前小时 < 18 {
        "☀️ 午安！Good Afternoon!"
    } มิฉะนั้น {
        "🌙 晚安！Good Evening!"
    }

    印(&格式("   {}", 问候))

    // 5. Loop with Pattern Matching
    印("\n📌 [5] Pattern Matching Demo:")
    ผูก 消息列表 = ["Hello", "World", "from", "Ling"]

    สำหรับ 消息 ใน 消息列表 {
        จับคู่ 消息 {
            "Ling"  => 印(&格式("   {} ✨ 这是灵境！", 消息))
            "World" => 印(&格式("   {} 🌍", 消息))
            _       => 印(&格式("   {}", 消息))
        }
    }

    // 6. Function Composition
    印("\n📌 [6] Function Composition:")
    ผูก 结果 = 复杂问候::สร้าง("开发者", "Ling")
    印(&格式("   {}", 结果))

    // 7. Error Handling
    印("\n📌 [7] Error Handling:")
    จับคู่ 安全问候::尝试打印("有效输入") {
        โอเค(_) => 印("   ✅ 问候发送成功")
        ผิด(错误) => 印(&格式("   ❌ 失败: {}", 错误))
    }
    จับคู่ 安全问候::尝试打印("") {
        โอเค(_) => 印("   ✅ 问候发送成功")
        ผิด(错误) => 印(&格式("   ❌ 失败: {}", 错误))
    }

    // 8. Grand Finale
    印("\n╔══════════════════════════════════════════════════════════════╗")
    印("║   ✨ 欢迎来到灵境！Welcome to the Spirit Realm of Ling! ✨    ║")
    印("║   灵符降世，万言共鸣                                          ║")
    印("║   Spirit Token Descends, Thousand Languages Resonate         ║")
    印("╚══════════════════════════════════════════════════════════════╝\n")
}

โมดูล 复杂问候 {
    ฟังก์ชัน สร้าง(接收者, 语言) {
        คืน 格式("🌟 你好，{}！欢迎来到 {} 灵境。愿灵与你同在 🌟", 接收者, 语言)
    }
}

โมดูล 安全问候 {
    ฟังก์ชัน 尝试打印(消息) {
        ถ้า 消息 == "" {
            คืน ผิด("消息不能为空")
        }
        印(&格式("   💬 安全问候: {}", 消息))
        คืน โอเค(())
    }
}

โมดูล 计时 {
    ฟังก์ชัน 获取当前小时() {
        คืน 14
    }
}
