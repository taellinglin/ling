# ════════════════════════════════════════════════════════════════════════════
# 3d-korean-room.ling — 육각 한옥 선원  Hexagonal Hanok Meditation Hall
#
#  A vast lacquer-blue hall in Korean sacred hexagonal architecture.
#  Every motif is built on six — 육각 (六角) is the structural soul.
#
#    Walls (4)  — Script-rain columns in Korean-inspired stroke glyphs.
#    Ceiling    — Dancheong cosmic disc: hyperbolic Poincaré grid +
#                 six-petal Flower of Life (육화 六花) rotating slowly.
#    Floor      — Hanji lattice: halftone dot-field + yantra mandala
#                 + vanishing stone-floor grid.
#    Centre     — 5-tier hexagonal pagoda (오층탑) with Taegeuk
#                 four-element counter-rotating core (태극 四象);
#                 Four Guardian Beasts (사신 四神) at cardinal positions.
#
#  Framefade: Two temporal echo passes (−48, −24 frames) with chromatic
#  hue drift — all rotating hexagonal geometry leaves vivid dancheong
#  cyan → gold → red trails.  Implemented in the sine-colour cycle only.
#
#  Camera: Very slow contemplative sway — stable, never tours the room.
#
#  Audio: Korean pentatonic gugak drones 황·태·중·임·남 (A minor
#  pentatonic A-C-D-E-G, root A2=110 Hz) — nine positional sine tones
#  with haegeum-breath vibrato evoke temple monks sustaining a chord.
#
#  Run:  ling run examples/3d-korean-room.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

ผูก W  = 9.0     # 반폭  half-width
ผูก H  = 4.5     # 반높이 half-height
ผูก FZ = 16.0    # 뒷벽  far-wall z
ผูก NZ = 1.4     # 앞벽  near-wall z
ผูก PZ = 8.0     # 탑 축  pagoda axis z
ผูก PR = 1.15    # 태극 반지름 taegeuk radius


# ════════════════════════════════════════════════════════════════════════════
# 색깔  COLOUR
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน col(t, p) {
    สีดินสอ(
        ไซน์(t + p)         * 127 + 128,
        ไซน์(t + p + 2.094) * 127 + 128,
        ไซน์(t + p + 4.189) * 127 + 128
    )
}

ฟังก์ชัน col_dim(t, p, b) {
    สีดินสอ(
        (ไซน์(t + p)         * 127 + 128) * b,
        (ไซน์(t + p + 2.094) * 127 + 128) * b,
        (ไซน์(t + p + 4.189) * 127 + 128) * b
    )
}


# ════════════════════════════════════════════════════════════════════════════
# 태극  TAEGEUK CORE  (four-element counter-rotating hexagonal ring system)
# 四象: 태양(太陽) 태음(太陰) 소양(少陽) 소음(少陰)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_taegeuk(FR, hd) {
    ผูก bob = ไซน์(FR * 0.020) * 0.28

    # 양 (陽) — clockwise hexagonal rings, warm gold/red (단청 적색)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  3, 6,  PR, 0.0,   FR, 1.2 + hd)
    # 음 (陰) — counter-clockwise hexagonal rings, cool cyan (단청 청색)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  3, 6,  PR, 0.524,  0-FR, 3.5 + hd)
    # 4-petal inner lotus (四象 four symbols)
    ลายดอกบัว(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.30, PR * 0.70, 4,  FR, 0.8 + hd)
    # 6-petal outer dancheong crown
    ลายดอกไม้(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.52, 6,  FR, 3.0 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 탑층  SINGLE HEXAGONAL PAGODA TIER
# Hexagonal Dharma wheel (6 spokes) + 6-petal lotus + hexagonal halo
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน 탑층(y, r, FR, hd) {
    ลายจักร(0, y, PZ,  1,0,0,  0,0,1,  r, 6,  FR, 3.0 + hd)
    ลายดอกบัว(0, y, PZ,  1,0,0,  0,0,1,  r * 0.44, r * 0.88, 6,  FR, 0.2 + hd)
    ลายวงซ้อน(0, y, PZ,  1,0,0,  0,0,1,  1, 6,  r * 1.10, 0.0,  FR, 1.2 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 오층탑  5-TIER HEXAGONAL PAGODA + FOUR GUARDIAN BEASTS (사신)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_탑(FR, hd) {
    draw_taegeuk(FR, hd)

    # Grand 12-petal base lotus at floor
    ลายดอกบัว(0, 0-H+0.5, PZ,  1,0,0,  0,0,1,  1.1, 2.8, 12,  FR, 0.0 + hd)

    # 5 ascending hexagonal tiers — (y, radius)
    탑층(0-2.8, 2.20, FR, hd)
    탑층(0-1.2, 1.75, FR, hd)
    탑층( 0.4,  1.38, FR, hd)
    탑층( 2.0,  1.05, FR, hd)
    탑층( H-0.6, 0.72, FR, hd)

    # Crown: 6-point star (육각성 六角星) + 6-petal flower
    ลายดาว(0, H-0.3, PZ,  1,0,0,  0,0,1,  6, 1.25, 0.52, 0.036,  FR, 0.6 + hd)
    ลายดอกไม้(0, H-0.3, PZ,  1,0,0,  0,0,1,  0.68, 6,  FR, 2.8 + hd)

    # ── 四神 Four Guardian Beasts ─────────────────────────────────────────
    # 청룡 (靑龍) Blue Dragon — left, in YZ plane
    ลายเกลียว(0-4.2, 0, PZ,  0,0,1,  0,1,0,  2.8, 2.6, 72,  FR, 3.5 + hd)
    ลายวงซ้อน(0-4.2, 0, PZ,   0,0,1,  0,1,0,  2, 6,  1.5, 0.524,  FR, 3.8 + hd)

    # 백호 (白虎) White Tiger — right, mirrored phase
    ลายเกลียว( 4.2, 0, PZ,  0,0,1,  0,1,0,  2.8, 2.6, 72,  FR, 3.5 + hd + 3.14159)
    ลายวงซ้อน( 4.2, 0, PZ,   0,0,1,  0,1,0,  2, 6,  1.5, 0.524,  FR, 0.8 + hd)

    # 주작 (朱雀) Phoenix — upper, horizontal disc
    ลายดอกไม้(0, 3.8, PZ,  1,0,0,  0,0,1,  1.6, 12,  FR, 0.3 + hd)
    ลายวงซ้อน(0, 3.8, PZ,   1,0,0,  0,0,1,  2, 12,  2.0, 0.20,  FR, 5.8 + hd)

    # 현무 (玄武) Black Tortoise — low, horizontal floor disc
    ลายยันต์(0, 0-H+0.6, PZ,  1,0,0,  0,0,1,  3, 2.8,  FR, 5.0 + hd)
    ลายวงซ้อน(0, 0-H+0.6, PZ,   1,0,0,  0,0,1,  2, 6,  3.2, 0.0,  FR, 4.8 + hd)

    # Pagoda aura: equatorial hexagonal halo
    ลายดอกบัว(0, 0, PZ,  1,0,0,  0,1,0,  1.5, 2.3, 6,  FR, 5.2 + hd)
    ลายวงซ้อน(0, 0, PZ,  1,0,0,  0,1,0,  3, 6,  2.5, 0.10,  FR, 6.0 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 방 표면  ROOM SURFACES
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_floor(FR, hd) {
    ผูก cy   = 0 - H
    ผูก fmid = FZ / 2
    # Hanji lattice halftone (한지 paper dot-texture)
    ลายจุด(0, cy, fmid,  1,0,0,  0,0,1,  24, 18,  0.50, 0.50, 0.55,  FR, 0.5 + hd)
    # Buddhist mandala yantra
    ลายยันต์(0, cy, fmid,  1,0,0,  0,0,1,  4, 4.6,  FR, 0.0 + hd)
    # Stone floor perspective grid
    ลายตาราง(0, cy, fmid,  1,0,0,  0,0,1,  28, 24,  0.64, 0.64,  FR, 3.0 + hd)
}

ฟังก์ชัน draw_ceiling(FR, hd) {
    ผูก cy   = H
    ผูก fmid = FZ / 2
    # Dancheong cosmic disc — hyperbolic Poincaré
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  6.0, 14, 18,  FR, 3.0 + hd)
    # Six-petal Flower of Life 육화
    ลายดอกไม้(0, cy, fmid,  1,0,0,  0,0,1,  2.5, 6,  FR, 1.0 + hd)
    # Three concentric hexagonal outer rings
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  3, 6,  5.5, 0.10,  FR, 0.2 + hd)
}

ฟังก์ชัน draw_front_wall(FR, hd) {
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.018,  FR, 0.0 + hd)
}

ฟังก์ชัน draw_back_wall(FR, hd) {
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.024,  FR, 3.1 + hd)
    # Dancheong portal — hexagonal wheel + rings
    ลายจักร(0, 0, FZ,  1,0,0,  0,1,0,  4.2, 6,  FR, 0.2 + hd)
    ลายวงซ้อน(0, 0, FZ,   1,0,0,  0,1,0,  3, 6,  4.8, 0.10,  FR, 3.5 + hd)
}

ฟังก์ชัน draw_left_wall(FR, hd) {
    ผูก cx   = 0 - W
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.022,  FR, 4.0 + hd)
}

ฟังก์ชัน draw_right_wall(FR, hd) {
    ผูก cx   = W
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.018,  FR, 1.5 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 잔상 패스  ECHO PASS (structural elements only — for temporal framefade)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก cy_f = 0 - H
    ผูก cy_c = H
    ผูก fm   = FZ / 2

    # Floor: yantra + grid (skip expensive halftone)
    ลายยันต์(0, cy_f, fm,  1,0,0,  0,0,1,  4, 4.6,  FR, 0.0 + hd)
    ลายตาราง(0, cy_f, fm,  1,0,0,  0,0,1,  28, 24,  0.64, 0.64,  FR, 3.0 + hd)

    # Ceiling: hexagonal rings + flower
    ลายวงซ้อน(0, cy_c, fm,  1,0,0,  0,0,1,  3, 6,  5.5, 0.10,  FR, 0.2 + hd)
    ลายดอกไม้(0, cy_c, fm,  1,0,0,  0,0,1,  2.5, 6,  FR, 1.0 + hd)

    # Back portal
    ลายจักร(0, 0, FZ,  1,0,0,  0,1,0,  4.2, 6,  FR, 0.2 + hd)
    ลายวงซ้อน(0, 0, FZ,   1,0,0,  0,1,0,  3, 6,  4.8, 0.10,  FR, 3.5 + hd)

    # Sparse pagoda tiers + taegeuk core
    draw_taegeuk(FR, hd)
    탑층(0-2.8, 2.20, FR, hd)
    탑층( 0.4,  1.38, FR, hd)
    탑층( H-0.6, 0.72, FR, hd)
    ลายดาว(0, H-0.3, PZ,  1,0,0,  0,0,1,  6, 1.25, 0.52, 0.036,  FR, 0.6 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 조명  LIGHTS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()
    # Warm gold key — lantern orbiting above pagoda (청사초롱 lantern)
    เพิ่มแสง(
        ไซน์(FR * 0.0078) * 4.0,
        3.8,
        โคไซน์(FR * 0.0078) * 2.0 + PZ,
        1.0, 0.86, 0.45,
        3.0, 14.0
    )
    # Cool moonlit blue fill — hanji paper window (달빛 moonlight)
    เพิ่มแสง(0-4.5, 1.8, PZ,  0.28, 0.42, 0.92,  1.5, 11.0)
    # Vermilion candle rim — right rear (초 candle)
    เพิ่มแสง(
        ไซน์(FR * 0.0062) * 3.0,
        0.4,
        0-โคไซน์(FR * 0.0062) * 2.0 + PZ,
        0.88, 0.22, 0.12,
        1.0, 9.0
    )
    # Deep blue under-fill (아래 그림자 shadow)
    เพิ่มแสง(0, 0-3.5, PZ,  0.10, 0.10, 0.58,  0.5, 7.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 음악  AUDIO — Korean pentatonic gugak drone ensemble
# 황종(A)·태주(C)·중려(D)·임종(E)·남려(G) — A minor pentatonic A2=110 Hz
# LFO 0.12–0.48 Hz = haegeum bow breath — like monks sustaining a tone
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot   x      y     z    w     freq     amp   lfo_hz  depth
    เสียง(0,  0,  0-H,  PZ, 1.5,  110.00, 0.12, 0.18, 0.012) # 황종 A2 floor
    เสียง(1,  0,  0-H,  FZ, 2.0,   55.00, 0.10, 0.12, 0.008) # A1  sub-bass
    เสียง(2, 0-W,  0,   PZ, 2.0,  164.81, 0.09, 0.25, 0.015) # E3  fifth (left)
    เสียง(3,  W,   0,   PZ, 2.0,  220.00, 0.09, 0.28, 0.018) # A3  octave (right)
    เสียง(4,  0,   H,   PZ, 0.5,  146.83, 0.07, 0.20, 0.013) # D3  fourth (ceiling)
    เสียง(5,  0,   0,   FZ, 1.2,  196.00, 0.08, 0.36, 0.020) # G3  minor 7th (portal)
    เสียง(6,  0,   0,   PZ, 1.0,  261.63, 0.07, 0.15, 0.010) # C4  minor 3rd (pagoda)
    เสียง(7, 0-4.2, 0,  PZ, 3.0,  293.66, 0.06, 0.42, 0.022) # D4  dragon left
    เสียง(8,  4.2, 0,   PZ, 3.0,  329.63, 0.06, 0.48, 0.024) # E4  dragon right
    ระดับเสียง(0.58)
}


# ════════════════════════════════════════════════════════════════════════════
# 시작  MAIN
# ════════════════════════════════════════════════════════════════════════════
ผูก 시작 = ทำ {
    เปิดหน้าต่างเต็มจอ("Hexagonal Hanok Meditation Hall — 육각 한옥 선원")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.05)

    init_audio()

    ผูก 프레임 = 0

    ผูก cam_px = 0.0
    ผูก cam_py = 0.0
    ผูก cam_pz = 0.0
    ผูก cam_zdist = 2.0
    ผูก cam_ry_off = 0.0
    ผูก cam_rx_off = 0.0
    ผูก cam_idle = 0
    ผูก cam_manual = 0
    ผูก cam_ry_snap = 0.0
    ผูก cam_rx_snap = 0.0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(0, 0, 4)    # deep lacquer-blue (한복 짙은 남색)

        # ── Camera: very slow pendulum sway ───────────────────────────────
        # Horizontal ±0.20 rad (11°), period ~2500 frames
        # Vertical   ±0.07 rad  (4°), period ~3700 frames
        ผูก ry  = ไซน์(프레임 * 0.00040) * 0.20
        ผูก rx  = ไซน์(프레임 * 0.00026) * 0.07
        ผูก mdx = mouse_dx()
        ผูก mdy = mouse_dy()
        ผูก any_input = 0
        ถ้า key_down("w")      { ผูก any_input = 1 }
        ถ้า key_down("s")      { ผูก any_input = 1 }
        ถ้า key_down("a")      { ผูก any_input = 1 }
        ถ้า key_down("d")      { ผูก any_input = 1 }
        ถ้า key_down("space")  { ผูก any_input = 1 }
        ถ้า key_down("lshift") { ผูก any_input = 1 }
        ถ้า key_down("left")   { ผูก any_input = 1 }
        ถ้า key_down("right")  { ผูก any_input = 1 }
        ถ้า key_down("up")     { ผูก any_input = 1 }
        ถ้า key_down("down")   { ผูก any_input = 1 }
        ถ้า mdx * mdx + mdy * mdy > 0.25 { ผูก any_input = 1 }
        ถ้า any_input == 1 { ผูก cam_manual = 1; ผูก cam_idle = 0 }
        ถ้า cam_manual == 1 {
            ผูก cam_idle = cam_idle + 1
            ถ้า cam_idle > 300 { ผูก cam_manual = 0; ผูก cam_idle = 0 }
        }
        ถ้า cam_manual == 1 {
            ผูก cam_ry_off = cam_ry_off + mdx * 0.0022
            ผูก cam_rx_off = cam_rx_off + mdy * 0.0022
            ถ้า cam_rx_off > 3.14159  { ผูก cam_rx_off = 3.14159 }
            ถ้า cam_rx_off < -3.14159 { ผูก cam_rx_off = -3.14159 }
            ถ้า key_down("left")  { ผูก cam_ry_off = cam_ry_off - 0.018 }
            ถ้า key_down("right") { ผูก cam_ry_off = cam_ry_off + 0.018 }
            ถ้า key_down("up")    { ผูก cam_rx_off = cam_rx_off - 0.018 }
            ถ้า key_down("down")  { ผูก cam_rx_off = cam_rx_off + 0.018 }
            ผูก fwd_x = ไซน์(cam_ry_snap + cam_ry_off)
            ผูก fwd_z = โคไซน์(cam_ry_snap + cam_ry_off)
            ผูก rgt_x = โคไซน์(cam_ry_snap + cam_ry_off)
            ผูก rgt_z = 0.0 - ไซน์(cam_ry_snap + cam_ry_off)
            ผูก spd = 0.12
            ถ้า key_down("w") { ผูก cam_px = cam_px + fwd_x * spd; ผูก cam_pz = cam_pz + fwd_z * spd }
            ถ้า key_down("s") { ผูก cam_px = cam_px - fwd_x * spd; ผูก cam_pz = cam_pz - fwd_z * spd }
            ถ้า key_down("a") { ผูก cam_px = cam_px - rgt_x * spd; ผูก cam_pz = cam_pz - rgt_z * spd }
            ถ้า key_down("d") { ผูก cam_px = cam_px + rgt_x * spd; ผูก cam_pz = cam_pz + rgt_z * spd }
            ถ้า key_down("space")  { ผูก cam_py = cam_py + spd }
            ถ้า key_down("lshift") { ผูก cam_py = cam_py - spd }
            ถ้า key_pressed("numpad+") { ผูก cam_zdist = cam_zdist + 0.5 }
            ถ้า key_pressed("numpad-") { ผูก cam_zdist = cam_zdist - 0.5; ถ้า cam_zdist < 0.5 { ผูก cam_zdist = 0.5 } }
        }
        ถ้า cam_manual == 0 {
            ผูก cam_ry_snap = ry
            ผูก cam_rx_snap = rx
            ผูก cam_ry_off = cam_ry_off * 0.97
            ผูก cam_rx_off = cam_rx_off * 0.97
            ผูก cam_px = cam_px * 0.97
            ผูก cam_py = cam_py * 0.97
            ผูก cam_pz = cam_pz * 0.97
        }
        ผูก cry = โคไซน์(cam_ry_snap + cam_ry_off)   ผูก sry = ไซน์(cam_ry_snap + cam_ry_off)
        ผูก crx = โคไซน์(cam_rx_snap + cam_rx_off)   ผูก srx = ไซน์(cam_rx_snap + cam_rx_off)
        ตั้งกล้อง(cry, sry, crx, srx)
        ตั้งตำแหน่งกล้อง(cam_px, cam_py, cam_pz)
        ตั้งระยะห่าง(cam_zdist)
        ผู้ฟัง(cry, sry, crx, srx)

        setup_lights(프레임)

        # ── Temporal framefade — 2 echo passes then current frame ─────────
        # Chromatic hue drift (+2.0, +1.0) shifts echoes toward warm amber,
        # leaving dancheong colour trails on all rotating hexagonal elements.
        draw_echo(프레임 - 48, 2.0)
        draw_echo(프레임 - 24, 1.0)

        # Current frame — full scene
        draw_floor(프레임, 0.0)
        draw_ceiling(프레임, 0.0)
        draw_front_wall(프레임, 0.0)
        draw_back_wall(프레임, 0.0)
        draw_left_wall(프레임, 0.0)
        draw_right_wall(프레임, 0.0)
        draw_탑(프레임, 0.0)

        แสดงผล()
        ผูก 프레임 = 프레임 + 1
    }
}
