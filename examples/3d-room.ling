# ════════════════════════════════════════════════════════════════════════════
# 3d-room.ling  v4 — Thai Matrix Cathedral
#
#  A vast dark cathedral.  Six surfaces, each a distinct sacred vision:
#
#    Walls (4)  — Thai-letter Matrix rain on a honeycomb column grid.
#                 Letters cycle colour, fade from bright head to dark tail,
#                 and flicker slowly — organic, not digital.
#
#    Ceiling    — Poincaré-disc hyperbolic UV grid: concentric rings spaced by
#                 tanh, crossed by subtly-curved radial rays.  Rotates.
#
#    Floor      — Deep perspective grid + 4-layer yantra (interlocked triangles
#                 + bhupura earth square).
#
#    Centre     — Thai totem pole with garuda wings:
#                   lotus base → tiers of chakra / yantra / lotus →
#                   8-point apex star.  Garuda wings: twin outward spirals +
#                   side ring-stacks.  Merkaba tetrahedra spin at the core.
#
#  Camera tours the room on a compound Lissajous path — ceiling, walls,
#  floor, back portal all pass through view naturally.
#
#  Run:   ling run examples/3d-room.ling
#  Quit:  Escape or close window
# ════════════════════════════════════════════════════════════════════════════

bind W   = 9.0     # half-width   (side walls at x = ±W)
bind H   = 4.5     # half-height  (floor y=-H, ceiling y=+H)
bind FZ  = 16.0    # far z        (back wall)
bind NZ  = 1.4     # near z       (front wall — close, frames view)
bind MZ  = 8.0     # totem / merkaba z-centre
bind MR  = 1.30    # merkaba radius


# ════════════════════════════════════════════════════════════════════════════
# COLOUR HELPER
# ════════════════════════════════════════════════════════════════════════════

fn col(t, p) {
    สีดินสอ(
        sin(t + p)         * 127 + 128,
        sin(t + p + 2.094) * 127 + 128,
        sin(t + p + 4.189) * 127 + 128
    )
}


# ════════════════════════════════════════════════════════════════════════════
# MERKABA CORE  (tetrahedra at the heart of the totem)
# ════════════════════════════════════════════════════════════════════════════

fn tetra(ax,ay,az, bx,by,bz, cx,cy,cz, dx,dy,dz, t) {
    col(t, 0.0)   วาดสามเหลี่ยม3มิติ(ax,ay,az, bx,by,bz, cx,cy,cz)
    col(t, 0.78)  วาดสามเหลี่ยม3มิติ(ax,ay,az, bx,by,bz, dx,dy,dz)
    col(t, 1.57)  วาดสามเหลี่ยม3มิติ(ax,ay,az, cx,cy,cz, dx,dy,dz)
    col(t, 2.36)  วาดสามเหลี่ยม3มิติ(bx,by,bz, cx,cy,cz, dx,dy,dz)
}

fn draw_merkaba_core(FR) {
    bind mr   = MR
    bind mrot = FR * 0.011
    bind mc   = cos(mrot)
    bind ms   = sin(mrot)
    bind bob  = sin(FR * 0.028) * 0.35
    bind oy   = bob
    bind t    = FR * 0.020

    bind v0x = 0.0              bind v0y = mr + oy          bind v0z = MZ
    bind v1x = mr * 0.9428 * mc bind v1y = 0-mr*0.3333 + oy bind v1z = 0-mr*0.9428*ms + MZ
    bind v2x = 0-mr*0.4714*mc + mr*0.8165*ms
    bind v2y = 0-mr*0.3333 + oy
    bind v2z = mr*0.4714*ms + mr*0.8165*mc + MZ
    bind v3x = 0-mr*0.4714*mc - mr*0.8165*ms
    bind v3y = 0-mr*0.3333 + oy
    bind v3z = mr*0.4714*ms - mr*0.8165*mc + MZ
    tetra(v0x,v0y,v0z, v1x,v1y,v1z, v2x,v2y,v2z, v3x,v3y,v3z, t)

    bind u0x = 0.0               bind u0y = 0-mr + oy         bind u0z = MZ
    bind u1x = 0-mr*0.9428*mc   bind u1y = mr*0.3333 + oy    bind u1z = mr*0.9428*ms + MZ
    bind u2x = mr*0.4714*mc - mr*0.8165*ms
    bind u2y = mr*0.3333 + oy
    bind u2z = 0-mr*0.4714*ms - mr*0.8165*mc + MZ
    bind u3x = mr*0.4714*mc + mr*0.8165*ms
    bind u3y = mr*0.3333 + oy
    bind u3z = 0-mr*0.4714*ms + mr*0.8165*mc + MZ
    tetra(u0x,u0y,u0z, u1x,u1y,u1z, u2x,u2y,u2z, u3x,u3y,u3z, t + 1.5)
}


# ════════════════════════════════════════════════════════════════════════════
# THAI TOTEM POLE WITH GARUDA WINGS
# ════════════════════════════════════════════════════════════════════════════

fn draw_totem(FR) {
    bind tz = MZ

    # ── Merkaba at the core ───────────────────────────────────────────────
    draw_merkaba_core(FR)

    # ── Base: grand lotus bloom at floor level ────────────────────────────
    vtex_lotus(0, 0-H+0.5, tz,  1,0,0,  0,0,1,  1.2, 3.2, 16,  FR, 0.0)

    # ── Tier -3: wide chakra at y=-3 (hovering above floor) ──────────────
    vtex_chakra(0, 0-3.0, tz,  1,0,0,  0,0,1,  2.2, 8,  FR, 0.8)

    # ── Tier -2: yantra at y=-1.8 ────────────────────────────────────────
    vtex_yantra(0, 0-1.8, tz,  1,0,0,  0,0,1,  3, 1.6,  FR, 1.8)

    # ── Tier -1: chakra (body lower) ─────────────────────────────────────
    vtex_chakra(0, 0-0.6, tz,  1,0,0,  0,0,1,  1.2, 12,  FR, 2.8)

    # ── Tier 0: yantra (body centre) ─────────────────────────────────────
    vtex_yantra(0, 0.6, tz,  1,0,0,  0,0,1,  2, 1.0,  FR, 3.8)

    # ── Tier +1: lotus mid ────────────────────────────────────────────────
    vtex_lotus(0, 1.8, tz,  1,0,0,  0,0,1,  0.55, 1.6, 12,  FR, 4.8)

    # ── Tier +2: spinning chakra (fast) ──────────────────────────────────
    vtex_chakra(0, 3.0, tz,  1,0,0,  0,0,1,  1.1, 16,  FR, 5.8)

    # ── Apex: 8-point star crown ──────────────────────────────────────────
    vtex_star(0, H-0.6, tz,  1,0,0,  0,0,1,  8, 1.4, 0.60, 0.045,  FR, 0.5)
    vtex_flower(0, H-0.6, tz,  1,0,0,  0,0,1,  0.75, 12,  FR, 3.0)

    # ── Garuda wings — outward spirals on the XZ plane ───────────────────
    # Left wing: spiral centred at (-4, 0, MZ)
    vtex_spiral(0-4.0, 0, tz,  1,0,0,  0,0,1,  3.5, 3.2, 90,  FR, 1.0)
    # Right wing: mirrored (phase +π)
    vtex_spiral( 4.0, 0, tz,  1,0,0,  0,0,1,  3.5, 3.2, 90,  FR, 1.0 + 3.14159)

    # ── Wing ring stacks (like feathered naga wings) ──────────────────────
    # Left rings at y=0 (same height as merkaba)
    vtex_rings(0-4.5, 0, tz,  1,0,0,  0,0,1,  3, 20,  2.0, 0.28,  FR, 2.2)
    vtex_rings( 4.5, 0, tz,  1,0,0,  0,0,1,  3, 20,  2.0, 0.28,  FR, 5.4)

    # Upper wing arcs (secondary feathers)
    vtex_rings(0-3.2, 1.5, tz,  1,0,0,  0,0,1,  2, 12,  1.3, 0.35,  FR, 3.0)
    vtex_rings( 3.2, 1.5, tz,  1,0,0,  0,0,1,  2, 12,  1.3, 0.35,  FR, 0.2)

    # ── Totem aura: lotus + chakra halos around totem centre ─────────────
    vtex_lotus(0, 0, MZ,  1,0,0,  0,1,0,  1.55, 2.4, 12,  FR, 5.5)
    vtex_chakra(0, 0, MZ,  1,0,0,  0,0,1,  2.2, 8,  FR, 2.8)
    vtex_rings(0, 0, MZ,  1,0,0,  0,1,0,  3, 36,  2.6, 0.13,  FR, 6.1)
}


# ════════════════════════════════════════════════════════════════════════════
# ROOM SURFACES
# ════════════════════════════════════════════════════════════════════════════

fn wall_params(FR) {
    # Shared letter-rain sizing:
    #   side walls  — U along Z (depth), V along Y (height)
    #   front/back  — U along X (width),  V along Y (height)
    # All walls use same col_w / row_h
    bind col_w = 0.64
    bind row_h = 0.58
}

fn draw_floor(FR) {
    bind cy   = 0 - H
    bind fmid = FZ / 2

    # Yantra + grid — the ground feels inscribed and vast
    vtex_yantra(0, cy, fmid,  1,0,0,  0,0,1,  4, 4.8,  FR, 0.0)
    vtex_grid(0, cy, fmid,  1,0,0,  0,0,1,  28, 24,  0.64, 0.64,  FR, 3.5)
}

fn draw_ceiling(FR) {
    bind cy   = H
    bind fmid = FZ / 2
    # Poincaré-disc hyperbolic UV: 14 rings, 20 rays
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  5.8, 14, 20,  FR, 1.0)
    # Outer ring to frame the ceiling disc
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  2, 36,  6.2, 0.02,  FR, 4.5)
}

fn draw_front_wall(FR) {
    # Near wall (z=NZ=1.4) — close, fills the frame
    # 28 cols × 0.64 = 17.9 ≥ 2W=18; 16 rows × 0.58 = 9.28 ≥ 2H=9
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.022,  FR, 0.0)
}

fn draw_back_wall(FR) {
    # Far wall — letter rain forms the deep portal
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.028,  FR, 2.1)
    # Chakra portal glows through the rain
    vtex_chakra(0, 0, FZ,  1,0,0,  0,1,0,  4.2, 12,  FR, 0.5)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  3, 36,  4.8, 0.03,  FR, 3.5)
}

fn draw_left_wall(FR) {
    bind cx   = 0 - W
    bind fmid = (NZ + FZ) / 2   # z centre of the side wall
    # 24 cols × 0.64 = 15.36 ≥ FZ-NZ=14.6; 16 rows × 0.58 = 9.28 ≥ 2H=9
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.025,  FR, 4.2)
}

fn draw_right_wall(FR) {
    bind cx   = W
    bind fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.020,  FR, 1.6)
}

fn setup_lights(FR) {
    clear_lights()
    # Warm gold — orbits above totem
    add_light(
        sin(FR * 0.010) * 4.5,
        4.0,
        cos(FR * 0.010) * 2.5 + MZ,
        1.0, 0.88, 0.65,
        3.0, 14.0
    )
    # Cool teal fill: from above-left
    add_light(0-4.0, 2.0, MZ, 0.30, 0.80, 1.0, 1.5, 10.0)
    # Magenta rim: from behind-right
    add_light(
        sin(FR * 0.007) * 3.5,
        0.5,
        0-cos(FR * 0.007) * 2.5 + MZ,
        1.0, 0.20, 0.90,
        1.0, 8.0
    )
    # Deep violet under-fill (floor glow)
    add_light(0, 0-3.0, MZ, 0.55, 0.10, 1.0, 0.6, 7.0)
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO — 4D positional sine tones, one per room object
# ════════════════════════════════════════════════════════════════════════════

fn init_audio() {
    # Each tone: audio_tone(slot, x, y, z, w,  freq,   amp, lfo_rate, lfo_depth)
    # Harmonic A-series: 55·2^n Hz   (A1 → A5) with inter-harmonic rationals
    #  0  Merkaba core      (0,    0,    MZ)   A2   110 Hz  — beating heart of room
    audio_tone(0,   0,    0,    MZ,  1.0,   110.0, 0.12, 0.30, 0.040)
    #  1  Floor yantra      (0,  -H,    MZ)   A1    55 Hz  — sub, grounding
    audio_tone(1,   0,  0-H,   MZ,  1.5,    55.0, 0.10, 0.18, 0.030)
    #  2  Ceiling disc      (0,  +H,    MZ)   E5   660 Hz  — ethereal shimmer
    audio_tone(2,   0,   H,    MZ,  0.5,   660.0, 0.07, 0.70, 0.018)
    #  3  Left wall         (-W,  0,    MZ)   A3   220 Hz  — warm left pan
    audio_tone(3, 0-W,   0,    MZ,  2.0,   220.0, 0.10, 0.42, 0.050)
    #  4  Right wall        (+W,  0,    MZ)   D4   293 Hz  — natural right pan
    audio_tone(4,  W,    0,    MZ,  2.0,   293.0, 0.10, 0.55, 0.038)
    #  5  Back portal       (0,   0,    FZ)   E4   330 Hz  — deep-space drone
    audio_tone(5,   0,   0,    FZ,  1.2,   330.0, 0.09, 0.62, 0.028)
    #  6  Left Garuda wing  (-4,  0,    MZ)   E3   165 Hz  — wing rush left
    audio_tone(6, 0-4,   0,    MZ,  3.0,   165.0, 0.08, 0.80, 0.060)
    #  7  Right Garuda wing (+4,  0,    MZ)   A4   440 Hz  — wing rush right
    audio_tone(7,  4,    0,    MZ,  3.0,   440.0, 0.08, 0.88, 0.048)
    #  8  Front wall        (0,   0,    NZ)   C#5  550 Hz  — presence / breath
    audio_tone(8,   0,   0,    NZ,  0.8,   550.0, 0.07, 1.10, 0.035)
    audio_volume(0.65)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN
# ════════════════════════════════════════════════════════════════════════════
ผูก เริ่ม = ทำ {
    เปิดหน้าต่างเต็มจอ("Thai Matrix Cathedral — อาสนวิหารเมทริกซ์ไทย")
    set_ambient(0.06)

    # Boot the 4D audio landscape.
    init_audio()

    ผูก FR = 0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(1, 0, 5)    # near-black deep violet

        # ── Camera: compound Lissajous tour ───────────────────────────────
        # Two horizontal frequencies → camera visits walls + back portal
        # Two vertical frequencies  → ceiling + floor cycle through view
        # Max ry ≈ 0.50+0.18 = 0.68 rad (39°) — side walls always in front
        ผูก ry  = sin(FR * 0.00220) * 0.50 + sin(FR * 0.00091) * 0.18
        ผูก rx  = sin(FR * 0.00160) * 0.42 + sin(FR * 0.00077) * 0.18
        ผูก cry = cos(ry)   ผูก sry = sin(ry)
        ผูก crx = cos(rx)   ผูก srx = sin(rx)
        set_camera(cry, sry, crx, srx)

        # ── Sync audio listener to camera ─────────────────────────────────
        audio_listener(cry, sry, crx, srx)

        setup_lights(FR)

        # ── Room surfaces ─────────────────────────────────────────────────
        draw_floor(FR)
        draw_ceiling(FR)
        draw_front_wall(FR)
        draw_back_wall(FR)
        draw_left_wall(FR)
        draw_right_wall(FR)

        # ── Thai totem pole (with merkaba core) ───────────────────────────
        draw_totem(FR)

        แสดงผล()
        ผูก FR = FR + 1
    }
}
