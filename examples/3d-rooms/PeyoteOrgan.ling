# ════════════════════════════════════════════════════════════════════════════
# PeyoteOrgan.ling — The Higher-Dimensional Organism
#
# A ceremonial chamber that IS a body.  The peyote cactus organism mapped onto
# the human chakra spine — seen from any angle it reveals a different sacred
# geometry.  The solar system arranged as water-lens mandalas, with Earth/Ling
# as the pineal gland at the centre, Venus and Jupiter as mirror benefics.
#
# ── PEYOTE BUTTONS (Lophophora williamsii) ──────────────────────────────────
#   Flat 9-rib radial discs at ground level.  Two overlapping hyperbolic layers
#   at coprime ring counts (7/11 vs 9/13) and slightly different phase speeds
#   produce a sinusoidal moiré — the "signal of growth" made visible.
#   From above:  full mandala face-on.
#   From the side: thin disc + vertical growth column.
#   From front:  radial ribs + upward moiré plume.
#
# ── CHAKRA SPINE / CACTUS ORGANISM ──────────────────────────────────────────
#   San Pedro style column = human spine = 7 chakra wheels.
#   Root (C2 = 65 Hz) at floor  →  Crown (B4 = 494 Hz) at ceiling.
#   Each node pulses at its own speed (small upper nodes fastest).
#   Three orientation planes per node: XY/YZ/XZ reveals new geometry per angle.
#
# ── SOLAR SYSTEM MANDALA (back wall) ─────────────────────────────────────────
#   Saturn — Mars — Venus — EARTH/LING — Jupiter — Neptune
#   Venus (8-fold silver, inner) ↔ Jupiter (12-fold gold, outer):
#     cosmic mirror benefics equidistant from Earth on each side.
#   Earth/Ling = water lens = the pineal of the solar system.
#   SM2 hash seeds each planet's mandala with independent pseudo-random detail.
#
# ── BREATH PORTAL (left wall) ────────────────────────────────────────────────
#   Two lung spirals expand/contract with a ~150-frame sinusoidal breath rhythm.
#   Nose portal (small 9-petal lotus), mouth portal (wide 12-fold flower).
#   Sinusoidal moiré background = the visible waveform of breathing itself.
#
# ── ENERGY PORTAL (right wall) ───────────────────────────────────────────────
#   Intake yantra at top → descending galaxy spiral → root return mandala.
#   The second brain (gut) as nested spirals.  Water-to-earth return at base.
#
# ── TONES ────────────────────────────────────────────────────────────────────
#   ROOT    C2 =  65.41 Hz   SACRAL  G2 =  98.00 Hz
#   SOLAR   C3 = 130.81 Hz   HEART   F3 = 174.61 Hz  (OM freq)
#   THROAT  G3 = 196.00 Hz   AJNA    A4 = 440.00 Hz  (universal A)
#   CROWN   B4 = 493.88 Hz   COSMIC  C5 = 523.25 Hz
#   VENUS   E4 = 329.63 Hz   JUPITER D4 = 293.66 Hz
#
# ── CAMERA ───────────────────────────────────────────────────────────────────
#   灵 figure-eight, 800-frame period:
#   ry = sin(t)·0.40   →  ±0.40 rad horizontal yaw
#   rx = sin(2t)·0.22 + 0.06  →  figure-eight vertical + upward bias
# ════════════════════════════════════════════════════════════════════════════

ผูก W   = 14.0
ผูก H   = 7.0
ผูก FZ  = 28.0
ผูก NZ  = 1.5
ผูก MZ  = 14.75    # (NZ + FZ) / 2

ผูก SX  = 0.0      # spine / cactus centre x
ผูก SZ  = 11.0     # spine / cactus centre z

# Chakra frequencies — 7 nodes + cosmic + Venus + Jupiter
ผูก FC2  = 65.41   # C2 root rumble
ผูก FG2  = 98.00   # G2 sacral water
ผูก FC3  = 130.81  # C3 solar plexus fire
ผูก FF3  = 174.61  # F3 heart / OM
ผูก FG3  = 196.00  # G3 throat sound
ผูก FA4  = 440.00  # A4 ajna  (universal tuning A)
ผูก FB4  = 493.88  # B4 crown
ผูก FC5  = 523.25  # C5 cosmic overflow
ผูก FVen = 329.63  # E4 Venus  — inner mirror benefic
ผูก FJup = 293.66  # D4 Jupiter — outer mirror benefic


# ════════════════════════════════════════════════════════════════════════════
# SM2 HASH
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน sm2_hash(cx, ry, a, b) {
    ผูก p = cx * 2166136261.0 + ry * 16777619.0
    ผูก s = ไซน์(p * 0.0000031 + a) * 0.5 + 0.5
    ผูก c = โคไซน์(p * 0.0000059 - b) * 0.5 + 0.5
    s * 0.618 + c * 0.382
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO  — chakra tones placed along the spine, Venus/Jupiter on walls
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot  x     y           z     w    freq   amp   lfo_hz  depth
    เสียงโทน(0, SX, 0-H,       SZ, 5.5, FC2,  0.14, 0.012, 0.015)   # root
    เสียงโทน(1, SX, 0-H+2.0,  SZ, 4.5, FG2,  0.12, 0.019, 0.025)   # sacral
    เสียงโทน(2, SX, 0-H+4.0,  SZ, 4.0, FC3,  0.11, 0.028, 0.038)   # solar plexus
    เสียงโทน(3, SX, 0-H+6.0,  SZ, 4.5, FF3,  0.11, 0.022, 0.030)   # heart / OM
    เสียงโทน(4, SX, 0-H+8.0,  SZ, 3.5, FG3,  0.10, 0.035, 0.050)   # throat
    เสียงโทน(5, SX, 0-H+10.0, SZ, 3.0, FA4,  0.09, 0.048, 0.075)   # ajna
    เสียงโทน(6, SX, 0-H+12.0, SZ, 2.5, FB4,  0.08, 0.063, 0.120)   # crown
    เสียงโทน(7, 0,  H,         MZ, 5.0, FC5,  0.07, 0.038, 0.060)   # cosmic
    ระดับเสียง(0.50)
}


# ════════════════════════════════════════════════════════════════════════════
# LIGHTS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()

    # Heart-sun: warm gold overhead, slow drift around centre
    ผูก th = FR * 0.0018
    เพิ่มแสง(
        โคไซน์(th) * 6.5,  H * 0.88,  MZ + ไซน์(th) * 3.5,
        0.95, 0.80, 0.44,   4.5, 18.0
    )

    # Venus light: cool silver-blue from left wall, gentle sway
    ผูก tv = FR * 0.0026
    เพิ่มแสง(
        0-W*0.72,  H*0.35 + ไซน์(tv)*1.2,  MZ + โคไซน์(tv)*2.0,
        0.76, 0.88, 1.00,   2.8, 12.0
    )

    # Jupiter light: warm amber from right — mirrors Venus exactly
    ผูก tj = tv + 3.14159
    เพิ่มแสง(
        W*0.72,  H*0.35 + ไซน์(tj)*1.2,  MZ + โคไซน์(tj)*2.0,
        1.00, 0.84, 0.32,   2.8, 12.0
    )

    # Earth core: deep blue-green rising from ground at spine
    เพิ่มแสง(SX, 0-H-1.2, SZ,   0.20, 0.55, 0.42,   1.5, 8.0)

    # Peyote shimmer: cycling green near the cactus field
    ผูก tp = FR * 0.055
    เพิ่มแสง(
        ไซน์(tp)*3.2,  0-H+0.4,  SZ + โคไซน์(tp)*2.2,
        0.30, 0.78, 0.52,   1.8, 6.0
    )
}


# ════════════════════════════════════════════════════════════════════════════
# PEYOTE BUTTON HELPER
# 9-rib chakra disc + sinusoidal moiré growth signal rising upward
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_peyote(px, py, pz, r, FR, hue) {
    ผูก br  = ไซน์(FR * 0.028 + pz * 0.31) * 0.35 + 0.65
    ผูก br2 = ไซน์(FR * 0.021 + pz * 0.47 + 1.57) * 0.35 + 0.65

    # Horizontal disc body — 9-rib pattern (best seen from above, XZ plane)
    ลายจักร(px, py, pz,  1,0,0, 0,0,1,  r*br, 9,  FR*0.018, hue)
    ลายวงซ้อน(px, py, pz,   1,0,0, 0,0,1,  4, 9,  r*1.20*br, 0.05,  FR*0.024, hue+0.22)

    # Central tuft visible from front (XY plane)
    ลายดอกบัว(px, py+r*0.06, pz,  1,0,0, 0,1,0,  r*0.10, r*0.32, 9,  FR*0.58, hue+0.55)

    # SINUSOIDAL MOIRE — coprime ring counts (7/11 vs 9/13) + different phase speeds
    ผูก m1 = ไซน์(FR * 0.031 + pz * 0.42) * 0.40 + 0.60
    ผูก m2 = ไซน์(FR * 0.023 + pz * 0.63 + 2.09) * 0.40 + 0.60
    vtex_hyperbolic_uv(px, py, pz,  1,0,0, 0,0,1,  r*m1, 7, 11,  FR*0.031, hue+0.12)
    vtex_hyperbolic_uv(px, py, pz,  1,0,0, 0,0,1,  r*m2*1.14, 9, 13,  FR*0.023, hue+0.52)

    # Growth signal rising upward — two layers of elevation (XY)
    ผูก gs = ไซน์(FR * 0.055 + pz * 0.77) * 0.40 + 0.60
    vtex_hyperbolic_uv(px, py+r*0.7, pz,  1,0,0, 0,1,0,  r*gs*0.58, 4, 7,  FR*0.044, hue+0.35)
    vtex_hyperbolic_uv(px, py+r*1.5, pz,  1,0,0, 0,1,0,  r*gs*0.34, 3, 5,  FR*0.033, hue+0.72)

    # Side-view disc (YZ) — seen as a flat disc from the side
    ลายดอกบัว(px, py, pz,  0,0,1, 0,1,0,  r*br2*0.44, r*br2*0.88, 9,  FR*0.032, hue+0.68)
}


# ════════════════════════════════════════════════════════════════════════════
# PEYOTE GARDEN  — SM2 earth floor + 5 buttons + root chakra mandala
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_peyote_garden(FR, hd) {
    ผูก gy  = 0 - H
    ผูก gfz = FZ * 0.50

    # SM2-seeded ground tessellation (root chakra earth pattern)
    ผูก hg1 = sm2_hash(4.0, 8.0,  FR*0.0028, FR*0.0040)
    ผูก hg2 = sm2_hash(8.0, 4.0,  FR*0.0040, FR*0.0028)
    vtex_tessellated(0, gy, gfz,  1,0,0, 0,0,1,  26, 20,  0.42+hg1*0.15, 0.09+hg2*0.06, 4.5,  FR, hd+2.2)

    # Root chakra mandala inlaid in floor
    ลายจักร(0, gy, gfz,  1,0,0, 0,0,1,  7.0, 4,  FR*0.006, hd+0.6)
    ลายยันต์(0, gy, gfz,  1,0,0, 0,0,1,  4, 6.0,  FR*0.008, hd+0.0)
    ลายวงซ้อน(0, gy, gfz,   1,0,0, 0,0,1,  3, 4,  6.4, 0.12,  FR*0.004, hd+1.0)

    # Ground moiré growth field (sinusoidal interference on earth surface)
    ผูก pm1 = sm2_hash(3.0, 9.0,  FR*0.0015, FR*0.0020)
    ผูก pm2 = sm2_hash(9.0, 3.0,  FR*0.0020, FR*0.0015)
    vtex_hyperbolic_uv(0, gy, gfz,     1,0,0, 0,0,1,  10.0, 6,10,  FR*(0.010+pm1*0.005), hd+3.5)
    vtex_hyperbolic_uv(0, gy, gfz+2.0, 1,0,0, 0,0,1,   8.0, 7,12,  FR*(0.014+pm2*0.004), hd+4.2)

    # Five peyote buttons — varying positions and sizes
    ผูก gy2 = gy + 0.04
    draw_peyote( 0.0,  gy2, SZ-1.5, 1.10, FR, hd)
    draw_peyote(0-2.8, gy2, SZ+0.5, 0.72, FR, hd+1.8)
    draw_peyote( 2.8,  gy2, SZ+0.5, 0.76, FR, hd+3.6)
    draw_peyote(0-4.5, gy2, SZ+2.0, 0.55, FR, hd+5.2)
    draw_peyote( 4.5,  gy2, SZ+2.0, 0.58, FR, hd+0.9)
}


# ════════════════════════════════════════════════════════════════════════════
# CHAKRA SPINE / CACTUS ORGANISM
# 7 nodes root-to-crown, San Pedro ribs between nodes
# Each node: three orientation planes for angle-dependent geometry
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_chakra_spine(FR, hd) {
    ผูก tx = SX
    ผูก tz = SZ
    ผูก gy = 0 - H

    # ── NODE 0: ROOT — Muladhara (4-fold earth, C2) ──
    ผูก br0 = ไซน์(FR * 0.013 + 0.00) * 0.42 + 0.58
    ผูก n0y = gy + 0.5
    ผูก m0a = ไซน์(FR * 0.031 + 0.5) * 0.40 + 0.60
    ผูก m0b = ไซน์(FR * 0.022 + 2.6) * 0.40 + 0.60
    ลายดอกบัว(tx, n0y, tz,  1,0,0, 0,0,1,  0.36*br0, 1.10*br0, 4,  FR, hd)
    ลายวงซ้อน(tx, n0y, tz,  1,0,0, 0,0,1,  3, 4,  2.20*br0, 0.08,  FR*0.020, hd+0.1)
    ลายจักร(tx, n0y, tz, 1,0,0, 0,1,0,  1.80*br0, 4,  FR*0.016, hd+0.2)
    vtex_hyperbolic_uv(tx, n0y, tz,  1,0,0, 0,0,1,  2.0*m0a, 4,8,  FR*0.031, hd)
    vtex_hyperbolic_uv(tx, n0y, tz,  1,0,0, 0,0,1,  2.3*m0b, 5,9,  FR*0.022, hd+0.4)

    ลายวงซ้อน(tx, gy+1.2, tz,  0,1,0, 1,0,0,  1, 4,  0.55, 0.0,  FR*0.05, hd+0.05)
    ลายวงซ้อน(tx, gy+1.7, tz,  0,1,0, 1,0,0,  1, 4,  0.52, 0.0,  FR*0.05, hd+0.08)

    # ── NODE 1: SACRAL — Svadhisthana (6-fold water, G2) ──
    ผูก br1 = ไซน์(FR * 0.019 + 1.00) * 0.42 + 0.58
    ผูก n1y = gy + 2.0
    ผูก m1a = ไซน์(FR * 0.031 + 1.0) * 0.40 + 0.60
    ผูก m1b = ไซน์(FR * 0.022 + 3.6) * 0.40 + 0.60
    ลายดอกบัว(tx, n1y, tz,  1,0,0, 0,1,0,  0.80*br1, 1.60*br1, 6,  FR*0.50, hd+0.15)
    ลายดอกบัว(tx, n1y, tz,   1,0,0, 0,0,1,  0.30*br1, 1.00*br1, 6,  FR, hd+0.18)
    ลายวงซ้อน(tx, n1y, tz,   1,0,0, 0,0,1,  3, 6,  2.10*br1, 0.07,  FR*0.025, hd+0.12)
    vtex_hyperbolic_uv(tx, n1y, tz,  1,0,0, 0,1,0,  1.8*m1a, 5,9,  FR*0.028, hd+0.12)
    vtex_hyperbolic_uv(tx, n1y, tz,  1,0,0, 0,0,1,  2.0*m1b, 6,10,  FR*0.020, hd+0.50)

    ลายวงซ้อน(tx, gy+2.8, tz,  0,1,0, 1,0,0,  1, 6,  0.50, 0.0,  FR*0.05, hd+0.12)
    ลายวงซ้อน(tx, gy+3.3, tz,  0,1,0, 1,0,0,  1, 6,  0.48, 0.0,  FR*0.05, hd+0.14)
    ลายเกลียว(tx, gy+2.9, tz,  0,1,0, 1,0,0,  0.08, 0.46, 18,  FR*0.18, hd+0.13)

    # ── NODE 2: SOLAR PLEXUS — Manipura (10-fold fire, C3) ──
    ผูก br2 = ไซน์(FR * 0.027 + 2.00) * 0.42 + 0.58
    ผูก n2y = gy + 4.0
    ผูก m2a = ไซน์(FR * 0.035 + 2.0) * 0.40 + 0.60
    ผูก m2b = ไซน์(FR * 0.027 + 4.7) * 0.40 + 0.60
    ลายดาว(tx, n2y, tz,   1,0,0, 0,1,0,  10, 1.80*br2, 0.72*br2, 0.04,  FR*0.040, hd+0.28)
    ลายจักร(tx, n2y, tz, 1,0,0, 0,1,0,  1.70*br2, 10,  FR*0.025, hd+0.25)
    ลายวงซ้อน(tx, n2y, tz,  1,0,0, 0,0,1,  3, 10,  2.00*br2, 0.06,  FR*0.032, hd+0.22)
    vtex_hyperbolic_uv(tx, n2y, tz,  1,0,0, 0,1,0,  1.6*m2a, 6,10,  FR*0.035, hd+0.22)
    vtex_hyperbolic_uv(tx, n2y, tz,  1,0,0, 0,0,1,  1.9*m2b, 7,11,  FR*0.026, hd+0.60)

    ลายวงซ้อน(tx, gy+4.8, tz,  0,1,0, 1,0,0,  1, 8,  0.44, 0.0,  FR*0.05, hd+0.22)
    ลายวงซ้อน(tx, gy+5.3, tz,  0,1,0, 1,0,0,  1, 8,  0.42, 0.0,  FR*0.05, hd+0.25)
    ลายเกลียว(tx, gy+4.9, tz,  0,1,0, 1,0,0,  0.07, 0.40, 20,  FR*0.22, hd+0.24)

    # ── NODE 3: HEART — Anahata (12-fold air+water, F3/OM — 3 planes = water lens) ──
    ผูก br3 = ไซน์(FR * 0.022 + 3.00) * 0.42 + 0.58
    ผูก n3y = gy + 6.0
    ผูก m3a = ไซน์(FR * 0.028 + 3.0) * 0.40 + 0.60
    ผูก m3b = ไซน์(FR * 0.020 + 5.7) * 0.40 + 0.60
    ลายดอกบัว(tx, n3y, tz,  1,0,0, 0,1,0,  0.36*br3, 1.28*br3, 12,  FR, hd+0.35)
    ลายดอกบัว(tx, n3y, tz,  0,0,1, 0,1,0,  0.28*br3, 1.00*br3, 12,  FR, hd+0.38)
    ลายวงซ้อน(tx, n3y, tz,  1,0,0, 0,0,1,  4, 12,  2.40*br3, 0.06,  FR*0.028, hd+0.33)
    vtex_hyperbolic_uv(tx, n3y, tz,  1,0,0, 0,1,0,  2.0*m3a, 8,12,  FR*0.028, hd+0.35)
    vtex_hyperbolic_uv(tx, n3y, tz,  0,0,1, 0,1,0,  1.7*m3b, 9,13,  FR*0.020, hd+0.72)
    vtex_hyperbolic_uv(tx, n3y, tz,  1,0,0, 0,0,1,  1.5*m3a, 6,10,  FR*0.024, hd+1.08)

    ลายวงซ้อน(tx, gy+6.8, tz,  0,1,0, 1,0,0,  1, 10, 0.38, 0.0,  FR*0.05, hd+0.34)
    ลายวงซ้อน(tx, gy+7.3, tz,  0,1,0, 1,0,0,  1, 10, 0.36, 0.0,  FR*0.05, hd+0.36)
    ลายเกลียว(tx, gy+6.9, tz,  0,1,0, 1,0,0,  0.06, 0.34, 24,  FR*0.26, hd+0.35)

    # ── NODE 4: THROAT — Vishuddha (16-fold sound, G3) ──
    ผูก br4 = ไซน์(FR * 0.034 + 4.00) * 0.42 + 0.58
    ผูก n4y = gy + 8.0
    ผูก m4a = ไซน์(FR * 0.042 + 4.0) * 0.40 + 0.60
    ผูก m4b = ไซน์(FR * 0.033 + 6.8) * 0.40 + 0.60
    ลายดอกบัว(tx, n4y, tz,  1,0,0, 0,1,0,  0.90*br4, 1.80*br4, 16,  FR*0.60, hd+0.48)
    ลายจักร(tx, n4y, tz,  0,0,1, 0,1,0,  1.40*br4, 16,  FR*0.048, hd+0.50)
    ลายวงซ้อน(tx, n4y, tz,   1,0,0, 0,0,1,  3, 16,  2.00*br4, 0.05,  FR*0.042, hd+0.46)
    vtex_hyperbolic_uv(tx, n4y, tz,  1,0,0, 0,1,0,  1.5*m4a, 9,13,  FR*0.042, hd+0.48)
    vtex_hyperbolic_uv(tx, n4y, tz,  0,0,1, 0,1,0,  1.3*m4b, 8,12,  FR*0.033, hd+0.85)

    ลายวงซ้อน(tx, gy+8.8, tz,  0,1,0, 1,0,0,  1, 12, 0.32, 0.0,  FR*0.06, hd+0.47)
    ลายวงซ้อน(tx, gy+9.2, tz,  0,1,0, 1,0,0,  1, 12, 0.30, 0.0,  FR*0.06, hd+0.49)
    ลายเกลียว(tx, gy+8.9, tz,  0,1,0, 1,0,0,  0.05, 0.28, 28,  FR*0.32, hd+0.48)

    # ── NODE 5: AJNA — Third Eye (2-fold mind + 6-fold star, A4/440Hz) ──
    ผูก br5 = ไซน์(FR * 0.046 + 5.00) * 0.42 + 0.58
    ผูก n5y = gy + 10.0
    ผูก m5a = ไซน์(FR * 0.055 + 5.0) * 0.40 + 0.60
    ลายดอกบัว(tx, n5y, tz,  1,0,0, 0,1,0,  0.28*br5, 0.92*br5, 2,  FR, hd+0.58)
    ลายดาว(tx, n5y, tz,   1,0,0, 0,1,0,  6, 1.60*br5, 0.64*br5, 0.04,  FR*0.068, hd+0.60)
    vtex_hyperbolic_uv(tx, n5y, tz,  1,0,0, 0,1,0,  1.4*br5, 2, 4,  FR*0.055, hd+0.58)
    vtex_hyperbolic_uv(tx, n5y, tz,  1,0,0, 0,0,1,  1.2*m5a, 3, 6,  FR*0.046, hd+0.95)
    ลายวงซ้อน(tx, n5y, tz,   1,0,0, 0,0,1,  2, 2,  1.60*br5, 0.04,  FR*0.058, hd+0.62)

    ลายวงซ้อน(tx, gy+10.8, tz,  0,1,0, 1,0,0,  1, 2, 0.26, 0.0,  FR*0.07, hd+0.59)
    ลายเกลียว(tx, gy+10.5, tz,  0,1,0, 1,0,0,  0.04, 0.24, 32,  FR*0.40, hd+0.60)

    # ── NODE 6: CROWN — Sahasrara (1000-fold cosmos, B4) — fastest pulse ──
    ผูก br6  = ไซน์(FR * 0.063 + 6.00) * 0.42 + 0.58
    ผูก n6y  = gy + 12.0
    ผูก m6a  = ไซน์(FR * 0.075 + 6.0) * 0.40 + 0.60
    ผูก n6ty = n6y + 0.80
    ลายดอกบัว(tx, n6y, tz,  1,0,0, 0,1,0,  0.24*br6, 0.80*br6, 1000,  FR, hd+0.72)
    vtex_hyperbolic_uv(tx, n6y, tz,  1,0,0, 0,1,0,  1.8*br6, 5,10,  FR*0.072, hd+0.72)
    vtex_hyperbolic_uv(tx, n6y, tz,  0,0,1, 0,1,0,  1.4*br6, 4, 8,  FR*0.063, hd+0.74)
    vtex_hyperbolic_uv(tx, n6y, tz,  1,0,0, 0,0,1,  1.2*br6, 3, 7,  FR*0.055, hd+0.76)
    ลายดาว(tx, n6y, tz,   1,0,0, 0,1,0,  8, 1.60*br6, 0.64*br6, 0.05,  FR*0.088, hd+0.70)
    ลายวงซ้อน(tx, n6y, tz,  1,0,0, 0,0,1,  5, 8,  2.20*br6, 0.04,  FR*0.080, hd+0.73)
    ลายดอกบัว(tx, n6ty, tz,  1,0,0, 0,1,0,  0.60*m6a, 1.20*m6a, 12,  FR*0.90, hd+0.78)
    vtex_hyperbolic_uv(tx, n6ty+0.8, tz,  1,0,0, 0,1,0,  0.90*m6a, 4, 8,  FR*0.10, hd+0.82)
}


# ════════════════════════════════════════════════════════════════════════════
# SOLAR SYSTEM MANDALA  — back wall
# Saturn–Mars–Venus—EARTH/LING—Jupiter–Neptune
# Venus (8-fold silver) ↔ Jupiter (12-fold gold) as mirror benefics
# Earth/Ling = the water-lens pineal — largest, most detailed, 3-layer moiré
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_solar_mandala(FR, hd) {
    ผูก wy = 0.0
    ผูก wz = FZ

    # ── Saturn (far left — root/time, 3-fold, cold grey-blue) ──
    ผูก sx   = 0-W*0.80
    ผูก hsat = sm2_hash(1.0, 1.0,  FR*0.0008, FR*0.0012)
    ผูก brs  = ไซน์(FR * 0.008 + 0.5) * 0.35 + 0.65
    ลายวงซ้อน(sx, wy, wz,  1,0,0, 0,1,0,  6, 3,  3.40*brs, 0.14,  FR*0.014, hd+5.5)
    vtex_hyperbolic_uv(sx, wy, wz,  1,0,0, 0,1,0,  (2.80 + hsat*0.42)*brs, 3,7,  FR*0.010, hd+5.2)
    ลายจักร(sx, wy, wz,  1,0,0, 0,1,0,  1.80*brs, 3,  FR*0.012, hd+5.0)

    # ── Mars (left-centre — solar plexus fire, 5-fold, orange-red) ──
    ผูก mx   = 0-W*0.42
    ผูก hmar = sm2_hash(3.0, 5.0,  FR*0.0015, FR*0.0022)
    ผูก brm  = ไซน์(FR * 0.015 + 1.5) * 0.35 + 0.65
    ลายดอกบัว(mx, wy, wz,  1,0,0, 0,1,0,  1.20*brm, 2.40*brm, 5,  FR*0.45, hd+0.22)
    vtex_hyperbolic_uv(mx, wy, wz,  1,0,0, 0,1,0,  (2.00 + hmar*0.40)*brm, 5,8,  FR*0.018, hd+0.25)
    ลายดาว(mx, wy, wz,    1,0,0, 0,1,0,  5, 2.00*brm, 0.80*brm, 0.04,  FR*0.025, hd+0.28)

    # ── Venus (center-left — beauty, 8-fold silver, sister of Jupiter) ──
    ผูก vx   = 0-W*0.18
    ผูก hven = sm2_hash(5.0, 8.0,  FR*0.0018, FR*0.0028)
    ผูก brv  = ไซน์(FR * 0.022 + 2.5) * 0.38 + 0.62
    ลายดอกบัว(vx, wy, wz,   1,0,0, 0,1,0,  0.44*brv, 1.60*brv, 8,  FR, hd+4.6)
    ลายวงซ้อน(vx, wy, wz,   1,0,0, 0,1,0,  5, 8,  2.80*brv, 0.08,  FR*0.030, hd+4.8)
    vtex_hyperbolic_uv(vx, wy, wz,  1,0,0, 0,1,0,  (2.40 + hven*0.44)*brv, 8,12,  FR*0.022, hd+4.4)
    ลายดอกบัว(vx, wy, wz,  1,0,0, 0,1,0,  1.00*brv, 2.00*brv, 8,  FR*0.55, hd+4.2)

    # ── EARTH / LING — water lens pineal (centre, 12-fold, blue-green, 3 planes) ──
    ผูก hear = sm2_hash(6.0, 6.0,  FR*0.0010, FR*0.0010)
    ผูก bre  = ไซน์(FR * 0.018 + 3.14) * 0.38 + 0.62
    ผูก brem = bre * (0.88 + hear*0.12)
    # Three hyperbolic layers — water-lens diffraction moiré
    vtex_hyperbolic_uv(0, wy, wz,  1,0,0, 0,1,0,  4.50*brem, 9,14,  FR*0.014, hd+1.8)
    vtex_hyperbolic_uv(0, wy, wz,  1,0,0, 0,1,0,  3.00*brem, 6,10,  FR*0.022, hd+3.6)
    vtex_hyperbolic_uv(0, wy, wz,  1,0,0, 0,1,0,  2.00*brem, 4, 8,  FR*0.030, hd+5.4)
    ลายดอกบัว(0, wy, wz,   1,0,0, 0,1,0,  0.55*bre, 2.00*bre, 12,  FR, hd+1.2)
    ลายวงซ้อน(0, wy, wz,   1,0,0, 0,1,0,  6, 12,  3.80*bre, 0.06,  FR*0.018, hd+0.9)
    ลายยันต์(0, wy, wz,  1,0,0, 0,1,0,  4, 5.00*brem,  FR*0.010, hd+2.5)
    # Pineal core dot (single-spoke chakra = the eye of Earth)
    ลายจักร(0, wy, wz,  1,0,0, 0,1,0,  0.42*bre, 1,  FR, hd+0.5)

    # ── Jupiter (center-right — expansion, 12-fold gold, brother of Venus) ──
    ผูก jx   = W*0.18
    ผูก hjup = sm2_hash(8.0, 5.0,  FR*0.0018, FR*0.0028)
    ผูก brj  = ไซน์(FR * 0.022 + 2.5 + 3.14159) * 0.38 + 0.62
    ลายดอกบัว(jx, wy, wz,   1,0,0, 0,1,0,  0.44*brj, 1.60*brj, 12,  FR, hd+0.8)
    ลายวงซ้อน(jx, wy, wz,   1,0,0, 0,1,0,  5, 12,  2.80*brj, 0.08,  FR*0.030, hd+1.0)
    vtex_hyperbolic_uv(jx, wy, wz,  1,0,0, 0,1,0,  (2.40 + hjup*0.44)*brj, 12,16,  FR*0.022, hd+0.6)
    ลายดอกบัว(jx, wy, wz,  1,0,0, 0,1,0,  2.00*brj, 12,  FR*0.55, hd+0.4)

    # ── Neptune (far right — cosmic mystery, 7-fold, deep indigo) ──
    ผูก npx  = W*0.80
    ผูก hnep = sm2_hash(9.0, 1.0,  FR*0.0008, FR*0.0012)
    ผูก brnp = ไซน์(FR * 0.010 + 5.0) * 0.35 + 0.65
    ลายวงซ้อน(npx, wy, wz,  1,0,0, 0,1,0,  4, 7,  3.20*brnp, 0.12,  FR*0.012, hd+4.0)
    vtex_hyperbolic_uv(npx, wy, wz,  1,0,0, 0,1,0,  (2.60 + hnep*0.42)*brnp, 7,11,  FR*0.008, hd+4.3)
    ลายดอกบัว(npx, wy, wz,  1,0,0, 0,1,0,  0.32*brnp, 1.10*brnp, 7,  FR, hd+4.6)
}


# ════════════════════════════════════════════════════════════════════════════
# BREATH PORTAL  — left wall
# Two lung spirals + nose/mouth portals + sinusoidal moiré background
# The sacred geometry of respiratory exchange made visible
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_breath_portal(FR, hd) {
    ผูก bwz = (NZ + FZ) / 2.0
    ผูก bx  = 0 - W

    # Breath rhythm: slow sinusoid, ~150-frame period
    ผูก breath = ไซน์(FR * 0.042) * 0.45 + 0.55
    ผูก antibreath = ไซน์(FR * 0.042 + 3.14159) * 0.45 + 0.55

    # Sinusoidal moiré background — the waveform of breath itself
    ผูก hb1 = sm2_hash(1.0, 7.0,  FR*0.0022, FR*0.0035)
    ผูก hb2 = sm2_hash(7.0, 1.0,  FR*0.0035, FR*0.0022)
    vtex_hyperbolic_uv(bx, 0.0, bwz,  0,0,1, 0,1,0,  6.0*breath, 6,10,  FR*0.042, hd+2.0)
    vtex_hyperbolic_uv(bx, 0.0, bwz,  0,0,1, 0,1,0,  5.0*(1.0 + hb1*0.15), 7,11,  FR*0.032, hd+2.8)
    vtex_hyperbolic_uv(bx, 0.0, bwz,  0,0,1, 0,1,0,  4.0*(0.90 + hb2*0.10), 5, 9,  FR*0.054, hd+1.5)

    # Left lung spiral (expands/contracts with breath)
    ผูก lly = 0 - H * 0.28
    ผูก llz = bwz - 2.2
    ลายเกลียว(bx, lly, llz,  0,0,1, 0,1,0,  0.30*breath, 2.40*breath, 24,  FR*0.30, hd+2.5)
    ลายวงซ้อน(bx, lly, llz,   0,0,1, 0,1,0,  3, 6,  2.20*breath, 0.10,  FR*0.042, hd+2.2)
    ลายดอกบัว(bx, lly, llz,   0,0,1, 0,1,0,  0.22*breath, 0.72*breath, 6,  FR, hd+2.8)

    # Right lung spiral (reciprocal phase — exhale while left inhales)
    ผูก rly = 0 - H * 0.28
    ผูก rlz = bwz + 2.2
    ลายเกลียว(bx, rly, rlz,  0,0,1, 0,1,0,  0.30*antibreath, 2.40*antibreath, 24,  FR*0.30, hd+2.5)
    ลายวงซ้อน(bx, rly, rlz,   0,0,1, 0,1,0,  3, 6,  2.20*antibreath, 0.10,  FR*0.042, hd+2.2)
    ลายดอกบัว(bx, rly, rlz,   0,0,1, 0,1,0,  0.22*antibreath, 0.72*antibreath, 6,  FR, hd+2.8)

    # Nose portal (9-petal lotus — fine nasal air at top)
    ลายดอกบัว(bx, H*0.55, bwz,  0,0,1, 0,1,0,  0.20, 0.62, 9,  FR*0.55, hd+1.2)
    ลายวงซ้อน(bx, H*0.55, bwz,  0,0,1, 0,1,0,  2, 9,  0.85, 0.05,  FR*0.055, hd+1.5)

    # Trachea — central vertical spiral (the air column)
    ลายเกลียว(bx, 0-H*0.08, bwz,  0,1,0, 0,0,1,  0.10, 0.42, 14,  FR*0.48, hd+1.8)

    # Mouth portal (12-fold flower — wider, stronger breath of speech and song)
    ลายดอกบัว(bx, 0-H*0.52, bwz,  0,0,1, 0,1,0,  0.70, 1.40, 12,  FR*0.40, hd+0.8)
    ลายวงซ้อน(bx, 0-H*0.52, bwz,   0,0,1, 0,1,0,  2, 12,  1.60, 0.06,  FR*0.038, hd+1.0)
    ลายจักร(bx, 0-H*0.52, bwz,  0,0,1, 0,1,0,  1.20, 12,  FR*0.045, hd+1.2)
}


# ════════════════════════════════════════════════════════════════════════════
# ENERGY PORTAL  — right wall
# Intake yantra (crown/mouth) → descending galaxy spiral → root earth return
# The digestive/metabolic energy cycle as sacred spiral geometry
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_energy_portal(FR, hd) {
    ผูก ewz = (NZ + FZ) / 2.0
    ผูก ex  = W

    # Background: SM2-hash metabolic energy field
    ผูก he1 = sm2_hash(2.0, 8.0,  FR*0.0025, FR*0.0038)
    ผูก he2 = sm2_hash(8.0, 2.0,  FR*0.0038, FR*0.0025)
    vtex_hyperbolic_uv(ex, 0.0, ewz,  0,0,1, 0,1,0,  5.5, 7,11,  FR*0.038, hd+0.8)
    vtex_hyperbolic_uv(ex, 0.0, ewz,  0,0,1, 0,1,0,  4.0*(0.88+he1*0.12), 8,12,  FR*0.028, hd+1.6)

    # Intake portal — yantra + star (sun-door: where energy enters)
    ลายยันต์(ex, H*0.65, ewz,  0,0,1, 0,1,0,  3, 2.80,  FR*0.018, hd+0.2)
    ลายดอกบัว(ex, H*0.65, ewz,   0,0,1, 0,1,0,  0.36, 1.20, 8,  FR, hd+0.5)
    ลายดาว(ex, H*0.65, ewz,    0,0,1, 0,1,0,  8, 1.60, 0.64, 0.04,  FR*0.038, hd+0.3)

    # Primary descending galaxy spiral (the stomach / first transformation)
    ผูก es1 = ไซน์(FR * 0.022 + 1.0) * 0.35 + 0.65
    ลายเกลียว(ex, H*0.15, ewz,  0,0,1, 0,1,0,  0.28*es1, 2.20*es1, 22,  FR*0.18, hd+0.9)

    # Sacral transformation (water-fire interface at mid-wall)
    ผูก swb = ไซน์(FR * 0.027 + 2.0) * 0.38 + 0.62
    ลายวงซ้อน(ex, 0-H*0.10, ewz,   0,0,1, 0,1,0,  4, 6,  2.40*swb, 0.08,  FR*0.030, hd+1.8)
    ลายดอกบัว(ex, 0-H*0.10, ewz,  0,0,1, 0,1,0,  1.00*swb, 2.00*swb, 6,  FR*0.55, hd+2.0)

    # Nested inner spirals — second brain / intestinal coils as galaxy arms
    ผูก es2 = ไซน์(FR * 0.031 + 3.0) * 0.35 + 0.65
    ลายเกลียว(ex, 0-H*0.22, ewz-1.5,  0,0,1, 0,1,0,  0.16, 1.20, 28,  FR*0.32, hd+1.5)
    ลายเกลียว(ex, 0-H*0.22, ewz+1.5,  0,0,1, 0,1,0,  0.14, 1.00, 24,  FR*0.38, hd+0.6)
    ลายเกลียว(ex, 0-H*0.35, ewz,  0,0,1, 0,1,0,  0.22*es2, 1.80*es2, 18,  FR*0.24, hd+1.2)

    # Root return portal — water/earth cycle completion at base (SFW: rain → river → ocean → cloud)
    ผูก rrb = ไซน์(FR * 0.015 + 4.0) * 0.35 + 0.65
    ลายจักร(ex, 0-H*0.68, ewz,  0,0,1, 0,1,0,  2.20*rrb, 4,  FR*0.022, hd+2.8)
    ลายยันต์(ex, 0-H*0.68, ewz,  0,0,1, 0,1,0,  3, 2.60*rrb,  FR*0.016, hd+3.0)
    vtex_hyperbolic_uv(ex, 0-H*0.68, ewz,  0,0,1, 0,1,0,  (1.80+he2*0.30)*rrb, 4, 8,  FR*0.018, hd+3.2)
}


# ════════════════════════════════════════════════════════════════════════════
# COSMIC CEILING  — Crown / Sahasrara / the stellar overflow
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_cosmic_ceiling(FR, hd) {
    ผูก cy = H
    ผูก cz = FZ * 0.48

    # Primary crown dome (three-layer depth)
    vtex_hyperbolic_uv(0, cy, cz,        1,0,0, 0,0,1,  12.0, 9,14,  FR*0.012, hd+5.5)
    vtex_hyperbolic_uv(0, cy, cz,        1,0,0, 0,0,1,   8.5, 6,10,  FR*0.018, hd+4.8)
    vtex_hyperbolic_uv(0, cy+1.0, cz+2.0, 1,0,0, 0,0,1,  6.0, 5, 8,  FR*0.024, hd+6.2)

    # Crown lotus (1000-petal Sahasrara)
    ลายดอกบัว(0, cy, cz,  1,0,0, 0,0,1,  0.60, 2.20, 1000,  FR, hd+6.0)
    ลายวงซ้อน(0, cy, cz,  1,0,0, 0,0,1,  5, 8,  4.20, 0.08,  FR*0.010, hd+5.8)

    # Star field — pentatonic constellations
    ลายดาว(0-5.2, cy+1.5, cz-2.0,  1,0,0, 0,0,1,  5, 0.90, 0.36, 0.025,  FR*0.42, hd+0.5)
    ลายดาว( 5.5,  cy+2.0, cz+1.8,  1,0,0, 0,0,1,  5, 0.70, 0.28, 0.030,  FR*0.38, hd+2.1)
    ลายดาว(0-3.0, cy+2.5, cz+3.0,  1,0,0, 0,0,1,  5, 0.55, 0.22, 0.035,  FR*0.48, hd+4.2)
    ลายดาว( 4.0,  cy+2.2, cz-3.5,  1,0,0, 0,0,1,  8, 0.45, 0.18, 0.040,  FR*0.52, hd+6.0)

    # Horizon bloom (crown-to-throat boundary glow)
    ลายดอกบัว(0, cy-1.2, FZ,  1,0,0, 0,0,1,  5.0, 10.0, 8,  FR*0.015, hd+4.5)
}


# ════════════════════════════════════════════════════════════════════════════
# AMBIENT WALLS  — back wall letter-rain for spatial depth
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ambient_walls(FR, hd) {
    ผูก ha1 = sm2_hash(4.0, 6.0,  FR*0.0030, FR*0.0020)
    ผูก ha2 = sm2_hash(6.0, 4.0,  FR*0.0020, FR*0.0030)
    vtex_letter_rain(0, 0, FZ,  1,0,0, 0,1,0,  28, 18,  0.64, 0.58,  0.012+ha1*0.006,  FR,        hd+1.0)
    vtex_letter_rain(0, 0, FZ,  1,0,0, 0,1,0,  28, 18,  0.64, 0.58,  0.018+ha2*0.006,  FR*0.62, hd+3.5)
}


# ════════════════════════════════════════════════════════════════════════════
# ECHO TRAILS  — anchor shapes from each zone, colour-offset ghost
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก gy  = 0 - H

    # Peyote ground moiré anchor
    ผูก pm = ไซน์(FR * 0.031) * 0.40 + 0.60
    vtex_hyperbolic_uv(0, gy, FZ*0.50,  1,0,0, 0,0,1,  9.0*pm, 7,11,  FR*0.031, hd)

    # Heart chakra (strongest spine node)
    ผูก br3e = ไซน์(FR * 0.022 + 3.00) * 0.42 + 0.58
    ผูก n3ye = gy + 6.0
    ลายดอกบัว(SX, n3ye, SZ,  1,0,0, 0,1,0,  0.32*br3e, 1.20*br3e, 12,  FR, hd)

    # Crown overflow anchor
    ผูก br6e = ไซน์(FR * 0.063 + 6.00) * 0.42 + 0.58
    ผูก n6ye = gy + 12.0
    ลายดาว(SX, n6ye, SZ,  1,0,0, 0,1,0,  5, 1.50*br6e, 0.60*br6e, 0.04,  FR*0.088, hd)

    # Earth/Ling water-lens anchor on back wall
    ผูก bree = ไซน์(FR * 0.018 + 3.14) * 0.38 + 0.62
    vtex_hyperbolic_uv(0, 0.0, FZ,  1,0,0, 0,1,0,  3.80*bree, 6,10,  FR*0.014, hd)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN — Floating Hyperspace Camera (always points to organism center)
# ════════════════════════════════════════════════════════════════════════════

ผูก สร้าง = ทำ {
    เปิดหน้าต่างเต็มจอ("PeyoteOrgan — The Higher-Dimensional Organism · Floating Vision")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.05)
    init_audio()

    ผูก 帧 = 0

    # Camera target — center of the organism (chakra spine root)
    ผูก target_x = 0.0
    ผูก target_y = 3.0      # Center of the spine
    ผูก target_z = 8.0      # Garden center

    # Floating orbit parameters (exaggerated hyperbolic)
    ผูก orbit_radius_horiz = 14.0      # Wide horizontal sweep
    ผูก orbit_radius_vert  = 7.0       # Extreme vertical range
    ผูก orbit_speed_horiz1 = 0.0007    # Primary horizontal drift
    ผูก orbit_speed_horiz2 = 0.0011    # Secondary harmonic
    ผูก orbit_speed_vert   = 0.0018    # Fast vertical figure-8
    ผูก roll_amplitude     = 0.15      # Camera roll (radians)
    ผูก roll_speed         = 0.0009
    ผูก spiral_intensity   = 1.8       # Hyperbolic spiral strength

    # Auto-cinematic mode — no manual controls
    # (Full autonomous floating experience)

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(1, 2, 8)

        ผูก hd = 帧 * 0.055

        # ── HYPERBOLIC FLOATING CAMERA PATH ────────────────────────────────
        # Multi-layered hyperbolic orbit for psychedelic effect
        
        ผูก t1 = 帧 * orbit_speed_horiz1
        ผูก t2 = 帧 * orbit_speed_horiz2
        ผูก t3 = 帧 * orbit_speed_vert
        
        # Hyperbolic XZ position: lemniscate + spiral harmonics
        ผูก cam_px = target_x + ไซน์(t1) * orbit_radius_horiz * 0.9
        ผูก cam_px = cam_px + ไซน์(t2 * 1.7) * orbit_radius_horiz * 0.4 * โคไซน์(t1 * 0.8)
        ผูก cam_pz = target_z + ไซน์(t1 * 1.3) * orbit_radius_horiz * 0.85
        ผูก cam_pz = cam_pz + โคไซน์(t2 * 2.1) * orbit_radius_horiz * 0.35
        
        # Vertical motion: figure-8 with hyperbolic amplitude
        ผูก cam_py = target_y + ไซน์(t3 * 1.5) * orbit_radius_vert * 0.7
        ผูก cam_py = cam_py + โคไซน์(t3 * 0.8) * 3.0
        ผูก cam_py = cam_py + ไซน์(帧 * 0.0004) * 1.2  # Slow drift
        
        # Hyperbolic spiral augmentation (creates infinity symbol in 3D)
        ผูก spiral_t = 帧 * 0.00045
        ผูก cam_px = cam_px + ไซน์(spiral_t * 2.3) * spiral_intensity
        ผูก cam_pz = cam_pz + โคไซน์(spiral_t * 1.9) * spiral_intensity
        ผูก cam_py = cam_py + ไซน์(spiral_t * 3.7) * 1.0
        
        # Extra dimension: hyperbolic tangent modulation for sudden swoops
        ผูก swoop = tanh(ไซน์(帧 * 0.00022) * 2.0)
        ผูก cam_px = cam_px + swoop * 2.5
        ผูก cam_py = cam_py + swoop * 1.8
        
        # ── LOOK-AT: Always point to organism center ───────────────────────
        # Compute direction from camera to target
        ผูก dx = target_x - cam_px
        ผูก dy = target_y - cam_py
        ผูก dz = target_z - cam_pz
        ผูก ความยาว = รากที่สอง(dx*dx + dy*dy + dz*dz)
        
        ถ้า ความยาว > 0.0001 {
            ผูก dx = dx / ความยาว
            ผูก dy = dy / ความยาว
            ผูก dz = dz / ความยาว
        }
        
        # Convert to yaw (ry) and pitch (rx)
        ผูก ry = atan2(dx, dz)           # Horizontal angle
        ผูก rx = asin(dy)                # Vertical angle
        
        # ── CINEMATIC ROLL (tilt) for psychedelic feel ─────────────────────
        # Roll creates the sensation of floating through higher dimensions
        ผูก roll_angle = ไซน์(帧 * roll_speed) * roll_amplitude
        ผูก roll_angle = roll_angle + ไซน์(帧 * 0.0014) * 0.05  # Secondary roll harmonic
        
        # ── SLOW MANUAL OVERRIDE DETECTION (optional) ──────────────────────
        # If user moves mouse or presses keys, briefly interrupt auto-camera
        # and then smoothly blend back to hyperbolic path
        
        ผูก mdx = mouse_dx()
        ผูก mdy = mouse_dy()
        ผูก any_input = 0
        
        ถ้า key_down("w")      { ผูก any_input = 1 }
        ถ้า key_down("s")      { ผูก any_input = 1 }
        ถ้า key_down("a")      { ผูก any_input = 1 }
        ถ้า key_down("d")      { ผูก any_input = 1 }
        ถ้า key_down("space")  { ผูก any_input = 1 }
        ถ้า key_down("lshift") { ผูก any_input = 1 }
        ถ้า key_down("left")   { ผูก any_input = 1 }
        ถ้า key_down("right")  { ผูก any_input = 1 }
        ถ้า key_down("up")     { ผูก any_input = 1 }
        ถ้า key_down("down")   { ผูก any_input = 1 }
        ถ้า mdx * mdx + mdy * mdy > 0.25 { ผูก any_input = 1 }
        
        # Static variables for smooth blending
        ผูก cam_manual = 0
        ผูก cam_ry_off = 0.0
        ผูก cam_rx_off = 0.0
        ผูก cam_px_offset = 0.0
        ผูก cam_py_offset = 0.0
        ผูก cam_pz_offset = 0.0
        ผูก blend_factor = 0.0
        
        # For simplicity in this example, we'll use pure auto-camera
        # To re-enable manual control, uncomment the blending logic from original
        
        # Set camera orientation (yaw + pitch)
        ตั้งกล้อง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))
        
        # Apply roll if supported by framework
        ถ้า roll_supported() {
            set_camera_roll(roll_angle)
        }
        
        # Set camera position
        ตั้งตำแหน่งกล้อง(cam_px, cam_py, cam_pz)
        
        # Dynamic zoom distance — pulses with the organism's breath
        ผูก breath_zoom = 2.0 + ไซน์(帧 * 0.008) * 0.3
        ตั้งระยะห่าง(breath_zoom)
        
        # Update audio listener orientation
        ผู้ฟัง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))
        
        # ── LIGHTS ─────────────────────────────────────────────────────────
        setup_lights(帧)
        
        # ── ECHO TRAILS ───────────────────────────────────────────────────
        # Enhanced with more trails for deeper psychedelic effect
        draw_echo(帧 - 12, hd + 1.8)
        draw_echo(帧 - 24, hd + 3.6)
        draw_echo(帧 - 36, hd + 5.4)
        draw_echo(帧 - 48, hd + 7.2)   # Extra echo layer
        draw_echo(帧 - 60, hd + 9.0)   # Deeper echo
        
        # ── FULL SCENE ─────────────────────────────────────────────────────
        draw_peyote_garden(帧, hd)
        draw_chakra_spine(帧, hd)
        draw_solar_mandala(帧, hd)
        draw_breath_portal(帧, hd)
        draw_energy_portal(帧, hd)
        draw_cosmic_ceiling(帧, hd)
        draw_ambient_walls(帧, hd)
        
        แสดงผล()
        ผูก 帧 = 帧 + 1
    }
}

# Helper function to check if roll is supported
ฟังก์ชัน roll_supported() {
    จริง
}

# Optional: Set camera roll if framework supports it
ฟังก์ชัน set_camera_roll(roll) {
    # Implementation depends on your rendering engine
    # Typical: set_camera_up(sin(roll), cos(roll), 0.0)
}

# Optional: Smooth blend function for returning to auto-camera
ฟังก์ชัน smooth_blend(current, target, factor) {
    current * (1.0 - factor) + target * factor
}