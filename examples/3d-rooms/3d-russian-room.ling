# ════════════════════════════════════════════════════════════════════════════
# 3d-russian-room.ling — Зал Жар-птицы  (Hall of the Firebird)
#
#  Written almost entirely in Russian: keywords (связать/функция/если/пока) and
#  every builtin with a Russian name in lexicons/ru.ling's runtime dispatch
#  table. NOTE: ru.ling's [builtins] section claims translations for a few
#  core 2-D functions (fill/present/open_fullscreen/window_is_open/set_color)
#  that the interpreter's runtime never actually wired up for Russian — a
#  real lexicon/runtime drift, verified directly against src/runtime/mod.rs
#  before writing this file. Those five fall back to English, exactly like
#  key_down and tanh do (no Russian alias exists for those anywhere either).
#
#  Winter Palace above an ice floor, Firebird below an aurora ceiling:
#
#    Floor    — a real 2-fluid sim (ling-physics liquid.rs) left in its
#                default frost-blue / firebird-amber colouring, swirling
#                under a slowly rotating gravity vector.
#    Ceiling  — the same fluid sim in full ROYGBIV rainbow mode — an aurora
#                borealis you're standing under, not looking up at.
#    Walls    — four, each a different Russian-folk-art motif: a snow-star
#                medallion, Khokhloma-style repeating florals, matryoshka
#                nested rings + a spiral, and a grand yantra medallion with
#                a slow, sparse letter-rain behind it (falling Cyrillic
#                "snow", not a fast Matrix effect).
#    Centre   — the Firebird itself: a flower/star/spiral pillar in molten
#                gold-and-ember hues, slowly turning.
#
#  Camera: Lissajous auto-tour; WASD + mouse-look takes over on input,
#  clamped so you can never fly through a wall, the floor, or the ceiling.
#
#  Run:   ling run examples/3d-rooms/3d-russian-room.ling
#  Quit:  Escape or close window
# ════════════════════════════════════════════════════════════════════════════

связать W = 16.0     # половина ширины  (half-width:  side walls at x = ±W)
связать D = 16.0     # половина глубины (half-depth:  front z=-D, back z=+D)
связать H = 7.5      # половина высоты  (half-height: floor y=-H, ceiling y=+H)


# ════════════════════════════════════════════════════════════════════════════
# ПОЛ И ПОТОЛОК — FLOOR & CEILING LIQUID
# ════════════════════════════════════════════════════════════════════════════

функция seed_liquid(id, GW) {
    связать sx = 0.0
    пока sx < GW {
        брызги_жидкости(id, sx, GW * 0.30 + синус(sx * 0.15) * 9.0,  1.0, 0.9, 3.5)
        брызги_жидкости(id, sx, GW * 0.70 + косинус(sx * 0.15) * 9.0, 0.0, 0.9, 3.5)
        связать sx = sx + 5.0
    }
}


# ════════════════════════════════════════════════════════════════════════════
# ЧЕТЫРЕ СТЕНЫ — FOUR WALLS, FOUR MOTIFS
# ════════════════════════════════════════════════════════════════════════════

функция draw_walls(FR) {
    # Передняя стена — снежная звезда-медальон
    узор_звезда(0, 0, 0 - D,  1,0,0,  0,1,0,  8, 6.5, 3.0, 0.012,  FR, 3.6)

    # Правая стена — хохломские повторяющиеся цветы
    узор_цветок(W, 0, 0,  0,0,1,  0,1,0,  2.6, 22,  FR, 0.6)
    узор_мозаика(W, 0, 0,  0,0,1,  0,1,0,  28, 12,  1.0, 0.25, 4.0,  FR, 0.9)

    # Левая стена — вложенные кольца матрёшки + спираль
    узор_кольца(0 - W, 0, 0,  0,0,-1,  0,1,0,  6, 9,  6.0, 0.18,  FR, 4.2)
    узор_спираль(0 - W, 0, 0,  0,0,-1,  0,1,0,  4.0, 6.0, 140,  FR, 4.9)

    # Задняя стена — большая янтра + медленный редкий дождь букв (снегопад)
    узор_янтра(0, 0, D,  1,0,0,  0,1,0,  6, 6.0,  FR, 1.4)
    узор_дождь_букв(0, 0, D,  1,0,0,  0,1,0,  12, 9,  1.2, 1.0,  0.007,  FR, 5.8)
}


# ════════════════════════════════════════════════════════════════════════════
# ЖАР-ПТИЦА В ЦЕНТРЕ — FIREBIRD CENTRE PILLAR
# ════════════════════════════════════════════════════════════════════════════

функция draw_centre(FR) {
    узор_цветок(0, 0 - 3.0, 0,  1,0,0,  0,0,1,  3.0, 18,  FR, 1.0)
    узор_звезда(0, 0, 0,        1,0,0,  0,0,1,  10, 4.2, 1.8, 0.02,  FR, 1.6)
    узор_спираль(0, 3.0, 0,    1,0,0,  0,0,1,  5.0, 3.8, 150,  FR, 2.1)
}


# ════════════════════════════════════════════════════════════════════════════
# ОСВЕЩЕНИЕ — LIGHTING (лёд / жар-птица / изумруд / аметист)
# ════════════════════════════════════════════════════════════════════════════

функция setup_lights(FR) {
    очистить_свет()
    добавить_свет(синус(FR * 0.008) * 9.0, 4.5, косинус(FR * 0.008) * 9.0,  1.0,0.55,0.15,  1.6, 18.0)   # жар-птица (пламя)
    добавить_свет(0 - 9.0, 3.0, 0,   0.35,0.65,1.0,  1.4, 15.0)                                            # ледяной свет
    добавить_свет(9.0, 3.0, 0,       0.15,0.85,0.55, 1.4, 15.0)                                            # изумруд
    добавить_свет(0, 0 - 5.0, 0,     0.65,0.20,0.85, 1.2, 13.0)                                            # аметист (снизу)
}


# ════════════════════════════════════════════════════════════════════════════
# НАЧАЛО — MAIN
# ════════════════════════════════════════════════════════════════════════════
связать начать = сделать {
    open_fullscreen("Зал Жар-птицы — Hall of the Firebird")
    захватить_мышь()
    задать_фон(0.05)

    связать GW = 64.0
    связать floor_liq = новая_жидкость(GW, GW)
    связать ceil_liq = новая_жидкость(GW, GW)
    seed_liquid(floor_liq, GW)
    seed_liquid(ceil_liq, GW)
    радуга_жидкости(ceil_liq, 1)   # потолок: полное сияние северного сияния

    связать FR = 0

    связать cam_px = 0.0
    связать cam_py = 0.0
    связать cam_pz = 0.0
    связать cam_zdist = 8.0
    связать cam_ry_off = 0.0
    связать cam_rx_off = 0.0
    связать cam_idle = 0
    связать cam_manual = 0
    связать cam_ry_snap = 0.0
    связать cam_rx_snap = 0.0

    связать max_x = W - 2.0   # границы для WASD — stay inside the walls
    связать max_z = D - 2.0
    связать max_y = H - 2.0

    пока window_is_open() {
        fill(2, 3, 10)   # почти чёрный морозный синий

        # ── Автотур по кривой Лиссажу ──────────────────────────────────────
        связать ry = синус(FR * 0.00190) * 0.46 + синус(FR * 0.00081) * 0.16
        связать rx = синус(FR * 0.00150) * 0.34 + синус(FR * 0.00070) * 0.14
        связать mdx = мышь_dx()
        связать mdy = мышь_dy()
        связать any_input = 0
        если key_down("w")      { связать any_input = 1 }
        если key_down("s")      { связать any_input = 1 }
        если key_down("a")      { связать any_input = 1 }
        если key_down("d")      { связать any_input = 1 }
        если key_down("space")  { связать any_input = 1 }
        если key_down("lshift") { связать any_input = 1 }
        если key_down("left")   { связать any_input = 1 }
        если key_down("right")  { связать any_input = 1 }
        если key_down("up")     { связать any_input = 1 }
        если key_down("down")   { связать any_input = 1 }
        если mdx * mdx + mdy * mdy > 0.25 { связать any_input = 1 }
        если any_input == 1 { связать cam_manual = 1; связать cam_idle = 0 }
        если cam_manual == 1 {
            связать cam_idle = cam_idle + 1
            если cam_idle > 300 { связать cam_manual = 0; связать cam_idle = 0 }
        }
        если cam_manual == 1 {
            связать cam_ry_off = cam_ry_off + mdx * 0.0022
            связать cam_rx_off = cam_rx_off + mdy * 0.0022
            если cam_rx_off > 1.5   { связать cam_rx_off = 1.5 }
            если cam_rx_off < 0-1.5 { связать cam_rx_off = 0-1.5 }
            если key_down("left")  { связать cam_ry_off = cam_ry_off - 0.020 }
            если key_down("right") { связать cam_ry_off = cam_ry_off + 0.020 }
            если key_down("up")    { связать cam_rx_off = cam_rx_off - 0.020 }
            если key_down("down")  { связать cam_rx_off = cam_rx_off + 0.020 }
            связать fwd_x = синус(cam_ry_snap + cam_ry_off)
            связать fwd_z = косинус(cam_ry_snap + cam_ry_off)
            связать rgt_x = косинус(cam_ry_snap + cam_ry_off)
            связать rgt_z = 0.0 - синус(cam_ry_snap + cam_ry_off)
            связать spd = 0.28
            если key_down("w") { связать cam_px = cam_px + fwd_x * spd; связать cam_pz = cam_pz + fwd_z * spd }
            если key_down("s") { связать cam_px = cam_px - fwd_x * spd; связать cam_pz = cam_pz - fwd_z * spd }
            если key_down("a") { связать cam_px = cam_px - rgt_x * spd; связать cam_pz = cam_pz - rgt_z * spd }
            если key_down("d") { связать cam_px = cam_px + rgt_x * spd; связать cam_pz = cam_pz + rgt_z * spd }
            если key_down("space")  { связать cam_py = cam_py + spd }
            если key_down("lshift") { связать cam_py = cam_py - spd }

            # оставаться в границах — clamp so WASD/fly can never cross a
            # wall, poke through the floor, or bump the ceiling.
            если cam_px > max_x   { связать cam_px = max_x }
            если cam_px < 0-max_x { связать cam_px = 0-max_x }
            если cam_pz > max_z   { связать cam_pz = max_z }
            если cam_pz < 0-max_z { связать cam_pz = 0-max_z }
            если cam_py > max_y   { связать cam_py = max_y }
            если cam_py < 0-max_y { связать cam_py = 0-max_y }
        }
        если cam_manual == 0 {
            связать cam_ry_snap = ry
            связать cam_rx_snap = rx
            связать cam_ry_off = cam_ry_off * 0.97
            связать cam_rx_off = cam_rx_off * 0.97
            связать cam_px = cam_px * 0.97
            связать cam_py = cam_py * 0.97
            связать cam_pz = cam_pz * 0.97
        }
        связать cry = косинус(cam_ry_snap + cam_ry_off)   связать sry = синус(cam_ry_snap + cam_ry_off)
        связать crx = косинус(cam_rx_snap + cam_rx_off)   связать srx = синус(cam_rx_snap + cam_rx_off)
        задать_камеру(cry, sry, crx, srx)
        задать_позицию_камеры(cam_px, cam_py, cam_pz)

        # дыхание масштаба — a gentle breathing zoom
        связать breathe = синус(FR * 0.006) * 2.4
        задать_дистанцию_z(cam_zdist + breathe)

        setup_lights(FR)

        # ── Течение жидкого льда и огня ────────────────────────────────────
        связать gt = FR * 0.010
        гравитация_жидкости(floor_liq, синус(gt) * 55.0, косинус(gt) * 55.0)
        гравитация_жидкости(ceil_liq, косинус(gt * 0.8) * 55.0, синус(gt * 0.8) * 55.0)
        шаг_жидкости(floor_liq, 0.016)
        шаг_жидкости(ceil_liq, 0.016)
        рисовать_поверхность_жидкости(floor_liq, 0, 0, 0 - H, 0,  12.0, 3.0)
        рисовать_поверхность_жидкости(ceil_liq, 0, 0, H, 0,  12.0, 3.0)

        draw_walls(FR)
        draw_centre(FR)

        present()
        связать FR = FR + 1
    }
}
