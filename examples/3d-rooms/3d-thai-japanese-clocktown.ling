# ════════════════════════════════════════════════════════════════════════════
# 3d-thai-japanese-clocktown.ling — ชุมทางนาฬิกา 時の交差路
#
#  Clock Town Market Square reimagined as Thai × Japanese fusion architecture.
#  Musical DNA sourced from Majora's Mask "Song of Time" / Clock Town theme
#  (no MIDI files in cwd — frequencies derived from the game's own D-minor
#  pentatonic and the iconic waltz pulse):
#
#    D3 = 146.83 Hz   F3 = 174.61 Hz   A3 = 220.00 Hz
#    C4 = 261.63 Hz   D4 = 293.66 Hz   E4 = 329.63 Hz
#
#  ARCHITECTURE — Thai × Japanese hybrid plaza:
#
#    Centre   — ชเดีย·五重塔 Chedi-Pagoda (Clock Tower analog):
#               Thai stupa lotus base + five ascending Japanese pagoda tiers.
#               Each tier keyed to one Song-of-Time note (D→F→A→C→D).
#               Naga tails (ナーガ) spiral from the base as sakura arms (桜吹雪).
#               Tomoe (巴) counter-rotation at mid-tower.
#
#    Floor    — กาลาแฮม Kalaham plaza: Thai stone-paved tessellation +
#               lotus-pool medallion (front) + Japanese ishigumi stone rings
#               (石組) encircling the tower base.
#
#    Ceiling  — Termina night sky: Majora's Moon (ominous 10-petal flower)
#               above the tower crown.  Sakura blizzard spirals + paper
#               lantern (ประทีป·提灯) lotus grid.
#
#    Front    — 鳥居·ประตู Torii·Pratu double-arch gateway: Japanese Torii
#               ring-pillars + Thai lotus-petal arch crown.
#
#    Back     — มณฑป Mondop octagonal shrine: yantra + 8-petal lotus +
#               two flanking dharma-wheel windows (法輪窓).
#
#    Left     — นาค Naga staircase wall: two counter-rotating naga serpent
#               spirals (ascending/descending) flanking a shoji moon window
#               (障子·月).  Thai script rain column.
#
#    Right    — กินนรี Kinnaree wall (half-bird/half-human ascending figure):
#               wing-star + crown-lotus.  Bishamonten guardian star (毘沙門天).
#               Japanese kanji rain column.
#
#  Colour: hd = FR * 0.040  — melancholy slow Clock Town hue drift
#  Camera: 3/4 waltz sway — period 300 frames (≈ 5 s @ 60 fps):
#           ry = sin(t · 0.00942) · 0.22
#           rx = sin(t · 0.00628) · 0.08
#  Echo:   Three waltz-triplet ghost passes at −72, −36, −18 frames.
#
#  Run:  ling run examples/3d-thai-japanese-clocktown.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

ผูก W  = 9.0     # half-width  (wide plaza)
ผูก H  = 5.0     # half-height (temple ceiling)
ผูก FZ = 18.0    # far wall
ผูก NZ = 1.5     # near wall
ผูก MZ = 9.75    # (NZ + FZ) / 2
ผูก TZ = 10.0    # tower / chedi centre z
ผูก TR = 1.20    # tomoe / naga radius


# ════════════════════════════════════════════════════════════════════════════
# ชเดีย·五重塔  CHEDI-PAGODA TOWER  (five Song-of-Time tiers)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_tower(FR, hd) {
    ผูก gy = 0 - H

    # Thai chedi lotus platform at ground
    ลายดอกบัว(0, gy + 0.5, TZ,  1,0,0,  0,0,1,  0.5, 1.8, 8,  FR, hd)
    ลายจักร(0, gy + 0.3, TZ,  1,0,0,  0,0,1,  2.2, 8,  FR * 0.012, hd + 0.3)
    ลายวงซ้อน(0, gy + 0.5, TZ,  1,0,0,  0,0,1,  3, 8,  2.6, 0.10,  FR * 0.018, hd + 0.1)

    # Tier 1 — D3 pace (slowest — stone foundation)
    ผูก t1 = FR * 0.22
    ลายวงซ้อน(0, gy + 1.6, TZ,  1,0,0,  0,0,1,  2, 40,  1.80, 0.0,  t1, hd)
    ลายดอก(0, gy + 1.6, TZ,  1,0,0,  0,0,1,  1.35, 8,  t1, hd + 1.2)

    # Tier 2 — F3
    ผูก t2 = FR * 0.36
    ลายวงซ้อน(0, gy + 3.1, TZ,  1,0,0,  0,0,1,  2, 40,  1.42, 0.0,  t2, hd + 0.8)
    ลายดอก(0, gy + 3.1, TZ,  1,0,0,  0,0,1,  1.06, 8,  t2, hd + 2.0)

    # Tier 3 — A3 (middle, water/breath pace)
    ผูก t3 = FR * 0.55
    ลายวงซ้อน(0, gy + 4.5, TZ,  1,0,0,  0,0,1,  2, 40,  1.08, 0.0,  t3, hd + 1.6)
    ลายดอกบัว(0, gy + 4.5, TZ,  1,0,0,  0,0,1,  0.30, 0.82, 5,  t3, hd + 2.5)

    # Tier 4 — C4
    ผูก t4 = FR * 0.75
    ลายวงซ้อน(0, gy + 5.7, TZ,  1,0,0,  0,0,1,  1, 40,  0.80, 0.0,  t4, hd + 2.4)
    ลายดาว(0, gy + 5.7, TZ,  1,0,0,  0,0,1,  5, 0.70, 0.28, 0.030,  t4, hd + 3.0)

    # Tier 5 — Crown / D4 (fastest — wind/flame)
    ผูก t5 = FR
    ลายวงซ้อน(0, gy + 6.8, TZ,  1,0,0,  0,0,1,  1, 40,  0.60, 0.0,  t5, hd + 3.2)
    ลายดอก(0, gy + 6.8, TZ,  1,0,0,  0,0,1,  0.50, 5,  t5, hd + 4.0)

    # Finial (相輪·bai sema) — flaming crown above tower
    ลายดาว(0, H - 0.5, TZ,  1,0,0,  0,0,1,  8, 1.10, 0.44, 0.035,  t5, hd + 0.5)
    ลายวงซ้อน(0, H - 0.5, TZ,  1,0,0,  0,0,1,  1, 40,  1.28, 0.0,  t5, hd + 0.7)

    # Tomoe (巴) counter-rotation at mid-tower — clockwise outer, anti-clockwise inner
    ผูก bob = ไซน์(FR * 0.014) * 0.20
    ลายวงซ้อน(0, bob + 2.0, TZ,  1,0,0,  0,0,1,  2, 48,  TR, 0.0,  FR, hd + 2.1)
    ลายวงซ้อน(0, bob + 2.0, TZ,  1,0,0,  0,0,1,  2, 48,  TR * 0.60, 0.0,  0 - FR, hd + 2.4)
    ลายดอก(0, bob + 2.0, TZ,  1,0,0,  0,0,1,  TR * 0.55, 5,  FR, hd + 3.5)

    # Naga tails (ナーガ·桜吹雪) — four sakura spiral arms at the base
    ลายเกลียว(0 - 2.4, gy + 0.8, TZ - 1.6,  1,0,0,  0,0,1,  1.8, 1.6, 56,  t2, hd + 0.4)
    ลายเกลียว( 2.4, gy + 0.8, TZ - 1.6,     1,0,0,  0,0,1,  1.8, 1.6, 56,  t2, hd + 3.1)
    ลายเกลียว(0 - 2.2, gy + 0.8, TZ + 2.0,  1,0,0,  0,0,1,  1.6, 1.4, 48,  t2, hd + 1.5)
    ลายเกลียว( 2.2, gy + 0.8, TZ + 2.0,     1,0,0,  0,0,1,  1.6, 1.4, 48,  t2, hd + 4.7)
}


# ════════════════════════════════════════════════════════════════════════════
# พื้น  FLOOR — Kalaham plaza + lotus pool + ishigumi (石組)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_floor(FR, hd) {
    ผูก cy    = 0 - H
    ผูก fmid  = MZ
    ผูก slow  = FR * 0.20

    # Thai kalaham stone paving
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  22, 18,  0.68, 0.14, 4.5,  FR, hd + 2.0)
    ลายตาราง(0, cy, fmid,  1,0,0,  0,0,1,  28, 22,  0.72, 0.72,  FR, hd + 3.8)

    # Thai lotus pool (front of plaza — koi pond)
    ผูก pz = TZ * 0.50
    ลายวงซ้อน(0, cy, pz,  1,0,0,  0,0,1,  4, 48,  3.5, 0.0,  slow, hd)
    ลายดอกบัว(0, cy, pz,  1,0,0,  0,0,1,  0.4, 2.2, 8,  FR, hd + 1.0)
    ลายดอก(0, cy, pz,  1,0,0,  0,0,1,  1.8, 8,  FR * 0.45, hd + 1.5)

    # Japanese ishigumi (石組) concentric stones under the tower
    ลายวงซ้อน(0, cy, TZ,  1,0,0,  0,0,1,  5, 48,  5.0, 0.0,  slow, hd + 0.5)
    ลายจักร(0, cy, TZ,  1,0,0,  0,0,1,  3.2, 4,  slow, hd + 0.8)
}


# ════════════════════════════════════════════════════════════════════════════
# เพดาน  CEILING — Termina night sky · Majora's Moon · sakura blizzard · lanterns
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ceiling(FR, hd) {
    ผูก cy   = H
    ผูก fmid = MZ
    ผูก slow = FR * 0.20

    # Termina star field — hyperbolic night sky
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  7.5, 14, 16,  FR, hd + 1.8)
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  2, 48,  7.0, 0.0,  slow, hd + 4.2)

    # Majora's Moon — ominous 10-fold dark flower descending toward the tower
    ผูก mz = TZ * 0.80
    ลายดอก(0, cy, mz,  1,0,0,  0,0,1,  4.2, 10,  slow, hd)
    ลายวงซ้อน(0, cy, mz,   1,0,0,  0,0,1,  1, 48,  4.8, 0.0,  slow, hd + 0.4)
    ลายวงซ้อน(0, cy, mz,   1,0,0,  0,0,1,  1, 48,  4.0, 0.0,  slow, hd + 0.7)

    # Paper lanterns (ประทีป·提灯) — two rows
    ผูก ly = cy - 0.5
    ลายดอกบัว(0 - 4.5, ly, fmid - 2.0,  1,0,0,  0,0,1,  0.22, 0.72, 6,  FR * 0.55, hd + 2.0)
    ลายดอกบัว( 4.5, ly, fmid - 2.0,     1,0,0,  0,0,1,  0.22, 0.72, 6,  FR * 0.55, hd + 2.0)
    ลายดอกบัว(0 - 4.5, ly, fmid + 2.0,  1,0,0,  0,0,1,  0.22, 0.72, 6,  FR * 0.55, hd + 4.2)
    ลายดอกบัว( 4.5, ly, fmid + 2.0,     1,0,0,  0,0,1,  0.22, 0.72, 6,  FR * 0.55, hd + 4.2)

    # Sakura blizzard (桜吹雪) — ceiling spirals
    ลายเกลียว(0 - 5.0, ly, fmid,  1,0,0,  0,0,1,  2.2, 2.0, 56,  FR * 0.55, hd + 0.6)
    ลายเกลียว( 5.0, ly, fmid,     1,0,0,  0,0,1,  2.2, 2.0, 56,  FR * 0.55, hd + 3.6)
}


# ════════════════════════════════════════════════════════════════════════════
# หน้า  FRONT WALL — 鳥居·ประตู  Torii · Thai Pratu double-arch gateway
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_front_wall(FR, hd) {
    ผูก slow = FR * 0.20

    # Ambient glyph rain (Thai/Japanese mixed)
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  20, 12,  0.65, 0.60,  0.014,  FR, hd + 2.0)

    # Torii pillars — ring circles at left and right
    ลายวงซ้อน(0 - 3.0, 0, NZ,  0,0,1,  0,1,0,  1, 40,  1.15, 0.0,  slow, hd)
    ลายวงซ้อน( 3.0, 0, NZ,     0,0,1,  0,1,0,  1, 40,  1.15, 0.0,  slow, hd + 0.3)

    # Torii crossbeam (horizontal ring arc at top)
    ลายวงซ้อน(0, H * 0.58, NZ,  1,0,0,  0,1,0,  1, 48,  3.5, 0.0,  slow, hd + 0.5)

    # Thai lotus arch crown above the Torii
    ลายดอกบัว(0, H * 0.70, NZ,  1,0,0,  0,1,0,  0.38, 1.15, 8,  FR, hd + 1.0)
    ลายดอก(0, H * 0.70, NZ,  1,0,0,  0,1,0,  1.6, 8,  FR * 0.40, hd + 1.5)

    # Kinnaree guardian flanks (small star medallions beside pillars)
    ลายดาว(0 - 5.5, 0, NZ,  1,0,0,  0,1,0,  6, 0.80, 0.32, 0.025,  slow, hd + 2.5)
    ลายดาว( 5.5, 0, NZ,     1,0,0,  0,1,0,  6, 0.80, 0.32, 0.025,  slow, hd + 2.8)
}


# ════════════════════════════════════════════════════════════════════════════
# หลัง  BACK WALL — มณฑป Mondop shrine · dharma wheel windows (法輪窓)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_back_wall(FR, hd) {
    ผูก slow = FR * 0.20

    # Thai/Japanese script rain
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  26, 15,  0.62, 0.55,  0.013,  FR, hd + 2.2)

    # Mondop central shrine — octagonal yantra + lotus + flower
    ลายยันต์(0, 0, FZ,  1,0,0,  0,1,0,  4, 5.8,  slow, hd)
    ลายดอกบัว(0, 0, FZ,   1,0,0,  0,1,0,  0.55, 2.2, 8,  FR, hd + 1.2)
    ลายดอก(0, 0, FZ,  1,0,0,  0,1,0,  3.0, 8,  FR * 0.35, hd + 0.8)
    ลายวงซ้อน(0, 0, FZ,   1,0,0,  0,1,0,  3, 48,  5.2, 0.0,  slow, hd + 0.3)

    # Left dharma window
    ลายจักร(0 - W * 0.62, 0, FZ,  1,0,0,  0,1,0,  2.2, 8,  slow, hd + 3.5)
    ลายวงซ้อน(0 - W * 0.62, 0, FZ,   1,0,0,  0,1,0,  2, 48,  2.8, 0.0,  slow, hd + 3.2)
    ลายดอก(0 - W * 0.62, 0, FZ,  1,0,0,  0,1,0,  1.6, 8,  FR * 0.30, hd + 4.0)

    # Right dharma window
    ลายจักร(W * 0.62, 0, FZ,  1,0,0,  0,1,0,  2.2, 8,  slow, hd + 1.8)
    ลายวงซ้อน( W * 0.62, 0, FZ,  1,0,0,  0,1,0,  2, 48,  2.8, 0.0,  slow, hd + 1.5)
    ลายดอก(W * 0.62, 0, FZ,  1,0,0,  0,1,0,  1.6, 8,  FR * 0.30, hd + 2.2)
}


# ════════════════════════════════════════════════════════════════════════════
# ซ้าย  LEFT WALL — นาค Naga staircase · shoji moon window (障子·月)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_left_wall(FR, hd) {
    ผูก cx   = 0 - W
    ผูก fmid = MZ
    ผูก slow = FR * 0.20

    # Thai script glyph rain
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  16, 10,  0.70, 0.62,  0.011,  FR, hd + 3.5)

    # Left naga: ascending spiral (counter-clockwise from root)
    ลายเกลียว(cx, 0 - H * 0.55, fmid - 2.8,  0,0,1,  0,1,0,  0.28, 2.60, 48,  FR * 0.30, hd + 2.0)
    ลายวงซ้อน(cx, 0 - H * 0.55, fmid - 2.8,   0,0,1,  0,1,0,  2, 7,  2.30, 0.10,  slow, hd + 2.2)
    ลายดอก(cx, H * 0.42, fmid - 2.8,       0,0,1,  0,1,0,  1.45, 7,  FR * 0.50, hd + 1.8)

    # Right naga: mirror descending (clockwise)
    ลายเกลียว(cx, 0 - H * 0.55, fmid + 2.8,  0,0,1,  0,1,0,  0.28, 2.60, 48,  0 - FR * 0.30, hd + 1.0)
    ลายวงซ้อน(cx, 0 - H * 0.55, fmid + 2.8,   0,0,1,  0,1,0,  2, 7,  2.30, 0.10,  slow, hd + 1.2)
    ลายดอก(cx, H * 0.42, fmid + 2.8,       0,0,1,  0,1,0,  1.45, 7,  FR * 0.50, hd + 3.8)

    # Shoji moon window centre (障子·月) — two concentric Enso rings + inner lotus
    ลายวงซ้อน(cx, 0, fmid,  0,0,1,  0,1,0,  1, 48,  3.2, 0.0,  slow, hd + 0.4)
    ลายวงซ้อน(cx, 0, fmid,  0,0,1,  0,1,0,  1, 48,  2.5, 0.0,  slow, hd + 0.7)
    ลายดอก(cx, 0, fmid,  0,0,1,  0,1,0,  1.6, 8,  FR * 0.28, hd + 1.0)
}


# ════════════════════════════════════════════════════════════════════════════
# ขวา  RIGHT WALL — กินนรี Kinnaree · Bishamonten guardian (毘沙門天)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_right_wall(FR, hd) {
    ผูก cx   = W
    ผูก fmid = MZ
    ผูก slow = FR * 0.20

    # Japanese kanji rain
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  16, 10,  0.70, 0.62,  0.011,  FR, hd + 1.8)

    # Kinnaree body — ascending lotus + paired wing spirals
    ลายดอกบัว(cx, 0 - H * 0.42, fmid,  0,0,1,  0,1,0,  0.32, 1.25, 12,  FR, hd + 0.5)
    ลายเกลียว(cx, 0 - H * 0.15, fmid - 2.0,  0,0,1,  0,1,0,  0.22, 1.85, 36,  FR * 0.35, hd + 1.5)
    ลายเกลียว(cx, 0 - H * 0.15, fmid + 2.0,  0,0,1,  0,1,0,  0.22, 1.85, 36,  0 - FR * 0.35, hd + 0.8)

    # Kinnaree wings — 8-pointed star
    ลายดาว(cx, H * 0.30, fmid,  0,0,1,  0,1,0,  8, 1.85, 0.74, 0.040,  FR * 0.55, hd + 0.3)

    # Kinnaree crown — 12-petal flower (Thai crown / Japanese kan)
    ลายดอก(cx, H * 0.58, fmid,  0,0,1,  0,1,0,  1.25, 12,  FR * 0.70, hd + 0.9)

    # Bishamonten (毘沙門天) — martial guardian star in the rear alcove
    ลายดาว(cx, 0, fmid + 3.8,  0,0,1,  0,1,0,  6, 1.65, 0.66, 0.040,  slow, hd + 2.8)
    ลายยันต์(cx, 0, fmid + 3.8,  0,0,1,  0,1,0,  3, 2.60,  slow, hd + 2.5)
}


# ════════════════════════════════════════════════════════════════════════════
# เงา  ECHO PASS — waltz-triplet ghost (structural anchors only)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก cy_f = 0 - H
    ผูก cy_c = H
    ผูก slow = FR * 0.20

    # Floor: lotus pool + ishigumi
    ลายวงซ้อน(0, cy_f, TZ * 0.50,  1,0,0,  0,0,1,  4, 48,  3.5, 0.0,  slow, hd)
    ลายวงซ้อน(0, cy_f, TZ,          1,0,0,  0,0,1,  5, 48,  5.0, 0.0,  slow, hd + 0.5)

    # Ceiling: Moon + sky ring
    ลายดอก(0, cy_c, TZ * 0.80,  1,0,0,  0,0,1,  4.2, 10,  slow, hd)
    ลายวงซ้อน(0, cy_c, MZ,           1,0,0,  0,0,1,  2, 48,  7.0, 0.0,  slow, hd + 4.2)

    # Mondop yantra portal
    ลายยันต์(0, 0, FZ,  1,0,0,  0,1,0,  4, 5.8,  slow, hd)
    ลายวงซ้อน(0, 0, FZ,   1,0,0,  0,1,0,  3, 48,  5.2, 0.0,  slow, hd + 0.3)

    # Tower: tier 1 + tier 3 + finial (sparse)
    ผูก gy = 0 - H
    ลายวงซ้อน(0, gy + 1.6, TZ,  1,0,0,  0,0,1,  2, 40,  1.80, 0.0,  FR * 0.22, hd)
    ลายวงซ้อน(0, gy + 4.5, TZ,  1,0,0,  0,0,1,  2, 40,  1.08, 0.0,  FR * 0.55, hd + 1.6)
    ลายดาว(0, H - 0.5, TZ,    1,0,0,  0,0,1,  8, 1.10, 0.44, 0.035,  FR, hd + 0.5)
}


# ════════════════════════════════════════════════════════════════════════════
# แสงสว่าง  LIGHTS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()

    # Chedi crown flame — warm gold orbiting above tower apex
    ผูก tc = FR * 0.0058
    เพิ่มแสง(
        ไซน์(tc) * 1.8,  H + 0.5,  TZ + โคไซน์(tc) * 1.2,
        1.0, 0.82, 0.42,   3.8, 15.0
    )

    # Majora's Moon — cold amber-green from above (ominous dusk)
    ผูก tm = FR * 0.0030
    เพิ่มแสง(
        ไซน์(tm * 0.7) * 3.5,  H * 0.88,  TZ * 0.80 + โคไซน์(tm) * 1.5,
        0.55, 0.72, 0.28,   2.5, 16.0
    )

    # Left lantern — Thai rose-gold glow
    ผูก tl = FR * 0.0042
    เพิ่มแสง(
        0 - W * 0.55 + ไซน์(tl) * 0.5,
        H * 0.55 + ไซน์(tl + 1.0) * 0.4,
        MZ + โคไซน์(tl) * 1.0,
        0.92, 0.48, 0.22,   1.8, 9.0
    )

    # Right Kinnaree — cool silver-blue (matches Venus in other rooms)
    ผูก tk = tl + 3.14159
    เพิ่มแสง(
        W * 0.55 + ไซน์(tk) * 0.5,
        H * 0.45 + ไซน์(tk + 1.0) * 0.4,
        MZ + โคไซน์(tk) * 1.0,
        0.42, 0.64, 0.96,   1.6, 9.0
    )

    # Lotus pool aqua shimmer
    ผูก tp = FR * 0.055
    เพิ่มแสง(
        ไซน์(tp) * 1.5,  0 - H - 0.5,  TZ * 0.50 + โคไซน์(tp) * 0.8,
        0.20, 0.70, 0.62,   1.4, 6.5
    )

    # Torii vermilion accent — front gate
    ผูก tt = FR * 0.0035
    เพิ่มแสง(
        ไซน์(tt) * 2.0,  0.0,  NZ + 0.5,
        0.84, 0.14, 0.06,   1.0, 7.5
    )
}


# ════════════════════════════════════════════════════════════════════════════
# เสียง  AUDIO — Song of Time D-minor pentatonic (Majora's Mask)
#
#  Notes:  D3=146.83  F3=174.61  A3=220.00  C4=261.63  D4=293.66  E4=329.63
#  LFO pacing: waltz triplet — slow (D3) → medium (A3) → fast (D4/E4)
#  Spatial layout mirrors the room architecture.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot   x       y       z      w     freq    amp   lfo_hz  depth
    เสียงโทน(0,  0,    0 - H,   TZ,   3.5,  146.83, 0.12, 0.08, 0.006) # D3  chedi base
    เสียงโทน(1,  0,    0 - H,   FZ,   2.5,  174.61, 0.10, 0.15, 0.010) # F3  mondop
    เสียงโทน(2,  0-W,  0,       MZ,   2.0,  220.00, 0.09, 0.22, 0.012) # A3  naga left
    เสียงโทน(3,  W,    0,       MZ,   2.0,  220.00, 0.09, 0.22, 0.012) # A3  kinnaree right
    เสียงโทน(4,  0,    H,       TZ,   0.8,  261.63, 0.07, 0.28, 0.014) # C4  Moon
    เสียงโทน(5,  0,    0,       NZ,   1.5,  293.66, 0.08, 0.20, 0.014) # D4  torii
    เสียงโทน(6,  0-3.8, 0.5,   TZ - 2.0, 3.0, 329.63, 0.05, 0.38, 0.018) # E4 naga L
    เสียงโทน(7,  3.8, 0.5,     TZ - 2.0, 3.0, 349.23, 0.05, 0.42, 0.020) # F4 naga R
    ระดับเสียง(0.52)
}


# ════════════════════════════════════════════════════════════════════════════
# เริ่ม  MAIN — 3/4 waltz sway camera (Clock Town rhythm)
#
#  Waltz period = 300 frames (≈ 5 s @ 60 fps):
#    ry = sin(t × 2π/300) × 0.22  =  sin(t × 0.00942) × 0.22
#    rx = sin(t × 2π/450) × 0.08  =  sin(t × 0.00628) × 0.08
#  Two-thirds phase difference captures the yoke-and-sway of a waltz step.
# ════════════════════════════════════════════════════════════════════════════

ผูก start = ทำ {
    เปิดหน้าต่างเต็มจอ("ชุมทางนาฬิกา 時の交差路 — Thai-Japanese Clock Town")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.05)    # approaching midnight (Majora's Moon descending)

    init_audio()

    ผูก 齣 = 0

    ผูก cam_px    = 0.0
    ผูก cam_py    = 0.0
    ผูก cam_pz    = 0.0
    ผูก cam_zdist = 2.2
    ผูก cam_ry_off = 0.0
    ผูก cam_rx_off = 0.0
    ผูก cam_idle   = 0
    ผูก cam_manual = 0
    ผูก cam_ry_snap = 0.0
    ผูก cam_rx_snap = 0.0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(0, 0, 0)    # Termina midnight black

        ผูก hd = 齣 * 0.040    # hue driver — melancholy Clock Town pace

        # ── Waltz sway camera ──────────────────────────────────────────────
        ผูก ry = ไซน์(齣 * 0.00942) * 0.22
        ผูก rx = ไซน์(齣 * 0.00628) * 0.08

        ผูก mdx = mouse_dx()
        ผูก mdy = mouse_dy()
        ผูก any_input = 0
        ถ้า key_down("w")      { ผูก any_input = 1 }
        ถ้า key_down("s")      { ผูก any_input = 1 }
        ถ้า key_down("a")      { ผูก any_input = 1 }
        ถ้า key_down("d")      { ผูก any_input = 1 }
        ถ้า key_down("space")  { ผูก any_input = 1 }
        ถ้า key_down("lshift") { ผูก any_input = 1 }
        ถ้า key_down("left")   { ผูก any_input = 1 }
        ถ้า key_down("right")  { ผูก any_input = 1 }
        ถ้า key_down("up")     { ผูก any_input = 1 }
        ถ้า key_down("down")   { ผูก any_input = 1 }
        ถ้า mdx * mdx + mdy * mdy > 0.25 { ผูก any_input = 1 }
        ถ้า any_input == 1 { ผูก cam_manual = 1; ผูก cam_idle = 0 }
        ถ้า cam_manual == 1 {
            ผูก cam_idle = cam_idle + 1
            ถ้า cam_idle > 300 { ผูก cam_manual = 0; ผูก cam_idle = 0 }
        }
        ถ้า cam_manual == 1 {
            ผูก cam_ry_off = cam_ry_off + mdx * 0.0022
            ผูก cam_rx_off = cam_rx_off + mdy * 0.0022
            ถ้า cam_rx_off >  3.14159 { ผูก cam_rx_off =  3.14159 }
            ถ้า cam_rx_off < -3.14159 { ผูก cam_rx_off = -3.14159 }
            ถ้า key_down("left")  { ผูก cam_ry_off = cam_ry_off - 0.018 }
            ถ้า key_down("right") { ผูก cam_ry_off = cam_ry_off + 0.018 }
            ถ้า key_down("up")    { ผูก cam_rx_off = cam_rx_off - 0.018 }
            ถ้า key_down("down")  { ผูก cam_rx_off = cam_rx_off + 0.018 }
            ผูก fwd_x = ไซน์(cam_ry_snap + cam_ry_off)
            ผูก fwd_z = โคไซน์(cam_ry_snap + cam_ry_off)
            ผูก rgt_x = โคไซน์(cam_ry_snap + cam_ry_off)
            ผูก rgt_z = 0.0 - ไซน์(cam_ry_snap + cam_ry_off)
            ผูก spd = 0.12
            ถ้า key_down("w") { ผูก cam_px = cam_px + fwd_x * spd; ผูก cam_pz = cam_pz + fwd_z * spd }
            ถ้า key_down("s") { ผูก cam_px = cam_px - fwd_x * spd; ผูก cam_pz = cam_pz - fwd_z * spd }
            ถ้า key_down("a") { ผูก cam_px = cam_px - rgt_x * spd; ผูก cam_pz = cam_pz - rgt_z * spd }
            ถ้า key_down("d") { ผูก cam_px = cam_px + rgt_x * spd; ผูก cam_pz = cam_pz + rgt_z * spd }
            ถ้า key_down("space")  { ผูก cam_py = cam_py + spd }
            ถ้า key_down("lshift") { ผูก cam_py = cam_py - spd }
            ถ้า key_pressed("numpad+") { ผูก cam_zdist = cam_zdist + 0.5 }
            ถ้า key_pressed("numpad-") { ผูก cam_zdist = cam_zdist - 0.5; ถ้า cam_zdist < 0.5 { ผูก cam_zdist = 0.5 } }
        }
        ถ้า cam_manual == 0 {
            ผูก cam_ry_snap = ry
            ผูก cam_rx_snap = rx
            ผูก cam_ry_off  = cam_ry_off * 0.97
            ผูก cam_rx_off  = cam_rx_off * 0.97
            ผูก cam_px      = cam_px * 0.97
            ผูก cam_py      = cam_py * 0.97
            ผูก cam_pz      = cam_pz * 0.97
        }
        ผูก cry = โคไซน์(cam_ry_snap + cam_ry_off)   ผูก sry = ไซน์(cam_ry_snap + cam_ry_off)
        ผูก crx = โคไซน์(cam_rx_snap + cam_rx_off)   ผูก srx = ไซน์(cam_rx_snap + cam_rx_off)
        ตั้งกล้อง(cry, sry, crx, srx)
        ตั้งตำแหน่งกล้อง(cam_px, cam_py, cam_pz)
        ตั้งระยะห่าง(cam_zdist)
        ผู้ฟัง(cry, sry, crx, srx)

        setup_lights(齣)

        # ── Waltz-triplet echo passes (−72 / −36 / −18 frames) ───────────
        draw_echo(齣 - 72, 2.4)
        draw_echo(齣 - 36, 1.2)
        draw_echo(齣 - 18, 0.6)

        # ── Full scene ─────────────────────────────────────────────────────
        draw_floor(齣, hd)
        draw_ceiling(齣, hd)
        draw_front_wall(齣, hd)
        draw_back_wall(齣, hd)
        draw_left_wall(齣, hd)
        draw_right_wall(齣, hd)
        draw_tower(齣, hd)

        แสดงผล()
        ผูก 齣 = 齣 + 1
    }
}
