# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HOLOGRAPHIC  —  4-D all-or-nothing transform (Rivest package transform)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# The secret is scattered into shards living on a 4-D sphere. EVERY shard is
# required — lose one and nothing is recoverable. Each orb is a shard; the 4th
# dimension (w) drives its hue. Colour theme: VIOLET → PINK.

bind start = do {
    open_window(900, 720)

    bind secret = "all-or-nothing holographic payload — every shard required — meet beneath the hyperbolic vault at the third chime of dusk"
    bind pts = holo_points(secret)      # flat [a,b,c,d, a,b,c,d, ...]
    bind n = len(pts) / 4.0

    while window_is_open() {
        set_color(8, 6, 14)
        fill()
        set_blend(1)

        bind t = time_now()
        bind a = t * 0.5
        bind ca = cos(a)
        bind sa = sin(a)
        bind cx = 450.0
        bind cy = 360.0
        bind scale = 230.0

        bind i = 0.0
        while i < n {
            bind k = i * 4.0
            bind x = pts[k]
            bind y = pts[k + 1.0]
            bind z = pts[k + 2.0]
            bind w = pts[k + 3.0]

            # rotate the (z,w) plane through time, then project 4-D → 3-D → 2-D
            bind zr = z * ca - w * sa
            bind wr = z * sa + w * ca
            bind xr = x * ca - zr * sa
            bind zz = x * sa + zr * ca
            bind f = 3.0 / (3.0 + zz + 1.5)
            bind sx = cx + xr * scale * f
            bind sy = cy - y * scale * f

            # hue from the 4th dimension (w): violet → pink
            bind hue = wr * 0.5 + 0.5
            bind r = 150.0 + hue * 105.0
            bind g = 40.0 + hue * 60.0
            bind b = 200.0 + (1.0 - hue) * 55.0
            bind rad = 6.0 + (f * 10.0)
            set_color(r, g, b)
            draw_disc(sx, sy, rad)

            bind i = i + 1.0
        }

        set_blend(0)
        present()
    }
}
