# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CRYPTO DONUT  —  hash a string into a torus, then drop it in a box
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Your INPUT string is SHA3-256 hashed into a (p,q) torus knot (the geo crypto
# module). The knot's inner/outer radius set the donut's hole and fatness; the
# hash bytes also pick its bounciness, spin and colour. Then gravity drops it
# into a big box and it tumbles & bounces — every string makes a different donut
# that bounces differently.
#
#   ✏  change `seed` below to make a new donut
#   ␣  SPACE = re-drop      R = re-roll velocity
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind seed = "灵 · ling · my cryptographic donut"

bind BOX     = 6.0          # half-size of the container
bind DONUT_R = 1.7          # outer radius of the donut
bind GRAVITY = 15.0
bind DT      = 0.016
bind DAMP    = 0.996

bind start = do {
    open_window(1000, 760)
    set_ambient(0.18)

    # ── Derive the donut's SHAPE from the knot fingerprint of the input ──
    bind pts = knot_points(seed)
    bind n = len(pts) / 3.0

    bind maxRad = 0.0
    bind minRad = 9999.0
    bind i = 0.0
    while i < n {
        bind k = i * 3.0
        bind x = pts[k]
        bind z = pts[k + 2.0]
        bind rad = sqrt(x * x + z * z)
        if rad > maxRad { bind maxRad = rad }
        if rad < minRad { bind minRad = rad }
        bind i = i + 1.0
    }
    # torus tube fraction so inner/outer matches the knot's inner/outer
    bind ratio = minRad / maxRad
    bind tube = (1.0 - ratio) / 2.0
    if tube < 0.08 { bind tube = 0.08 }
    if tube > 0.45 { bind tube = 0.45 }

    # ── Derive PHYSICS from the hash (deterministic pseudo-randoms 0..1) ──
    bind h1 = sin(pts[0] * 12.9898 + pts[1] * 4.1414) * 43758.5453
    bind f1 = h1 - floor(h1)
    bind h2 = sin(pts[3] * 19.19 + pts[5] * 7.77) * 31718.13
    bind f2 = h2 - floor(h2)
    bind h3 = sin(maxRad * 8.8 + minRad * 3.3) * 12345.678
    bind f3 = h3 - floor(h3)

    bind restitution = 0.55 + f1 * 0.4        # bounciness 0.55–0.95
    bind cr = (sin(f1 * 6.2831 + 0.0) * 0.5 + 0.5) * 235.0 + 20.0
    bind cg = (sin(f1 * 6.2831 + 2.0) * 0.5 + 0.5) * 235.0 + 20.0
    bind cb = (sin(f1 * 6.2831 + 4.0) * 0.5 + 0.5) * 235.0 + 20.0

    # ── Donut state ──
    bind px = 0.0
    bind py = 0.0 - BOX + DONUT_R + 0.3       # start near the ceiling
    bind pz = 0.0
    bind vx = (f2 - 0.5) * 11.0
    bind vy = 0.0
    bind vz = (f3 - 0.5) * 11.0
    bind rx = 0.0
    bind ry = 0.0
    bind rz = 0.0
    bind wx = (f1 - 0.5) * 5.0                # angular velocity (tumble)
    bind wy = (f2 - 0.5) * 5.0
    bind wz = (f3 - 0.5) * 5.0
    bind flash = 0.0

    bind lim = BOX - DONUT_R

    while window_is_open() {
        set_color(7, 8, 14)
        fill()

        bind t = time_now()
        set_camera(cos(t * 0.22), sin(t * 0.22), cos(0.5), sin(0.5))
        set_ambient(0.18)

        # ── integrate gravity + velocity ──
        bind vy = vy + GRAVITY * DT
        bind vx = vx * DAMP
        bind vy = vy * DAMP
        bind vz = vz * DAMP
        bind px = px + vx * DT
        bind py = py + vy * DT
        bind pz = pz + vz * DT

        # ── bounce off the 6 walls (bounding radius = DONUT_R) ──
        if px > lim       { bind px = lim            bind vx = 0.0 - vx * restitution  bind flash = 1.0  bind wy = wy + vz * 0.4 }
        if px < 0.0 - lim { bind px = 0.0 - lim      bind vx = 0.0 - vx * restitution  bind flash = 1.0  bind wy = wy - vz * 0.4 }
        if py > lim       { bind py = lim            bind vy = 0.0 - vy * restitution  bind flash = 1.0  bind wx = wx + vx * 0.5 }
        if py < 0.0 - lim { bind py = 0.0 - lim      bind vy = 0.0 - vy * restitution  bind flash = 1.0 }
        if pz > lim       { bind pz = lim            bind vz = 0.0 - vz * restitution  bind flash = 1.0  bind wx = wx + vx * 0.4 }
        if pz < 0.0 - lim { bind pz = 0.0 - lim      bind vz = 0.0 - vz * restitution  bind flash = 1.0 }

        # ── spin + flash decay ──
        bind rx = rx + wx * DT
        bind ry = ry + wy * DT
        bind rz = rz + wz * DT
        bind flash = flash * 0.86

        # ── auto re-energize if it's nearly settled on the floor (keep it fun) ──
        bind speed = vx * vx + vy * vy + vz * vz
        if speed < 1.2 {
            if py > lim - 0.4 {
                bind vy = 0.0 - 11.0 - f2 * 6.0
                bind vx = (f3 - 0.5) * 9.0
                bind vz = (f1 - 0.5) * 9.0
            }
        }

        # ── controls ──
        if key_pressed("space") {
            bind px = 0.0  bind pz = 0.0
            bind py = 0.0 - lim
            bind vx = (f2 - 0.5) * 11.0  bind vy = 0.0  bind vz = (f3 - 0.5) * 11.0
        }
        if key_pressed("r") {
            bind vx = sin(t * 7.0) * 10.0
            bind vz = cos(t * 5.0) * 10.0
            bind vy = 0.0 - 8.0
        }

        # ── draw the box (12 wireframe edges) ──
        set_color(46, 64, 104)
        draw_line_3d(0.0 - BOX, 0.0 - BOX, 0.0 - BOX,  BOX, 0.0 - BOX, 0.0 - BOX)
        draw_line_3d(BOX, 0.0 - BOX, 0.0 - BOX,  BOX, BOX, 0.0 - BOX)
        draw_line_3d(BOX, BOX, 0.0 - BOX,  0.0 - BOX, BOX, 0.0 - BOX)
        draw_line_3d(0.0 - BOX, BOX, 0.0 - BOX,  0.0 - BOX, 0.0 - BOX, 0.0 - BOX)
        draw_line_3d(0.0 - BOX, 0.0 - BOX, BOX,  BOX, 0.0 - BOX, BOX)
        draw_line_3d(BOX, 0.0 - BOX, BOX,  BOX, BOX, BOX)
        draw_line_3d(BOX, BOX, BOX,  0.0 - BOX, BOX, BOX)
        draw_line_3d(0.0 - BOX, BOX, BOX,  0.0 - BOX, 0.0 - BOX, BOX)
        draw_line_3d(0.0 - BOX, 0.0 - BOX, 0.0 - BOX,  0.0 - BOX, 0.0 - BOX, BOX)
        draw_line_3d(BOX, 0.0 - BOX, 0.0 - BOX,  BOX, 0.0 - BOX, BOX)
        draw_line_3d(BOX, BOX, 0.0 - BOX,  BOX, BOX, BOX)
        draw_line_3d(0.0 - BOX, BOX, 0.0 - BOX,  0.0 - BOX, BOX, BOX)

        # ── light follows the donut; donut flashes white on impact ──
        add_light(px, py - 3.0, pz - 3.0, 4.5, 1.0, 0.96, 0.88)
        bind fr = cr + (255.0 - cr) * flash
        bind fg = cg + (255.0 - cg) * flash
        bind fb = cb + (255.0 - cb) * flash
        set_color(fr, fg, fb)
        torus(px, py, pz,  DONUT_R, DONUT_R, DONUT_R,  rx, ry, rz,  2,  44.0, 16.0, tube)

        present()
    }
}
