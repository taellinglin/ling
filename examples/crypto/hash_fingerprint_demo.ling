# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HASH FINGERPRINT  —  SHA3-256 rendered as a 3-D knot (native renderer)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# A human-verifiable visual hash (like SSH randomart, but a 3-D knot). Uses the
# engine's depth-sorted `draw_line_3d` + a real rotating camera, so there is no
# projection singularity. Same input → same knot; one byte changes everything.
# Colour theme: ELECTRIC BLUE.

bind start = do {
    open_window(900, 720)
    set_zdist(7.0)                     # push the camera back so the knot sits in view

    bind message = "verify me: 灵 ling SHA3-256 fingerprint"
    bind pts = knot_points(message)
    bind n = len(pts) / 3.0
    bind s = 0.42                       # scale the knot to fit the field of view

    while window_is_open() {
        set_color(4, 8, 16)
        fill()

        bind t = time_now()
        set_camera(cos(t * 0.4), sin(t * 0.4), cos(0.5), sin(0.5))

        bind i = 0.0
        while i < n - 1.0 {
            bind k = i * 3.0
            # electric-blue twinkle travelling along the curve
            bind tw = sin(i * 0.3 + t * 3.0) * 0.5 + 0.5
            set_color(30.0 + tw * 45.0, 120.0 + tw * 95.0, 185.0 + tw * 70.0)
            draw_line_3d(pts[k] * s,        pts[k + 1.0] * s,  pts[k + 2.0] * s,
                         pts[k + 3.0] * s,  pts[k + 4.0] * s,  pts[k + 5.0] * s)
            bind i = i + 1.0
        }

        present()
    }
}
