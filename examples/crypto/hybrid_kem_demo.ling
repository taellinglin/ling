# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HYBRID KEM  —  X25519 + ML-KEM-768 post-quantum key encapsulation (native 3-D)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GOLD knot   = your public identity (the hybrid public key)
# MAGENTA knot= the ciphertext that encapsulates a shared secret to that key.
# Rendered with the engine's depth-sorted draw_line_3d + a single rotating camera.

bind start = do {
    open_window(960, 720)
    set_zdist(9.0)

    bind id = knot_keygen()
    bind pk = knot_public(id)
    bind enc = knot_encapsulate(pk)
    bind ct = enc[0]

    bind pkp = knot_points(pk)          # gold identity knot
    bind ctp = knot_points(ct)          # magenta ciphertext knot
    bind n = len(pkp) / 3.0
    bind s = 0.40                        # knot scale
    bind sep = 2.6                       # world-space separation of the two knots

    while window_is_open() {
        set_color(10, 8, 14)
        fill()

        bind t = time_now()
        set_camera(cos(t * 0.5), sin(t * 0.5), cos(0.45), sin(0.45))

        bind i = 0.0
        while i < n - 1.0 {
            bind k = i * 3.0

            # ── GOLD identity knot (shifted -X) ──
            set_color(255.0, 190.0, 40.0)
            draw_line_3d(pkp[k] * s - sep,        pkp[k + 1.0] * s,  pkp[k + 2.0] * s,
                         pkp[k + 3.0] * s - sep,  pkp[k + 4.0] * s,  pkp[k + 5.0] * s)

            # ── MAGENTA ciphertext knot (shifted +X) ──
            set_color(255.0, 40.0, 200.0)
            draw_line_3d(ctp[k] * s + sep,        ctp[k + 1.0] * s,  ctp[k + 2.0] * s,
                         ctp[k + 3.0] * s + sep,  ctp[k + 4.0] * s,  ctp[k + 5.0] * s)

            bind i = i + 1.0
        }

        present()
    }
}
