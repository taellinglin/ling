# ════════════════════════════════════════════════════════════════════════════
# 3d-japanese-room.ling — 円相禅堂  Enso Zen Meditation Hall
#
#  A vast sumi-ink-black hall governed by two Japanese principles:
#
#  序破急 Jo-ha-kyū (Introduction · Development · Rush):
#    Three time-streams run simultaneously at different speeds —
#    jo = FR×0.20 (outer Enso rings, very slow — stone/garden),
#    ha = FR×0.55 (middle structure, medium — water/breath),
#    kyū = FR     (crown / inner core, full — wind/flame).
#    Each vtex layer is assigned to one stream.
#
#  陰旋法 In-sen scale (A · B♭ · E · F · A):
#    Nine positional sine tones tuned to this quintessentially Japanese
#    pentatonic mode (root A2 = 110 Hz).  The minor second A/B♭ beating
#    at 6.54 Hz is the heartbeat of the hall — like a temple bell's decay.
#
#    Walls (4)  — Slow ink-fall columns + Enso moon circles (shoji window).
#    Ceiling    — Tsukimi moon disc: large Enso + hyperbolic night sky.
#    Floor      — Karesansui: tessellated raked sand + concentric stones.
#    Centre     — Gojū-no-tō (五重塔) 5-tier Enso pagoda; each tier
#                 assigned to jo/ha/kyū pace.  Four sakura-petal spiral
#                 arms (桜吹雪).  Tomoe (巴) counter-rotating core.
#
#  Framefade: Two chromatic echo passes (−48, −24 frames) — the Enso
#  circles leave silver → amber trails, like long-exposure brush calligraphy.
#
#  Camera: Extremely slow sway — the most still of the four rooms.
#
#  Run:  ling run examples/3d-japanese-room.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

束縛 W  = 9.0     # 幅   half-width
束縛 H  = 4.5     # 高さ  half-height
束縛 FZ = 16.0    # 奥壁  far-wall z
束縛 NZ = 1.4     # 手前壁 near-wall z
束縛 PZ = 8.0     # 塔軸  pagoda axis z
束縛 PR = 1.15    # 巴半径 tomoe radius


# ════════════════════════════════════════════════════════════════════════════
# 色  COLOUR
# ════════════════════════════════════════════════════════════════════════════

函 col(t, p) {
    สีดินสอ(
        sin(t + p)         * 127 + 128,
        sin(t + p + 2.094) * 127 + 128,
        sin(t + p + 4.189) * 127 + 128
    )
}

函 col_dim(t, p, b) {
    สีดินสอ(
        (sin(t + p)         * 127 + 128) * b,
        (sin(t + p + 2.094) * 127 + 128) * b,
        (sin(t + p + 4.189) * 127 + 128) * b
    )
}


# ════════════════════════════════════════════════════════════════════════════
# 巴  TOMOE CORE  (counter-rotating concentric circles)
# 「動中の静、静中の動」 — motion within stillness, stillness within motion
# ════════════════════════════════════════════════════════════════════════════

函 draw_tomoe(FR, hd) {
    束縛 bob = sin(FR * 0.016) * 0.22

    # Outer Tomoe rings (clockwise) — silver/warm
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  2, 48,  PR, 0.0,  FR, hd)
    # Inner Tomoe rings (counter-clockwise) — cool/blue
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  2, 48,  PR * 0.60, 0.0,  0-FR, hd + 2.1)
    # Chrysanthemum mon (16-petal 菊) — imperial crest
    vtex_flower(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.55, 16,  FR, hd + 1.0)
    # Sakura inner (5-petal 桜)
    vtex_flower(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.28, 5,  FR, hd + 3.5)
}


# ════════════════════════════════════════════════════════════════════════════
# 円相  ENSO TIER  (single Zen circle at one pagoda level)
# Outer circle → sakura flower → inner circle: three concentric rings
# ════════════════════════════════════════════════════════════════════════════

函 enso(y, r, fr_jo, hd) {
    vtex_rings(0, y, PZ,  1,0,0,  0,0,1,  1, 48,  r, 0.0,        fr_jo, hd)
    vtex_flower(0, y, PZ,  1,0,0,  0,0,1,  r * 0.40, 5,           fr_jo, hd + 1.2)
    vtex_rings(0, y, PZ,  1,0,0,  0,0,1,  1, 48,  r * 0.68, 0.0,  fr_jo, hd + 0.5)
}


# ════════════════════════════════════════════════════════════════════════════
# 五重塔  5-TIER ENSO PAGODA  (Jo-ha-kyū three-speed structure)
# ════════════════════════════════════════════════════════════════════════════

函 draw_塔(FR, hd) {
    束縛 jo  = FR * 0.20    # 序 — very slow, stone/garden pace
    束縛 ha  = FR * 0.55    # 破 — medium, water/breath pace
    束縛 kyu = FR            # 急 — full speed, wind/flame pace

    draw_tomoe(ha, hd)

    # Base sakura lotus (5-petal) at floor
    vtex_lotus(0, 0-H+0.5, PZ,  1,0,0,  0,0,1,  1.0, 2.8, 5,  jo, hd)

    # 5 ascending Enso tiers — base tiers Jo, apex Kyū
    enso(0-2.8, 2.20, jo, hd)
    enso(0-1.2, 1.78, jo, hd + 0.8)
    enso( 0.4,  1.40, ha, hd + 1.6)
    enso( 2.0,  1.06, ha, hd + 2.4)
    enso( H-0.6, 0.75, kyu, hd + 3.2)

    # Crown: single Enso circle + 5-point sakura star (Kyū pace)
    vtex_rings(0, H-0.3, PZ,  1,0,0,  0,0,1,  1, 48,  1.30, 0.0,  kyu, hd + 0.6)
    vtex_star(0, H-0.3, PZ,   1,0,0,  0,0,1,  5, 1.10, 0.45, 0.030,  kyu, hd + 0.5)

    # Sakura-petal falling spirals 桜吹雪 (Ha pace)
    vtex_spiral(0-3.8, 0.5, PZ-2.0,  1,0,0,  0,0,1,  2.5, 2.4, 60,  ha, hd + 0.5)
    vtex_spiral( 3.8,  0.5, PZ-2.0,  1,0,0,  0,0,1,  2.5, 2.4, 60,  ha, hd + 3.64)
    vtex_spiral(0-3.0, 0.5, PZ+2.5,  1,0,0,  0,0,1,  2.2, 2.0, 60,  ha, hd + 1.8)
    vtex_spiral( 3.0,  0.5, PZ+2.5,  1,0,0,  0,0,1,  2.2, 2.0, 60,  ha, hd + 5.1)

    # Large Enso aura (XY plane, Jo pace — the hall breathes very slowly)
    vtex_rings(0, 0, PZ,  1,0,0,  0,1,0,  2, 48,  2.6, 0.0,  jo, hd + 5.2)
}


# ════════════════════════════════════════════════════════════════════════════
# 室内面  ROOM SURFACES
# ════════════════════════════════════════════════════════════════════════════

函 draw_floor(FR, hd) {
    束縛 cy   = 0 - H
    束縛 fmid = FZ / 2
    # 枯山水 Karesansui — raked sand (very subtle wave field, low amplitude)
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  20, 16,  0.65, 0.12, 4.0,  FR, hd + 2.0)
    # Concentric stone circles (ishigumi 石組)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  5, 48,  4.2, 0.0,  FR * 0.20, hd)
    vtex_flower(0, cy, fmid,  1,0,0,  0,0,1,  1.5, 5,  FR, hd + 1.0)
    # Stone-slab grid
    vtex_grid(0, cy, fmid,  1,0,0,  0,0,1,  24, 20,  0.72, 0.72,  FR, hd + 3.5)
}

函 draw_ceiling(FR, hd) {
    束縛 cy   = H
    束縛 fmid = FZ / 2
    # Night sky — hyperbolic Poincaré (sparse: 12 rings, 12 rays)
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  6.2, 12, 12,  FR, hd + 1.5)
    # 月 Moon: single large Enso (Jo pace)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  1, 48,  3.8, 0.0,  FR * 0.20, hd + 0.2)
    # Inner moon glow (chrysanthemum)
    vtex_flower(0, cy, fmid,  1,0,0,  0,0,1,  1.8, 16,  FR, hd + 2.0)
    # Outer sky ring (Jo)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  2, 48,  5.8, 0.0,  FR * 0.20, hd + 4.0)
}

函 draw_front_wall(FR, hd) {
    # Sparse slow rain — ink brushstroke columns (shodo 書道)
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  24, 14,  0.68, 0.62,  0.014,  FR, hd + 2.0)
}

函 draw_back_wall(FR, hd) {
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.015,  FR, hd + 2.2)
    # 月洞門 Moon gate: two concentric Enso portal circles (Jo)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  1, 48,  4.5, 0.0,  FR * 0.20, hd)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  1, 48,  3.8, 0.0,  FR * 0.20, hd + 0.3)
    # Portal inner flower
    vtex_flower(0, 0, FZ,  1,0,0,  0,1,0,  2.2, 8,  FR, hd + 1.5)
}

函 draw_left_wall(FR, hd) {
    束縛 cx   = 0 - W
    束縛 fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  18, 12,  0.72, 0.65,  0.012,  FR, hd + 3.5)
    # 障子 Shoji moon circle (Jo pace)
    vtex_rings(cx, 0, fmid,  0,0,1,  0,1,0,  1, 48,  2.8, 0.0,  FR * 0.20, hd + 0.3)
}

函 draw_right_wall(FR, hd) {
    束縛 cx   = W
    束縛 fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  18, 12,  0.72, 0.65,  0.012,  FR, hd + 1.8)
    # Shoji moon circle (Jo pace)
    vtex_rings(cx, 0, fmid,  0,0,1,  0,1,0,  1, 48,  2.8, 0.0,  FR * 0.20, hd + 0.6)
}


# ════════════════════════════════════════════════════════════════════════════
# 残像  ECHO PASS (sparse structural elements for temporal framefade)
# ════════════════════════════════════════════════════════════════════════════

函 draw_echo(FR, hd) {
    束縛 cy_f = 0 - H
    束縛 cy_c = H
    束縛 fm   = FZ / 2
    束縛 jo   = FR * 0.20
    束縛 ha   = FR * 0.55

    # Floor: stone circles + grid
    vtex_rings(0, cy_f, fm,  1,0,0,  0,0,1,  5, 48,  4.2, 0.0,  jo, hd)
    vtex_grid(0, cy_f, fm,  1,0,0,  0,0,1,  24, 20,  0.72, 0.72,  FR, hd + 3.5)

    # Ceiling: moon + outer ring
    vtex_rings(0, cy_c, fm,  1,0,0,  0,0,1,  1, 48,  3.8, 0.0,  jo, hd + 0.2)
    vtex_rings(0, cy_c, fm,  1,0,0,  0,0,1,  2, 48,  5.8, 0.0,  jo, hd + 4.0)

    # Back portal moon gate
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  1, 48,  4.5, 0.0,  jo, hd)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  1, 48,  3.8, 0.0,  jo, hd + 0.3)

    # Sparse pagoda: core + 3 Enso tiers
    draw_tomoe(ha, hd)
    enso(0-2.8, 2.20, jo, hd)
    enso( 0.4,  1.40, ha, hd + 1.6)
    enso( H-0.6, 0.75, FR, hd + 3.2)
    vtex_rings(0, H-0.3, PZ,  1,0,0,  0,0,1,  1, 48,  1.30, 0.0,  FR, hd + 0.6)
}


# ════════════════════════════════════════════════════════════════════════════
# 照明  LIGHTS
# ════════════════════════════════════════════════════════════════════════════

函 setup_lights(FR) {
    clear_lights()
    # 行灯 Andon lantern — warm amber, slow orbit
    add_light(
        sin(FR * 0.0065) * 3.5,
        3.2,
        cos(FR * 0.0065) * 2.0 + PZ,
        1.0, 0.78, 0.40,
        2.5, 12.0
    )
    # 障子 Shoji moonlight — cool diffuse white-blue from left
    add_light(0-5.0, 2.0, PZ,  0.62, 0.68, 0.90,  1.2, 14.0)
    # 鳥居 Torii vermilion accent — right rear
    add_light(
        sin(FR * 0.0048) * 2.5,
        0.2,
        0-cos(FR * 0.0048) * 2.0 + PZ,
        0.80, 0.15, 0.05,
        0.8, 8.0
    )
    # Moon shadow under-fill (very dim)
    add_light(0, 0-3.5, PZ,  0.08, 0.08, 0.30,  0.4, 7.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 音楽  AUDIO — In-sen scale (陰旋法) drone ensemble
# Scale: A · B♭ · E · F · A  (root A2 = 110 Hz)
# A2/B♭2 beating at 6.54 Hz = temple bell decay heartbeat
# LFO 0.10–0.42 Hz = shakuhachi breath (very slow, Jo principle)
# ════════════════════════════════════════════════════════════════════════════

函 init_audio() {
    # slot   x      y     z    w     freq     amp   lfo_hz  depth
    audio_tone(0,  0,  0-H,  PZ, 1.5,   55.00, 0.11, 0.10, 0.008) # A1  sub-bass (jo)
    audio_tone(1,  0,  0-H,  FZ, 2.0,  110.00, 0.12, 0.15, 0.010) # A2  ground
    audio_tone(2, 0-W,  0,   PZ, 2.0,  116.54, 0.09, 0.18, 0.012) # B♭2 left (beating)
    audio_tone(3,  W,   0,   PZ, 2.0,  164.81, 0.09, 0.25, 0.014) # E3  right (fifth)
    audio_tone(4,  0,   H,   PZ, 0.5,  174.61, 0.07, 0.28, 0.013) # F3  ceiling (min 6th)
    audio_tone(5,  0,   0,   FZ, 1.2,  220.00, 0.08, 0.22, 0.012) # A3  portal (octave)
    audio_tone(6,  0,   0,   PZ, 1.0,  233.08, 0.06, 0.30, 0.016) # B♭3 pagoda (beating)
    audio_tone(7, 0-3.8, 0.5, PZ-2.0, 3.0, 329.63, 0.05, 0.38, 0.020) # E4 sakura L (kyu)
    audio_tone(8,  3.8, 0.5, PZ-2.0, 3.0, 349.23, 0.05, 0.42, 0.022) # F4 sakura R (kyu)
    audio_volume(0.55)
}


# ════════════════════════════════════════════════════════════════════════════
# 開始  MAIN
# ════════════════════════════════════════════════════════════════════════════
束縛 start = 実行 {
    เปิดหน้าต่างเต็มจอ("Enso Zen Meditation Hall — 円相禅堂")
    capture_mouse()
    set_ambient(0.04)    # near-total darkness — Ma (間) principle

    init_audio()

    束縛 齣 = 0    # 齣 = koma (frame), Japanese film/manga term

    令 cam_px = 0.0
    令 cam_py = 0.0
    令 cam_pz = 0.0
    令 cam_zdist = 2.0
    令 cam_ry_off = 0.0
    令 cam_rx_off = 0.0
    令 cam_idle = 0
    令 cam_manual = 0
    令 cam_ry_snap = 0.0
    令 cam_rx_snap = 0.0

    一方 หน้าต่างเปิดอยู่() {
        เติม(0, 0, 0)    # 墨 sumi ink black — pure emptiness

        # ── Camera: the most still of all rooms (Jo principle) ────────────
        # Horizontal ±0.16 rad ( 9°), period ~3300 frames
        # Vertical   ±0.06 rad ( 3°), period ~5500 frames
        束縛 ry  = sin(齣 * 0.00030) * 0.16
        束縛 rx  = sin(齣 * 0.00018) * 0.06
        令 mdx = mouse_dx()
        令 mdy = mouse_dy()
        令 any_input = 0
        若 key_down("w")      { 令 any_input = 1 }
        若 key_down("s")      { 令 any_input = 1 }
        若 key_down("a")      { 令 any_input = 1 }
        若 key_down("d")      { 令 any_input = 1 }
        若 key_down("space")  { 令 any_input = 1 }
        若 key_down("lshift") { 令 any_input = 1 }
        若 key_down("left")   { 令 any_input = 1 }
        若 key_down("right")  { 令 any_input = 1 }
        若 key_down("up")     { 令 any_input = 1 }
        若 key_down("down")   { 令 any_input = 1 }
        若 mdx * mdx + mdy * mdy > 0.25 { 令 any_input = 1 }
        若 any_input == 1 { 令 cam_manual = 1; 令 cam_idle = 0 }
        若 cam_manual == 1 {
            令 cam_idle = cam_idle + 1
            若 cam_idle > 300 { 令 cam_manual = 0; 令 cam_idle = 0 }
        }
        若 cam_manual == 1 {
            令 cam_ry_off = cam_ry_off + mdx * 0.0022
            令 cam_rx_off = cam_rx_off + mdy * 0.0022
            若 cam_rx_off > 3.14159  { 令 cam_rx_off = 3.14159 }
            若 cam_rx_off < -3.14159 { 令 cam_rx_off = -3.14159 }
            若 key_down("left")  { 令 cam_ry_off = cam_ry_off - 0.018 }
            若 key_down("right") { 令 cam_ry_off = cam_ry_off + 0.018 }
            若 key_down("up")    { 令 cam_rx_off = cam_rx_off - 0.018 }
            若 key_down("down")  { 令 cam_rx_off = cam_rx_off + 0.018 }
            令 fwd_x = sin(cam_ry_snap + cam_ry_off)
            令 fwd_z = cos(cam_ry_snap + cam_ry_off)
            令 rgt_x = cos(cam_ry_snap + cam_ry_off)
            令 rgt_z = 0.0 - sin(cam_ry_snap + cam_ry_off)
            令 spd = 0.12
            若 key_down("w") { 令 cam_px = cam_px + fwd_x * spd; 令 cam_pz = cam_pz + fwd_z * spd }
            若 key_down("s") { 令 cam_px = cam_px - fwd_x * spd; 令 cam_pz = cam_pz - fwd_z * spd }
            若 key_down("a") { 令 cam_px = cam_px - rgt_x * spd; 令 cam_pz = cam_pz - rgt_z * spd }
            若 key_down("d") { 令 cam_px = cam_px + rgt_x * spd; 令 cam_pz = cam_pz + rgt_z * spd }
            若 key_down("space")  { 令 cam_py = cam_py + spd }
            若 key_down("lshift") { 令 cam_py = cam_py - spd }
            若 key_pressed("numpad+") { 令 cam_zdist = cam_zdist + 0.5 }
            若 key_pressed("numpad-") { 令 cam_zdist = cam_zdist - 0.5; 若 cam_zdist < 0.5 { 令 cam_zdist = 0.5 } }
        }
        若 cam_manual == 0 {
            令 cam_ry_snap = ry
            令 cam_rx_snap = rx
            令 cam_ry_off = cam_ry_off * 0.97
            令 cam_rx_off = cam_rx_off * 0.97
            令 cam_px = cam_px * 0.97
            令 cam_py = cam_py * 0.97
            令 cam_pz = cam_pz * 0.97
        }
        束縛 cry = cos(cam_ry_snap + cam_ry_off)   束縛 sry = sin(cam_ry_snap + cam_ry_off)
        束縛 crx = cos(cam_rx_snap + cam_rx_off)   束縛 srx = sin(cam_rx_snap + cam_rx_off)
        set_camera(cry, sry, crx, srx)
        set_camera_pos(cam_px, cam_py, cam_pz)
        set_zdist(cam_zdist)
        audio_listener(cry, sry, crx, srx)

        setup_lights(齣)

        # ── Temporal framefade — 2 echo passes then current ───────────────
        # Echo passes carry the Jo/Ha time-split internally, so the Enso
        # circles ghost correctly at all three speeds simultaneously.
        draw_echo(齣 - 48, 2.0)
        draw_echo(齣 - 24, 1.0)

        # Current frame — full scene
        draw_floor(齣, 0.0)
        draw_ceiling(齣, 0.0)
        draw_front_wall(齣, 0.0)
        draw_back_wall(齣, 0.0)
        draw_left_wall(齣, 0.0)
        draw_right_wall(齣, 0.0)
        draw_塔(齣, 0.0)

        แสดงผล()
        束縛 齣 = 齣 + 1
    }
}
