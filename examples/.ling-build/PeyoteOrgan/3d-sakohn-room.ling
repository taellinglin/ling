# ════════════════════════════════════════════════════════════════════════════
# 3d-sakohn-room.ling — สกลนคร · วัดพระธาตุเชิงชุม
#                       Sakon Nakhon · Phra That Choeng Chum
#
#  The universe-city of the northeast.  สกล (Sakon) = all / the whole cosmos.
#  Built around three Thai sacred traditions:
#
#  ปรางค์  Khmer Prang — the towering corn-cob spire of Choeng Chum temple:
#    Five ascending tiers of diminishing chakra wheels, each 4-fold (Khmer
#    cardinal directions), crowned with a 16-petal lotus finial.  Naga
#    serpent balustrades spiral up both flanks.
#
#  สักยันต์  Sak Yant Sacred Geometry — magical tattoo diagrams:
#    The back-wall portal layers Paed Tidt (8-direction Yant), Unalome
#    spirals, and a grand yantra gate — geometry charged with protective power.
#
#  หนองหาน  Nong Han Lake — Thailand's largest natural lake below the city:
#    The floor is a gently rippling tessellated water plane with concentric
#    lotus-pad dots (halftone) and reflection rings — you stand on the lake.
#
#  Four Ngũ Hành–inspired time-streams (Thai names):
#    ช้า   = FR × 0.14   slow  — stone / ดิน  (earth)
#    กลาง  = FR × 0.50   mid   — wind  / ลม   (air)
#    เร็ว  = FR × 0.88   fast  — fire  / ไฟ   (fire)
#    พายุ  = FR × 1.60   storm — lightning / สายฟ้า
#
#  Audio: Isaan khaen mouth-organ pentatonic — G · A · B · D · E
#    Root G2 = 98 Hz.  LFO 0.10–0.45 Hz = slow khaen breath.
#
#  Written entirely in Thai keywords (ผูก · ทำ · ขณะที่ · ฟังก์ชัน).
#  Variable and function names are Thai wherever possible.
#
#  Run:  ling run examples/3d-sakohn-room.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

ผูก W  = 9.0    # half-width
ผูก H  = 4.5    # half-height
ผูก FZ = 16.0   # far wall z
ผูก NZ = 1.4    # near wall z
ผูก PZ = 8.0    # prang axis z
ผูก PR = 1.20   # prang core radius


# ════════════════════════════════════════════════════════════════════════════
# ปรางค์  KHMER PRANG  — 5-tier tower + Naga serpent columns
# 4-fold Khmer symmetry (n_spokes=4 at base, rising to n_spokes=8 at crown)
# Two pairs of Naga spiral balustrades at the flanks
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ปรางค์(FR, hd) {
    ผูก ช้า  = FR * 0.14
    ผูก กลาง = FR * 0.50
    ผูก เร็ว = FR * 0.88
    ผูก พายุ = FR * 1.60
    ผูก bob  = sin(FR * 0.013) * 0.22

    # Base lotus — ground bloom
    vtex_lotus(0, 0-H+0.5, PZ,  1,0,0,  0,0,1,  0.9, 2.8, 12,  ช้า, hd)

    # ── Tier 1 — widest base (Khmer 4-spoke) ─────────────────────────────
    vtex_chakra(0, 0-2.5, PZ,  1,0,0,  0,0,1,  2.2, 4,          กลาง, hd + 0.5)
    vtex_rings(0, 0-2.5, PZ,  1,0,0,  0,0,1,  3, 36,  2.0, 0.0, ช้า,  hd + 1.0)

    # ── Tier 2 ────────────────────────────────────────────────────────────
    vtex_chakra(0, 0-1.2, PZ,  1,0,0,  0,0,1,  1.8, 4,          กลาง, hd + 1.5)
    vtex_rings(0, 0-1.2, PZ,  1,0,0,  0,0,1,  2, 36,  1.6, 0.0, ช้า,  hd + 2.0)

    # ── Tier 3 — mid (8-spoke + Sak Yant yantra) ─────────────────────────
    vtex_chakra(0, bob, PZ,  1,0,0,  0,0,1,  1.4, 8,             กลาง, hd + 2.5)
    vtex_yantra(0, bob, PZ,  1,0,0,  0,0,1,  3, 1.2,             กลาง, hd + 3.0)

    # ── Tier 4 — lotus-ringed shoulder ───────────────────────────────────
    vtex_chakra(0, 1.5, PZ,  1,0,0,  0,0,1,  1.0, 4,             เร็ว, hd + 3.5)
    vtex_lotus(0, 1.5, PZ,  1,0,0,  0,0,1,  0.36, 0.92, 12,      เร็ว, hd + 4.0)

    # ── Crown — 4-point Khmer spire + 16-petal lotus finial ──────────────
    vtex_rings(0, H-0.5, PZ,  1,0,0,  0,0,1,  2, 36,  1.3, 0.0,  เร็ว, hd + 4.5)
    vtex_star(0, H-0.5, PZ,   1,0,0,  0,0,1,  4, 1.10, 0.52, 0.0, พายุ, hd + 5.0)
    vtex_flower(0, H-0.5, PZ,  1,0,0,  0,0,1,  0.60, 16,          พายุ, hd + 5.5)

    # ── Naga serpent balustrade columns (2 pairs) ─────────────────────────
    # Front pair (closer, กลาง pace)
    vtex_spiral(0-3.5, 0, PZ-1.5,  1,0,0,  0,0,1,  2.2, 2.0, 72,  กลาง, hd + 0.8)
    vtex_spiral( 3.5,  0, PZ-1.5,  1,0,0,  0,0,1,  2.2, 2.0, 72,  กลาง, hd + 4.1)
    # Rear pair (deeper, เร็ว pace — faster shimmer)
    vtex_spiral(0-3.2, 0, PZ+1.8,  1,0,0,  0,0,1,  2.0, 1.8, 72,  เร็ว, hd + 2.0)
    vtex_spiral( 3.2,  0, PZ+1.8,  1,0,0,  0,0,1,  2.0, 1.8, 72,  เร็ว, hd + 5.5)

    # ── Prang vertical disc aura (XY plane — sacred halo) ────────────────
    vtex_rings(0, 0, PZ,  1,0,0,  0,1,0,  2, 36,  2.8, 0.0,        ช้า, hd + 6.2)
    vtex_chakra(0, 0, PZ,  1,0,0,  0,1,0,  2.4, 8,                 กลาง, hd + 7.0)
}


# ════════════════════════════════════════════════════════════════════════════
# หนองหาน  FLOOR — Nong Han lake reflection
# Gentle tessellated water ripple + halftone lotus pads + Sak Yant yantra
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_พื้น(FR, hd) {
    ผูก cy   = 0 - H
    ผูก fmid = FZ / 2
    ผูก ช้า  = FR * 0.14
    # Water ripple — modest amplitude (lake surface, not ocean)
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  24, 18,  0.68, 0.20, 4.5,  FR, hd + 2.0)
    # Concentric lake ripples
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  6, 48,  5.2, 0.0,  ช้า, hd + 0.0)
    # Lotus pads floating on the water
    vtex_halftone(0, cy, fmid,  1,0,0,  0,0,1,  20, 14,  0.55, 0.50, 0.32,  FR, hd + 3.5)
    # Sak Yant sacred diagram on the lake bed
    vtex_yantra(0, cy, fmid,  1,0,0,  0,0,1,  4, 4.6,  FR, hd + 1.5)
    vtex_grid(0, cy, fmid,  1,0,0,  0,0,1,  26, 20,  0.66, 0.66,  FR, hd + 4.0)
}


# ════════════════════════════════════════════════════════════════════════════
# เพดาน  CEILING — Thai cosmos / Poincaré night sky
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_เพดาน(FR, hd) {
    ผูก cy   = H
    ผูก fmid = FZ / 2
    ผูก ช้า  = FR * 0.14
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  5.8, 14, 18,  FR, hd + 1.5)
    # 16-petal celestial lotus
    vtex_flower(0, cy, fmid,  1,0,0,  0,0,1,  2.4, 16,  FR, hd + 0.2)
    # Two outer concentric halos (ช้า — very slow overhead sweep)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  2, 36,  6.2, 0.0,  ช้า, hd + 4.5)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  3, 36,  5.0, 0.0,  ช้า, hd + 2.8)
}


# ════════════════════════════════════════════════════════════════════════════
# ผนัง  WALLS — Thai glyph rain
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ผนังหน้า(FR, hd) {
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.020,  FR, hd + 0.0)
}

ฟังก์ชัน draw_ผนังหลัง(FR, hd) {
    ผูก เร็ว = FR * 0.88
    # Glyph rain
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  28, 16,  0.64, 0.58,  0.026,  FR, hd + 2.1)
    # Sak Yant portal — Paed Tidt (8-direction yantra)
    vtex_chakra(0, 0, FZ,  1,0,0,  0,1,0,  4.2, 8,                            เร็ว, hd + 0.8)
    vtex_yantra(0, 0, FZ,  1,0,0,  0,1,0,  4, 3.8,                            FR,   hd + 5.0)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  3, 36,  4.8, 0.02,                  FR,   hd + 3.5)
    # Unalome crown star (8-point — Dhamma wheel)
    vtex_star(0, 0, FZ,   1,0,0,  0,1,0,  8, 4.5, 2.4, 0.0,                  เร็ว, hd + 1.5)
}

ฟังก์ชัน draw_ผนังซ้าย(FR, hd) {
    ผูก cx   = 0 - W
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.024,  FR, hd + 4.2)
}

ฟังก์ชัน draw_ผนังขวา(FR, hd) {
    ผูก cx   = W
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  24, 16,  0.64, 0.58,  0.024,  FR, hd + 1.0)
}


# ════════════════════════════════════════════════════════════════════════════
# เงา  ECHO PASS — two-layer temporal framefade
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_เงา(FR, hd) {
    ผูก cy_f = 0 - H
    ผูก cy_c = H
    ผูก fm   = FZ / 2
    ผูก ช้า  = FR * 0.14
    ผูก กลาง = FR * 0.50
    ผูก เร็ว = FR * 0.88

    # Floor
    vtex_rings(0, cy_f, fm,  1,0,0,  0,0,1,  6, 48,  5.2, 0.0,  ช้า, hd + 0.0)
    vtex_yantra(0, cy_f, fm,  1,0,0,  0,0,1,  4, 4.6,  FR, hd + 1.5)
    vtex_grid(0, cy_f, fm,  1,0,0,  0,0,1,  26, 20,  0.66, 0.66,  FR, hd + 4.0)

    # Ceiling
    vtex_flower(0, cy_c, fm,  1,0,0,  0,0,1,  2.4, 16,  FR, hd + 0.2)
    vtex_rings(0, cy_c, fm,  1,0,0,  0,0,1,  2, 36,  6.2, 0.0,  ช้า, hd + 4.5)

    # Back portal
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  3, 36,  4.8, 0.02,  FR, hd + 3.5)
    vtex_star(0, 0, FZ,   1,0,0,  0,1,0,  8, 4.5, 2.4, 0.0,   เร็ว, hd + 1.5)

    # Prang mid-tier + crown
    ผูก bob = sin(FR * 0.013) * 0.22
    vtex_chakra(0, bob, PZ,  1,0,0,  0,0,1,  1.4, 8,  กลาง, hd + 2.5)
    vtex_yantra(0, bob, PZ,  1,0,0,  0,0,1,  3, 1.2,  กลาง, hd + 3.0)
    vtex_rings(0, H-0.5, PZ,  1,0,0,  0,0,1,  2, 36,  1.3, 0.0,  เร็ว, hd + 4.5)
    vtex_rings(0, 0, PZ,  1,0,0,  0,1,0,  2, 36,  2.8, 0.0,  ช้า, hd + 6.2)
}


# ════════════════════════════════════════════════════════════════════════════
# แสง  LIGHTS
#   Golden saffron lantern · Naga jade-green · Sunset vermilion ·
#   Moonlight silver-blue (Nong Han lake reflection)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน แสง(FR) {
    clear_lights()
    # Saffron temple candle — warm gold, slow orbit
    add_light(
        sin(FR * 0.0058) * 3.5,
        3.2,
        cos(FR * 0.0058) * 2.2 + PZ,
        1.0, 0.76, 0.18,
        2.4, 13.0
    )
    # Naga jade-green — left (emerald serpent shimmer)
    add_light(0-5.2, 1.5, PZ,  0.08, 0.80, 0.42,  1.2, 11.0)
    # Sunset vermilion — right, slow orbit
    add_light(
        sin(FR * 0.0044) * 2.8,
        0.2,
        0-cos(FR * 0.0044) * 1.8 + PZ,
        0.90, 0.28, 0.04,
        0.9, 9.0
    )
    # Moonlight silver-blue from lake below
    add_light(0, 0-3.8, PZ,  0.30, 0.38, 0.70,  0.6, 8.0)
}


# ════════════════════════════════════════════════════════════════════════════
# เสียง  AUDIO — Isaan khaen mouth-organ pentatonic (G · A · B · D · E)
#   Root G2 = 98.00 Hz  (แคน bamboo pipe fundamental)
#   LFO 0.10–0.45 Hz = slow khaen breath / temple drone
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน เสียง() {
    # slot   x       y     z       w     freq     amp   lfo_hz  depth
    audio_tone(0,  0,   0-H,  PZ,  1.8,   98.00, 0.12, 0.10, 0.008) # G2  earth drone
    audio_tone(1,  0,   0-H,  FZ,  2.0,  110.00, 0.13, 0.14, 0.010) # A2  ground
    audio_tone(2, 0-W,  0,    PZ,  1.8,  123.47, 0.10, 0.18, 0.011) # B2  left
    audio_tone(3,  W,   0,    PZ,  1.8,  146.83, 0.10, 0.22, 0.011) # D3  right
    audio_tone(4,  0,   H,    PZ,  0.5,  164.81, 0.08, 0.26, 0.012) # E3  ceiling
    audio_tone(5,  0,   0,    FZ,  1.2,  196.00, 0.09, 0.30, 0.013) # G3  portal
    audio_tone(6,  0,   0,    PZ,  0.8,  220.00, 0.07, 0.34, 0.015) # A3  prang
    audio_tone(7, 0-3.5, 0, PZ-1.5, 2.8, 246.94, 0.05, 0.38, 0.017) # B3  naga-L
    audio_tone(8,  3.5, 0, PZ-1.5, 2.8,  293.66, 0.05, 0.44, 0.019) # D4  naga-R
    audio_volume(0.58)
}


# ════════════════════════════════════════════════════════════════════════════
# เริ่ม  MAIN  — สกลนคร
# ════════════════════════════════════════════════════════════════════════════

ผูก เริ่ม = ทำ {
    เปิดหน้าต่างเต็มจอ("สกลนคร · วัดพระธาตุเชิงชุม · Phra That Choeng Chum")
    capture_mouse()
    set_ambient(0.05)

    เสียง()

    ผูก กรอบ = 0

    令 cam_px = 0.0
    令 cam_py = 0.0
    令 cam_pz = 0.0
    令 cam_zdist = 2.0
    令 cam_ry_off = 0.0
    令 cam_rx_off = 0.0
    令 cam_idle = 0
    令 cam_manual = 0
    令 cam_ry_snap = 0.0
    令 cam_rx_snap = 0.0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(6, 2, 0)   # deep saffron-black — temple darkness, warm

        # Camera: gentle sway (±0.22 rad horizontal, ±0.08 rad vertical)
        ผูก ry  = sin(กรอบ * 0.00044) * 0.22
        ผูก rx  = sin(กรอบ * 0.00028) * 0.08
        令 mdx = mouse_dx()
        令 mdy = mouse_dy()
        令 any_input = 0
        若 key_down("w")      { 令 any_input = 1 }
        若 key_down("s")      { 令 any_input = 1 }
        若 key_down("a")      { 令 any_input = 1 }
        若 key_down("d")      { 令 any_input = 1 }
        若 key_down("space")  { 令 any_input = 1 }
        若 key_down("lshift") { 令 any_input = 1 }
        若 key_down("left")   { 令 any_input = 1 }
        若 key_down("right")  { 令 any_input = 1 }
        若 key_down("up")     { 令 any_input = 1 }
        若 key_down("down")   { 令 any_input = 1 }
        若 mdx * mdx + mdy * mdy > 0.25 { 令 any_input = 1 }
        若 any_input == 1 { 令 cam_manual = 1; 令 cam_idle = 0 }
        若 cam_manual == 1 {
            令 cam_idle = cam_idle + 1
            若 cam_idle > 300 { 令 cam_manual = 0; 令 cam_idle = 0 }
        }
        若 cam_manual == 1 {
            令 cam_ry_off = cam_ry_off + mdx * 0.0022
            令 cam_rx_off = cam_rx_off + mdy * 0.0022
            若 cam_rx_off > 3.14159  { 令 cam_rx_off = 3.14159 }
            若 cam_rx_off < -3.14159 { 令 cam_rx_off = -3.14159 }
            若 key_down("left")  { 令 cam_ry_off = cam_ry_off - 0.018 }
            若 key_down("right") { 令 cam_ry_off = cam_ry_off + 0.018 }
            若 key_down("up")    { 令 cam_rx_off = cam_rx_off - 0.018 }
            若 key_down("down")  { 令 cam_rx_off = cam_rx_off + 0.018 }
            令 fwd_x = sin(cam_ry_snap + cam_ry_off)
            令 fwd_z = cos(cam_ry_snap + cam_ry_off)
            令 rgt_x = cos(cam_ry_snap + cam_ry_off)
            令 rgt_z = 0.0 - sin(cam_ry_snap + cam_ry_off)
            令 spd = 0.12
            若 key_down("w") { 令 cam_px = cam_px + fwd_x * spd; 令 cam_pz = cam_pz + fwd_z * spd }
            若 key_down("s") { 令 cam_px = cam_px - fwd_x * spd; 令 cam_pz = cam_pz - fwd_z * spd }
            若 key_down("a") { 令 cam_px = cam_px - rgt_x * spd; 令 cam_pz = cam_pz - rgt_z * spd }
            若 key_down("d") { 令 cam_px = cam_px + rgt_x * spd; 令 cam_pz = cam_pz + rgt_z * spd }
            若 key_down("space")  { 令 cam_py = cam_py + spd }
            若 key_down("lshift") { 令 cam_py = cam_py - spd }
            若 key_pressed("numpad+") { 令 cam_zdist = cam_zdist + 0.5 }
            若 key_pressed("numpad-") { 令 cam_zdist = cam_zdist - 0.5; 若 cam_zdist < 0.5 { 令 cam_zdist = 0.5 } }
        }
        若 cam_manual == 0 {
            令 cam_ry_snap = ry
            令 cam_rx_snap = rx
            令 cam_ry_off = cam_ry_off * 0.97
            令 cam_rx_off = cam_rx_off * 0.97
            令 cam_px = cam_px * 0.97
            令 cam_py = cam_py * 0.97
            令 cam_pz = cam_pz * 0.97
        }
        ผูก cry = cos(cam_ry_snap + cam_ry_off)   ผูก sry = sin(cam_ry_snap + cam_ry_off)
        ผูก crx = cos(cam_rx_snap + cam_rx_off)   ผูก srx = sin(cam_rx_snap + cam_rx_off)
        set_camera(cry, sry, crx, srx)
        set_camera_pos(cam_px, cam_py, cam_pz)
        set_zdist(cam_zdist)
        audio_listener(cry, sry, crx, srx)

        แสง(กรอบ)

        # Two-pass chromatic framefade
        draw_เงา(กรอบ - 48, 2.0)
        draw_เงา(กรอบ - 24, 1.0)

        draw_พื้น(กรอบ, 0.0)
        draw_เพดาน(กรอบ, 0.0)
        draw_ผนังหน้า(กรอบ, 0.0)
        draw_ผนังหลัง(กรอบ, 0.0)
        draw_ผนังซ้าย(กรอบ, 0.0)
        draw_ผนังขวา(กรอบ, 0.0)
        draw_ปรางค์(กรอบ, 0.0)

        แสดงผล()
        ผูก กรอบ = กรอบ + 1
    }
}
