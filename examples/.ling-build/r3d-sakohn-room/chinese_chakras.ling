# ═══════════════════════════════════════════════════════════════════════════════
# chinese_chakras.ling — 中脈輪 · Chinese Chakras · จักระจีโนม
#
#  A tall octagonal temple.  The genome's double helix rises from the lotus
#  floor to the crown dome.  Seven energy nodes mark the metabolic chakras:
#
#    1  Root    (red)    — Glycolysis         — CV1  Huiyin    — 6-point star
#    2  Sacral  (orange) — Krebs / TCA cycle  — CV4  Guanyuan  — spinning rings
#    3  Solar   (yellow) — Oxidative phospho. — CV12 Zhongwan  — 8-spoke chakra
#    4  Heart   (green)  — Fatty-acid β-oxid. — CV17 Shanzhong — lotus flower
#    5  Throat  (cyan)   — Protein synthesis  — CV22 Tiantu    — double spiral
#    6  Third   (indigo) — DNA repair/repl.   — GV16 Fengfu    — yantra
#    7  Crown   (violet) — Epigenetics / Txn  — GV20 Baihui    — 16-petal flower
#
#  The Phos Mimosa (light flower) blooms above and below in mirrored symmetry.
#  Asian calligraphy rains the eight walls.  A Greek-meander dome crowns all.
#
#  Run:  ling run examples/chinese_chakras.ling
#  Build: ling build examples/chinese_chakras.ling --platform win
# ═══════════════════════════════════════════════════════════════════════════════

ผูก R   = 7.2    # octagon inner radius
ผูก H   = 10.0   # half-height (floor y=-H, dome base y=+H)
ผูก CZ  = 12.0   # room centre depth
ผูก HEL = 1.35   # DNA helix radius
ผูก TAU = 6.283185

# ── Sine-wave RGB colour (smooth hue cycling) ─────────────────────────────
ฟังก์ชัน col(ฮิว, sat, lit, dim) {
    ผูก h = ฮิว * 3.14159 / 180.0
    ผูก r = clamp((sin(h)         * sat + lit) * dim, 0.0, 255.0)
    ผูก g = clamp((sin(h + 2.094) * sat + lit) * dim, 0.0, 255.0)
    ผูก b = clamp((sin(h + 4.189) * sat + lit) * dim, 0.0, 255.0)
    สีดินสอ(r, g, b)
}

# ── DNA Double Helix ──────────────────────────────────────────────────────────
# 81 steps (3^4), two strands offset by π, base-pair rungs every 4 steps.
# Hue sweeps the full spectrum from root (red) to crown (violet).
ฟังก์ชัน จีโนม(เฟรม) {
    ผูก N   = 81
    ผูก rot = เฟรม * 0.0055

    ผูก i = 0
    ขณะที่ i < N {
        ผูก t   = i / N
        ผูก y0  = t * H * 2.0 - H
        ผูก t1  = (i + 1) / N
        ผูก y1  = t1 * H * 2.0 - H

        ผูก φ0  = i * TAU / 16.0 + rot
        ผูก φ1  = (i + 1) * TAU / 16.0 + rot

        ผูก ax0 = HEL * cos(φ0)       ผูก az0 = CZ + HEL * sin(φ0)
        ผูก ax1 = HEL * cos(φ1)       ผูก az1 = CZ + HEL * sin(φ1)
        ผูก bx0 = HEL * cos(φ0 + pi)  ผูก bz0 = CZ + HEL * sin(φ0 + pi)
        ผูก bx1 = HEL * cos(φ1 + pi)  ผูก bz1 = CZ + HEL * sin(φ1 + pi)

        ผูก ฮิวA = t * 300.0 + เฟรม * 0.20
        ผูก ฮิวB = ฮิวA + 180.0

        col(ฮิวA, 120.0, 62.0, 1.0)
        วาดเส้น3มิติ(ax0, y0, az0,  ax1, y1, az1)
        col(ฮิวB, 100.0, 55.0, 1.0)
        วาดเส้น3มิติ(bx0, y0, bz0,  bx1, y1, bz1)

        ถ้า i % 4 == 0 {
            col(ฮิวA, 70.0, 38.0, 0.60)
            วาดเส้น3มิติ(ax0, y0, az0,  bx0, y0, bz0)
        }

        ผูก i = i + 1
    }
}

# ── 7 Chakra Nodes — Metabolic Pathway Acupuncture Points ────────────────────
# Placed along the helix axis (x=0, z=CZ) at the seven chakra heights.
ฟังก์ชัน จักระ(เฟรม) {
    ผูก ช้า  = เฟรม * 0.18
    ผูก กลาง = เฟรม * 0.50
    ผูก เร็ว = เฟรม * 0.92

    # 1 — Root  · Glycolysis · CV1 Huiyin · red · 6-point ATP star
    ผูก cy1 = 0.0 - H * 0.857
    vtex_star(0, cy1, CZ,   1,0,0,  0,0,1,  6, 1.5, 0.75, 0.0,  ช้า,  0.0)
    vtex_rings(0, cy1, CZ,  1,0,0,  0,0,1,  2, 24,  1.7, 0.0,   ช้า,  0.0)

    # 2 — Sacral · Krebs/TCA Cycle · CV4 Guanyuan · orange · spinning rings
    ผูก cy2 = 0.0 - H * 0.571
    vtex_rings(0, cy2, CZ,  1,0,0,  0,0,1,  3, 36,  1.6, 0.04,  กลาง, 30.0)
    vtex_chakra(0, cy2, CZ, 1,0,0,  0,0,1,  1.3, 6,              กลาง, 30.0)

    # 3 — Solar · Oxidative Phosphorylation · CV12 Zhongwan · yellow · wheel
    ผูก cy3 = 0.0 - H * 0.286
    vtex_chakra(0, cy3, CZ, 1,0,0,  0,0,1,  1.5, 8,              เร็ว, 60.0)
    vtex_star(0, cy3, CZ,   1,0,0,  0,0,1,  8, 1.7, 0.85, 0.0,  เร็ว, 60.0)

    # 4 — Heart · Fatty-Acid β-Oxidation · CV17 Shanzhong · green · lotus
    vtex_lotus(0, 0.0, CZ,  1,0,0,  0,0,1,  0.55, 1.9, 8,        ช้า, 120.0)
    vtex_flower(0, 0.0, CZ, 1,0,0,  0,0,1,  1.85, 12,            กลาง, 120.0)

    # 5 — Throat · Protein Synthesis · CV22 Tiantu · cyan · double spiral
    ผูก cy5 = H * 0.286
    vtex_spiral(0, cy5, CZ, 1,0,0,  0,0,1,  2.0, 1.5, 48,        กลาง, 200.0)
    vtex_rings(0, cy5, CZ,  1,0,0,  0,0,1,  2, 24,  1.3, 0.02,   กลาง, 200.0)

    # 6 — Third Eye · DNA Repair/Replication · GV16 Fengfu · indigo · yantra
    ผูก cy6 = H * 0.571
    vtex_yantra(0, cy6, CZ, 1,0,0,  0,0,1,  3, 1.5,               ช้า, 250.0)
    vtex_lotus(0, cy6, CZ,  1,0,0,  0,0,1,  0.45, 1.65, 16,       เร็ว, 250.0)

    # 7 — Crown · Epigenetics / Transcription · GV20 Baihui · violet · 16-petal
    ผูก cy7 = H * 0.857
    vtex_flower(0, cy7, CZ, 1,0,0,  0,0,1,  2.3, 16,              ช้า, 280.0)
    vtex_yantra(0, cy7, CZ, 1,0,0,  0,0,1,  4, 2.1,               ช้า, 280.0)
    vtex_rings(0, cy7, CZ,  1,0,0,  0,0,1,  2, 24,  2.1, 0.0,     ช้า, 280.0)
}

# ── Phos Mimosa — Light Flower ────────────────────────────────────────────────
# Top–bottom reflected symmetry: call with cy = +H*0.55 and cy = -H*0.55.
# 8-fold radial fronds (bipinnate mimosa arms) + central globular flower head.
ฟังก์ชัน ดอกแสง(เฟรม, cy) {
    ผูก ช้า  = เฟรม * 0.14
    ผูก กลาง = เฟรม * 0.48
    ผูก ฮิว  = เฟรม * 0.50

    # Globular central head
    vtex_rings(0, cy, CZ,  1,0,0,  0,0,1,  4, 36,  2.6, 0.0,  ช้า,  ฮิว + 330.0)
    vtex_flower(0, cy, CZ, 1,0,0,  0,0,1,  2.3, 8,             กลาง, ฮิว + 340.0)
    vtex_lotus(0, cy, CZ,  1,0,0,  0,0,1,  0.6, 2.5, 16,       ช้า,  ฮิว + 350.0)

    # 8 bipinnate fronds radiating outward
    ผูก k = 0
    ขณะที่ k < 8 {
        ผูก θ  = k * TAU / 8.0
        ผูก fx = cos(θ) * 3.6
        ผูก fz = CZ + sin(θ) * 3.6

        # Frond spiral tip
        vtex_spiral(fx, cy, fz,   1,0,0,  0,0,1,  1.6, 0.75, 36,  กลาง, ฮิว + k * 45.0)
        vtex_chakra(fx, cy, fz,   1,0,0,  0,0,1,  0.55, 4,         กลาง, ฮิว + k * 45.0 + 30.0)

        # Leaflet dots along each frond arm
        ผูก j = 0
        ขณะที่ j < 4 {
            ผูก frac = (j + 1) / 5.0
            ผูก jx = cos(θ) * 3.6 * frac
            ผูก jz = CZ + sin(θ) * 3.6 * frac
            vtex_star(jx, cy, jz,  1,0,0,  0,0,1,  4, 0.26, 0.13, 0.0,  กลาง, ฮิว + k*45.0 + j*20.0)
            ผูก j = j + 1
        }

        ผูก k = k + 1
    }

    # Reflection ring — marks the mirror plane
    vtex_rings(0, cy, CZ,  1,0,0,  0,0,1,  1, 48,  4.6, 0.0,  ช้า, ฮิว + 0.0)
}

# ── Octagonal Walls — Asian Calligraphy + Chakra Panels ──────────────────────
ฟังก์ชัน ผนัง8เหลี่ยม(เฟรม, ฮิว) {
    ผูก k = 0
    ขณะที่ k < 8 {
        ผูก θ  = k * TAU / 8.0
        ผูก cθ = cos(θ)
        ผูก sθ = sin(θ)
        ผูก cx = R * cθ
        ผูก cz = CZ + R * sθ
        # Wall tangent U = perpendicular in XZ: (-sinθ, 0, cosθ)
        ผูก ux = 0.0 - sθ
        ผูก uz = cθ

        # Calligraphy rain column
        vtex_letter_rain(cx, 0, cz,  ux,0,uz,  0,1,0,  22,16,  0.62,0.55,  0.022,  เฟรม, ฮิว + k*45.0)
        # Central chakra panel motif
        vtex_chakra(cx, 0, cz,  ux,0,uz,  0,1,0,  3.0, 8,  เฟรม * 0.50, ฮิว + k*45.0 + 20.0)
        # Upper border ring
        vtex_rings(cx,  H*0.75, cz,  ux,0,uz,  0,1,0,  2,12,  1.2,0.0,  เฟรม * 0.32, ฮิว + k*45.0 + 60.0)
        # Lower border ring
        vtex_rings(cx, 0.0 - H*0.75, cz,  ux,0,uz,  0,1,0,  2,12,  1.2,0.0,  เฟรม * 0.32, ฮิว + k*45.0 + 120.0)
        # Star panel accent (top-centre and bottom-centre of each wall)
        vtex_star(cx,  H*0.45, cz,  ux,0,uz,  0,1,0,  6,0.7,0.35,0.0,  เฟรม*0.4, ฮิว + k*45.0 + 90.0)
        vtex_star(cx, 0.0 - H*0.45, cz,  ux,0,uz,  0,1,0,  6,0.7,0.35,0.0,  เฟรม*0.4, ฮิว + k*45.0 + 180.0)

        ผูก k = k + 1
    }
}

# ── Dome Ceiling — Greek Meander Equator + Concentric Tiers ──────────────────
ฟังก์ชัน โดม(เฟรม, ฮิว) {
    ผูก ช้า  = เฟรม * 0.12
    ผูก กลาง = เฟรม * 0.44

    # Equator band — Greek meander (dense grid + wide star + concentric rings)
    vtex_grid(0, H, CZ,   1,0,0,  0,0,1,  32, 8,  0.70, 0.28,  เฟรม, ฮิว + 40.0)
    vtex_star(0, H, CZ,   1,0,0,  0,0,1,  8, R*0.82, R*0.62, 0.0,  ช้า,  ฮิว + 50.0)
    vtex_rings(0, H, CZ,  1,0,0,  0,0,1,  3, 48,  R*0.88, 0.0,      ช้า,  ฮิว + 45.0)

    # Tier 1 — hyperbolic UV + rings
    ผูก dY1 = H + 1.9
    ผูก dR1 = R * 0.70
    vtex_hyperbolic_uv(0, dY1, CZ,  1,0,0,  0,0,1,  dR1*0.88, 12, 16,  เฟรม, ฮิว + 30.0)
    vtex_rings(0, dY1, CZ,  1,0,0,  0,0,1,  2, 36,  dR1, 0.0,          ช้า,  ฮิว + 35.0)

    # Tier 2 — flower + chakra
    ผูก dY2 = H + 3.9
    ผูก dR2 = R * 0.48
    vtex_flower(0, dY2, CZ,  1,0,0,  0,0,1,  dR2, 16,             กลาง, ฮิว + 20.0)
    vtex_chakra(0, dY2, CZ,  1,0,0,  0,0,1,  dR2 * 0.78, 8,       กลาง, ฮิว + 15.0)
    vtex_spiral(0, dY2, CZ,  1,0,0,  0,0,1,  1.8, dR2, 64,        กลาง, ฮิว + 25.0)

    # Tier 3 — yantra + lotus
    ผูก dY3 = H + 5.6
    ผูก dR3 = R * 0.26
    vtex_yantra(0, dY3, CZ,  1,0,0,  0,0,1,  3, dR3 * 1.6,        ช้า, ฮิว + 5.0)
    vtex_lotus(0, dY3, CZ,   1,0,0,  0,0,1,  dR3*0.4, dR3, 12,    ช้า, ฮิว + 10.0)

    # Crown apex — 8-pointed star of light
    vtex_star(0, H+7.0, CZ,  1,0,0,  0,0,1,  8, 1.25, 0.62, 0.0,  ช้า, ฮิว + 280.0)
    vtex_rings(0, H+7.0, CZ, 1,0,0,  0,0,1,  2, 24,  1.4, 0.0,    ช้า, ฮิว + 280.0)
    vtex_flower(0, H+7.0, CZ, 1,0,0, 0,0,1,  1.0, 8,              กลาง, ฮิว + 290.0)
}

# ── Floor — Sacred Yantra Lake ────────────────────────────────────────────────
ฟังก์ชัน พื้น(เฟรม, ฮิว) {
    ผูก cy  = 0.0 - H
    ผูก ช้า = เฟรม * 0.14
    vtex_tessellated(0, cy, CZ,  1,0,0,  0,0,1,  28,28,  0.70,0.22,5.0,  เฟรม, ฮิว + 5.0)
    vtex_yantra(0, cy, CZ,  1,0,0,  0,0,1,  4, R*0.58,   เฟรม, ฮิว + 0.0)
    vtex_rings(0, cy, CZ,   1,0,0,  0,0,1,  6, 48,  R*0.52, 0.0,  ช้า, ฮิว + 10.0)
    vtex_halftone(0, cy, CZ, 1,0,0, 0,0,1,  24,24,  0.60,0.55,0.30,  เฟรม, ฮิว + 15.0)
    vtex_lotus(0, cy, CZ,   1,0,0,  0,0,1,  1.0, 3.8, 8,  ช้า, ฮิว + 20.0)
}

# ── Lights ────────────────────────────────────────────────────────────────────
# 7 chakra lights along the helix spine + dome gold + floor cool
ฟังก์ชัน แสง(เฟรม) {
    clear_lights()
    ผูก t   = เฟรม * 0.005
    # Seven chakra point lights (root → crown)
    add_light(0.0, 0.0 - H*0.857, CZ,  1.0, 0.10, 0.10, 1.4, 9.0)  # root    red
    add_light(0.0, 0.0 - H*0.571, CZ,  1.0, 0.45, 0.08, 1.2, 8.0)  # sacral  orange
    add_light(0.0, 0.0 - H*0.286, CZ,  0.90, 0.90, 0.08, 1.0, 7.5) # solar   yellow
    add_light(0.0, 0.0,           CZ,  0.10, 0.90, 0.10, 1.3, 8.0)  # heart   green
    add_light(0.0, H*0.286,       CZ,  0.10, 0.70, 1.00, 1.0, 7.5)  # throat  cyan
    add_light(0.0, H*0.571,       CZ,  0.30, 0.10, 1.00, 1.0, 7.5)  # third   indigo
    add_light(0.0, H*0.857,       CZ,  0.80, 0.10, 1.00, 1.4, 9.0)  # crown   violet
    # Dome overhead warm gold — slow orbit
    add_light(sin(t)*4.0, H+3.5, CZ+cos(t)*2.0,  1.0,0.88,0.30, 2.2,16.0)
    # Cool floor moonlight
    add_light(0.0, 0.0 - H - 2.0, CZ,  0.28, 0.38, 0.80, 0.8, 12.0)
    # Mimosa blossom glow (slow counter-orbit)
    add_light(sin(t*1.3)*3.5, H*0.55, CZ+cos(t*0.8)*2.5,  0.90,0.70,1.0, 1.2,7.0)
}

# ── Audio — 7-tone Solfège mapped to metabolic chakras ────────────────────────
ฟังก์ชัน เสียง() {
    audio_tone(0,  0.0, 0.0-H*0.857, CZ,  2.2,  174.61, 0.09, 0.10, 0.008)  # F3 root
    audio_tone(1,  0.0, 0.0-H*0.571, CZ,  1.9,  196.00, 0.08, 0.13, 0.008)  # G3 sacral
    audio_tone(2,  0.0, 0.0-H*0.286, CZ,  1.6,  261.63, 0.08, 0.16, 0.009)  # C4 solar
    audio_tone(3,  0.0, 0.0,          CZ,  1.4,  329.63, 0.09, 0.18, 0.010)  # E4 heart
    audio_tone(4,  0.0, H*0.286,      CZ,  1.2,  392.00, 0.07, 0.20, 0.010)  # G4 throat
    audio_tone(5,  0.0, H*0.571,      CZ,  0.9,  523.25, 0.06, 0.22, 0.011)  # C5 third
    audio_tone(6,  0.0, H*0.857,      CZ,  0.6,  659.25, 0.05, 0.26, 0.012)  # E5 crown
    audio_volume(0.52)
}

# ═══════════════════════════════════════════════════════════════════════════════
# MAIN — 中脈輪 · Chinese Chakras
# ═══════════════════════════════════════════════════════════════════════════════

ผูก เริ่ม = ทำ {
    เปิดหน้าต่างเต็มจอ("中脈輪 · Chinese Chakras · จักระจีโนม")
    จับเมาส์()
    set_ambient(0.04)
    เสียง()

    ผูก กรอบ        = 0
    ผูก cam_px      = 0.0
    ผูก cam_py      = 0.0
    ผูก cam_pz      = 0.0
    ผูก cam_zdist   = 2.0
    ผูก cam_ry_off  = 0.0
    ผูก cam_rx_off  = 0.0
    ผูก cam_manual  = 0
    ผูก cam_idle    = 0
    ผูก cam_ry_snap = 0.0
    ผูก cam_rx_snap = 0.0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(2, 0, 6)

        # Gentle auto-orbit (±0.30 yaw, ±0.14 pitch)
        ผูก ry = sin(กรอบ * 0.00038) * 0.30
        ผูก rx = sin(กรอบ * 0.00021) * 0.14

        ผูก mdx = mouse_dx()
        ผูก mdy = mouse_dy()
        ผูก any_input = 0
        ถ้า key_down("w")      { ผูก any_input = 1 }
        ถ้า key_down("s")      { ผูก any_input = 1 }
        ถ้า key_down("a")      { ผูก any_input = 1 }
        ถ้า key_down("d")      { ผูก any_input = 1 }
        ถ้า key_down("space")  { ผูก any_input = 1 }
        ถ้า key_down("lshift") { ผูก any_input = 1 }
        ถ้า key_down("left")   { ผูก any_input = 1 }
        ถ้า key_down("right")  { ผูก any_input = 1 }
        ถ้า key_down("up")     { ผูก any_input = 1 }
        ถ้า key_down("down")   { ผูก any_input = 1 }
        ถ้า mdx * mdx + mdy * mdy > 0.25 { ผูก any_input = 1 }
        ถ้า any_input == 1 {
            ผูก cam_manual = 1
            ผูก cam_idle   = 0
        }
        ถ้า cam_manual == 1 {
            ผูก cam_idle = cam_idle + 1
            ถ้า cam_idle > 300 {
                ผูก cam_manual = 0
                ผูก cam_idle   = 0
            }
        }
        ถ้า cam_manual == 1 {
            ผูก cam_ry_off = cam_ry_off + mdx * 0.0022
            ผูก cam_rx_off = cam_rx_off + mdy * 0.0022
            ถ้า cam_rx_off >  3.14159 { ผูก cam_rx_off =  3.14159 }
            ถ้า cam_rx_off < -3.14159 { ผูก cam_rx_off = -3.14159 }
            ถ้า key_down("left")  { ผูก cam_ry_off = cam_ry_off - 0.018 }
            ถ้า key_down("right") { ผูก cam_ry_off = cam_ry_off + 0.018 }
            ถ้า key_down("up")    { ผูก cam_rx_off = cam_rx_off - 0.018 }
            ถ้า key_down("down")  { ผูก cam_rx_off = cam_rx_off + 0.018 }
            ผูก fwd_x = sin(cam_ry_snap + cam_ry_off)
            ผูก fwd_z = cos(cam_ry_snap + cam_ry_off)
            ผูก rgt_x = cos(cam_ry_snap + cam_ry_off)
            ผูก rgt_z = 0.0 - sin(cam_ry_snap + cam_ry_off)
            ผูก spd   = 0.12
            ถ้า key_down("w") { ผูก cam_px = cam_px + fwd_x*spd; ผูก cam_pz = cam_pz + fwd_z*spd }
            ถ้า key_down("s") { ผูก cam_px = cam_px - fwd_x*spd; ผูก cam_pz = cam_pz - fwd_z*spd }
            ถ้า key_down("a") { ผูก cam_px = cam_px - rgt_x*spd; ผูก cam_pz = cam_pz - rgt_z*spd }
            ถ้า key_down("d") { ผูก cam_px = cam_px + rgt_x*spd; ผูก cam_pz = cam_pz + rgt_z*spd }
            ถ้า key_down("space")  { ผูก cam_py = cam_py + spd }
            ถ้า key_down("lshift") { ผูก cam_py = cam_py - spd }
            ถ้า key_pressed("numpad+") { ผูก cam_zdist = cam_zdist + 0.5 }
            ถ้า key_pressed("numpad-") {
                ผูก cam_zdist = cam_zdist - 0.5
                ถ้า cam_zdist < 0.5 { ผูก cam_zdist = 0.5 }
            }
        }
        ถ้า cam_manual == 0 {
            ผูก cam_ry_snap = ry
            ผูก cam_rx_snap = rx
            ผูก cam_ry_off  = cam_ry_off * 0.97
            ผูก cam_rx_off  = cam_rx_off * 0.97
            ผูก cam_px      = cam_px     * 0.97
            ผูก cam_py      = cam_py     * 0.97
            ผูก cam_pz      = cam_pz     * 0.97
        }

        ผูก cry = cos(cam_ry_snap + cam_ry_off)
        ผูก sry = sin(cam_ry_snap + cam_ry_off)
        ผูก crx = cos(cam_rx_snap + cam_rx_off)
        ผูก srx = sin(cam_rx_snap + cam_rx_off)
        set_camera(cry, sry, crx, srx)
        set_camera_pos(cam_px, cam_py, cam_pz)
        set_zdist(cam_zdist)
        audio_listener(cry, sry, crx, srx)

        แสง(กรอบ)

        ผูก ฮิว = กรอบ * 0.35

        # Room shell
        พื้น(กรอบ, ฮิว)
        โดม(กรอบ, ฮิว)
        ผนัง8เหลี่ยม(กรอบ, ฮิว)

        # Genome helix — central DNA pillar
        จีโนม(กรอบ)

        # 7 Chakra / metabolic pathway nodes along the helix
        จักระ(กรอบ)

        # Phos Mimosa — top and bottom in mirrored symmetry
        ดอกแสง(กรอบ,  H * 0.55)
        ดอกแสง(กรอบ,  0.0 - H * 0.55)

        แสดงผล()
        ผูก กรอบ = กรอบ + 1
    }
}
