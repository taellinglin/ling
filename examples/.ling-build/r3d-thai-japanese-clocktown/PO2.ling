令 W = 14.0
令 H = 9.0
令 FZ = 24.0
令 center_x = 0.0
令 center_z = FZ * 0.45
令 FC4 = 261.63

令 F1_m_a = 730
令 F2_m_a = 1090
令 F3_m_a = 2440
令 F1_m_o = 570
令 F2_m_o = 840
令 F3_m_o = 2410
令 F1_m_e = 500
令 F2_m_e = 1840
令 F3_m_e = 2480
令 F1_m_i = 310
令 F2_m_i = 2790
令 F3_m_i = 2960
令 F1_m_u = 310
令 F2_m_u = 870
令 F3_m_u = 2240
令 F1_m_v = 310
令 F2_m_v = 2000
令 F3_m_v = 2640

令 F1_f_a = 860
令 F2_f_a = 1286
令 F3_f_a = 2880
令 F1_f_o = 673
令 F2_f_o = 991
令 F3_f_o = 2840
令 F1_f_e = 590
令 F2_f_e = 2171
令 F3_f_e = 2930
令 F1_f_i = 366
令 F2_f_i = 3292
令 F3_f_i = 3490
令 F1_f_u = 366
令 F2_f_u = 1027
令 F3_f_u = 3040
令 F1_f_v = 366
令 F2_f_v = 2360
令 F3_f_v = 3590

函 sm2_hash(cx ry a b) {
    令 p = cx * 2166136261.0 + ry * 16777619.0
    令 s = sin(p * 0.0000031 + a) * 0.5 + 0.5
    令 c = cos(p * 0.0000059 - b) * 0.5 + 0.5
    s * 0.618 + c * 0.382
}

函 init_audio() {
    audio_tone(0 0 0 center_z 8.0 FC4 0.22 0.000 0.000)
    audio_tone(1 -4.0 1.5 center_z 3.0 F1_m_a 0.12 0.000 0.000)
    audio_tone(2 -4.0 1.5 center_z 3.0 F2_m_a 0.12 0.000 0.000)
    audio_tone(3 -4.0 1.5 center_z 3.0 F3_m_a 0.08 0.000 0.000)
    audio_tone(4 4.0 1.5 center_z 3.0 F1_f_a 0.12 0.000 0.000)
    audio_tone(5 4.0 1.5 center_z 3.0 F2_f_a 0.12 0.000 0.000)
    audio_tone(6 4.0 1.5 center_z 3.0 F3_f_a 0.08 0.000 0.000)
    audio_volume(0.55)
}

函 update_vowel(voice vowel breath) {
    若 voice == "yang" {
        若 vowel == "a" {
            730 * (1 + (breath-0.5)*0.15)
            1090 * (1 + (breath-0.5)*0.15)
            2440 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "o" {
            570 * (1 + (breath-0.5)*0.15)
            840 * (1 + (breath-0.5)*0.15)
            2410 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "e" {
            500 * (1 + (breath-0.5)*0.15)
            1840 * (1 + (breath-0.5)*0.15)
            2480 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "i" {
            310 * (1 + (breath-0.5)*0.15)
            2790 * (1 + (breath-0.5)*0.15)
            2960 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "u" {
            310 * (1 + (breath-0.5)*0.15)
            870 * (1 + (breath-0.5)*0.15)
            2240 * (1 + (breath-0.5)*0.08)
        }
        否则 {
            310 * (1 + (breath-0.5)*0.15)
            2000 * (1 + (breath-0.5)*0.15)
            2640 * (1 + (breath-0.5)*0.08)
        }
    } 否则 {
        若 vowel == "a" {
            860 * (1 + (breath-0.5)*0.15)
            1286 * (1 + (breath-0.5)*0.15)
            2880 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "o" {
            673 * (1 + (breath-0.5)*0.15)
            991 * (1 + (breath-0.5)*0.15)
            2840 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "e" {
            590 * (1 + (breath-0.5)*0.15)
            2171 * (1 + (breath-0.5)*0.15)
            2930 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "i" {
            366 * (1 + (breath-0.5)*0.15)
            3292 * (1 + (breath-0.5)*0.15)
            3490 * (1 + (breath-0.5)*0.08)
        }
        若 vowel == "u" {
            366 * (1 + (breath-0.5)*0.15)
            1027 * (1 + (breath-0.5)*0.15)
            3040 * (1 + (breath-0.5)*0.08)
        }
        否则 {
            366 * (1 + (breath-0.5)*0.15)
            2360 * (1 + (breath-0.5)*0.15)
            3590 * (1 + (breath-0.5)*0.08)
        }
    }
}

函 audio_tone_update(slot freq amp) { }

函 draw_doll_eye(x y z is_left is_male blink pupil_dilate gaze_x gaze_y hue FR) {
    令 eye_width = 0.52
    令 eye_height = 0.38
    若 is_male == 1 {
        eye_height = eye_height * 0.92
    } 否则 {
        eye_height = eye_height * 1.08
    }
    令 open = 1.0 - blink
    若 is_male == 1 {
        vtex_hyperbolic_uv(x y z-0.05 1 0 0 0 1 0 eye_width*1.2 4 6 FR*0.02 hue+3.8)
        vtex_rings(x y-0.08 z-0.05 0 1 0 1 0 0 2 4 eye_width*1.1 0.02 FR*0.01 hue+3.5)
    } 否则 {
        vtex_flower(x y z-0.05 1 0 0 0 1 0 eye_width*1.15 6 FR*0.03 hue+4.0)
        vtex_chakra(x y-0.05 z-0.05 1 0 0 0 1 0 eye_width*1.0 1 FR*0.01 hue+3.8)
    }
    令 eyeball_r = eye_width * 0.48 * open
    vtex_chakra(x y z 1 0 0 0 1 0 eyeball_r 32 FR*0.05 hue+5.5)
    令 iris_r = eyeball_r * 0.65
    令 iris_hue = hue+4.2
    若 is_male == 0 {
        iris_hue = hue+5.8
    }
    vtex_lotus(x + gaze_x*0.12 y + gaze_y*0.08 z+0.02 1 0 0 0 1 0 iris_r*0.7 iris_r 8 FR*0.08 iris_hue)
    令 pupil_r = iris_r * (0.35 + pupil_dilate * 0.15)
    vtex_chakra(x + gaze_x*0.15 y + gaze_y*0.10 z+0.04 1 0 0 0 1 0 pupil_r 1 FR*0.10 hue+2.0)
    vtex_chakra(x + 0.12 + gaze_x*0.08 y + 0.10 + gaze_y*0.06 z+0.06 1 0 0 0 1 0 pupil_r*0.28 1 FR*0.15 hue+7.0)
    若 open > 0.1 {
        循 (令 i = 0; i < 14; i = i + 1) {
            令 angle = -1.2 + i * 0.18
            令 lash_len = 0.12
            若 is_male == 1 {
                lash_len = lash_len * 0.85
            } 否则 {
                lash_len = lash_len * 1.15
            }
            令 lx = x + cos(angle) * eye_width * 0.85
            令 ly = y + sin(angle) * eye_height * 0.7 - 0.05
            vtex_spiral(lx ly z+0.03 0 1 0 1 0 0 0.008 lash_len 3 FR*0.2 hue+4.5)
        }
        循 (令 i = 0; i < 10; i = i + 1) {
            令 angle = 0.5 + i * 0.15
            令 lash_len = 0.07
            若 is_male == 1 {
                lash_len = lash_len * 0.90
            } 否则 {
                lash_len = lash_len * 1.10
            }
            令 lx = x + cos(angle) * eye_width * 0.75
            令 ly = y + sin(angle) * eye_height * 0.6 + 0.03
            vtex_spiral(lx ly z+0.02 0 1 0 1 0 0 0.006 lash_len 2 FR*0.18 hue+4.6)
        }
    }
    令 brow_y = y + 0.28
    若 is_male == 1 {
        brow_y = brow_y * 0.90
    } 否则 {
        brow_y = brow_y * 1.10
    }
    若 is_male == 1 {
        vtex_hyperbolic_uv(x brow_y z-0.02 1 0 0 0 0 1 eye_width*1.2 3 5 FR*0.04 hue+3.2)
    } 否则 {
        vtex_flower(x brow_y z-0.02 1 0 0 0 1 0 eye_width*1.1 5 FR*0.05 hue+3.5)
        vtex_star(x brow_y-0.03 z-0.01 1 0 0 0 1 0 3 eye_width*0.9 eye_width*0.35 0.02 FR*0.06 hue+3.8)
    }
}

函 draw_yang_face(x y z hue FR breath blink pupil_dilate mouth_open vowel_shape) {
    vtex_hyperbolic_uv(x y z 1 0 0 0 1 0 1.8 6 8 FR*0.01 hue+1.5)
    vtex_rings(x y-0.15 z 1 0 0 0 1 0 2 6 1.6 0.03 FR*0.008 hue+1.2)
    vtex_hyperbolic_uv(x-0.65 y-0.35 z+0.02 0 1 0 1 0 0 0.45 3 4 FR*0.015 hue+1.0)
    vtex_hyperbolic_uv(x+0.65 y-0.35 z+0.02 0 1 0 1 0 0 0.45 3 4 FR*0.015 hue+1.0)
    vtex_hyperbolic_uv(x y+0.22 z+0.05 1 0 0 0 1 0 1.4 4 6 FR*0.012 hue+0.8)
    vtex_spiral(x y-0.05 z+0.08 0 1 0 1 0 0 0.06 0.55 16 FR*0.03 hue+1.2)
    vtex_chakra(x y-0.20 z+0.10 1 0 0 0 1 0 0.12 1 FR*0.04 hue+1.0)
    draw_doll_eye(x-0.48 y+0.10 z+0.04 1 1 blink pupil_dilate 0.02 breath*0.05 hue FR)
    draw_doll_eye(x+0.48 y+0.10 z+0.04 0 1 blink pupil_dilate -0.02 breath*0.05 hue FR)
    令 mouth_width = 0.45 + vowel_shape * 0.15
    令 mouth_height = 0.12 * mouth_open
    令 mouth_y = y - 0.38
    vtex_lotus(x mouth_y z+0.06 1 0 0 0 1 0 mouth_height*0.6 mouth_width 4 FR*0.08 hue+2.0)
    vtex_rings(x mouth_y z+0.05 1 0 0 0 1 0 1 8 mouth_width 0.02 FR*0.06 hue+1.8)
    若 mouth_open > 0.1 {
        vtex_hyperbolic_uv(x mouth_y - mouth_height*0.5 z+0.03 1 0 0 0 1 0 mouth_width*0.8 3 4 FR*0.05 hue+1.5)
    }
}

函 draw_yin_face(x y z hue FR breath blink pupil_dilate mouth_open vowel_shape) {
    vtex_flower(x y z 1 0 0 0 1 0 1.75 12 FR*0.012 hue+2.5)
    vtex_hyperbolic_uv(x y z 1 0 0 0 1 0 1.6 8 10 FR*0.01 hue+2.2)
    vtex_rings(x-0.55 y-0.18 z+0.02 1 0 0 0 1 0 2 6 0.38 0.01 FR*0.02 hue+3.0)
    vtex_rings(x+0.55 y-0.18 z+0.02 1 0 0 0 1 0 2 6 0.38 0.01 FR*0.02 hue+3.0)
    vtex_spiral(x y-0.08 z+0.07 0 1 0 1 0 0 0.04 0.42 12 FR*0.035 hue+2.8)
    vtex_chakra(x y-0.22 z+0.09 1 0 0 0 1 0 0.08 1 FR*0.045 hue+2.5)
    draw_doll_eye(x-0.50 y+0.12 z+0.04 1 0 blink pupil_dilate 0.03 breath*0.06 hue FR)
    draw_doll_eye(x+0.50 y+0.12 z+0.04 0 0 blink pupil_dilate -0.03 breath*0.06 hue FR)
    令 mouth_width = 0.48 + vowel_shape * 0.18
    令 mouth_height = 0.14 * mouth_open
    令 mouth_y = y - 0.40
    vtex_lotus(x mouth_y z+0.06 1 0 0 0 1 0 mouth_height*0.7 mouth_width 6 FR*0.09 hue+3.2)
    vtex_rings(x mouth_y z+0.05 1 0 0 0 1 0 2 12 mouth_width 0.02 FR*0.07 hue+2.8)
    vtex_flower(x mouth_y-0.02 z+0.04 1 0 0 0 1 0 mouth_width*0.9 8 FR*0.08 hue+3.0)
    vtex_hyperbolic_uv(x mouth_y-0.06 z+0.03 1 0 0 0 1 0 mouth_width*0.7 3 4 FR*0.055 hue+2.6)
}

函 get_breath_phase(FR) {
    令 cycle_frame = FR % 180
    令 breath_strength = 0.0
    令 mouth_open = 0.0
    令 blink = 0.0
    若 cycle_frame < 60 {
        breath_strength = cycle_frame / 60.0
        mouth_open = breath_strength * 0.6
    } 若 cycle_frame < 75 {
        breath_strength = 1.0
        mouth_open = 0.1
    } 若 cycle_frame < 135 {
        令 exhale_t = (cycle_frame - 75) / 60.0
        breath_strength = 1.0 - exhale_t
        mouth_open = 0.3 + exhale_t * 0.4
    } 否则 {
        breath_strength = 0.0
        mouth_open = 0.0
    }
    令 blink_at = 0
    若 cycle_frame < 3 {
        blink_at = 1
    }
    若 cycle_frame > 57 && cycle_frame < 63 {
        blink_at = 1
    }
    若 cycle_frame > 72 && cycle_frame < 78 {
        blink_at = 1
    }
    若 cycle_frame > 132 && cycle_frame < 138 {
        blink_at = 1
    }
    令 random_blink = 0
    若 sm2_hash(FR 0 0.1 0.2) > 0.98 {
        random_blink = 1
    }
    blink_at + random_blink
    breath_strength
    mouth_open
}

函 get_current_vowel(FR) {
    令 vowel_index = (FR / 180) % 6
    令 vowels = ["a", "o", "e", "i", "u", "ü"]
    vowels[vowel_index]
}

函 get_vowel_shape(vowel) {
    若 vowel == "a" {
        0.9
    } 若 vowel == "o" {
        0.7
    } 若 vowel == "e" {
        0.5
    } 若 vowel == "i" {
        0.3
    } 若 vowel == "u" {
        0.4
    } 若 vowel == "ü" {
        0.6
    } 否则 {
        0.5
    }
}

函 draw_lissajous_formants(FR hd current_vowel breath_strength) {
    令 f1 = 0
    令 f2 = 0
    令 f3 = 0
    若 current_vowel == "a" {
        f1 = 730
        f2 = 1090
        f3 = 2440
    }
    若 current_vowel == "o" {
        f1 = 570
        f2 = 840
        f3 = 2410
    }
    若 current_vowel == "e" {
        f1 = 500
        f2 = 1840
        f3 = 2480
    }
    若 current_vowel == "i" {
        f1 = 310
        f2 = 2790
        f3 = 2960
    }
    若 current_vowel == "u" {
        f1 = 310
        f2 = 870
        f3 = 2240
    }
    若 current_vowel == "ü" {
        f1 = 310
        f2 = 2000
        f3 = 2640
    }
    令 px = -3.0 + (f2 - 800) / 2500 * 6.0
    令 py = -2.0 + (f1 - 300) / 600 * 5.0
    令 size = 0.3 + (f3 - 2200) / 1400 * 0.7
    令 t = FR * 0.008
    令 lx = px + sin(t * 2.0) * size * 0.4 * breath_strength
    令 ly = py + cos(t * 3.0) * size * 0.4 * breath_strength
    令 lz = center_z - 1.0 + sin(t * 1.7) * 0.8
    vtex_star(lx ly lz 1 0 0 0 1 0 4 size*1.2 size*0.48 0.03 FR*0.12 hd+4.0)
    vtex_rings(lx ly lz 1 0 0 0 1 0 2 8 size*0.8 0.02 FR*0.08 hd+3.5)
    vtex_hyperbolic_uv(lx ly lz 1 0 0 0 1 0 size 3 5 FR*0.06 hd+4.2)
    循 (令 i = 1; i <= 8; i = i + 1) {
        令 trail_t = FR * 0.008 - i * 0.12
        令 trail_lx = px + sin(trail_t * 2.0) * size * 0.4 * breath_strength
        令 trail_ly = py + cos(trail_t * 3.0) * size * 0.4 * breath_strength
        vtex_chakra(trail_lx trail_ly lz - i*0.03 1 0 0 0 1 0 size*0.15 1 FR*0.1 hd+4.5 - i*0.2)
    }
    vtex_hyperbolic_uv(-4.0 py center_z-0.5 0 1 0 1 0 0 0.08 1 2 FR*0.02 hd+3.0)
    vtex_hyperbolic_uv(px -3.0 center_z-0.5 1 0 0 0 1 0 0.08 1 2 FR*0.02 hd+3.2)
    vtex_rings(px py center_z-1.2 1 0 0 0 0 1 1 6 size*0.5 0.0 FR*0.04 hd+3.8)
}

函 draw_meditation_ground(FR hd) {
    令 gy = 0 - 4.5
    令 gz = FZ * 0.50
    vtex_hyperbolic_uv(0 gy gz 1 0 0 0 0 1 10.0 8 12 FR*0.015 hd+2.0)
    vtex_tessellated(0 gy gz 1 0 0 0 0 1 24 18 0.35 0.12 4.0 FR hd+2.5)
    vtex_lotus(0 gy+0.5 gz-1.0 1 0 0 0 0 1 0.48 1.60 8 FR hd+1.0)
    vtex_rings(0 gy+0.5 gz-1.0 1 0 0 0 0 1 4 8 2.20 0.06 FR*0.02 hd+1.5)
}

函 setup_lights(FR) {
    clear_lights()
    add_light(0 0 center_z-1.0 0.85 0.72 0.48 3.5 14.0)
    add_light(-4.2 1.2 center_z-0.5 0.72 0.68 0.58 2.8 10.0)
    add_light(4.2 1.2 center_z-0.5 0.82 0.70 0.55 2.8 10.0)
    add_light(0 2.5 center_z+1.0 0.35 0.40 0.55 1.5 18.0)
}

令 启 = 执 {
    เปิดหน้าต่างเต็มจอ("หลิง หยิน-หยาง")
    capture_mouse()
    set_ambient(0.06)
    init_audio()
    令 帧 = 0
    set_camera(0.0 0.0 1.0 0.0)
    set_camera_pos(0.0 0.0 -8.0)
    set_zdist(2.0)
    循 หน้าต่างเปิดอยู่() {
        เติม(1 2 8)
        令 hd = 帧 * 0.055
        令 blink_trigger breath_strength mouth_open = get_breath_phase(帧)
        令 current_vowel = get_current_vowel(帧)
        令 vowel_shape = get_vowel_shape(current_vowel)
        令 pupil_dilate = 0.3 + breath_strength * 0.2
        令 f1_m f2_m f3_m = update_vowel("yang" current_vowel breath_strength)
        audio_tone_update(1 f1_m 0.12 * breath_strength)
        audio_tone_update(2 f2_m 0.12 * breath_strength)
        audio_tone_update(3 f3_m 0.08 * breath_strength)
        令 f1_f f2_f f3_f = update_vowel("yin" current_vowel breath_strength)
        audio_tone_update(4 f1_f 0.12 * breath_strength)
        audio_tone_update(5 f2_f 0.12 * breath_strength)
        audio_tone_update(6 f3_f 0.08 * breath_strength)
        setup_lights(帧)
        draw_meditation_ground(帧 hd)
        draw_yang_face(-4.2 0.8 center_z-0.8 hd 帧 breath_strength blink_trigger pupil_dilate mouth_open vowel_shape)
        draw_yin_face(4.2 0.8 center_z-0.8 hd 帧 breath_strength blink_trigger pupil_dilate mouth_open vowel_shape)
        draw_lissajous_formants(帧 hd current_vowel breath_strength)
        令 breath_particles = 20 + breath_strength * 40
        循 (令 i = 0; i < breath_particles; i = i + 1) {
            令 px = -3.0 + sm2_hash(i 帧*0.01 0.0 0.0) * 6.0
            令 py = -2.0 + (breath_strength * 5.0) + sm2_hash(i+100 帧*0.02 0.0 0.0) * 2.0
            令 sz = center_z - 1.0 + sm2_hash(i+200 帧*0.015 0.0 0.0) * 1.5
            vtex_chakra(px py sz 1 0 0 0 1 0 0.04 + breath_strength*0.06 1 帧*0.1 hd+6.0)
        }
        vtex_chakra(0 1.8 center_z-1.2 1 0 0 0 1 0 0.35 1 帧*0.1 hd+5.5)
        vtex_rings(0 1.8 center_z-1.2 1 0 0 0 1 0 2 6 0.65 0.02 帧*0.08 hd+5.0)
        令 cycle_frame = 帧 % 180
        若 cycle_frame < 60 {
            vtex_hyperbolic_uv(0 -1.0 + breath_strength*3 center_z-1.5 1 0 0 0 1 0 1.2 3 5 帧*0.06 hd+6.5)
        } 若 cycle_frame < 75 {
            vtex_lotus(0 1.2 center_z-1.5 1 0 0 0 1 0 0.32 1.10 8 帧 hd+7.0)
        } 若 cycle_frame < 135 {
            vtex_hyperbolic_uv(0 2.0 - breath_strength*1.5 center_z-1.3 1 0 0 0 1 0 1.5 * breath_strength 4 7 帧*0.1 hd+5.8)
        } 否则 {
            vtex_chakra(0 -0.5 center_z-1.5 1 0 0 0 1 0 0.15 1 帧*0.05 hd+4.5)
        }
        แสดงผล()
        令 帧 = 帧 + 1
    }
}