# ════════════════════════════════════════════════════════════════════════════
# สามเหลี่ยมเซียร์พินสกี้สีหมุนวน  —  Animated Sierpiński Triangle (Thai)
# เขียนด้วยภาษาลิง
#
# วิธีรัน:
#   ling run examples/color-serpinski.ling
#
# กด Escape หรือปิดหน้าต่างเพื่อออก
# ════════════════════════════════════════════════════════════════════════════

# ── ตั้งค่าสีแบบ RGB จาก HSV-ผ่าน-ไซน์ ──────────────────────────────────────
# t   = เวลา (เฟรม * 0.04)
# เฟส = ระดับ * (2π/6) ≈ 1.0472 — แต่ละระดับเหลื่อมกัน 60°
#
# สูตร: channel = sin(t + เฟส + offset) × 127 + 128
#   offset สำหรับ R=0, G=2π/3≈2.094, B=4π/3≈4.189
#
ฟังก์ชัน สีระดับ(ระดับ, เฟรม) {
    ผูก t    = เฟรม * 0.04
    ผูก เฟส  = ระดับ * 1.0472
    ผูก r    = sin(t + เฟส)         * 127 + 128
    ผูก g    = sin(t + เฟส + 2.094) * 127 + 128
    ผูก b    = sin(t + เฟส + 4.189) * 127 + 128
    สีดินสอ(r, g, b)
}

# ── วาดเซียร์พินสกี้แบบ "ทาจากใหญ่ไปเล็ก" (paint large → small) ────────────
#
# วาดสามเหลี่ยมนี้ก่อนด้วยสีของระดับนี้ จากนั้นวาดทับ 3 มุมด้วยสามเหลี่ยมย่อย
# ทำให้กลางสามเหลี่ยมแต่ละระดับมีสีที่ต่างกัน — ไม่ต้องแตะพื้นหลังเลย
#
ฟังก์ชัน วาดเซียร์(x1, y1, x2, y2, x3, y3, ระดับ, เฟรม) {
    สีระดับ(ระดับ, เฟรม)
    วาดสามเหลี่ยม(x1, y1, x2, y2, x3, y3)

    ถ้า ระดับ > 0 {
        ผูก mx12 = (x1 + x2) / 2
        ผูก my12 = (y1 + y2) / 2
        ผูก mx23 = (x2 + x3) / 2
        ผูก my23 = (y2 + y3) / 2
        ผูก mx13 = (x1 + x3) / 2
        ผูก my13 = (y1 + y3) / 2

        วาดเซียร์(x1,   y1,   mx12, my12, mx13, my13, ระดับ - 1, เฟรม)
        วาดเซียร์(mx12, my12, x2,   y2,   mx23, my23, ระดับ - 1, เฟรม)
        วาดเซียร์(mx13, my13, mx23, my23, x3,   y3,   ระดับ - 1, เฟรม)
    }
}

# ── โปรแกรมหลัก ─────────────────────────────────────────────────────────────
ผูก เริ่ม = ทำ {
    เปิดหน้าต่าง(800, 700, "สามเหลี่ยมเซียร์พินสกี้ — Ling")

    ผูก เฟรม = 0

    ขณะที่ หน้าต่างเปิดอยู่() {
        # ล้างหน้าจอด้วยพื้นหลังสีน้ำเงินดำ
        เติม(8, 6, 18)

        # วาดสามเหลี่ยมเซียร์พินสกี้  6 ระดับ  จุดบน=(400,30), ล่างซ้าย=(40,670), ล่างขวา=(760,670)
        วาดเซียร์(400, 30, 40, 670, 760, 670, 6, เฟรม)

        แสดงผล()

        ผูก เฟรม = เฟรม + 1
    }
}
