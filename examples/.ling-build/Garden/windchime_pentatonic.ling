# ════════════════════════════════════════════════════════════════════════════════
# windchime_pentatonic.ling  —  风铃五声螺旋阶梯 (Enhanced: Faster, Shorter, Echo)
# ════════════════════════════════════════════════════════════════════════════════

令 N    = 81
令 W    = 1920.0
令 H    = 1080.0
令 CZ   = 6.0
令 总高  = N * 0.24

令 基R   = 4.2
令 收缩  = 0.9675
令 步高  = 0.24
令 键宽  = 0.43
令 键深  = 0.17
令 管基  = 0.88
令 阳台  = 0.30

令 帧速基 = 28.0
令 帧速减 = 0.48
令 拖尾  = 24

函 hcol(hue, sat, lit, dim) {
    令 h = hue * pi / 180.0
    令 r = clamp((sin(h)         * sat + lit) * dim, 0.0, 255.0)
    令 g = clamp((sin(h + 2.094) * sat + lit) * dim, 0.0, 255.0)
    令 b = clamp((sin(h + 4.189) * sat + lit) * dim, 0.0, 255.0)
    สีดินสอ(r, g, b)
}

# Echo arrays using separate lists
令 回声索引 = []
令 回声帧 = []
令 回声幅 = []

函 add_echo(idx, fr, amp) {
    回声索引.push(idx)
    回声帧.push(fr)
    回声幅.push(amp)
}

函 is_echo_active(idx, fr) {
    令 i = 0
    循 i < 回声索引.len() {
        若 回声索引[i] == idx {
            若 fr - 回声帧[i] < 30 {
                返 1
            }
        }
        i = i + 1
    }
    返 0
}

函 get_echo_dim(idx, fr) {
    令 i = 0
    循 i < 回声索引.len() {
        若 回声索引[i] == idx {
            令 age = fr - 回声帧[i]
            若 age < 30 {
                返 (1.0 - age / 30.0) * 0.45
            }
        }
        i = i + 1
    }
    返 0.0
}

函 cleanup_echoes(fr) {
    令 新索引 = []
    令 新帧 = []
    令 新幅 = []
    令 i = 0
    循 i < 回声索引.len() {
        若 fr - 回声帧[i] < 35 {
            新索引.push(回声索引[i])
            新帧.push(回声帧[i])
            新幅.push(回声幅[i])
        }
        i = i + 1
    }
    回声索引 = 新索引
    回声帧 = 新帧
    回声幅 = 新幅
}

令 启 = 执 {
    令 帧   = 0
    令 当音  = 0
    令 亮音  = 0
    令 触帧  = 12
    令 摆幅  = 0.0
    令 摆相  = 0.0
    令 管当  = 管基

    เปิดหน้าต่างเต็มจอ("风铃五声螺旋阶梯 — 回声增强版", W, H)

    循 หน้าต่างเปิดอยู่() {
        เติม(2, 4, 18)

        # ── HYPERBOLIC FLOATING CAMERA ──────────────────────────────────
        令 t1 = 帧 * 0.00098
        令 t2 = 帧 * 0.00162
        令 t3 = 帧 * 0.00077
        令 t4 = 帧 * 0.0021
        令 cX = sin(t1) * 10.8 + sin(t2 * 1.35) * 2.6 + sin(t4 * 1.8) * 1.2
        令 cZ = CZ + 14.5 + cos(t1 * 1.22) * 3.4 + sin(t2 * 0.88) * 1.7 + cos(t4 * 1.2) * 0.9
        令 cY = 总高/2 - 2.5 + sin(t3 * 1.42) * 4.6 + cos(t3 * 0.72) * 2.1

        令 dx = 0.0 - cX
        令 dy = 总高/2 - 2.0 - cY
        令 dz = CZ - cZ
        令 dd = sqrt(dx*dx + dy*dy + dz*dz)
        若 dd > 0.0001 {
            dx = dx / dd
            dy = dy / dd
            dz = dz / dd
        }
        令 ry = atan2(dx, dz)
        令 rx = asin(dy)
        ตั้งกล้อง(cos(ry), sin(ry), cos(rx), sin(rx))
        ตั้งตำแหน่งกล้อง(cX, cY, cZ)
        ตั้งระยะห่าง(2.5)

        # ── LIGHTING ────────────────────────────────────────────────────
        ตั้งแสงรอบข้าง(0.04)
        ล้างแสง()
        เพิ่มแสง(0.0, 总高/2 + 9.0, CZ, 1.0, 0.90, 0.75, 2.4, 40.0)
        เพิ่มแสง(0.0, -4.0, CZ + 9.0, 0.18, 0.40, 1.0, 1.1, 24.0)
        
        若 摆幅 > 0.03 {
            令 aθ = 亮音 * pi / 6.0
            令 aR = 基R * pow(收缩, 亮音)
            令 pulse = 0.8 + 摆幅 * 1.2
            เพิ่มแสง(aR * cos(aθ), 亮音 * 步高 - 总高/2 + 0.5, CZ + aR * sin(aθ),
                     1.0 * pulse, 0.7 * pulse, 0.3 * pulse, 摆幅 * 5.0, 8.0)
        }

        # ── DRAW ALL 81 CHIMES ──────────────────────────────────────────
        令 i = 0
        循 i < N {
            令 θ  = i * pi / 6.0
            令 R  = 基R * pow(收缩, i)
            令 pX = R * cos(θ)
            令 pZ = CZ + R * sin(θ)
            令 pY = i * 步高 - 总高/2

            令 tX = 0.0 - sin(θ)
            令 tZ = cos(θ)
            令 rX = cos(θ)
            令 rZ = sin(θ)

            令 管L = 管基 * pow(0.982, i)
            若 管L < 0.12 { 令 管L = 0.12 }

            令 音级 = (i * 7) % 12
            令 色相 = 音级 * 30.0

            令 亮 = 0.12
            令 闪 = 0.0
            
            若 i == 亮音 {
                亮 = 1.0
                闪 = 摆幅
            } 否则 {
                令 拖 = 亮音 - i
                若 拖 > 0 && 拖 < 拖尾 {
                    亮 = 0.20 + (拖尾 - 拖) / 拖尾 * 0.75
                    闪 = (拖尾 - 拖) / 拖尾 * 0.4
                }
            }
            
            令 echo_dim = get_echo_dim(i, 帧)
            若 echo_dim > 0.0 {
                亮 = 亮 + echo_dim
                闪 = 闪 + echo_dim * 0.5
            }
            
            亮 = clamp(亮, 0.08, 1.0)

            # ── Pendulum swing ──────────────────────────────────────────
            令 swX = 0.0
            令 swZ = 0.0
            若 i == 亮音 {
                令 sw = sin(摆相) * 摆幅 * 0.35
                swX = sw * tX
                swZ = sw * tZ
            }
            令 bX = pX + swX
            令 bZ = pZ + swZ

            # ── Chime tube ──────────────────────────────────────────────
            令 sat = 110.0 + 闪 * 100.0
            令 lit = 45.0 + 闪 * 140.0
            hcol(色相, sat, lit, 亮)
            
            令 thickness = clamp(管L * 0.5, 0.02, 0.12)
            วาดเส้น3มิติ(bX, pY, bZ, bX, pY - 管L, bZ)
            若 管L > 0.4 {
                วาดเส้น3มิติ(bX + thickness*0.3, pY, bZ + thickness*0.3, 
                             bX + thickness*0.3, pY - 管L, bZ + thickness*0.3)
                วาดเส้น3มิติ(bX - thickness*0.3, pY, bZ - thickness*0.3, 
                             bX - thickness*0.3, pY - 管L, bZ - thickness*0.3)
            }

            # ── Piano key cap ───────────────────────────────────────────
            令 kw = 键宽 * pow(0.9915, i)
            令 kd = 键深 * pow(0.9915, i)
            令 aX = bX - kw*tX - kd*rX
            令 aZ = bZ - kw*tZ - kd*rZ
            令 bkX = bX + kw*tX - kd*rX
            令 bkZ = bZ + kw*tZ - kd*rZ
            令 ckX = bX + kw*tX + kd*rX
            令 ckZ = bZ + kw*tZ + kd*rZ
            令 dkX = bX - kw*tX + kd*rX
            令 dkZ = bZ - kw*tZ + kd*rZ
            hcol(色相, sat + 30.0, lit + 20.0, 亮)
            วาดสามเหลี่ยม3มิติ(aX, pY + 0.03, aZ, bkX, pY + 0.03, bkZ, ckX, pY + 0.03, ckZ)
            วาดสามเหลี่ยม3มิติ(aX, pY + 0.03, aZ, ckX, pY + 0.03, ckZ, dkX, pY + 0.03, dkZ)

            # ── 7th balcony ─────────────────────────────────────────────
            若 i % 5 == 4 {
                令 bY = pY - 管L * 0.35
                令 eX = bX + rX * 阳台
                令 eZ = bZ + rZ * 阳台
                hcol(色相 + 65.0, 70.0, 75.0, 亮 * 0.68)
                วาดเส้น3มิติ(bX, bY, bZ, eX, bY, eZ)
                令 bkw = kw * 0.38
                令 bkd = kd * 0.42
                วาดสามเหลี่ยม3มิติ(eX - bkw*tX, bY + 0.01, eZ - bkw*tZ,
                                     eX + bkw*tX, bY + 0.01, eZ + bkw*tZ,
                                     eX, bY + 0.01, eZ + rZ*bkd)
            }

            # ── Spiral ring for non-pentatonic ──────────────────────────
            令 五声 = 0
            若 音级 == 0 { 五声 = 1 }
            若 音级 == 2 { 五声 = 1 }
            若 音级 == 4 { 五声 = 1 }
            若 音级 == 7 { 五声 = 1 }
            若 音级 == 9 { 五声 = 1 }
            若 五声 == 0 {
                令 sR = R * 0.42
                令 sY = pY - 管L * 0.58
                令 sk = 0
                循 sk < 8 {
                    令 sa = sk * pi / 4.0
                    令 sb = (sk + 1.0) * pi / 4.0
                    令 sXa = bX + cos(sa) * sR
                    令 sZa = bZ + sin(sa) * sR
                    令 sXb = bX + cos(sb) * sR
                    令 sZb = bZ + sin(sb) * sR
                    hcol(色相 + 195.0, 55.0, 55.0, 亮 * 0.45)
                    วาดเส้น3มิติ(sXa, sY, sZa, sXb, sY, sZb)
                    sk = sk + 1
                }
            }

            i = i + 1
        }

        # ── TRIGGER NEXT NOTE ───────────────────────────────────────────
        若 帧 == 触帧 && 当音 < N {
            令 帧速当 = 帧速基 - 当音 * 帧速减
            若 帧速当 < 8.0 { 帧速当 = 8.0 }
            
            令 freq = 55.0 * pow(1.5, 当音)
            循 freq > 1760.0 { freq = freq * 0.5 }
            循 freq < 55.0   { freq = freq * 2.0 }
            
            令 管今 = 管基 * pow(0.982, 当音)
            若 管今 < 0.12 { 管今 = 0.12 }

            令 attack = 0.02 + (当音 / N) * 0.06
            令 amp = 0.22 + (1.0 - 当音 / N) * 0.28
            令 lfo = 3.5 + 当音 * 0.12
            令 lfd = 0.012 + (N - 当音) / N * 0.048

            เสียงโทน(当音 % 8, 0.0, 0.0, 0.0, attack, freq, amp, lfo, lfd)
            
            # Add echoes
            令 echo_count = 4 + 当音 / 20
            若 echo_count > 8 { echo_count = 8 }
            令 e = 1
            循 e <= echo_count {
                令 echo_delay = 0.08 + e * 0.06
                令 echo_amp = amp * pow(0.55, e) * (1.0 - 当音 / N * 0.4)
                令 echo_freq = freq * (1.0 + e * 0.003)
                令 echo_slot = (当音 + e * 3) % 8
                若 echo_slot < 8 {
                    เสียงโทน(echo_slot, 0.0, 0.0, 0.0, attack * 1.2, echo_freq, echo_amp, lfo * 1.1, lfd * 1.2)
                }
                e = e + 1
            }
            
            add_echo(当音, 帧, 1.0)
            
            摆幅 = 1.2
            摆相 = 0.0
            管当 = 管今
            亮音 = 当音
            当音 = 当音 + 1
            触帧 = 帧 + 帧速当
        }

        # ── PENDULUM PHYSICS ────────────────────────────────────────────
        令 ω = sqrt(9.81 / (管当 + 0.35))
        若 管当 < 0.3 { ω = ω * 1.4 }
        摆相 = 摆相 + ω * 0.052
        摆幅 = 摆幅 * 0.945

        # ── VISUAL ECHO PARTICLES ───────────────────────────────────────
        令 eidx = 0
        循 eidx < 回声索引.len() {
            令 eco_idx = 回声索引[eidx]
            令 eco_age = 帧 - 回声帧[eidx]
            若 eco_age < 20 {
                令 θ_e = eco_idx * pi / 6.0
                令 R_e = 基R * pow(收缩, eco_idx)
                令 x_e = R_e * cos(θ_e)
                令 z_e = CZ + R_e * sin(θ_e)
                令 y_e = eco_idx * 步高 - 总高/2 - 0.3 - eco_age * 0.05
                令 alpha = (1.0 - eco_age / 20.0) * 0.6
                令 hue_e = ((eco_idx * 7) % 12) * 30.0
                hcol(hue_e + 30, 120.0, 80.0, alpha)
                วาดเส้น3มิติ(x_e - 0.08, y_e, z_e, x_e + 0.08, y_e, z_e)
                วาดเส้น3มิติ(x_e, y_e - 0.05, z_e, x_e, y_e + 0.08, z_e)
            }
            eidx = eidx + 1
        }
        cleanup_echoes(帧)

        # ── AMBIENT BREATH PARTICLES ────────────────────────────────────
        令 粒子数 = 30 + 摆幅 * 40
        令 p = 0
        循 p < 粒子数 {
            令 pr = 3.0 + (帧 * 0.023 + p) % 7.0
            令 pa = (帧 * 0.012 + p) * 1.2
            令 px = sin(pa) * pr
            令 pz = CZ + cos(pa * 0.7) * pr
            令 py = (总高/2) * ((帧 * 0.008 + p) % 1) - 2.0
            hcol(180.0 + py * 180.0, 40.0, 30.0, 0.12)
            วาดเส้น3มิติ(px, py, pz, px + 0.03, py + 0.05, pz + 0.03)
            p = p + 1
        }

        แสดงผล()
        帧 = 帧 + 1
    }
}