# ════════════════════════════════════════════════════════════════════════════
# Garden.ling — The Synesthetic Garden
#
# An open outdoor garden — no walls, no ceiling.  Ground, open sky, living
# geometry.  A reflective pond at centre, two foreground trees, scattered
# flower beds, a backdrop tree line, and a wooden garden shed.
#
# Shape → Tone mapping (pentatonic G major: G A B D E):
#   DOT   (tiny chakra, single ring)          → G3 = 196.00 Hz  (earth pulse)
#   LINE  (grid, yantra, flat rings)           → A3 = 220.00 Hz  (wind chime)
#   CURVE (spiral, lotus, flower)              → B3 = 246.94 Hz  (bird / water)
#   BLOOM (flower + rings together)            → D4 = 293.66 Hz  (sunlight shimmer)
#   SKY   (hyperbolic, star)                   → E4 = 329.63 Hz  (sky drone)
#
# SM2-inspired hash: ground patches and shed planks each get independent
# hash seeds — every surface has its own pseudo-random detail density.
#
# Camera: slow panoramic yaw + slight upward tilt, 520-frame period.
# ════════════════════════════════════════════════════════════════════════════

令 W   = 10.0
令 H   = 5.5
令 FZ  = 20.0
令 NZ  = 1.5
令 MZ  = 10.75    # (NZ + FZ) / 2

令 PX  = 0.0      # pond centre x
令 PZ  = 9.0      # pond centre z

令 SX  = 5.8      # shed centre x
令 SZ  = 14.5     # shed centre z

# Pentatonic G major frequencies
令 PG3 = 196.00   # G3 — earth / ground
令 PA3 = 220.00   # A3 — wind / path
令 PB3 = 246.94   # B3 — water / bird
令 PD4 = 293.66   # D4 — sunlight / bloom
令 PE4 = 329.63   # E4 — sky drone


# ════════════════════════════════════════════════════════════════════════════
# SM2-INSPIRED HASH  (ground and shed surface seeding)
# ════════════════════════════════════════════════════════════════════════════

函 sm2_hash(cx, ry, a, b) {
    令 p = cx * 2166136261.0 + ry * 16777619.0
    令 s = sin(p * 0.0000031 + a) * 0.5 + 0.5
    令 c = cos(p * 0.0000059 - b) * 0.5 + 0.5
    s * 0.618 + c * 0.382
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO  — five pentatonic voices
#   earth hum · water ripple · sky drone · bird chirp · wind breeze
# ════════════════════════════════════════════════════════════════════════════

函 init_audio() {
    # slot  x          y         z      w    freq  amp  lfo_hz  depth
    audio_tone(0,  PX,       0-H,     PZ,   3.0,  PG3, 0.09, 0.04, 0.002)
    audio_tone(1,  PX,       0,       PZ,   2.5,  PB3, 0.10, 0.28, 0.030)
    audio_tone(2,  0,        H,       MZ,   4.0,  PE4, 0.08, 0.07, 0.005)
    audio_tone(3,  0-W*0.4,  H*0.5,  MZ*0.75, 2.0, PD4, 0.09, 3.20, 0.180)
    audio_tone(4,  SX,       0,       SZ,   2.0,  PA3, 0.08, 0.34, 0.038)
    audio_tone(5,  0,        H*0.4,   MZ,   3.5,  PB3, 0.07, 0.17, 0.018)
    audio_volume(0.48)
}


# ════════════════════════════════════════════════════════════════════════════
# LIGHTS
# ════════════════════════════════════════════════════════════════════════════

函 setup_lights(FR) {
    clear_lights()

    # Sun — warm bright, slow arc overhead
    令 ts = FR * 0.0026
    add_light(
        cos(ts) * 8.0,
        H + 2.2 + sin(ts) * 1.4,
        MZ + sin(ts * 0.5) * 4.0,
        1.00, 0.94, 0.70,   5.2, 18.0
    )

    # Sky fill — soft blue from above
    add_light(0, H + 1.0, MZ,   0.30, 0.50, 0.92,   1.2, 16.0)

    # Pond shimmer — cool reflection ripple
    令 tp = FR * 0.040
    add_light(
        PX + sin(tp) * 0.6,  0-H + 0.4,  PZ + cos(tp) * 0.5,
        0.26, 0.66, 0.98,   1.6, 7.0
    )

    # Shed lantern — warm amber, slight flicker
    令 tl = FR * 0.058
    add_light(
        SX + sin(tl) * 0.14,  0-H + 1.9,  SZ - 0.4,
        1.00, 0.68, 0.20,   1.8, 5.5
    )

    # Ground bounce — warm fill from below
    add_light(0,  0-H + 0.1,  MZ,   0.38, 0.26, 0.14,   0.6, 9.0)
}


# ════════════════════════════════════════════════════════════════════════════
# GROUND  — grass, stone path, flower-bed patches
# ════════════════════════════════════════════════════════════════════════════

函 draw_ground(FR, hd) {
    令 gy = 0 - H
    令 gz = FZ * 0.50

    # Grass — SM2-hash tessellation (earth/green hue band)
    令 h1 = sm2_hash(2.0, 6.0,  FR * 0.0018,  FR * 0.0024)
    令 h2 = sm2_hash(6.0, 2.0,  FR * 0.0024,  FR * 0.0018)
    vtex_tessellated(0, gy, gz,  1,0,0,  0,0,1,  26, 22,  0.30 + h1*0.12, 0.08 + h2*0.04, 4.0,  FR, hd + 2.2)

    # Stone path — central yantra + grid (LINE → A3)
    vtex_yantra(0, gy, gz * 0.68,  1,0,0,  0,0,1,  4, 4.2,  FR * 0.06, hd + 1.0)
    vtex_grid(0, gy, gz * 0.52,    1,0,0,  0,0,1,  18, 8,  0.56, 0.38,  FR * 0.04, hd + 0.6)

    # Flower-bed ground patches — SM2-seeded chakra base (DOT → G3)
    令 h3 = sm2_hash(4.0, 8.0,  FR * 0.0015,  FR * 0.0032)
    令 h4 = sm2_hash(8.0, 4.0,  FR * 0.0032,  FR * 0.0015)
    vtex_chakra(0-3.5, gy, gz * 0.52,  1,0,0,  0,0,1,  2.6, 5,  FR, hd + 0.0 + h3 * 1.5)
    vtex_chakra( 2.8,  gy, gz * 0.60,  1,0,0,  0,0,1,  2.2, 5,  FR, hd + 2.0 + h4 * 1.5)

    # Back ground fade
    vtex_grid(0, gy, gz * 1.18,  1,0,0,  0,0,1,  20, 14,  0.58, 0.52,  FR * 0.03, hd + 2.8)
}


# ════════════════════════════════════════════════════════════════════════════
# SKY  — open dome: sun disc, drifting clouds, horizon glow
# ════════════════════════════════════════════════════════════════════════════

函 draw_sky(FR, hd) {
    令 sy = H
    令 sz = FZ * 0.50

    # Sky dome — hyperbolic Poincaré field (slow = drifting clouds)
    vtex_hyperbolic_uv(0, sy, sz,  1,0,0,  0,0,1,  9.0, 6, 10,  FR * 0.014, hd + 4.5)

    # Sun disc — 5-point star + radiant rings (SKY → E4)
    vtex_star(0, sy + 1.8, sz - 3.5,   1,0,0,  0,0,1,  5, 1.3, 0.52, 0.03,  FR * 0.50, hd + 0.7)
    vtex_rings(0, sy + 1.8, sz - 3.5,  1,0,0,  0,0,1,  2, 5,  2.0, 0.0,    FR * 0.50, hd + 1.1)

    # Cloud banks — slow, large, soft rings (LINE → A3)
    vtex_rings(0-3.5, sy + 0.6, sz + 1.2,  1,0,0,  0,0,1,  1, 5,  3.4, 0.0,  FR * 0.007, hd + 4.0)
    vtex_rings( 4.0,  sy + 0.9, sz - 1.8,  1,0,0,  0,0,1,  1, 5,  2.7, 0.0,  FR * 0.009, hd + 4.6)

    # Horizon glow — large flower silhouette at FZ back
    vtex_flower(0, sy - 1.4, FZ,  1,0,0,  0,0,1,  7.5, 5,  FR * 0.016, hd + 3.8)
}


# ════════════════════════════════════════════════════════════════════════════
# TREE  — spiral trunk rings + layered flower/lotus crown
# ════════════════════════════════════════════════════════════════════════════

函 draw_tree(x, z, scale, FR, hd) {
    令 ty_mid   = 0 - H + scale * 1.1
    令 ty_top   = 0 - H + scale * 2.2
    令 ty_crown = 0 - H + scale * 2.85

    # Trunk rings — horizontal circles stacked in XZ plane (DOT → G3)
    vtex_rings(x, ty_mid, z,  0,1,0,  1,0,0,  3, 4,  scale * 0.22, 0.0,  FR * 0.04, hd + 1.8)
    # Bark spiral — vertical twist (CURVE → B3)
    vtex_spiral(x, ty_mid, z,  0,1,0,  1,0,0,  scale * 0.07, scale * 1.1, 30,  FR * 0.07, hd + 1.5)

    # Lower crown flower (BLOOM → D4)
    vtex_flower(x, ty_top, z,    1,0,0,  0,1,0,  scale * 1.05, 8,  FR * 0.20, hd + 2.5)
    # Crown lotus (CURVE → B3)
    vtex_lotus(x, ty_top, z,     1,0,0,  0,1,0,  scale * 0.28, scale * 0.86, 10,  FR * 0.24, hd + 2.0)
    # Upper crown tip flower
    vtex_flower(x, ty_crown, z,  1,0,0,  0,1,0,  scale * 0.58, 6,  FR * 0.32, hd + 3.0)
    # Crown star (SKY → E4)
    vtex_star(x, ty_crown + scale * 0.32, z,  1,0,0,  0,1,0,  5, scale * 0.28, scale * 0.11, 0.04,  FR, hd + 0.5)
}


# ════════════════════════════════════════════════════════════════════════════
# TREES  — two foreground + tree-line backdrop
# ════════════════════════════════════════════════════════════════════════════

函 draw_trees(FR, hd) {
    # Left foreground — tall oak
    draw_tree(0-5.8, 7.5,  2.0,  FR, hd + 0.0)
    # Right foreground — medium birch
    draw_tree( 3.2,  6.8,  1.7,  FR, hd + 1.2)
    # Back left
    draw_tree(0-6.5, 15.0, 1.4,  FR, hd + 2.4)
    # Back right
    draw_tree( 5.5,  13.5, 1.3,  FR, hd + 3.6)
    # Distant tree line
    draw_tree(0-3.0, 18.0, 1.0,  FR, hd + 0.8)
    draw_tree( 0.8,  19.0, 0.9,  FR, hd + 1.6)
    draw_tree( 4.5,  17.5, 1.1,  FR, hd + 2.8)
}


# ════════════════════════════════════════════════════════════════════════════
# FLOWERS  — scattered beds, left, right, path edges
# ════════════════════════════════════════════════════════════════════════════

函 draw_flowers(FR, hd) {
    令 fy = 0 - H + 0.05

    # Left bed — warm reds / golds
    vtex_flower(0-4.0, fy + 0.55, 5.5,   1,0,0,  0,1,0,  0.36, 6,  FR * 0.60, hd + 0.5)
    vtex_lotus( 0-4.0, fy + 0.34, 5.5,   1,0,0,  0,1,0,  0.11, 0.32, 8,  FR,        hd + 0.2)
    vtex_flower(0-4.8, fy + 0.44, 6.2,   1,0,0,  0,1,0,  0.28, 5,  FR * 0.70, hd + 1.0)
    vtex_flower(0-3.4, fy + 0.48, 4.8,   1,0,0,  0,1,0,  0.30, 7,  FR * 0.50, hd + 1.5)
    # DOT accents (G3 tone)
    vtex_chakra(0-3.8, fy + 0.20, 5.2,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 0.0)
    vtex_chakra(0-4.4, fy + 0.18, 6.8,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 0.8)

    # Right bed — blues / purples
    vtex_flower( 3.8,  fy + 0.50, 5.2,   1,0,0,  0,1,0,  0.33, 6,  FR * 0.55, hd + 3.8)
    vtex_lotus(  3.8,  fy + 0.30, 5.2,   1,0,0,  0,1,0,  0.10, 0.30, 8,  FR,        hd + 3.5)
    vtex_flower( 4.5,  fy + 0.44, 5.9,   1,0,0,  0,1,0,  0.26, 5,  FR * 0.65, hd + 4.2)
    vtex_flower( 3.2,  fy + 0.46, 4.6,   1,0,0,  0,1,0,  0.28, 7,  FR * 0.45, hd + 4.8)
    vtex_chakra( 3.6,  fy + 0.18, 5.0,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 3.0)
    vtex_chakra( 4.2,  fy + 0.16, 6.5,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 3.8)

    # Path-edge accent flowers
    vtex_lotus( 0-1.2, fy + 0.42, 8.5,   1,0,0,  0,1,0,  0.14, 0.42, 6,  FR * 0.80, hd + 2.0)
    vtex_flower(  1.4, fy + 0.38, 8.8,   1,0,0,  0,1,0,  0.24, 5,  FR * 0.70, hd + 5.0)

    # Scattered singles
    vtex_chakra(0-5.5, fy + 0.14, 9.5,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 0.8)
    vtex_chakra(  4.8, fy + 0.14, 7.5,   1,0,0,  0,1,0,  0.06, 1,  FR, hd + 4.0)
    vtex_chakra(0-2.5, fy + 0.12, 12.0,  1,0,0,  0,1,0,  0.05, 1,  FR, hd + 1.5)
    vtex_flower(  2.0, fy + 0.35, 11.5,  1,0,0,  0,1,0,  0.20, 5,  FR * 0.55, hd + 2.8)
    vtex_lotus( 0-3.0, fy + 0.30, 11.0,  1,0,0,  0,1,0,  0.09, 0.28, 6,  FR * 0.60, hd + 1.8)
}


# ════════════════════════════════════════════════════════════════════════════
# POND  — reflective basin, floating lotus, fountain jet, ripple rings
# ════════════════════════════════════════════════════════════════════════════

函 draw_pond(FR, hd) {
    令 py = 0 - H + 0.02

    # Water surface — SM2-hash hyperbolic ripple (CURVE → B3)
    令 hw = sm2_hash(5.0, 5.0,  FR * 0.0038,  FR * 0.0044)
    vtex_hyperbolic_uv(PX, py, PZ,  1,0,0,  0,0,1,  2.8, 5, 10,  FR * (0.08 + hw * 0.04), hd + 4.2)

    # Concentric ripple rings (LINE → A3)
    vtex_rings(PX, py, PZ,  1,0,0,  0,0,1,  4, 5,  3.0, 0.14,  FR, hd + 4.8)

    # Floating lotus (CURVE → B3)
    vtex_lotus(PX,          py + 0.06, PZ,           1,0,0,  0,0,1,  0.20, 0.65, 8,  FR * 0.54, hd + 3.6)
    vtex_lotus(PX + 0.9,    py + 0.05, PZ + 0.7,     1,0,0,  0,0,1,  0.15, 0.46, 6,  FR * 0.59, hd + 5.0)
    vtex_lotus(PX - 0.8,    py + 0.05, PZ - 0.6,     1,0,0,  0,0,1,  0.13, 0.40, 6,  FR * 0.64, hd + 2.5)

    # Fountain jet — vertical spiral (CURVE)
    vtex_spiral(PX, py + 0.85, PZ,  0,1,0,  1,0,0,  0.09, 0.82, 32,  FR * 0.88, hd + 4.6)

    # Pond edge — 5-spoke ring border (DOT → G3)
    vtex_chakra(PX, py, PZ,  1,0,0,  0,0,1,  3.2, 5,  FR * 0.05, hd + 3.0)
}


# ════════════════════════════════════════════════════════════════════════════
# SHED  — wooden garden shed
#
# Front wall (faces viewer, z ≈ SZ−1.8): grid planks, door, window
# Left side  (x ≈ SX−1.8):               grid planks
# Roof       (y ≈ −H+3.2):               yantra + chakra + ridge star
# Interior   (seen through open door):    tools, flower pot, shelf lantern
# ════════════════════════════════════════════════════════════════════════════

函 draw_shed(FR, hd) {
    令 swy  = 0 - H + 1.55    # wall mid-height
    令 sfz  = SZ - 1.8        # front wall z
    令 sxl  = SX - 1.85       # left side wall x
    令 sry  = 0 - H + 3.18    # roof y

    # SM2-hash seeds for plank textures
    令 hp = sm2_hash(7.0, 3.0,  FR * 0.0012,  FR * 0.0018)
    令 hs = sm2_hash(3.0, 7.0,  FR * 0.0018,  FR * 0.0012)

    # FRONT WALL — wood plank grid (LINE → A3)
    vtex_grid(SX, swy, sfz,   1,0,0,  0,1,0,  14, 10,  0.25 + hp * 0.04, 0.33,  FR * 0.02, hd + 1.5)

    # DOOR — flower frame + ring surround (BLOOM → D4)
    vtex_flower(SX - 0.5, swy - 0.18, sfz - 0.06,  1,0,0,  0,1,0,  0.70, 4,  FR * 0.14, hd + 1.2)
    vtex_rings( SX - 0.5, swy - 0.18, sfz - 0.06,  1,0,0,  0,1,0,  1, 4,  0.73, 0.0,  FR * 0.14, hd + 0.8)
    # Door handle DOT (G3)
    vtex_chakra(SX - 0.14, swy - 0.24, sfz - 0.07,  1,0,0,  0,1,0,  0.05, 1,  FR, hd + 0.2)

    # WINDOW — eight-petal flower lattice (BLOOM)
    vtex_flower(SX + 0.72, swy + 0.44, sfz - 0.05,  1,0,0,  0,1,0,  0.40, 8,  FR * 0.18, hd + 2.8)
    vtex_rings( SX + 0.72, swy + 0.44, sfz - 0.05,  1,0,0,  0,1,0,  1, 4,  0.43, 0.0,  FR * 0.09, hd + 2.4)

    # LEFT SIDE WALL (LINE)
    vtex_grid(sxl, swy, SZ,   0,0,1,  0,1,0,  10, 10,  0.26 + hs * 0.04, 0.33,  FR * 0.02, hd + 1.8)

    # ROOF — yantra base + chakra + ridge star (LINE / DOT)
    vtex_yantra(SX, sry, SZ,       1,0,0,  0,0,1,  3, 2.18,  FR * 0.03, hd + 1.2)
    vtex_chakra(SX, sry + 0.12, SZ,  1,0,0,  0,0,1,  1.90, 4,  FR * 0.03, hd + 1.0)
    vtex_rings( SX, sry, SZ,       1,0,0,  0,0,1,  1, 4,  2.26, 0.0,  FR * 0.03, hd + 0.4)
    # Ridge crest star
    vtex_star(SX, sry + 0.30, SZ,  1,0,0,  0,0,1,  4, 0.36, 0.14, 0.02,  FR * 0.08, hd + 0.6)

    # ── Interior (seen through open door) ──
    令 iz = SZ + 0.55

    # Garden tools — two LINE grid shapes (rake / shovel silhouettes)
    vtex_grid(SX + 0.62, swy + 0.22, iz,  1,0,0,  0,1,0,  1, 7,  0.06, 0.28,  FR * 0.01, hd + 2.0)
    vtex_grid(SX + 0.82, swy + 0.22, iz,  1,0,0,  0,1,0,  1, 7,  0.06, 0.28,  FR * 0.01, hd + 3.0)

    # Flower pot — DOT base + small lotus (G3 → B3)
    令 poty = 0 - H + 0.78
    vtex_chakra(SX - 0.7, poty,        iz,  1,0,0,  0,1,0,  0.17, 4,  FR * 0.05, hd + 2.4)
    vtex_lotus( SX - 0.7, poty + 0.36, iz,  1,0,0,  0,1,0,  0.07, 0.20, 6,  FR * 0.40, hd + 2.1)

    # Wall shelf (LINE grid slab)
    vtex_grid(SX, 0-H+1.90, iz + 0.45,  1,0,0,  0,0,1,  4, 1,  0.72, 0.07,  FR * 0.01, hd + 1.4)
    # Lantern on shelf — DOT + glow rings (G3)
    vtex_chakra(SX, 0-H+2.04, iz + 0.45,  1,0,0,  0,1,0,  0.07, 1,  FR, hd + 0.8)
    vtex_rings( SX, 0-H+2.04, iz + 0.45,  1,0,0,  0,1,0,  1, 6,  0.21, 0.0,  FR * 0.58, hd + 1.0)
}


# ════════════════════════════════════════════════════════════════════════════
# ECHO PASS  — temporal ghost (no letter-rain, no tessellation)
# ════════════════════════════════════════════════════════════════════════════

函 draw_echo(FR, hd) {
    令 gy = 0 - H
    令 gz = FZ * 0.50

    # Ground compass ghost
    vtex_chakra(0, gy, gz * 0.68,  1,0,0,  0,0,1,  5.8, 5,  FR, hd + 0.8)

    # Pond ripple ghost
    vtex_rings(PX, gy, PZ,  1,0,0,  0,0,1,  4, 5,  3.0, 0.14,  FR, hd + 4.8)

    # Sun ghost
    vtex_star(0, H + 1.8, FZ * 0.32,  1,0,0,  0,0,1,  5, 1.3, 0.52, 0.03,  FR * 0.50, hd + 0.7)

    # Left tree crown ghost
    vtex_flower(0-5.8, 0-H+2.0*2.2, 7.5,  1,0,0,  0,1,0,  2.0*1.05, 8,  FR * 0.20, hd + 2.5)

    # Shed roof ghost
    vtex_chakra(SX, 0-H+3.30, SZ,  1,0,0,  0,0,1,  1.90, 4,  FR * 0.03, hd + 1.0)

    # Pond lotus ghost
    vtex_lotus(PX, gy + 0.06, PZ,   1,0,0,  0,0,1,  0.20, 0.65, 8,  FR * 0.54, hd + 3.6)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN
# ════════════════════════════════════════════════════════════════════════════

令 启 = 执 {
    เปิดหน้าต่างเต็มจอ("Garden — The Synesthetic Garden")
    set_ambient(0.14)
    init_audio()

    令 帧 = 0

    循 หน้าต่างเปิดอยู่() {
        เติม(6, 10, 20)   # deep twilight-blue sky

        # Hue cycling — full spectrum every ~126 frames (~2.1 s @ 60 fps)
        令 hd = 帧 * 0.05

        # Camera: slow panoramic yaw + gentle upward tilt, 520-frame period
        令 tc = 帧 * (1.0 / 520.0) * 6.2832
        令 ry = sin(tc) * 0.20
        令 rx = sin(tc * 0.618) * 0.058 + 0.042    # slight permanent upward gaze
        令 cry = cos(ry)   令 sry = sin(ry)
        令 crx = cos(rx)   令 srx = sin(rx)
        set_camera(cry, sry, crx, srx)
        audio_listener(cry, sry, crx, srx)

        setup_lights(帧)

        # Two echo trails — offset by +1.5 and +3.0 hue
        draw_echo(帧 - 18, hd + 1.5)
        draw_echo(帧 - 36, hd + 3.0)

        # Full scene
        draw_ground(帧, hd)
        draw_sky(帧, hd)
        draw_trees(帧, hd)
        draw_pond(帧, hd)
        draw_flowers(帧, hd)
        draw_shed(帧, hd)

        แสดงผล()
        令 帧 = 帧 + 1
    }
}
