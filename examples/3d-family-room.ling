# ════════════════════════════════════════════════════════════════════════════
# 3d-family-room.ling — 囍家团圆  Double Happiness Family Hall
#
#  A warm Chinese family room celebrating Mom (母), Dad (父), and their
#  children.  The 囍 (shuāng xǐ — Double Happiness) motif is the
#  architectural soul of every surface.
#
#    Centre    — Two interlocking lotus pillars:
#                  父 Dad (left)  — strong yang chakra, warm gold rings
#                  母 Mom (right) — graceful yin lotus, jade-rose counter-spin
#                  Their shared union rings form 囍.
#
#    Children  — Three figures at floor level:
#                  长 Elder child  — bold chakra + warm orange spiral
#                  次 Younger child — smaller lotus + rosy spiral
#                  灵 Ling (potential third) — the harmony between
#                     Chinese 喜 (xǐ, joy) and Korean 기쁨 (gippeum, joy).
#                     A hybrid eight-petal lotus whose hue drifts slowly
#                     between gold (Chinese warmth) and teal (Korean stillness),
#                     breathing with a ~600-frame cycle.
#
#    Ceiling   — Red lantern festival: hyperbolic Poincaré disc + eight-petal
#               flower + radial rings in deep crimson and warm gold.
#    Floor     — Cash-coin mandala: concentric copper rings (铜钱) + yantra +
#               tessellated wave field + perspective grid.
#    Walls (4) — 囍/喜 character-rain columns, slow fall.
#
#  Framefade: Two temporal echo passes (−48, −24 frames) with warm amber
#  and rose hue drift — rotating geometry leaves glowing family-warmth trails.
#
#  Camera: Gentle warm pendulum — the feeling of watching children at play.
#
#  Audio: Five-voice family chord.
#    父 Dad   = 宫 C3 (130.81 Hz) — steady foundation
#    母 Mom   = 商 D3 (146.83 Hz) — warm second
#    长 Elder = 角 E3 (164.81 Hz) — bright third
#    次 Younger = 徵 G3 (196.00 Hz) — playful fifth
#    灵 Ling  = B♭2 (116.54 Hz) — the interval midway between
#               the Chinese 宫 root (C3) and Korean 황 root (A2);
#               a tone that belongs to both traditions and neither.
#
#  Run:  ling run examples/3d-family-room.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

ผูก W  = 9.0
ผูก H  = 4.5
ผูก FZ = 16.0
ผูก NZ = 1.4
ผูก PZ = 8.0

# Family x-positions
ผูก DAD_X    = 0 - 2.4
ผูก MOM_X    =     2.4
ผูก LING_X   = 0.0
ผูก CHILD1_X = 0 - 1.1
ผูก CHILD2_X =     1.1


# ════════════════════════════════════════════════════════════════════════════
# COLOUR HELPERS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน col(t, p) {
    สีดินสอ(
        ไซน์(t + p)         * 127 + 128,
        ไซน์(t + p + 2.094) * 127 + 128,
        ไซน์(t + p + 4.189) * 127 + 128
    )
}

ฟังก์ชัน col_dim(t, p, b) {
    สีดินสอ(
        (ไซน์(t + p)         * 127 + 128) * b,
        (ไซน์(t + p + 2.094) * 127 + 128) * b,
        (ไซน์(t + p + 4.189) * 127 + 128) * b
    )
}


# ════════════════════════════════════════════════════════════════════════════
# 父  DAD — yang pillar, left side
# Strong eight-spoke dharma wheel (father's steadiness), clockwise warm gold,
# vertical axis rings showing height/authority.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_dad(FR, hd) {
    ผูก bob = ไซน์(FR * 0.018) * 0.18
    # Eight-spoke yang chakra — steady, structural
    ลายจักร(DAD_X, bob, PZ,  1,0,0,  0,0,1,  1.52, 8,  FR, 1.0 + hd)
    # Inner lotus — warm heart
    ลายดอกบัว(DAD_X, bob, PZ,  1,0,0,  0,0,1,  0.52, 1.28, 8,  FR, 0.4 + hd)
    # Clockwise gold rings — yang rotation
    ลายวงซ้อน(DAD_X, bob, PZ,  1,0,0,  0,0,1,  3, 24,  1.65, 0.0,  FR, 1.6 + hd)
    # Eight-point authority star
    ลายดาว(DAD_X, bob, PZ,  1,0,0,  0,0,1,  8, 1.82, 0.74, 0.04,  FR, 0.2 + hd)
    # Vertical column — father's standing height
    ลายวงซ้อน(DAD_X, 0, PZ,  0,1,0,  0,0,1,  2, 20,  0.28, 0.0,  FR, 2.8 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 母  MOM — yin pillar, right side
# Twelve-petal lotus (mother's grace), counter-clockwise jade-rose,
# gentle horizontal halo showing nurturance and embrace.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_mom(FR, hd) {
    ผูก bob = ไซน์(FR * 0.016) * 0.22
    # Twelve-petal yin lotus — full bloom
    ลายดอกบัว(MOM_X, bob, PZ,  1,0,0,  0,0,1,  0.46, 1.38, 12,  FR, 3.4 + hd)
    # Counter-clockwise jade rings — yin rotation
    ลายวงซ้อน(MOM_X, bob, PZ,  1,0,0,  0,0,1,  3, 36,  1.58, 0.26,  0-FR, 5.0 + hd)
    # Twelve-petal outer flower crown
    ลายดอกไม้(MOM_X, bob, PZ,  1,0,0,  0,0,1,  1.72, 12,  FR, 4.2 + hd)
    # Horizontal embrace ring
    ลายวงซ้อน(MOM_X, bob, PZ,  1,0,0,  0,1,0,  2, 32,  0.26, 0.0,  FR, 6.0 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 囍  DOUBLE HAPPINESS — the union of 父 and 母
# Two interlocking lotus pillars share common rings at their midpoint,
# forming the character 囍 as a living geometric bond.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_double_happiness(FR, hd) {
    draw_dad(FR, hd)
    draw_mom(FR, hd)
    # Shared union rings — the 囍 bond
    ผูก cx = 0.0
    ลายวงซ้อน(cx, 0, PZ,  1,0,0,  0,1,0,  2, 48,  2.62, 0.0,  FR, 2.0 + hd)
    ลายวงซ้อน(cx, 0, PZ,  1,0,0,  0,0,1,  1, 64,  3.05, 0.13,  FR, 0.7 + hd)
    # Six-petal harmony lotus bridging the two pillars (六合 six unions)
    ลายดอกบัว(cx, 0, PZ,  1,0,0,  0,1,0,  1.48, 3.20, 6,  FR, 1.4 + hd)
    # Outermost 囍 halo
    ลายวงซ้อน(cx, 0, PZ,  0,1,0,  0,0,1,  1, 72,  3.50, 0.0,  FR, 3.0 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 长  ELDER CHILD — bold and bright, floor left
# Six-spoke chakra + ascending spiral = the confidence of a first child.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_elder_child(FR, hd) {
    ผูก y = 0 - H + 2.0
    ลายจักร(CHILD1_X, y, PZ - 0.8,  1,0,0,  0,0,1,  0.72, 6,  FR, 2.2 + hd)
    ลายเกลียว(CHILD1_X, y, PZ - 0.8,  1,0,0,  0,0,1,  0.68, 0.82, 36,  FR, 0.6 + hd)
    ลายดอกไม้(CHILD1_X, y, PZ - 0.8,  1,0,0,  0,0,1,  0.88, 6,  FR, 3.8 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 次  YOUNGER CHILD — softer and smaller, floor right
# Lotus + gentle spiral = the tender joy of a younger sibling.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_younger_child(FR, hd) {
    ผูก y = 0 - H + 1.68
    ลายจักร(CHILD2_X, y, PZ - 0.8,  1,0,0,  0,0,1,  0.56, 6,  FR, 4.6 + hd)
    ลายเกลียว(CHILD2_X, y, PZ - 0.8,  1,0,0,  0,0,1,  0.48, 0.64, 30,  FR, 5.4 + hd)
    ลายดอกบัว(CHILD2_X, y, PZ - 0.8,  1,0,0,  0,0,1,  0.20, 0.58, 6,  FR, 1.8 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# 灵  LING — potential third child, centre floor
#
#  Ling is the meeting-point of Chinese 喜 (xǐ) and Korean 기쁨 (gippeum).
#  An eight-petal lotus whose hue drifts on a ~600-frame breath between:
#    Chinese warmth  → hd+0.6  (amber-gold, the colour of 喜)
#    Korean coolness → hd+4.6  (teal-cyan, the colour of 기쁨)
#    Ling's centre   → hd+2.6  (the fusion — neither and both)
#
#  The slow drift is `sin(FR × 0.0105) × 2.0` — one full oscillation ≈ 598
#  frames, about 10 seconds: a child's long, wondering breath.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_ling(FR, hd) {
    ผูก y    = 0 - H + 2.4
    ผูก drift = ไซน์(FR * 0.0105) * 2.0
    ผูก hdl  = hd + 2.6 + drift
    # Eight-petal hybrid lotus — the blossoming of two joys
    ลายดอกบัว(LING_X, y, PZ - 1.5,  1,0,0,  0,0,1,  0.30, 0.84, 8,  FR, hdl)
    # Inner breathing rings — in/out with the drift
    ลายวงซ้อน(LING_X, y, PZ - 1.5,  1,0,0,  0,0,1,  2, 32,  0.92, 0.0,  FR, hdl + 1.2)
    # Horizontal halo (horizontal plane: the world Ling stands between)
    ลายดอกไม้(LING_X, y, PZ - 1.5,  1,0,0,  0,1,0,  1.02, 8,  FR, hdl - 0.8)
    # Light-of-possibility ring: faint, large, steady
    ลายวงซ้อน(LING_X, y, PZ - 1.5,  1,0,0,  0,1,0,  1, 48,  1.24, 0.0,  FR, hdl + 3.14159)
}


# ════════════════════════════════════════════════════════════════════════════
# ROOM SURFACES
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_floor(FR, hd) {
    ผูก cy   = 0 - H
    ผูก fmid = FZ / 2
    # Cash-coin mandala — concentric copper rings 铜钱
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  5, 40,  7.2, 0.12,  FR, 0.5 + hd)
    # Yantra — sacred family geometry (bhupura four-sided)
    ลายยันต์(0, cy, fmid,  1,0,0,  0,0,1,  4, 5.0,  FR, 0.9 + hd)
    # Stone-tile perspective grid
    ลายตาราง(0, cy, fmid,  1,0,0,  0,0,1,  28, 24,  0.64, 0.64,  FR, 2.6 + hd)
    # Warm wave field — children running barefoot
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  16, 14,  0.52, 0.18, 4.2,  FR, 0.0 + hd)
}

ฟังก์ชัน draw_ceiling(FR, hd) {
    ผูก cy   = H
    ผูก fmid = FZ / 2
    # Poincaré disc (lantern) — hyperbolic warm red
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  5.0, 12, 16,  FR, 3.0 + hd)
    # Eight-petal lantern flower
    ลายดอกไม้(0, cy, fmid,  1,0,0,  0,0,1,  3.0, 8,  FR, 1.4 + hd)
    # Concentric lantern rings
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  4, 32,  5.6, 0.06,  FR, 0.4 + hd)
    # Outer corona
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  1, 48,  7.2, 0.0,  FR, 4.4 + hd)
}

ฟังก์ชัน draw_front_wall(FR, hd) {
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  24, 14,  0.64, 0.58,  0.012,  FR, 0.0 + hd)
}

ฟังก์ชัน draw_back_wall(FR, hd) {
    # 囍 portal — back gate of double happiness
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  24, 14,  0.64, 0.58,  0.016,  FR, 1.6 + hd)
    ลายดาว(0, 0, FZ,  1,0,0,  0,1,0,  8, 4.6, 1.9, 0.05,  FR, 0.3 + hd)
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  3, 48,  5.2, 0.04,  FR, 2.4 + hd)
}

ฟังก์ชัน draw_left_wall(FR, hd) {
    ผูก cx   = 0 - W
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  20, 14,  0.64, 0.58,  0.018,  FR, 3.0 + hd)
    # Flanking lotus panel
    ลายดอกบัว(cx, 0, fmid,  0,0,1,  0,1,0,  1.2, 3.2, 8,  FR, 1.0 + hd)
}

ฟังก์ชัน draw_right_wall(FR, hd) {
    ผูก cx   = W
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  20, 14,  0.64, 0.58,  0.014,  FR, 5.0 + hd)
    ลายดอกบัว(cx, 0, fmid,  0,0,1,  0,1,0,  1.2, 3.2, 8,  FR, 4.0 + hd)
}


# ════════════════════════════════════════════════════════════════════════════
# ECHO PASS — cheap version for temporal framefade smear
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก cy_f = 0 - H
    ผูก cy_c = H
    ผูก fm   = FZ / 2

    # Floor: coins + yantra
    ลายวงซ้อน(0, cy_f, fm,  1,0,0,  0,0,1,  5, 40,  7.2, 0.12,  FR, 0.5 + hd)
    ลายยันต์(0, cy_f, fm,  1,0,0,  0,0,1,  4, 5.0,  FR, 0.9 + hd)

    # Ceiling: lantern rings + flower
    ลายวงซ้อน(0, cy_c, fm,  1,0,0,  0,0,1,  4, 32,  5.6, 0.06,  FR, 0.4 + hd)
    ลายดอกไม้(0, cy_c, fm,  1,0,0,  0,0,1,  3.0, 8,  FR, 1.4 + hd)

    # Back portal
    ลายดาว(0, 0, FZ,  1,0,0,  0,1,0,  8, 4.6, 1.9, 0.05,  FR, 0.3 + hd)
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  3, 48,  5.2, 0.04,  FR, 2.4 + hd)

    # Family (sparse — core silhouettes only)
    ผูก bob_d = ไซน์(FR * 0.018) * 0.18
    ผูก bob_m = ไซน์(FR * 0.016) * 0.22
    ลายจักร(DAD_X, bob_d, PZ,  1,0,0,  0,0,1,  1.52, 8,  FR, 1.0 + hd)
    ลายดอกบัว(MOM_X, bob_m, PZ,  1,0,0,  0,0,1,  0.46, 1.38, 12,  FR, 3.4 + hd)
    ลายวงซ้อน(0.0, 0, PZ,  1,0,0,  0,1,0,  2, 48,  2.62, 0.0,  FR, 2.0 + hd)

    # Ling echo
    ผูก drift = ไซน์(FR * 0.0105) * 2.0
    ผูก hdl   = hd + 2.6 + drift
    ลายดอกบัว(LING_X, 0-H+2.4, PZ-1.5,  1,0,0,  0,0,1,  0.30, 0.84, 8,  FR, hdl)
}


# ════════════════════════════════════════════════════════════════════════════
# LIGHTS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()
    # Warm gold key — Dad's candle, slowly orbiting above him (蜡烛 temple candle)
    เพิ่มแสง(
        DAD_X + ไซน์(FR * 0.0076) * 1.4,
        3.2,
        PZ + โคไซน์(FR * 0.0076) * 1.4,
        1.0, 0.80, 0.28,
        2.8, 12.0
    )
    # Soft jade-rose fill — Mom's warmth from right
    เพิ่มแสง(MOM_X, 1.6, PZ,  0.88, 0.55, 0.68,  1.4, 10.0)
    # Ling's shifting light — oscillates between Chinese gold and Korean teal
    ผูก lr = ไซน์(FR * 0.0105) * 0.35 + 0.58
    ผูก lg = ไซน์(FR * 0.0105 + 2.094) * 0.18 + 0.70
    ผูก lb = ไซน์(FR * 0.0105 + 4.189) * 0.38 + 0.55
    เพิ่มแสง(LING_X, 0-H+2.4, PZ-1.5,  lr, lg, lb,  1.2, 8.0)
    # Deep festive red under-fill — 红色 floor warmth
    เพิ่มแสง(0, 0-4.2, PZ,  0.62, 0.08, 0.04,  0.5, 7.0)
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO — Five-voice family chord
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot  x         y            z        w     freq     amp   lfo_hz lfo_depth
    เสียง(0, DAD_X,    0,          PZ,      2.0,  130.81, 0.11, 0.14, 0.010)  # 父Dad  宫C3
    เสียง(1, MOM_X,    0,          PZ,      2.0,  146.83, 0.10, 0.16, 0.012)  # 母Mom  商D3
    เสียง(2, CHILD1_X, 0-H+2.0,  PZ-0.8,  1.5,  164.81, 0.08, 0.28, 0.018)  # 长Elder 角E3
    เสียง(3, CHILD2_X, 0-H+1.68, PZ-0.8,  1.5,  196.00, 0.07, 0.32, 0.020)  # 次Younger 徵G3
    เสียง(4, LING_X,   0-H+2.4,  PZ-1.5,  1.0,  116.54, 0.09, 0.22, 0.015)  # 灵Ling B♭2
    # Harmonic overtones from the room itself
    เสียง(5, 0,         H,         PZ,      0.5,  261.63, 0.05, 0.10, 0.008)  # 宫C4 lantern echo
    เสียง(6, 0,         0,         FZ,      1.5,  293.66, 0.05, 0.18, 0.012)  # 商D4 portal echo
    ระดับเสียง(0.55)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN
# ════════════════════════════════════════════════════════════════════════════

ผูก สร้าง = ทำ {
    เปิดหน้าต่างเต็มจอ("囍家团圆 — Double Happiness Family Room")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.08)
    init_audio()

    ผูก 帧 = 0

    # Camera target — family centrepiece (囍 union point)
    ผูก target_x = 0.0
    ผูก target_y = 0.4
    ผูก target_z = PZ

    # Hyperbolic orbit: warm family room — very slow, tender floating survey
    ผูก orbit_h  = 8.0
    ผูก orbit_v  = 3.8
    ผูก speed_h1 = 0.00085
    ผูก speed_h2 = 0.00135
    ผูก speed_v  = 0.00110

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(8, 2, 2)    # deep crimson-black — 中国红 family warmth

        ผูก hd = 帧 * 0.055

        # ── Hyperbolic floating orbit around 囍 centrepiece ───────────────
        ผูก t1 = 帧 * speed_h1
        ผูก t2 = 帧 * speed_h2
        ผูก t3 = 帧 * speed_v
        ผูก cam_px = target_x + ไซน์(t1) * orbit_h * 0.85 + ไซน์(t2 * 1.6) * orbit_h * 0.22
        ผูก cam_pz = target_z + ไซน์(t1 * 1.8) * orbit_h * 0.65 + โคไซน์(t2 * 1.3) * orbit_h * 0.20
        ผูก cam_py = target_y + ไซน์(t3 * 1.5) * orbit_v * 0.65 + โคไซน์(t3 * 0.8) * orbit_v * 0.28

        # ── Look-at: always face the family centre ────────────────────────
        ผูก dx = target_x - cam_px
        ผูก dy = target_y - cam_py
        ผูก dz = target_z - cam_pz
        ผูก dist = รากที่สอง(dx*dx + dy*dy + dz*dz)
        ถ้า dist > 0.0001 {
            ผูก dx = dx / dist
            ผูก dy = dy / dist
            ผูก dz = dz / dist
        }
        ผูก ry = atan2(dx, dz)
        ผูก rx = asin(dy)

        ตั้งกล้อง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))
        ตั้งตำแหน่งกล้อง(cam_px, cam_py, cam_pz)
        ตั้งระยะห่าง(2.0)
        ผู้ฟัง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))

        setup_lights(帧)

        # Temporal framefade — two echo passes with warm amber (+2.2) and rose (+1.1) tint
        draw_echo(帧 - 48, 2.2)
        draw_echo(帧 - 24, 1.1)

        # Current frame — full scene
        draw_floor(帧, 0.0)
        draw_ceiling(帧, 0.0)
        draw_front_wall(帧, 0.0)
        draw_back_wall(帧, 0.0)
        draw_left_wall(帧, 0.0)
        draw_right_wall(帧, 0.0)
        draw_double_happiness(帧, 0.0)
        draw_elder_child(帧, 0.0)
        draw_younger_child(帧, 0.0)
        draw_ling(帧, 0.0)

        แสดงผล()
        ผูก 帧 = 帧 + 1
    }
}
