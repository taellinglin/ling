# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MISSION CONSOLE — a tour of the ling-ui vector toolkit
# HUD · meters · interface controls · game UI · faux-3D · interface sounds
# Everything is vector, theme-coloured, and works in all 5 languages.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind start = do {
    open_window(1120, 720)
    audio_volume(0.5)

    bind ui = font_load("assets/fonts/Orbitron.ttf", 600.0)
    if ui < 0.0 { bind ui = font_load("../../assets/fonts/Orbitron.ttf", 600.0) }

    # custom holographic theme: primary, accent, track, warn, text, bg
    ui_theme(0.0,220.0,255.0,  60.0,255.0,180.0,  40.0,60.0,95.0,  255.0,90.0,90.0,  190.0,235.0,255.0,  10.0,16.0,24.0)

    bind sw1 = 1.0       # toggle state
    bind vol = 0.6       # slider value
    bind tab = 0.0       # active tab
    bind hp  = 1.0       # health
    bind wasClick = 0.0

    while window_is_open() {
        bind t = time_now()
        set_color(8, 11, 18)
        fill()
        set_blend(1)

        # ── title ──
        set_color(0, 220, 255)
        if ui < 0.0 { ui_text(36.0, 22.0, 24.0, "MISSION CONSOLE") } else { font_text_fill(ui, 36.0, 22.0, 28.0, "MISSION CONSOLE") }

        # ── HUD: radar + compass + reticle ──
        ui_panel(36.0, 80.0, 240.0, 240.0, 14.0)
        ui_radar(156.0, 200.0, 95.0, t * 1.6)
        ui_compass(36.0, 336.0, 240.0, 26.0, t * 18.0)
        ui_reticle(156.0, 470.0, 46.0, sin(t * 2.0) * 0.5 + 0.5)
        ui_target(96.0, 540.0, 120.0, 120.0, sin(t) * 0.5 + 0.5)

        # ── meters column ──
        bind gv = sin(t * 0.7) * 0.5 + 0.5
        ui_gauge(380.0, 150.0, 60.0, gv, 1.0)
        ui_ring(520.0, 150.0, 50.0, sin(t * 0.5) * 0.5 + 0.5, 1.0)
        ui_bar(330.0, 240.0, 260.0, 16.0, gv, 1.0)
        ui_segbar(330.0, 270.0, 260.0, 16.0, sin(t * 1.3) * 0.5 + 0.5, 1.0, 16.0)
        ui_battery(330.0, 300.0, 60.0, 24.0, sin(t * 0.3) * 0.5 + 0.5, 1.0)

        # VU bars + sparkline (lists)
        bind lv = [ sin(t*5.0)*0.5+0.5, sin(t*5.0+1.0)*0.5+0.5, sin(t*5.0+2.0)*0.5+0.5, sin(t*5.0+3.0)*0.5+0.5, sin(t*5.0+4.0)*0.5+0.5, sin(t*5.0+5.0)*0.5+0.5, sin(t*5.0+6.0)*0.5+0.5, sin(t*5.0+7.0)*0.5+0.5 ]
        ui_vu(330.0, 350.0, 160.0, 64.0, lv)
        bind sp = [ sin(t)*0.5, sin(t*1.5)*0.7, sin(t*2.1)*0.4, sin(t*0.8)*0.9, sin(t*3.0)*0.3, sin(t*1.2)*0.6, sin(t*2.6)*0.8 ]
        ui_spark(330.0, 430.0, 160.0, 44.0, sp)

        # ── interface controls (interactive) ──
        bind clicked = ui_button(640.0, 90.0, 130.0, 42.0)
        if ui < 0.0 { ui_text(666.0, 102.0, 16.0, "ENGAGE") } else { font_text_fill(ui, 664.0, 100.0, 18.0, "ENGAGE") }
        if clicked > 0.5 { ui_sound("confirm") }

        bind sw1 = ui_toggle(640.0, 150.0, 54.0, 26.0, sw1)
        bind vol = ui_slider(720.0, 210.0, 180.0, vol, 0.0, 1.0)
        ui_progress(640.0, 250.0, 260.0, 12.0, gv)
        bind tab = ui_tabs(640.0, 290.0, 260.0, 30.0, 3.0, tab)
        ui_stepper(640.0, 340.0, 130.0, 28.0, 0.0, 1.0)
        ui_checkbox(820.0, 150.0, 22.0, 1.0)

        # ── game UI ──
        ui_healthbar(640.0, 400.0, 220.0, 18.0, hp, 1.0, sin(t * 8.0) * 0.5 + 0.5)
        ui_cooldown(900.0, 410.0, 26.0, sin(t) * 0.5 + 0.5)
        ui_counter(640.0, 440.0, 16.0, 28.0, 1337.0, 4.0)
        ui_slotgrid(640.0, 500.0, 5.0, 1.0, 38.0, 2.0)
        ui_minimap(950.0, 90.0, 140.0, 140.0)

        # ── faux-3D in 2D space ──
        ui_gauge3d(990.0, 320.0, 64.0, gv, t * 1.2)
        ui_panel3d(940.0, 430.0, 150.0, 90.0, 16.0)
        ui_radar3d(1010.0, 600.0, 70.0, 1.0, t * 1.4)

        set_blend(0)
        present()
    }
}
