# ════════════════════════════════════════════════════════════════════════════════
# windchime_pentatonic.ling  —  风铃五声螺旋阶梯 (Enhanced: Faster, Shorter, Echo)
# ════════════════════════════════════════════════════════════════════════════════

ผูก N    = 81
ผูก W    = 1920.0
ผูก H    = 1080.0
ผูก CZ   = 6.0
ผูก 总高  = N * 0.24

ผูก 基R   = 4.2
ผูก 收缩  = 0.9675
ผูก 步高  = 0.24
ผูก 键宽  = 0.43
ผูก 键深  = 0.17
ผูก 管基  = 0.88
ผูก 阳台  = 0.30

ผูก 帧速基 = 28.0
ผูก 帧速减 = 0.48
ผูก 拖尾  = 24

ฟังก์ชัน hcol(hue, sat, lit, dim) {
    ผูก h = hue * pi / 180.0
    ผูก r = clamp((ไซน์(h)         * sat + lit) * dim, 0.0, 255.0)
    ผูก g = clamp((ไซน์(h + 2.094) * sat + lit) * dim, 0.0, 255.0)
    ผูก b = clamp((ไซน์(h + 4.189) * sat + lit) * dim, 0.0, 255.0)
    สีดินสอ(r, g, b)
}

# Echo arrays using separate lists
ผูก 回声索引 = []
ผูก 回声帧 = []
ผูก 回声幅 = []

ฟังก์ชัน add_echo(idx, fr, amp) {
    回声索引.เพิ่ม(idx)
    回声帧.เพิ่ม(fr)
    回声幅.เพิ่ม(amp)
}

ฟังก์ชัน is_echo_active(idx, fr) {
    ผูก i = 0
    ขณะที่ i < 回声索引.ความยาว() {
        ถ้า 回声索引[i] == idx {
            ถ้า fr - 回声帧[i] < 30 {
                返 1
            }
        }
        i = i + 1
    }
    返 0
}

ฟังก์ชัน get_echo_dim(idx, fr) {
    ผูก i = 0
    ขณะที่ i < 回声索引.ความยาว() {
        ถ้า 回声索引[i] == idx {
            ผูก age = fr - 回声帧[i]
            ถ้า age < 30 {
                返 (1.0 - age / 30.0) * 0.45
            }
        }
        i = i + 1
    }
    返 0.0
}

ฟังก์ชัน cleanup_echoes(fr) {
    ผูก 新索引 = []
    ผูก 新帧 = []
    ผูก 新幅 = []
    ผูก i = 0
    ขณะที่ i < 回声索引.ความยาว() {
        ถ้า fr - 回声帧[i] < 35 {
            新索引.เพิ่ม(回声索引[i])
            新帧.เพิ่ม(回声帧[i])
            新幅.เพิ่ม(回声幅[i])
        }
        i = i + 1
    }
    回声索引 = 新索引
    回声帧 = 新帧
    回声幅 = 新幅
}

ผูก สร้าง = ทำ {
    ผูก 帧   = 0
    ผูก 当音  = 0
    ผูก 亮音  = 0
    ผูก 触帧  = 12
    ผูก 摆幅  = 0.0
    ผูก 摆相  = 0.0
    ผูก 管当  = 管基

    เปิดหน้าต่างเต็มจอ("风铃五声螺旋阶梯 — 回声增强版", W, H)

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(2, 4, 18)

        # ── HYPERBOLIC FLOATING CAMERA ──────────────────────────────────
        ผูก t1 = 帧 * 0.00098
        ผูก t2 = 帧 * 0.00162
        ผูก t3 = 帧 * 0.00077
        ผูก t4 = 帧 * 0.0021
        ผูก cX = ไซน์(t1) * 10.8 + ไซน์(t2 * 1.35) * 2.6 + ไซน์(t4 * 1.8) * 1.2
        ผูก cZ = CZ + 14.5 + โคไซน์(t1 * 1.22) * 3.4 + ไซน์(t2 * 0.88) * 1.7 + โคไซน์(t4 * 1.2) * 0.9
        ผูก cY = 总高/2 - 2.5 + ไซน์(t3 * 1.42) * 4.6 + โคไซน์(t3 * 0.72) * 2.1

        ผูก dx = 0.0 - cX
        ผูก dy = 总高/2 - 2.0 - cY
        ผูก dz = CZ - cZ
        ผูก dd = รากที่สอง(dx*dx + dy*dy + dz*dz)
        ถ้า dd > 0.0001 {
            dx = dx / dd
            dy = dy / dd
            dz = dz / dd
        }
        ผูก ry = atan2(dx, dz)
        ผูก rx = asin(dy)
        ตั้งกล้อง(โคไซน์(ry), ไซน์(ry), โคไซน์(rx), ไซน์(rx))
        ตั้งตำแหน่งกล้อง(cX, cY, cZ)
        ตั้งระยะห่าง(2.5)

        # ── LIGHTING ────────────────────────────────────────────────────
        ตั้งแสงรอบข้าง(0.04)
        ล้างแสง()
        เพิ่มแสง(0.0, 总高/2 + 9.0, CZ, 1.0, 0.90, 0.75, 2.4, 40.0)
        เพิ่มแสง(0.0, -4.0, CZ + 9.0, 0.18, 0.40, 1.0, 1.1, 24.0)
        
        ถ้า 摆幅 > 0.03 {
            ผูก aθ = 亮音 * pi / 6.0
            ผูก aR = 基R * pow(收缩, 亮音)
            ผูก pulse = 0.8 + 摆幅 * 1.2
            เพิ่มแสง(aR * โคไซน์(aθ), 亮音 * 步高 - 总高/2 + 0.5, CZ + aR * ไซน์(aθ),
                     1.0 * pulse, 0.7 * pulse, 0.3 * pulse, 摆幅 * 5.0, 8.0)
        }

        # ── DRAW ALL 81 CHIMES ──────────────────────────────────────────
        ผูก i = 0
        ขณะที่ i < N {
            ผูก θ  = i * pi / 6.0
            ผูก R  = 基R * pow(收缩, i)
            ผูก pX = R * โคไซน์(θ)
            ผูก pZ = CZ + R * ไซน์(θ)
            ผูก pY = i * 步高 - 总高/2

            ผูก tX = 0.0 - ไซน์(θ)
            ผูก tZ = โคไซน์(θ)
            ผูก rX = โคไซน์(θ)
            ผูก rZ = ไซน์(θ)

            ผูก 管L = 管基 * pow(0.982, i)
            ถ้า 管L < 0.12 { ผูก 管L = 0.12 }

            ผูก 音级 = (i * 7) % 12
            ผูก 色相 = 音级 * 30.0

            ผูก 亮 = 0.12
            ผูก 闪 = 0.0
            
            ถ้า i == 亮音 {
                亮 = 1.0
                闪 = 摆幅
            } มิฉะนั้น {
                ผูก 拖 = 亮音 - i
                ถ้า 拖 > 0 && 拖 < 拖尾 {
                    亮 = 0.20 + (拖尾 - 拖) / 拖尾 * 0.75
                    闪 = (拖尾 - 拖) / 拖尾 * 0.4
                }
            }
            
            ผูก echo_dim = get_echo_dim(i, 帧)
            ถ้า echo_dim > 0.0 {
                亮 = 亮 + echo_dim
                闪 = 闪 + echo_dim * 0.5
            }
            
            亮 = clamp(亮, 0.08, 1.0)

            # ── Pendulum swing ──────────────────────────────────────────
            ผูก swX = 0.0
            ผูก swZ = 0.0
            ถ้า i == 亮音 {
                ผูก sw = ไซน์(摆相) * 摆幅 * 0.35
                swX = sw * tX
                swZ = sw * tZ
            }
            ผูก bX = pX + swX
            ผูก bZ = pZ + swZ

            # ── Chime tube ──────────────────────────────────────────────
            ผูก sat = 110.0 + 闪 * 100.0
            ผูก lit = 45.0 + 闪 * 140.0
            hcol(色相, sat, lit, 亮)
            
            ผูก thickness = clamp(管L * 0.5, 0.02, 0.12)
            วาดเส้น3มิติ(bX, pY, bZ, bX, pY - 管L, bZ)
            ถ้า 管L > 0.4 {
                วาดเส้น3มิติ(bX + thickness*0.3, pY, bZ + thickness*0.3, 
                             bX + thickness*0.3, pY - 管L, bZ + thickness*0.3)
                วาดเส้น3มิติ(bX - thickness*0.3, pY, bZ - thickness*0.3, 
                             bX - thickness*0.3, pY - 管L, bZ - thickness*0.3)
            }

            # ── Piano key cap ───────────────────────────────────────────
            ผูก kw = 键宽 * pow(0.9915, i)
            ผูก kd = 键深 * pow(0.9915, i)
            ผูก aX = bX - kw*tX - kd*rX
            ผูก aZ = bZ - kw*tZ - kd*rZ
            ผูก bkX = bX + kw*tX - kd*rX
            ผูก bkZ = bZ + kw*tZ - kd*rZ
            ผูก ckX = bX + kw*tX + kd*rX
            ผูก ckZ = bZ + kw*tZ + kd*rZ
            ผูก dkX = bX - kw*tX + kd*rX
            ผูก dkZ = bZ - kw*tZ + kd*rZ
            hcol(色相, sat + 30.0, lit + 20.0, 亮)
            วาดสามเหลี่ยม3มิติ(aX, pY + 0.03, aZ, bkX, pY + 0.03, bkZ, ckX, pY + 0.03, ckZ)
            วาดสามเหลี่ยม3มิติ(aX, pY + 0.03, aZ, ckX, pY + 0.03, ckZ, dkX, pY + 0.03, dkZ)

            # ── 7th balcony ─────────────────────────────────────────────
            ถ้า i % 5 == 4 {
                ผูก bY = pY - 管L * 0.35
                ผูก eX = bX + rX * 阳台
                ผูก eZ = bZ + rZ * 阳台
                hcol(色相 + 65.0, 70.0, 75.0, 亮 * 0.68)
                วาดเส้น3มิติ(bX, bY, bZ, eX, bY, eZ)
                ผูก bkw = kw * 0.38
                ผูก bkd = kd * 0.42
                วาดสามเหลี่ยม3มิติ(eX - bkw*tX, bY + 0.01, eZ - bkw*tZ,
                                     eX + bkw*tX, bY + 0.01, eZ + bkw*tZ,
                                     eX, bY + 0.01, eZ + rZ*bkd)
            }

            # ── Spiral ring for non-pentatonic ──────────────────────────
            ผูก 五声 = 0
            ถ้า 音级 == 0 { 五声 = 1 }
            ถ้า 音级 == 2 { 五声 = 1 }
            ถ้า 音级 == 4 { 五声 = 1 }
            ถ้า 音级 == 7 { 五声 = 1 }
            ถ้า 音级 == 9 { 五声 = 1 }
            ถ้า 五声 == 0 {
                ผูก sR = R * 0.42
                ผูก sY = pY - 管L * 0.58
                ผูก sk = 0
                ขณะที่ sk < 8 {
                    ผูก sa = sk * pi / 4.0
                    ผูก sb = (sk + 1.0) * pi / 4.0
                    ผูก sXa = bX + โคไซน์(sa) * sR
                    ผูก sZa = bZ + ไซน์(sa) * sR
                    ผูก sXb = bX + โคไซน์(sb) * sR
                    ผูก sZb = bZ + ไซน์(sb) * sR
                    hcol(色相 + 195.0, 55.0, 55.0, 亮 * 0.45)
                    วาดเส้น3มิติ(sXa, sY, sZa, sXb, sY, sZb)
                    sk = sk + 1
                }
            }

            i = i + 1
        }

        # ── TRIGGER NEXT NOTE ───────────────────────────────────────────
        ถ้า 帧 == 触帧 && 当音 < N {
            ผูก 帧速当 = 帧速基 - 当音 * 帧速减
            ถ้า 帧速当 < 8.0 { 帧速当 = 8.0 }
            
            ผูก freq = 55.0 * pow(1.5, 当音)
            ขณะที่ freq > 1760.0 { freq = freq * 0.5 }
            ขณะที่ freq < 55.0   { freq = freq * 2.0 }
            
            ผูก 管今 = 管基 * pow(0.982, 当音)
            ถ้า 管今 < 0.12 { 管今 = 0.12 }

            ผูก attack = 0.02 + (当音 / N) * 0.06
            ผูก amp = 0.22 + (1.0 - 当音 / N) * 0.28
            ผูก lfo = 3.5 + 当音 * 0.12
            ผูก lfd = 0.012 + (N - 当音) / N * 0.048

            เสียงโทน(当音 % 8, 0.0, 0.0, 0.0, attack, freq, amp, lfo, lfd)
            
            # Add echoes
            ผูก echo_count = 4 + 当音 / 20
            ถ้า echo_count > 8 { echo_count = 8 }
            ผูก e = 1
            ขณะที่ e <= echo_count {
                ผูก echo_delay = 0.08 + e * 0.06
                ผูก echo_amp = amp * pow(0.55, e) * (1.0 - 当音 / N * 0.4)
                ผูก echo_freq = freq * (1.0 + e * 0.003)
                ผูก echo_slot = (当音 + e * 3) % 8
                ถ้า echo_slot < 8 {
                    เสียงโทน(echo_slot, 0.0, 0.0, 0.0, attack * 1.2, echo_freq, echo_amp, lfo * 1.1, lfd * 1.2)
                }
                e = e + 1
            }
            
            add_echo(当音, 帧, 1.0)
            
            摆幅 = 1.2
            摆相 = 0.0
            管当 = 管今
            亮音 = 当音
            当音 = 当音 + 1
            触帧 = 帧 + 帧速当
        }

        # ── PENDULUM PHYSICS ────────────────────────────────────────────
        ผูก ω = รากที่สอง(9.81 / (管当 + 0.35))
        ถ้า 管当 < 0.3 { ω = ω * 1.4 }
        摆相 = 摆相 + ω * 0.052
        摆幅 = 摆幅 * 0.945

        # ── VISUAL ECHO PARTICLES ───────────────────────────────────────
        ผูก eidx = 0
        ขณะที่ eidx < 回声索引.ความยาว() {
            ผูก eco_idx = 回声索引[eidx]
            ผูก eco_age = 帧 - 回声帧[eidx]
            ถ้า eco_age < 20 {
                ผูก θ_e = eco_idx * pi / 6.0
                ผูก R_e = 基R * pow(收缩, eco_idx)
                ผูก x_e = R_e * โคไซน์(θ_e)
                ผูก z_e = CZ + R_e * ไซน์(θ_e)
                ผูก y_e = eco_idx * 步高 - 总高/2 - 0.3 - eco_age * 0.05
                ผูก alpha = (1.0 - eco_age / 20.0) * 0.6
                ผูก hue_e = ((eco_idx * 7) % 12) * 30.0
                hcol(hue_e + 30, 120.0, 80.0, alpha)
                วาดเส้น3มิติ(x_e - 0.08, y_e, z_e, x_e + 0.08, y_e, z_e)
                วาดเส้น3มิติ(x_e, y_e - 0.05, z_e, x_e, y_e + 0.08, z_e)
            }
            eidx = eidx + 1
        }
        cleanup_echoes(帧)

        # ── AMBIENT BREATH PARTICLES ────────────────────────────────────
        ผูก 粒子数 = 30 + 摆幅 * 40
        ผูก p = 0
        ขณะที่ p < 粒子数 {
            ผูก pr = 3.0 + (帧 * 0.023 + p) % 7.0
            ผูก pa = (帧 * 0.012 + p) * 1.2
            ผูก px = ไซน์(pa) * pr
            ผูก pz = CZ + โคไซน์(pa * 0.7) * pr
            ผูก py = (总高/2) * ((帧 * 0.008 + p) % 1) - 2.0
            hcol(180.0 + py * 180.0, 40.0, 30.0, 0.12)
            วาดเส้น3มิติ(px, py, pz, px + 0.03, py + 0.05, pz + 0.03)
            p = p + 1
        }

        แสดงผล()
        帧 = 帧 + 1
    }
}