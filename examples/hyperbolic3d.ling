# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Hyperbolic 3D DOOM — Symmetrical Wireframe Maze in H³ Space
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# A symmetrical 8-way mandala maze floating in H³ hyperbolic space.
# Central atrium with mandala floor → 8 radial hallways → small alcove rooms.
# Wireframe walls + archways as doorways. Ground plane walkable.
# Physics ball avatar with audio encoding.
#
# Controls:
#   W / S   move forward / back (FASTER than before)
#   A / D   strafe left / right
#   Q / E   turn left / right
#   SPACE   jump
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind SCALE  = 6.5     # Poincaré ball → world-space scale
bind ZC     = 9.0     # z-centre
bind STEP   = 0.025   # FASTER movement
bind TURN   = 0.03
bind G      = 22.0    # gravity
bind JUMP   = 7.5
bind HDIST  = 1.5     # distance to spoke rooms in H³
bind NROOMS = 9       # 1 centre + 8 spokes

# Ball physics
bind BALL_R = 1.4
bind DAMPING = 0.995
bind ELASTICITY = 0.86
bind MOVE_ACCEL = 20.0

# Maze parameters
bind HALLWAY_W = 2.0      # hallway half-width
bind HALLWAY_H = 2.2      # hallway half-height
bind ATRIUM_R = 2.5       # central atrium radius
bind SPOKE_L = 4.0        # spoke (hallway) length from centre to alcove

# ── cosh / sinh ───────────────────────────────────────────────────────────────
fn cosh_h(v) {
    (exp(v) + exp(0.0 - v)) / 2.0
}

fn sinh_h(v) {
    (exp(v) - exp(0.0 - v)) / 2.0
}

# ── hash for procedural colouring ──────────────────────────────────────────────
fn hash01(a, b) {
    sin(a*12.9898 + b*78.233) * 43758.5453 - floor(sin(a*12.9898 + b*78.233) * 43758.5453)
}

# ── draw a wireframe box (hallway section) ────────────────────────────────────
fn draw_wireframe_box(cx, cy, cz, sx, sy, sz, col_r, col_g, col_b) {
    set_color(col_r, col_g, col_b)
    # bottom rectangle
    draw_line_3d(cx-sx, cy+sy, cz-sz,  cx+sx, cy+sy, cz-sz)
    draw_line_3d(cx+sx, cy+sy, cz-sz,  cx+sx, cy+sy, cz+sz)
    draw_line_3d(cx+sx, cy+sy, cz+sz,  cx-sx, cy+sy, cz+sz)
    draw_line_3d(cx-sx, cy+sy, cz+sz,  cx-sx, cy+sy, cz-sz)
    # top rectangle
    draw_line_3d(cx-sx, cy-sy, cz-sz,  cx+sx, cy-sy, cz-sz)
    draw_line_3d(cx+sx, cy-sy, cz-sz,  cx+sx, cy-sy, cz+sz)
    draw_line_3d(cx+sx, cy-sy, cz+sz,  cx-sx, cy-sy, cz+sz)
    draw_line_3d(cx-sx, cy-sy, cz+sz,  cx-sx, cy-sy, cz-sz)
    # vertical pillars
    draw_line_3d(cx-sx, cy-sy, cz-sz,  cx-sx, cy+sy, cz-sz)
    draw_line_3d(cx+sx, cy-sy, cz-sz,  cx+sx, cy+sy, cz-sz)
    draw_line_3d(cx+sx, cy-sy, cz+sz,  cx+sx, cy+sy, cz+sz)
    draw_line_3d(cx-sx, cy-sy, cz+sz,  cx-sx, cy+sy, cz+sz)
}

# ── main ──────────────────────────────────────────────────────────────────────
bind start = do {
    open_fullscreen("Hyperbolic 3D DOOM — Wireframe Maze")
    capture_mouse()
    set_ambient(0.14)

    # Cel shading: clean toon look
    set_shade_mode(1)
    set_cel_bands(4)
    set_shadow_color(10, 5, 30)
    set_rim(0.3, 80, 120, 200)

    # Audio
    audio_tone(0, 0.0, 0.0, ZC, 4.0, 180.0, 0.06, 0.5, 0.02)

    # Initialize room positions (same H³ geometry as before)
    bind rx = list_new()
    bind ry = list_new()
    bind rz = list_new()
    bind rw = list_new()
    bind rtype = list_new()

    # Centre room
    bind rx = list_push(rx, 0.0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0)
    bind rw = list_push(rw, 1.0)
    bind rtype = list_push(rtype, 0)

    # 8 spoke rooms (radial directions)
    bind ch0 = cosh_h(HDIST)
    bind sh0 = sinh_h(HDIST)
    bind spoke_dirs = list_new()

    # Cardinal directions (N, S, E, W)
    bind spoke_dirs = list_push(spoke_dirs, 0)    # +Z (N)
    bind spoke_dirs = list_push(spoke_dirs, 1)    # -Z (S)
    bind spoke_dirs = list_push(spoke_dirs, 2)    # +X (E)
    bind spoke_dirs = list_push(spoke_dirs, 3)    # -X (W)

    # Diagonal directions (NE, NW, SE, SW)
    bind spoke_dirs = list_push(spoke_dirs, 4)    # +X+Z
    bind spoke_dirs = list_push(spoke_dirs, 5)    # -X+Z
    bind spoke_dirs = list_push(spoke_dirs, 6)    # +X-Z
    bind spoke_dirs = list_push(spoke_dirs, 7)    # -X-Z

    # Place spoke rooms
    bind D2 = sh0 * 0.7071
    # Cardinal
    bind rx = list_push(rx, 0.0)       bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, sh0)    bind rw = list_push(rw, ch0)   bind rtype = list_push(rtype, 1)
    bind rx = list_push(rx, 0.0)       bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, 0.0-sh0) bind rw = list_push(rw, ch0)  bind rtype = list_push(rtype, 2)
    bind rx = list_push(rx, sh0)       bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, 0.0)   bind rw = list_push(rw, ch0)   bind rtype = list_push(rtype, 3)
    bind rx = list_push(rx, 0.0-sh0)   bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, 0.0)   bind rw = list_push(rw, ch0)   bind rtype = list_push(rtype, 4)
    # Diagonal
    bind rx = list_push(rx, D2)        bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, D2)    bind rw = list_push(rw, ch0)   bind rtype = list_push(rtype, 5)
    bind rx = list_push(rx, 0.0-D2)    bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, D2)    bind rw = list_push(rw, ch0)   bind rtype = list_push(rtype, 6)
    bind rx = list_push(rx, D2)        bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, 0.0-D2) bind rw = list_push(rw, ch0)  bind rtype = list_push(rtype, 7)
    bind rx = list_push(rx, 0.0-D2)    bind ry = list_push(ry, 0.0)      bind rz = list_push(rz, 0.0-D2) bind rw = list_push(rw, ch0)  bind rtype = list_push(rtype, 8)

    # Player/ball state
    bind bx = 0.0
    bind by = 0.2
    bind bz = ZC
    bind vx = 0.0
    bind vy_phys = 0.0
    bind vz = 0.0
    bind pyaw = 0.0
    bind FR = 0
    bind lastBounce = -99
    bind spaceWasDown = 0
    bind charge = 0.0

    while window_is_open() {
        fill(1, 1, 6)
        bind dt = 0.0166667

        # ── PHYSICS ────────────────────────────────────────────────────────────
        bind vy_phys = vy_phys + G * dt
        bind vx = vx * DAMPING
        bind vy_phys = vy_phys * DAMPING
        bind vz = vz * DAMPING

        bind bx = bx + vx * dt
        bind by = by + vy_phys * dt
        bind bz = bz + vz * dt

        bind hit = 0

        # Boundary bounces (large arena)
        if bx < (0.0 - 5.0 + BALL_R) { bind bx = 0.0 - 5.0 + BALL_R   bind vx = 0.0 - vx * ELASTICITY   bind hit = 1 }
        if bx > (5.0 - BALL_R) { bind bx = 5.0 - BALL_R   bind vx = 0.0 - vx * ELASTICITY   bind hit = 1 }
        if by < (0.2 + BALL_R) { bind by = 0.2 + BALL_R   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }
        if by > (4.5 - BALL_R) { bind by = 4.5 - BALL_R   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }
        if bz < (ZC - 5.0 + BALL_R) { bind bz = ZC - 5.0 + BALL_R   bind vz = 0.0 - vz * ELASTICITY   bind hit = 1 }
        if bz > (ZC + 5.0 - BALL_R) { bind bz = ZC + 5.0 - BALL_R   bind vz = 0.0 - vz * ELASTICITY   bind hit = 1 }

        if hit > 0 { bind lastBounce = FR }
        bind grounded = 0
        if by > (0.2 + BALL_R - 0.15) { bind grounded = 1 }

        # ── INPUT ──────────────────────────────────────────────────────────────
        bind bx_move = 0.0
        bind bz_move = 0.0
        if key_down("w") { bind bx_move = bx_move + sin(pyaw) * STEP   bind bz_move = bz_move + cos(pyaw) * STEP }
        if key_down("s") { bind bx_move = bx_move - sin(pyaw) * STEP   bind bz_move = bz_move - cos(pyaw) * STEP }
        if key_down("a") { bind bx_move = bx_move + cos(pyaw) * STEP   bind bz_move = bz_move - sin(pyaw) * STEP }
        if key_down("d") { bind bx_move = bx_move - cos(pyaw) * STEP   bind bz_move = bz_move + sin(pyaw) * STEP }

        bind vx = vx + bx_move * MOVE_ACCEL * dt
        bind vz = vz + bz_move * MOVE_ACCEL * dt

        if key_down("q") { bind pyaw = pyaw + TURN }
        if key_down("e") { bind pyaw = pyaw - TURN }

        # ── JUMP ───────────────────────────────────────────────────────────────
        bind spaceNow = 0
        if key_down("space") { bind spaceNow = 1 }
        if spaceNow > 0 {
            if grounded > 0 { bind charge = charge + 14.0 * dt   if charge > 11.0 { bind charge = 11.0 } }
        } else {
            if spaceWasDown > 0 {
                if charge > 0.01 { bind vy_phys = vy_phys - charge }
                bind charge = 0.0
            }
        }
        bind spaceWasDown = spaceNow

        # ── AUDIO ──────────────────────────────────────────────────────────────
        bind speed = sqrt(vx*vx + vy_phys*vy_phys + vz*vz)
        bind hNorm = (by - 0.2) / 4.0
        bind sinceHit = FR - lastBounce
        bind impact = 0.0
        if sinceHit < 6 { bind impact = (6 - sinceHit) * 24.0 }
        bind freq = 140.0 + hNorm * 200.0 + impact + speed * 20.0
        bind amp = 0.04 + speed * 0.06
        bind pan = bx / 5.0
        audio_tone(0, bx, by, bz, 4.0, freq, amp, pan, 0.02)

        # ── LIGHTS ────────────────────────────────────────────────────────────
        clear_lights()
        add_light(sin(FR*0.006)*3.5, 0.0-4.0, ZC,  0.8, 0.7, 0.55,  1.8, 16.0)
        add_light(0.0-2.5, 0.0-2.0, ZC-2.5,  0.4, 0.5, 0.9,  0.8, 10.0)
        add_light(bx, by + 0.8, bz,  0.6, 0.3, 0.8,  0.5, 6.0)

        # ── CAMERA: 3rd person (further back) ──────────────────────────────────
        bind cam_dist = 4.5
        bind cam_x = bx - sin(pyaw) * cam_dist
        bind cam_z = bz - cos(pyaw) * cam_dist
        set_camera(cos(pyaw), sin(pyaw), 0.85, 0.53)
        set_camera_pos(cam_x, by - 0.6, cam_z)
        set_zdist(1.4)

        # ── H³ BOOST for room movement ────────────────────────────────────────
        bind blen = sqrt(bx_move*bx_move + bz_move*bz_move)
        bind dx = 0.0
        bind dz = 0.0
        if blen > 0.00001 { bind dx = bx_move / blen   bind dz = bz_move / blen }
        bind v = blen

        bind ep = exp(v)
        bind em = exp((0.0 - v))
        bind ch = (ep + em) / 2.0
        bind sh = (ep - em) / 2.0
        bind nsh = 0.0 - sh

        # ── UPDATE ROOMS ───────────────────────────────────────────────────────
        bind nrx = list_new()
        bind nry = list_new()
        bind nrz = list_new()
        bind nrw = list_new()
        bind i = 0

        while i < NROOMS {
            bind px = list_get(rx, i)
            bind py = list_get(ry, i)
            bind pz = list_get(rz, i)
            bind pw = list_get(rw, i)

            bind dot = dx*px + dz*pz
            bind nx = px + (ch - 1.0)*dx*dot + nsh*dx*pw
            bind ny = py
            bind nz = pz + (ch - 1.0)*dz*dot + nsh*dz*pw
            bind nw = nsh*dot + ch*pw

            bind nn = sqrt(nw*nw - nx*nx - ny*ny - nz*nz)
            if nn > 0.0001 { bind nx = nx / nn   bind ny = ny / nn   bind nz = nz / nn   bind nw = nw / nn }

            bind nrx = list_push(nrx, nx)
            bind nry = list_push(nry, ny)
            bind nrz = list_push(nrz, nz)
            bind nrw = list_push(nrw, nw)

            # ── DRAW MAZE STRUCTURE ────────────────────────────────────────────
            bind bx2 = nx / (1.0 + nw)
            bind by2 = ny / (1.0 + nw)
            bind bz2 = nz / (1.0 + nw)
            bind rr = bx2*bx2 + by2*by2 + bz2*bz2
            bind conf = 1.0 - rr

            if conf > 0.02 {
                bind wx = bx2 * SCALE
                bind wy = by2 * SCALE
                bind wz = ZC + bz2 * SCALE

                # Colour by room type
                bind rt = list_get(rtype, i)
                bind hue = hash01(rt, 1.0)
                bind col_r = int(sin(hue * 6.28 + FR * 0.002) * 40.0 + 100.0)
                bind col_g = int(sin(hue * 6.28 + FR * 0.002 + 2.094) * 50.0 + 110.0)
                bind col_b = int(sin(hue * 6.28 + FR * 0.002 + 4.189) * 60.0 + 140.0)

                if i == 0 {
                    # ── CENTRE ATRIUM: ground plane + mandala ──────────────────
                    set_color(col_r, col_g, col_b)
                    # Ground plane (wireframe grid)
                    bind gx = 0
                    while gx < 5 {
                        draw_line_3d(wx - 2.5, wy, wz - 2.5 + gx,  wx + 2.5, wy, wz - 2.5 + gx)
                        bind gx = gx + 1
                    }
                    bind gx = 0
                    while gx < 5 {
                        draw_line_3d(wx - 2.5 + gx, wy, wz - 2.5,  wx - 2.5 + gx, wy, wz + 2.5)
                        bind gx = gx + 1
                    }

                    # Mandala floor pattern
                    set_color(col_r - 20, col_g - 20, col_b + 30)
                    bind mrad = 0.5
                    while mrad < 2.2 {
                        draw_line_3d(wx, wy, wz - mrad,  wx + mrad * 0.866, wy, wz - mrad * 0.5)
                        draw_line_3d(wx + mrad * 0.866, wy, wz - mrad * 0.5,  wx + mrad * 0.866, wy, wz + mrad * 0.5)
                        draw_line_3d(wx + mrad * 0.866, wy, wz + mrad * 0.5,  wx, wy, wz + mrad)
                        draw_line_3d(wx, wy, wz + mrad,  wx - mrad * 0.866, wy, wz + mrad * 0.5)
                        draw_line_3d(wx - mrad * 0.866, wy, wz + mrad * 0.5,  wx - mrad * 0.866, wy, wz - mrad * 0.5)
                        draw_line_3d(wx - mrad * 0.866, wy, wz - mrad * 0.5,  wx, wy, wz - mrad)
                        bind mrad = mrad + 0.35
                    }
                } else {
                    # ── SPOKE ROOMS: hallway + alcove ─────────────────────────
                    bind spoke_idx = i - 1

                    # Direction vector for this spoke
                    bind spoke_angle = spoke_idx * 0.7854   # π/4 radians per spoke
                    bind spoke_dx = cos(spoke_angle)
                    bind spoke_dz = sin(spoke_angle)

                    # Hallway from centre toward alcove
                    bind hw_len = SPOKE_L * conf
                    bind hw_cx = wx + spoke_dx * hw_len * 0.5
                    bind hw_cz = wz + spoke_dz * hw_len * 0.5

                    draw_wireframe_box(hw_cx, wy, hw_cz,  HALLWAY_W * conf, HALLWAY_H * conf, hw_len * 0.5,  col_r, col_g, col_b)

                    # Alcove at end of hallway (room)
                    bind alcove_cx = wx + spoke_dx * hw_len
                    bind alcove_cz = wz + spoke_dz * hw_len

                    # Room box (wireframe)
                    draw_wireframe_box(alcove_cx, wy, alcove_cz,  1.2 * conf, 1.5 * conf, 1.2 * conf,  col_r + 30, col_g + 20, col_b - 20)

                    # Archway into alcove (FILLED, prominent)
                    set_color(col_r - 40, col_g + 60, col_b + 80)
                    bind arch_x = wx + spoke_dx * (hw_len - 1.0 * conf)
                    bind arch_z = wz + spoke_dz * (hw_len - 1.0 * conf)
                    arch(arch_x, wy, arch_z,  HALLWAY_W * conf * 0.8, HALLWAY_H * conf * 0.7, 0.3 * conf,  spoke_angle, 0.0, 0.0,  0,  10, 0.18)

                    # Geometric decoration (mandala or geometric shape)
                    set_color(col_r + 20, col_g - 30, col_b + 50)
                    bind deco_x = alcove_cx
                    bind deco_z = alcove_cz
                    # Draw decorative circle
                    bind deco_rad = 0.3 * conf
                    bind deco_angle = 0
                    while deco_angle < 6.28 {
                        bind next_angle = deco_angle + 0.39
                        draw_line_3d(deco_x + deco_rad * cos(deco_angle), wy - 0.5, deco_z + deco_rad * sin(deco_angle),  deco_x + deco_rad * cos(next_angle), wy - 0.5, deco_z + deco_rad * sin(next_angle))
                        bind deco_angle = next_angle
                    }
                }
            }

            bind i = i + 1
        }

        bind rx = nrx
        bind ry = nry
        bind rz = nrz
        bind rw = nrw

        # ── DRAW THE BALL: mandala chakra ─────────────────────────────────────
        bind ball_hue = hash01(speed, FR * 0.01) * 6.28
        vtex_chakra(bx, by, bz,  1,0,0,  0,1,0,  6, BALL_R,  FR * 0.04, ball_hue)

        # Shadow and indicators
        set_color(50, 40, 100)
        draw_line_3d(bx - BALL_R, 0.2, bz,  bx + BALL_R, 0.2, bz)
        draw_line_3d(bx, 0.2, bz - BALL_R,  bx, 0.2, bz + BALL_R)

        set_color(100, 200, 255)
        draw_line_3d(bx, by, bz,  bx + vx * 0.25, by + vy_phys * 0.25, bz + vz * 0.25)

        if charge > 0.01 {
            bind cf = charge / 11.0
            set_color(255, int(200 - cf * 150.0), 40)
            draw_line_3d(bx, by, bz, bx, by - cf * 2.0, bz)
        }

        present()
        bind FR = FR + 1
    }
}
