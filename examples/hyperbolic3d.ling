# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Hypermine-Style Hyperbolic Voxel World with Billboarded Ball
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# H³ hyperbolic voxel world. Voxel blocks stacked on ground via procedural generation.
# Ball rendered as billboard (always faces camera). Walls fade when occluding ball.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind SCALE  = 6.5
bind ZC     = 9.0
bind STEP   = 0.04
bind TURN   = 0.03
bind G      = 22.0
bind JUMP   = 60.0
bind HDIST  = 2.2
bind NROOMS = 6

bind BALL_R = 2.0
bind DAMPING = 0.99
bind ELASTICITY = 0.80
bind MOVE_ACCEL = 250.0

# Massive voxel world (5-way symmetry)
bind VOXEL_SIZE = 2.0

# Orbital camera (zoomed in close)
bind CAM_DIST_INIT = 8.0
bind CAM_DIST_MIN = 2.0
bind CAM_DIST_MAX = 150.0

# ── cosh / sinh ───────────────────────────────────────────────────────────────
fn cosh_h(v) {
    (exp(v) + exp(0.0 - v)) / 2.0
}

fn sinh_h(v) {
    (exp(v) - exp(0.0 - v)) / 2.0
}

fn hash01(a, b) {
    sin(a*12.9898 + b*78.233) * 43758.5453 - floor(sin(a*12.9898 + b*78.233) * 43758.5453)
}

# ── main ──────────────────────────────────────────────────────────────────────
bind start = do {
    open_fullscreen("Hypermine-Style Hypervoxel World")
    capture_mouse()
    set_ambient(0.18)

    set_shade_mode(1)
    set_cel_bands(5)
    set_shadow_color(12, 18, 30)
    set_rim(0.35, 110, 160, 210)

    audio_tone(0, 0.0, 0.0, ZC, 4.0, 180.0, 0.06, 0.5, 0.02)

    # ── H³ rooms (5-spoke hyperbolic) ──────────────────────────────────────────
    bind rx = list_new()
    bind ry = list_new()
    bind rz = list_new()
    bind rw = list_new()
    bind rtype = list_new()

    # Center atrium
    bind rx = list_push(rx, 0.0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0)
    bind rw = list_push(rw, 1.0)
    bind rtype = list_push(rtype, 0)

    # 5 spoke rooms
    bind ch0 = cosh_h(HDIST)
    bind sh0 = sinh_h(HDIST)

    bind spoke = 0
    while spoke < 5 {
        bind angle = spoke * 1.2566
        bind dx = cos(angle)
        bind dz = sin(angle)
        bind rx = list_push(rx, sh0 * dx)
        bind ry = list_push(ry, 0.0)
        bind rz = list_push(rz, sh0 * dz)
        bind rw = list_push(rw, ch0)
        bind rtype = list_push(rtype, spoke + 1)
        bind spoke = spoke + 1
    }

    # Portal locations
    bind portal_x = list_new()
    bind portal_z = list_new()
    bind spoke = 0
    while spoke < 5 {
        bind angle = spoke * 1.2566
        bind portal_x = list_push(portal_x, cos(angle) * 25.0)
        bind portal_z = list_push(portal_z, sin(angle) * 25.0)
        bind spoke = spoke + 1
    }

    # ── Ball state ─────────────────────────────────────────────────────────────
    bind bx = 0.0
    bind by = BALL_R + 0.1
    bind bz = ZC
    bind vx = 0.0
    bind vy_phys = 0.0
    bind vz = 0.0
    bind pyaw = 0.0
    bind FR = 0
    bind lastBounce = -99
    bind spaceWasDown = 0
    bind charge = 0.0

    # ── Camera orbital state ───────────────────────────────────────────────────
    bind cam_dist = CAM_DIST_INIT
    bind cam_orbit = 0.0
    bind cam_pitch = 0.8

    while window_is_open() {
        fill(3, 10, 8)
        bind dt = 0.0166667

        # ── PHYSICS ────────────────────────────────────────────────────────────
        bind vy_phys = vy_phys - G * dt
        bind vx = vx * DAMPING
        bind vy_phys = vy_phys * DAMPING
        bind vz = vz * DAMPING

        bind bx = bx + vx * dt
        bind by = by + vy_phys * dt
        bind bz = bz + vz * dt

        bind hit = 0

        # Infinite ground wrap
        if bx < -50.0 { bind bx = bx + 100.0 }
        if bx > 50.0 { bind bx = bx - 100.0 }
        if bz < ZC - 50.0 { bind bz = bz + 100.0 }
        if bz > ZC + 50.0 { bind bz = bz - 100.0 }

        # Ground collision
        if by < (BALL_R + 0.1) { bind by = BALL_R + 0.1   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }
        if by > 60.0 { bind by = 60.0   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }

        if hit > 0 { bind lastBounce = FR }
        bind grounded = 0
        if by > (BALL_R + 0.1 - 0.2) { bind grounded = 1 }

        # ── BALL INPUT ─────────────────────────────────────────────────────────
        bind bx_move = 0.0
        bind bz_move = 0.0
        if key_down("w") { bind bx_move = bx_move + sin(pyaw) * STEP   bind bz_move = bz_move + cos(pyaw) * STEP }
        if key_down("s") { bind bx_move = bx_move - sin(pyaw) * STEP   bind bz_move = bz_move - cos(pyaw) * STEP }
        if key_down("a") { bind bx_move = bx_move + cos(pyaw) * STEP   bind bz_move = bz_move - sin(pyaw) * STEP }
        if key_down("d") { bind bx_move = bx_move - cos(pyaw) * STEP   bind bz_move = bz_move + sin(pyaw) * STEP }

        bind vx = vx + bx_move * MOVE_ACCEL * dt
        bind vz = vz + bz_move * MOVE_ACCEL * dt

        if key_down("q") { bind pyaw = pyaw + TURN }
        if key_down("e") { bind pyaw = pyaw - TURN }

        # ── JUMP ───────────────────────────────────────────────────────────────
        bind spaceNow = 0
        if key_down("space") { bind spaceNow = 1 }
        if spaceNow > 0 {
            if grounded > 0 { bind charge = charge + 112.0 * dt   if charge > 88.0 { bind charge = 88.0 } }
        } else {
            if spaceWasDown > 0 {
                if charge > 0.01 { bind vy_phys = vy_phys - charge }
                bind charge = 0.0
            }
        }
        bind spaceWasDown = spaceNow

        # ── PORTAL TELEPORTATION ───────────────────────────────────────────────
        bind p = 0
        while p < 5 {
            bind px = list_get(portal_x, p)
            bind pz = list_get(portal_z, p)
            bind dist_to_portal = sqrt((bx - px)*(bx - px) + (bz - ZC - pz)*(bz - ZC - pz))
            if dist_to_portal < 5.0 {
                bind target = int(hash01(FR, p) * 4.999)
                bind new_px = list_get(portal_x, target)
                bind new_pz = list_get(portal_z, target)
                bind bx = new_px + 1.0 * cos(pyaw)
                bind bz = ZC + new_pz + 1.0 * sin(pyaw)
                bind by = BALL_R + 0.1
            }
            bind p = p + 1
        }

        # ── CAMERA ORBITAL CONTROL ─────────────────────────────────────────────
        if key_down("left") { bind cam_orbit = cam_orbit + 0.04 }
        if key_down("right") { bind cam_orbit = cam_orbit - 0.04 }
        if key_down("up") { bind cam_pitch = cam_pitch + 0.04   if cam_pitch > 1.4 { bind cam_pitch = 1.4 } }
        if key_down("down") { bind cam_pitch = cam_pitch - 0.04   if cam_pitch < -0.5 { bind cam_pitch = -0.5 } }

        bind mouse_dx_now = mouse_dx()
        bind mouse_dy_now = mouse_dy()
        if mouse_dx_now > 5 { bind cam_orbit = cam_orbit - 0.03 }
        if mouse_dx_now < -5 { bind cam_orbit = cam_orbit + 0.03 }
        if mouse_dy_now > 5 { bind cam_pitch = cam_pitch - 0.02   if cam_pitch < -0.5 { bind cam_pitch = -0.5 } }
        if mouse_dy_now < -5 { bind cam_pitch = cam_pitch + 0.02   if cam_pitch > 1.4 { bind cam_pitch = 1.4 } }

        if key_down("z") { bind cam_dist = cam_dist - 1.0   if cam_dist < CAM_DIST_MIN { bind cam_dist = CAM_DIST_MIN } }
        if key_down("x") { bind cam_dist = cam_dist + 1.0   if cam_dist > CAM_DIST_MAX { bind cam_dist = CAM_DIST_MAX } }

        # ── AUDIO ──────────────────────────────────────────────────────────────
        bind speed = sqrt(vx*vx + vy_phys*vy_phys + vz*vz)
        bind hNorm = (by - BALL_R - 0.1) / 8.0
        bind sinceHit = FR - lastBounce
        bind impact = 0.0
        if sinceHit < 6 { bind impact = (6 - sinceHit) * 24.0 }
        bind freq = 140.0 + hNorm * 200.0 + impact + speed * 20.0
        bind amp = 0.04 + speed * 0.06
        bind pan = bx / 12.0
        audio_tone(0, bx, by, bz, 4.0, freq, amp, pan, 0.02)

        # ── LIGHTS ────────────────────────────────────────────────────────────
        clear_lights()
        add_light(sin(FR*0.005)*6.0, 8.0, ZC,  1.0, 0.9, 0.8,  2.5, 30.0)
        add_light(-4.0, 3.0, ZC-4.0,  0.6, 0.7, 1.0,  1.0, 20.0)
        add_light(bx, by + 3.0, bz,  0.8, 0.5, 0.9,  0.9, 15.0)

        # ── CAMERA POSITION ────────────────────────────────────────────────────
        bind cam_x = bx + cam_dist * cos(cam_pitch) * sin(cam_orbit)
        bind cam_y = by + cam_dist * sin(cam_pitch)
        bind cam_z = bz + cam_dist * cos(cam_pitch) * cos(cam_orbit)

        bind look_dx = bx - cam_x
        bind look_dy = by - cam_y
        bind look_dz = bz - cam_z
        bind look_len = sqrt(look_dx*look_dx + look_dy*look_dy + look_dz*look_dz)

        if look_len > 0.01 {
            bind look_dx = look_dx / look_len
            bind look_dy = look_dy / look_len
            bind look_dz = look_dz / look_len
        }

        bind cam_yaw = 0.0 - atan2(look_dz, look_dx) + 1.5708
        bind cry = cos(cam_yaw)
        bind sry = sin(cam_yaw)

        bind cam_horiz_len = sqrt(look_dx*look_dx + look_dz*look_dz)
        bind cam_pitch_angle = 0.0 - atan2(look_dy, cam_horiz_len)
        bind crx = cos(cam_pitch_angle)
        bind srx = sin(cam_pitch_angle)

        set_camera(cry, sry, crx, srx)
        set_camera_pos(cam_x, cam_y, cam_z)
        set_zdist(500.0)

        # ── HYPERBOLIC LENS (conformal projection) ──────────────────────────────
        # Camera uses hyperbolic geometry for field of view distortion
        bind cam_to_origin_dist = sqrt(cam_x*cam_x + cam_y*cam_y + cam_z*cam_z)
        bind hyperbolic_scale = 1.0 / (1.0 + cam_to_origin_dist * 0.05)

        # ── INFINITE VOXEL GROUND ─────────────────────────────────────────────
        set_color(40, 70, 35)
        cube(0.0, 0.2, ZC,  300.0, 0.2, 300.0,  0.0, 0.0, 0.0,  0)

        # Grass/ground grid
        set_color(50, 80, 45)
        bind gx = int(bx / 8.0) * 8.0 - 60.0
        while gx < bx + 60.0 {
            draw_line_3d(gx, 0.3, ZC - 60.0,  gx, 0.3, ZC + 60.0)
            bind gx = gx + 4.0
        }
        bind gz = int((bz - ZC) / 8.0) * 8.0 - 60.0
        while gz < (bz - ZC) + 60.0 {
            draw_line_3d(bx - 60.0, 0.3, ZC + gz,  bx + 60.0, 0.3, ZC + gz)
            bind gz = gz + 4.0
        }

        # Procedural voxel towers on ground
        bind vx_world = int(bx / 6.0) * 6.0 - 80.0
        while vx_world < bx + 80.0 {
            bind vz_world = int((bz - ZC) / 6.0) * 6.0 - 80.0
            while vz_world < (bz - ZC) + 80.0 {
                bind voxel_hash = hash01(vx_world * 0.05, vz_world * 0.05)
                if voxel_hash > 0.4 {
                    bind voxel_height = int(voxel_hash * 5.0) + 1
                    bind voxel_color_r = int(sin(voxel_hash * 6.28) * 60.0 + 90.0)
                    bind voxel_color_g = int(cos(voxel_hash * 6.28) * 70.0 + 100.0)
                    bind voxel_color_b = int(sin(voxel_hash * 6.28 + 2.1) * 50.0 + 110.0)

                    # Stack voxels with bottom at ground, scaled by hyperbolic lens
                    bind v_y = 0
                    while v_y < voxel_height {
                        bind vy_pos = VOXEL_SIZE * 0.5 + v_y * VOXEL_SIZE
                        bind voxel_cam_dist = sqrt((vx_world-cam_x)*(vx_world-cam_x) + (vy_pos-cam_y)*(vy_pos-cam_y) + (ZC+vz_world-cam_z)*(ZC+vz_world-cam_z))
                        bind voxel_hyperbolic_scale = 1.0 / (1.0 + voxel_cam_dist * 0.02)
                        set_color(voxel_color_r - v_y * 8, voxel_color_g - v_y * 8, voxel_color_b - v_y * 8)
                        cube(vx_world, vy_pos, ZC + vz_world,  VOXEL_SIZE * voxel_hyperbolic_scale, VOXEL_SIZE * voxel_hyperbolic_scale, VOXEL_SIZE * voxel_hyperbolic_scale,  0.0, 0.0, 0.0,  0)
                        bind v_y = v_y + 1
                    }
                }
                bind vz_world = vz_world + 6.0
            }
            bind vx_world = vx_world + 6.0
        }

        # ── H³ BOOST ───────────────────────────────────────────────────────────
        bind blen = sqrt(bx_move*bx_move + bz_move*bz_move)
        bind dx = 0.0
        bind dz = 0.0
        if blen > 0.00001 { bind dx = bx_move / blen   bind dz = bz_move / blen }
        bind v = blen

        bind ep = exp(v)
        bind em = exp((0.0 - v))
        bind ch = (ep + em) / 2.0
        bind sh = (ep - em) / 2.0
        bind nsh = 0.0 - sh

        # ── UPDATE ROOMS & DRAW ────────────────────────────────────────────────
        bind nrx = list_new()
        bind nry = list_new()
        bind nrz = list_new()
        bind nrw = list_new()
        bind occlusion_count = 0
        bind i = 0

        while i < NROOMS {
            bind px = list_get(rx, i)
            bind py = list_get(ry, i)
            bind pz = list_get(rz, i)
            bind pw = list_get(rw, i)

            bind dot = dx*px + dz*pz
            bind nx = px + (ch - 1.0)*dx*dot + nsh*dx*pw
            bind ny = py
            bind nz = pz + (ch - 1.0)*dz*dot + nsh*dz*pw
            bind nw = nsh*dot + ch*pw

            bind nn = sqrt(nw*nw - nx*nx - ny*ny - nz*nz)
            if nn > 0.0001 { bind nx = nx / nn   bind ny = ny / nn   bind nz = nz / nn   bind nw = nw / nn }

            bind nrx = list_push(nrx, nx)
            bind nry = list_push(nry, ny)
            bind nrz = list_push(nrz, nz)
            bind nrw = list_push(nrw, nw)

            # ── DRAW MAZE ──────────────────────────────────────────────────────
            bind bx2 = nx / (1.0 + nw)
            bind by2 = ny / (1.0 + nw)
            bind bz2 = nz / (1.0 + nw)
            bind rr = bx2*bx2 + by2*by2 + bz2*bz2
            bind conf = 1.0 - rr

            if conf > 0.01 {
                bind wx = bx2 * SCALE
                bind wy = by2 * SCALE
                bind wz = ZC + bz2 * SCALE

                bind dot_with_cam = (wx-cam_x)*look_dx + (wy-cam_y)*look_dy + (wz-cam_z)*look_dz

                if dot_with_cam > 0 {
                    bind cam_to_room_dist = sqrt((wx-cam_x)*(wx-cam_x) + (wy-cam_y)*(wy-cam_y) + (wz-cam_z)*(wz-cam_z))
                    bind cam_to_ball_dist = sqrt((bx-cam_x)*(bx-cam_x) + (by-cam_y)*(by-cam_y) + (bz-cam_z)*(bz-cam_z))
                    bind is_occluding = 0
                    if cam_to_room_dist < cam_to_ball_dist - 1.0 { bind is_occluding = 1   bind occlusion_count = occlusion_count + 1 }

                    bind rt = list_get(rtype, i)
                    bind hue = hash01(rt, 1.0)
                    bind col_r = int(sin(hue * 6.28 + FR * 0.001) * 50.0 + 100.0)
                    bind col_g = int(sin(hue * 6.28 + FR * 0.001 + 2.094) * 60.0 + 110.0)
                    bind col_b = int(sin(hue * 6.28 + FR * 0.001 + 4.189) * 70.0 + 140.0)

                    # Fade occluding geometry
                    if is_occluding > 0 {
                        bind col_r = int(col_r * 0.2 + 3.0 * 0.8)
                        bind col_g = int(col_g * 0.2 + 10.0 * 0.8)
                        bind col_b = int(col_b * 0.2 + 8.0 * 0.8)
                    }

                    if i == 0 {
                        # ── CENTRAL CHAMBER ────────────────────────────────────
                        set_color(col_r, col_g, col_b)
                        bind gx = 0
                        while gx < 12 {
                            draw_line_3d(wx - 30.0, wy, wz - 30.0 + gx * 5.0,  wx + 30.0, wy, wz - 30.0 + gx * 5.0)
                            bind gx = gx + 1
                        }
                        bind gx = 0
                        while gx < 12 {
                            draw_line_3d(wx - 30.0 + gx * 5.0, wy, wz - 30.0,  wx - 30.0 + gx * 5.0, wy, wz + 30.0)
                            bind gx = gx + 1
                        }

                        # Portal in center
                        bind portal_cycle = sin(FR * 0.04) * 0.5 + 0.5
                        bind portal_r = int(sin(portal_cycle * 6.28) * 90.0 + 130.0)
                        bind portal_g = int(cos(portal_cycle * 6.28) * 90.0 + 130.0)
                        bind portal_b = int(sin(portal_cycle * 6.28 + 2.1) * 90.0 + 130.0)
                        set_color(portal_r, portal_g, portal_b)
                        sphere(wx, wy + 12.0 * conf, wz,  4.0 * conf, 4.0 * conf, 4.0 * conf,  0.0, 0.0, 0.0,  0)
                    } else {
                        # ── SPOKE CHAMBERS ────────────────────────────────────
                        set_color(col_r, col_g, col_b)
                        cube(wx, wy + 8.0 * conf, wz,  20.0 * conf, 16.0 * conf, 20.0 * conf,  0.0, 0.0, 0.0,  0)
                    }
                }
            }

            bind i = i + 1
        }

        bind rx = nrx
        bind ry = nry
        bind rz = nrz
        bind rw = nrw

        # ── BILLBOARDED BALL (always faces camera) ─────────────────────────────
        # Draw ball as flat circles in 3D that always face camera
        bind ball_color_r = int(sin(FR * 0.02) * 80.0 + 140.0)
        bind ball_color_g = int(cos(FR * 0.02) * 80.0 + 140.0)
        bind ball_color_b = int(sin(FR * 0.02 + 2.1) * 80.0 + 140.0)
        set_color(ball_color_r, ball_color_g, ball_color_b)

        # Draw ball as concentric circles facing camera
        bind circle_rad = 0.0
        while circle_rad < BALL_R {
            bind angle = 0.0
            while angle < 6.28 {
                bind next_angle = angle + 0.2
                # Offset along camera direction for pseudo-3D effect
                bind offset_dist = circle_rad * 0.5
                bind offset_x = look_dx * offset_dist
                bind offset_y = look_dy * offset_dist
                bind offset_z = look_dz * offset_dist

                bind p1_x = bx + cos(angle) * circle_rad - offset_x
                bind p1_y = by + sin(angle) * circle_rad - offset_y
                bind p1_z = bz - offset_z
                bind p2_x = bx + cos(next_angle) * circle_rad - offset_x
                bind p2_y = by + sin(next_angle) * circle_rad - offset_y
                bind p2_z = bz - offset_z

                draw_line_3d(p1_x, p1_y, p1_z,  p2_x, p2_y, p2_z)
                bind angle = next_angle
            }
            bind circle_rad = circle_rad + BALL_R * 0.25
        }

        # Shadow
        set_color(50, 50, 100)
        draw_line_3d(bx - BALL_R * 1.5, 0.15, bz,  bx + BALL_R * 1.5, 0.15, bz)
        draw_line_3d(bx, 0.15, bz - BALL_R * 1.5,  bx, 0.15, bz + BALL_R * 1.5)

        # Velocity indicator
        set_color(100, 200, 255)
        draw_line_3d(bx, by, bz,  bx + vx * 0.4, by + vy_phys * 0.4, bz + vz * 0.4)

        # Jump meter
        if charge > 0.01 {
            bind cf = charge / 88.0
            set_color(255, int(200 - cf * 150.0), 40)
            draw_line_3d(bx, by, bz, bx, by - cf * 16.0, bz)
        }

        present()
        bind FR = FR + 1
    }
}
