# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Hyperbolic 5-Way Portal Castle — Pentagonal Tower with Winding Stairs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 5-spoke hyperbolic house with pentagonal rooms and central tower.
# Color-cycling portals teleport you between random rooms.
# Infinite grass ground with procedural trees.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind SCALE  = 6.5
bind ZC     = 9.0
bind STEP   = 0.025
bind TURN   = 0.03
bind G      = 22.0
bind JUMP   = 60.0
bind HDIST  = 1.5
bind NROOMS = 6

bind BALL_R = 1.5
bind DAMPING = 0.995
bind ELASTICITY = 0.86
bind MOVE_ACCEL = 200.0

# Pentagonal castle (balanced scale)
bind ROOM_W = 14.0
bind ROOM_H = 16.0

# Orbital camera
bind CAM_DIST_INIT = 20.0
bind CAM_DIST_MIN = 5.0
bind CAM_DIST_MAX = 400.0

# ── cosh / sinh ───────────────────────────────────────────────────────────────
fn cosh_h(v) {
    (exp(v) + exp(0.0 - v)) / 2.0
}

fn sinh_h(v) {
    (exp(v) - exp(0.0 - v)) / 2.0
}

fn hash01(a, b) {
    sin(a*12.9898 + b*78.233) * 43758.5453 - floor(sin(a*12.9898 + b*78.233) * 43758.5453)
}

# ── main ──────────────────────────────────────────────────────────────────────
bind start = do {
    open_fullscreen("Hyperbolic 5-Portal Castle")
    capture_mouse()
    set_ambient(0.16)

    set_shade_mode(1)
    set_cel_bands(4)
    set_shadow_color(10, 15, 25)
    set_rim(0.3, 100, 150, 200)

    audio_tone(0, 0.0, 0.0, ZC, 4.0, 180.0, 0.06, 0.5, 0.02)

    # ── H³ rooms (5-spoke pentagonal) ──────────────────────────────────────────
    bind rx = list_new()
    bind ry = list_new()
    bind rz = list_new()
    bind rw = list_new()
    bind rtype = list_new()

    # Center atrium
    bind rx = list_push(rx, 0.0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0)
    bind rw = list_push(rw, 1.0)
    bind rtype = list_push(rtype, 0)

    # 5 spoke rooms (72° apart)
    bind ch0 = cosh_h(HDIST)
    bind sh0 = sinh_h(HDIST)

    bind spoke = 0
    while spoke < 5 {
        bind angle = spoke * 1.2566  # 2π/5
        bind dx = cos(angle)
        bind dz = sin(angle)
        bind rx = list_push(rx, sh0 * dx)
        bind ry = list_push(ry, 0.0)
        bind rz = list_push(rz, sh0 * dz)
        bind rw = list_push(rw, ch0)
        bind rtype = list_push(rtype, spoke + 1)
        bind spoke = spoke + 1
    }

    # Portal locations (one per spoke room)
    bind portal_x = list_new()
    bind portal_z = list_new()
    bind spoke = 0
    while spoke < 5 {
        bind angle = spoke * 1.2566
        bind portal_x = list_push(portal_x, cos(angle) * 12.0)
        bind portal_z = list_push(portal_z, sin(angle) * 12.0)
        bind spoke = spoke + 1
    }

    # ── Ball state ─────────────────────────────────────────────────────────────
    bind bx = 0.0
    bind by = 0.2
    bind bz = ZC
    bind vx = 0.0
    bind vy_phys = 0.0
    bind vz = 0.0
    bind pyaw = 0.0
    bind FR = 0
    bind lastBounce = -99
    bind spaceWasDown = 0
    bind charge = 0.0

    # ── Camera orbital state ───────────────────────────────────────────────────
    bind cam_dist = CAM_DIST_INIT
    bind cam_orbit = 0.0
    bind cam_pitch = 1.1

    while window_is_open() {
        fill(2, 8, 5)
        bind dt = 0.0166667

        # ── PHYSICS ────────────────────────────────────────────────────────────
        bind vy_phys = vy_phys + G * dt
        bind vx = vx * DAMPING
        bind vy_phys = vy_phys * DAMPING
        bind vz = vz * DAMPING

        bind bx = bx + vx * dt
        bind by = by + vy_phys * dt
        bind bz = bz + vz * dt

        bind hit = 0

        # Infinite ground wrap (72x72 tiles)
        if bx < -36.0 { bind bx = bx + 72.0 }
        if bx > 36.0 { bind bx = bx - 72.0 }
        if bz < ZC - 36.0 { bind bz = bz + 72.0 }
        if bz > ZC + 36.0 { bind bz = bz - 72.0 }

        # Ground collision
        if by < (0.1 + BALL_R) { bind by = 0.1 + BALL_R   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }
        if by > 40.0 { bind by = 40.0   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }

        if hit > 0 { bind lastBounce = FR }
        bind grounded = 0
        if by > (0.1 + BALL_R - 0.15) { bind grounded = 1 }

        # ── BALL INPUT ─────────────────────────────────────────────────────────
        bind bx_move = 0.0
        bind bz_move = 0.0
        if key_down("w") { bind bx_move = bx_move + sin(pyaw) * STEP   bind bz_move = bz_move + cos(pyaw) * STEP }
        if key_down("s") { bind bx_move = bx_move - sin(pyaw) * STEP   bind bz_move = bz_move - cos(pyaw) * STEP }
        if key_down("a") { bind bx_move = bx_move + cos(pyaw) * STEP   bind bz_move = bz_move - sin(pyaw) * STEP }
        if key_down("d") { bind bx_move = bx_move - cos(pyaw) * STEP   bind bz_move = bz_move + sin(pyaw) * STEP }

        bind vx = vx + bx_move * MOVE_ACCEL * dt
        bind vz = vz + bz_move * MOVE_ACCEL * dt

        if key_down("q") { bind pyaw = pyaw + TURN }
        if key_down("e") { bind pyaw = pyaw - TURN }

        # ── JUMP ───────────────────────────────────────────────────────────────
        bind spaceNow = 0
        if key_down("space") { bind spaceNow = 1 }
        if spaceNow > 0 {
            if grounded > 0 { bind charge = charge + 112.0 * dt   if charge > 88.0 { bind charge = 88.0 } }
        } else {
            if spaceWasDown > 0 {
                if charge > 0.01 { bind vy_phys = vy_phys - charge }
                bind charge = 0.0
            }
        }
        bind spaceWasDown = spaceNow

        # ── PORTAL TELEPORTATION ───────────────────────────────────────────────
        bind p = 0
        while p < 5 {
            bind px = list_get(portal_x, p)
            bind pz = list_get(portal_z, p)
            bind dist_to_portal = sqrt((bx - px)*(bx - px) + (bz - ZC - pz)*(bz - ZC - pz))
            if dist_to_portal < 3.5 {
                # Teleport to random other portal
                bind target = int(hash01(FR, p) * 4.999)
                bind new_px = list_get(portal_x, target)
                bind new_pz = list_get(portal_z, target)
                bind bx = new_px + 0.5 * cos(pyaw)
                bind bz = ZC + new_pz + 0.5 * sin(pyaw)
                bind by = 0.2
            }
            bind p = p + 1
        }

        # ── CAMERA ORBITAL CONTROL ─────────────────────────────────────────────
        if key_down("left") { bind cam_orbit = cam_orbit + 0.04 }
        if key_down("right") { bind cam_orbit = cam_orbit - 0.04 }
        if key_down("up") { bind cam_pitch = cam_pitch + 0.04   if cam_pitch > 1.5 { bind cam_pitch = 1.5 } }
        if key_down("down") { bind cam_pitch = cam_pitch - 0.04   if cam_pitch < -1.5 { bind cam_pitch = -1.5 } }

        bind mouse_dx_now = mouse_dx()
        bind mouse_dy_now = mouse_dy()
        if mouse_dx_now > 5 { bind cam_orbit = cam_orbit - 0.02 }
        if mouse_dx_now < -5 { bind cam_orbit = cam_orbit + 0.02 }
        if mouse_dy_now > 5 { bind cam_pitch = cam_pitch - 0.02   if cam_pitch < -1.5 { bind cam_pitch = -1.5 } }
        if mouse_dy_now < -5 { bind cam_pitch = cam_pitch + 0.02   if cam_pitch > 1.5 { bind cam_pitch = 1.5 } }

        if key_down("z") { bind cam_dist = cam_dist - 0.5   if cam_dist < CAM_DIST_MIN { bind cam_dist = CAM_DIST_MIN } }
        if key_down("x") { bind cam_dist = cam_dist + 0.5   if cam_dist > CAM_DIST_MAX { bind cam_dist = CAM_DIST_MAX } }

        # ── AUDIO ──────────────────────────────────────────────────────────────
        bind speed = sqrt(vx*vx + vy_phys*vy_phys + vz*vz)
        bind hNorm = (by - 0.2) / 6.0
        bind sinceHit = FR - lastBounce
        bind impact = 0.0
        if sinceHit < 6 { bind impact = (6 - sinceHit) * 24.0 }
        bind freq = 140.0 + hNorm * 200.0 + impact + speed * 20.0
        bind amp = 0.04 + speed * 0.06
        bind pan = bx / 8.0
        audio_tone(0, bx, by, bz, 4.0, freq, amp, pan, 0.02)

        # ── LIGHTS ────────────────────────────────────────────────────────────
        clear_lights()
        add_light(sin(FR*0.006)*4.0, 5.0, ZC,  0.9, 0.8, 0.7,  2.0, 20.0)
        add_light(-2.0, 2.0, ZC-2.0,  0.5, 0.6, 0.9,  0.8, 15.0)
        add_light(bx, by + 2.0, bz,  0.7, 0.4, 0.8,  0.7, 10.0)

        # ── CAMERA POSITION ────────────────────────────────────────────────────
        bind cam_x = bx + cam_dist * cos(cam_pitch) * sin(cam_orbit)
        bind cam_y = by + cam_dist * sin(cam_pitch)
        bind cam_z = bz + cam_dist * cos(cam_pitch) * cos(cam_orbit)

        bind look_dx = bx - cam_x
        bind look_dy = by - cam_y
        bind look_dz = bz - cam_z
        bind look_len = sqrt(look_dx*look_dx + look_dy*look_dy + look_dz*look_dz)

        if look_len > 0.01 {
            bind look_dx = look_dx / look_len
            bind look_dy = look_dy / look_len
            bind look_dz = look_dz / look_len
        }

        bind cam_yaw = 0.0 - atan2(look_dz, look_dx) + 1.5708
        bind cry = cos(cam_yaw)
        bind sry = sin(cam_yaw)

        bind cam_horiz_len = sqrt(look_dx*look_dx + look_dz*look_dz)
        bind cam_pitch_angle = 0.0 - atan2(look_dy, cam_horiz_len)
        bind crx = cos(cam_pitch_angle)
        bind srx = sin(cam_pitch_angle)

        set_camera(cry, sry, crx, srx)
        set_camera_pos(cam_x, cam_y, cam_z)
        set_zdist(300.0)

        # ── INFINITE GRASS GROUND ──────────────────────────────────────────────
        set_color(30, 60, 25)
        cube(0.0, 0.15, ZC,  200.0, 0.15, 200.0,  0.0, 0.0, 0.0,  0)

        # Grass grid pattern
        set_color(40, 75, 35)
        bind gx = int(bx / 8.0) * 8.0 - 40.0
        while gx < bx + 40.0 {
            draw_line_3d(gx, 0.2, ZC - 40.0,  gx, 0.2, ZC + 40.0)
            bind gx = gx + 4.0
        }
        bind gz = int((bz - ZC) / 8.0) * 8.0 - 40.0
        while gz < (bz - ZC) + 40.0 {
            draw_line_3d(bx - 40.0, 0.2, ZC + gz,  bx + 40.0, 0.2, ZC + gz)
            bind gz = gz + 4.0
        }

        # Procedural trees
        bind tx = int(bx / 6.0) * 6.0 - 30.0
        while tx < bx + 30.0 {
            bind tz = int((bz - ZC) / 6.0) * 6.0 - 30.0
            while tz < (bz - ZC) + 30.0 {
                bind tree_hash = hash01(tx * 0.1, tz * 0.1)
                if tree_hash > 0.7 {
                    # Draw tree
                    set_color(100, 140, 80)
                    cylinder(tx, 2.0, ZC + tz,  0.4, 3.0, 0.4,  0.0, 0.0, 0.0,  0,  8)
                    set_color(60, 120, 50)
                    sphere(tx, 3.5, ZC + tz,  1.2, 1.2, 1.2,  0.0, 0.0, 0.0,  0)
                }
                bind tz = tz + 6.0
            }
            bind tx = tx + 6.0
        }

        # ── H³ BOOST ───────────────────────────────────────────────────────────
        bind blen = sqrt(bx_move*bx_move + bz_move*bz_move)
        bind dx = 0.0
        bind dz = 0.0
        if blen > 0.00001 { bind dx = bx_move / blen   bind dz = bz_move / blen }
        bind v = blen

        bind ep = exp(v)
        bind em = exp((0.0 - v))
        bind ch = (ep + em) / 2.0
        bind sh = (ep - em) / 2.0
        bind nsh = 0.0 - sh

        # ── UPDATE ROOMS & DRAW ────────────────────────────────────────────────
        bind nrx = list_new()
        bind nry = list_new()
        bind nrz = list_new()
        bind nrw = list_new()
        bind i = 0

        while i < NROOMS {
            bind px = list_get(rx, i)
            bind py = list_get(ry, i)
            bind pz = list_get(rz, i)
            bind pw = list_get(rw, i)

            bind dot = dx*px + dz*pz
            bind nx = px + (ch - 1.0)*dx*dot + nsh*dx*pw
            bind ny = py
            bind nz = pz + (ch - 1.0)*dz*dot + nsh*dz*pw
            bind nw = nsh*dot + ch*pw

            bind nn = sqrt(nw*nw - nx*nx - ny*ny - nz*nz)
            if nn > 0.0001 { bind nx = nx / nn   bind ny = ny / nn   bind nz = nz / nn   bind nw = nw / nn }

            bind nrx = list_push(nrx, nx)
            bind nry = list_push(nry, ny)
            bind nrz = list_push(nrz, nz)
            bind nrw = list_push(nrw, nw)

            # ── DRAW MAZE ──────────────────────────────────────────────────────
            bind bx2 = nx / (1.0 + nw)
            bind by2 = ny / (1.0 + nw)
            bind bz2 = nz / (1.0 + nw)
            bind rr = bx2*bx2 + by2*by2 + bz2*bz2
            bind conf = 1.0 - rr

            if conf > 0.02 {
                bind wx = bx2 * SCALE
                bind wy = by2 * SCALE
                bind wz = ZC + bz2 * SCALE

                bind dot_with_cam_dir = (wx-cam_x)*look_dx + (wy-cam_y)*look_dy + (wz-cam_z)*look_dz

                if dot_with_cam_dir > 0 {
                    bind rt = list_get(rtype, i)
                    bind hue = hash01(rt, 1.0)
                    bind col_r = int(sin(hue * 6.28 + FR * 0.002) * 40.0 + 100.0)
                    bind col_g = int(sin(hue * 6.28 + FR * 0.002 + 2.094) * 50.0 + 110.0)
                    bind col_b = int(sin(hue * 6.28 + FR * 0.002 + 4.189) * 60.0 + 140.0)

                    if i == 0 {
                        # ── CENTRAL ATRIUM with tower ──────────────────────────
                        set_color(col_r, col_g, col_b)
                        bind gx = 0
                        while gx < 10 {
                            draw_line_3d(wx - 20.0, wy, wz - 20.0 + gx * 4.0,  wx + 20.0, wy, wz - 20.0 + gx * 4.0)
                            bind gx = gx + 1
                        }
                        bind gx = 0
                        while gx < 10 {
                            draw_line_3d(wx - 20.0 + gx * 4.0, wy, wz - 20.0,  wx - 20.0 + gx * 4.0, wy, wz + 20.0)
                            bind gx = gx + 1
                        }

                        # Hyperbolic spiral tower
                        set_color(col_r - 20, col_g + 20, col_b + 30)
                        bind spiral_h = 0.0
                        bind spiral_angle = 0.0
                        while spiral_h < 20.0 {
                            bind sx = wx + sin(spiral_angle) * 3.0
                            bind sz = wz + cos(spiral_angle) * 3.0
                            bind sy = wy + spiral_h * conf
                            sphere(sx, sy, sz,  0.8 * conf, 0.8 * conf, 0.8 * conf,  0.0, 0.0, 0.0,  0)
                            bind spiral_h = spiral_h + 0.5
                            bind spiral_angle = spiral_angle + 0.4
                        }
                    } else {
                        # ── PENTAGONAL ROOMS ───────────────────────────────────
                        bind room_color_r = col_r
                        bind room_color_g = col_g
                        bind room_color_b = col_b

                        set_color(room_color_r, room_color_g, room_color_b)
                        cube(wx, wy, wz,  ROOM_W * conf, ROOM_H * conf, ROOM_W * conf,  0.0, 0.0, 0.0,  0)

                        # Color-cycling portal at room center
                        bind portal_cycle = sin(FR * 0.05) * 0.5 + 0.5
                        bind portal_r = int(sin(portal_cycle * 6.28) * 80.0 + 120.0)
                        bind portal_g = int(cos(portal_cycle * 6.28) * 80.0 + 120.0)
                        bind portal_b = int(sin(portal_cycle * 6.28 + 2.1) * 80.0 + 120.0)
                        set_color(portal_r, portal_g, portal_b)
                        sphere(wx, wy + 8.0 * conf, wz,  2.5 * conf, 2.5 * conf, 2.5 * conf,  0.0, 0.0, 0.0,  0)

                        # Portal glow rings
                        set_color(portal_r / 2, portal_g / 2, portal_b / 2)
                        bind ring_rad = 3.0 * conf
                        bind ring_angle = 0.0
                        while ring_angle < 6.28 {
                            bind next_angle = ring_angle + 0.3
                            draw_line_3d(wx + ring_rad * cos(ring_angle), wy + 8.0 * conf, wz + ring_rad * sin(ring_angle),  wx + ring_rad * cos(next_angle), wy + 8.0 * conf, wz + ring_rad * sin(next_angle))
                            bind ring_angle = next_angle
                        }
                    }
                }
            }

            bind i = i + 1
        }

        bind rx = nrx
        bind ry = nry
        bind rz = nrz
        bind rw = nrw

        # ── BALL (CHAKRA) ──────────────────────────────────────────────────────
        bind ball_hue = hash01(speed, FR * 0.01) * 6.28
        vtex_chakra(bx, by, bz,  1,0,0,  0,1,0,  6, BALL_R,  FR * 0.04, ball_hue)

        # Shadow & indicators
        set_color(50, 40, 100)
        draw_line_3d(bx - BALL_R, 0.1, bz,  bx + BALL_R, 0.1, bz)
        draw_line_3d(bx, 0.1, bz - BALL_R,  bx, 0.1, bz + BALL_R)

        set_color(100, 200, 255)
        draw_line_3d(bx, by, bz,  bx + vx * 0.25, by + vy_phys * 0.25, bz + vz * 0.25)

        if charge > 0.01 {
            bind cf = charge / 88.0
            set_color(255, int(200 - cf * 150.0), 40)
            draw_line_3d(bx, by, bz, bx, by - cf * 16.0, bz)
        }

        present()
        bind FR = FR + 1
    }
}
