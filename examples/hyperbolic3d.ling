# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Hyperbolic 3D DOOM — Orbital Camera Around Physics Ball in Vast H³ Maze
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Massive 8-spoke wireframe maze in H³. Ball rolls on ground.
# Camera tethered to ball by a string—orbit it with arrow keys or mouse.
#
# Controls:
#   WASD / Arrows  move ball
#   Q / E          turn ball
#   SPACE          jump ball
#   ← / →          orbit left/right around ball
#   ↑ / ↓          look up/down
#   Mouse L/R      orbit left/right
#   Mouse U/D      look up/down
#   W / S (while camera focused)  zoom in/out
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind SCALE  = 6.5
bind ZC     = 9.0
bind STEP   = 0.025
bind TURN   = 0.03
bind G      = 22.0
bind JUMP   = 60.0
bind HDIST  = 1.8
bind NROOMS = 9

bind BALL_R = 0.35
bind DAMPING = 0.995
bind ELASTICITY = 0.86
bind MOVE_ACCEL = 200.0

# MASSIVE hyperbolic temple (8x scale)
bind HALLWAY_W = 64.0
bind HALLWAY_H = 72.0
bind ATRIUM_R = 80.0
bind SPOKE_L = 160.0

# Orbital camera
bind CAM_DIST_INIT = 25.0   # start far away (8x scale)
bind CAM_DIST_MIN = 4.0
bind CAM_DIST_MAX = 800.0

# ── cosh / sinh ───────────────────────────────────────────────────────────────
fn cosh_h(v) {
    (exp(v) + exp(0.0 - v)) / 2.0
}

fn sinh_h(v) {
    (exp(v) - exp(0.0 - v)) / 2.0
}

fn hash01(a, b) {
    sin(a*12.9898 + b*78.233) * 43758.5453 - floor(sin(a*12.9898 + b*78.233) * 43758.5453)
}

# ── draw wireframe box ─────────────────────────────────────────────────────────
fn draw_wireframe_box(cx, cy, cz, sx, sy, sz, col_r, col_g, col_b) {
    set_color(col_r, col_g, col_b)
    draw_line_3d(cx-sx, cy+sy, cz-sz,  cx+sx, cy+sy, cz-sz)
    draw_line_3d(cx+sx, cy+sy, cz-sz,  cx+sx, cy+sy, cz+sz)
    draw_line_3d(cx+sx, cy+sy, cz+sz,  cx-sx, cy+sy, cz+sz)
    draw_line_3d(cx-sx, cy+sy, cz+sz,  cx-sx, cy+sy, cz-sz)
    draw_line_3d(cx-sx, cy-sy, cz-sz,  cx+sx, cy-sy, cz-sz)
    draw_line_3d(cx+sx, cy-sy, cz-sz,  cx+sx, cy-sy, cz+sz)
    draw_line_3d(cx+sx, cy-sy, cz+sz,  cx-sx, cy-sy, cz+sz)
    draw_line_3d(cx-sx, cy-sy, cz+sz,  cx-sx, cy-sy, cz-sz)
    draw_line_3d(cx-sx, cy-sy, cz-sz,  cx-sx, cy+sy, cz-sz)
    draw_line_3d(cx+sx, cy-sy, cz-sz,  cx+sx, cy+sy, cz-sz)
    draw_line_3d(cx+sx, cy-sy, cz+sz,  cx+sx, cy+sy, cz+sz)
    draw_line_3d(cx-sx, cy-sy, cz+sz,  cx-sx, cy+sy, cz+sz)
}

# ── main ──────────────────────────────────────────────────────────────────────
bind start = do {
    open_fullscreen("Hyperbolic 3D DOOM — Orbital Camera")
    capture_mouse()
    set_ambient(0.14)

    set_shade_mode(1)
    set_cel_bands(4)
    set_shadow_color(10, 5, 30)
    set_rim(0.3, 80, 120, 200)

    audio_tone(0, 0.0, 0.0, ZC, 4.0, 180.0, 0.06, 0.5, 0.02)

    # ── H³ rooms ───────────────────────────────────────────────────────────────
    bind rx = list_new()
    bind ry = list_new()
    bind rz = list_new()
    bind rw = list_new()
    bind rtype = list_new()

    bind rx = list_push(rx, 0.0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0)
    bind rw = list_push(rw, 1.0)
    bind rtype = list_push(rtype, 0)

    bind ch0 = cosh_h(HDIST)
    bind sh0 = sinh_h(HDIST)
    bind D2 = sh0 * 0.7071

    bind rx = list_push(rx, 0.0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, sh0)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 1)

    bind rx = list_push(rx, 0.0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0-sh0)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 2)

    bind rx = list_push(rx, sh0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 3)

    bind rx = list_push(rx, 0.0-sh0)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 4)

    bind rx = list_push(rx, D2)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, D2)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 5)

    bind rx = list_push(rx, 0.0-D2)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, D2)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 6)

    bind rx = list_push(rx, D2)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0-D2)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 7)

    bind rx = list_push(rx, 0.0-D2)
    bind ry = list_push(ry, 0.0)
    bind rz = list_push(rz, 0.0-D2)
    bind rw = list_push(rw, ch0)
    bind rtype = list_push(rtype, 8)

    # ── Ball state ─────────────────────────────────────────────────────────────
    bind bx = 0.0
    bind by = 0.2
    bind bz = ZC
    bind vx = 0.0
    bind vy_phys = 0.0
    bind vz = 0.0
    bind pyaw = 0.0
    bind FR = 0
    bind lastBounce = -99
    bind spaceWasDown = 0
    bind charge = 0.0

    # ── Camera orbital state ───────────────────────────────────────────────────
    bind cam_dist = CAM_DIST_INIT
    bind cam_orbit = 0.0          # horizontal orbit around ball (radians)
    bind cam_pitch = 1.1          # vertical pitch (up/down, radians) — start HIGH looking down
    bind last_mouse_x = 0
    bind last_mouse_y = 0

    while window_is_open() {
        fill(1, 1, 6)
        bind dt = 0.0166667

        # ── PHYSICS ────────────────────────────────────────────────────────────
        bind vy_phys = vy_phys + G * dt
        bind vx = vx * DAMPING
        bind vy_phys = vy_phys * DAMPING
        bind vz = vz * DAMPING

        bind bx = bx + vx * dt
        bind by = by + vy_phys * dt
        bind bz = bz + vz * dt

        bind hit = 0

        # MASSIVE arena boundary (8x scale)
        if bx < (0.0 - 144.0 + BALL_R) { bind bx = 0.0 - 144.0 + BALL_R   bind vx = 0.0 - vx * ELASTICITY   bind hit = 1 }
        if bx > (144.0 - BALL_R) { bind bx = 144.0 - BALL_R   bind vx = 0.0 - vx * ELASTICITY   bind hit = 1 }
        if by < (0.2 + BALL_R) { bind by = 0.2 + BALL_R   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }
        if by > (96.0 - BALL_R) { bind by = 96.0 - BALL_R   bind vy_phys = 0.0 - vy_phys * ELASTICITY   bind hit = 1 }
        if bz < (ZC - 144.0 + BALL_R) { bind bz = ZC - 144.0 + BALL_R   bind vz = 0.0 - vz * ELASTICITY   bind hit = 1 }
        if bz > (ZC + 144.0 - BALL_R) { bind bz = ZC + 144.0 - BALL_R   bind vz = 0.0 - vz * ELASTICITY   bind hit = 1 }

        if hit > 0 { bind lastBounce = FR }
        bind grounded = 0
        if by > (0.2 + BALL_R - 0.15) { bind grounded = 1 }

        # ── BALL INPUT ─────────────────────────────────────────────────────────
        bind bx_move = 0.0
        bind bz_move = 0.0
        if key_down("w") { bind bx_move = bx_move + sin(pyaw) * STEP   bind bz_move = bz_move + cos(pyaw) * STEP }
        if key_down("s") { bind bx_move = bx_move - sin(pyaw) * STEP   bind bz_move = bz_move - cos(pyaw) * STEP }
        if key_down("a") { bind bx_move = bx_move + cos(pyaw) * STEP   bind bz_move = bz_move - sin(pyaw) * STEP }
        if key_down("d") { bind bx_move = bx_move - cos(pyaw) * STEP   bind bz_move = bz_move + sin(pyaw) * STEP }

        bind vx = vx + bx_move * MOVE_ACCEL * dt
        bind vz = vz + bz_move * MOVE_ACCEL * dt

        if key_down("q") { bind pyaw = pyaw + TURN }
        if key_down("e") { bind pyaw = pyaw - TURN }

        # ── JUMP ───────────────────────────────────────────────────────────────
        bind spaceNow = 0
        if key_down("space") { bind spaceNow = 1 }
        if spaceNow > 0 {
            if grounded > 0 { bind charge = charge + 112.0 * dt   if charge > 88.0 { bind charge = 88.0 } }
        } else {
            if spaceWasDown > 0 {
                if charge > 0.01 { bind vy_phys = vy_phys - charge }
                bind charge = 0.0
            }
        }
        bind spaceWasDown = spaceNow

        # ── CAMERA ORBITAL CONTROL ─────────────────────────────────────────────
        # Arrow keys
        if key_down("left") { bind cam_orbit = cam_orbit + 0.04 }
        if key_down("right") { bind cam_orbit = cam_orbit - 0.04 }
        if key_down("up") { bind cam_pitch = cam_pitch + 0.04   if cam_pitch > 1.5 { bind cam_pitch = 1.5 } }
        if key_down("down") { bind cam_pitch = cam_pitch - 0.04   if cam_pitch < -1.5 { bind cam_pitch = -1.5 } }

        # Mouse movement (relative)
        bind mouse_dx_now = mouse_dx()
        bind mouse_dy_now = mouse_dy()
        if mouse_dx_now > 5 { bind cam_orbit = cam_orbit - 0.02 }
        if mouse_dx_now < -5 { bind cam_orbit = cam_orbit + 0.02 }
        if mouse_dy_now > 5 { bind cam_pitch = cam_pitch - 0.02   if cam_pitch < -1.5 { bind cam_pitch = -1.5 } }
        if mouse_dy_now < -5 { bind cam_pitch = cam_pitch + 0.02   if cam_pitch > 1.5 { bind cam_pitch = 1.5 } }

        # Zoom in/out with Z/X keys (since we can't easily do scroll wheel)
        if key_down("z") { bind cam_dist = cam_dist - 0.5   if cam_dist < CAM_DIST_MIN { bind cam_dist = CAM_DIST_MIN } }
        if key_down("x") { bind cam_dist = cam_dist + 0.5   if cam_dist > CAM_DIST_MAX { bind cam_dist = CAM_DIST_MAX } }

        # ── AUDIO ──────────────────────────────────────────────────────────────
        bind speed = sqrt(vx*vx + vy_phys*vy_phys + vz*vz)
        bind hNorm = (by - 0.2) / 6.0
        bind sinceHit = FR - lastBounce
        bind impact = 0.0
        if sinceHit < 6 { bind impact = (6 - sinceHit) * 24.0 }
        bind freq = 140.0 + hNorm * 200.0 + impact + speed * 20.0
        bind amp = 0.04 + speed * 0.06
        bind pan = bx / 8.0
        audio_tone(0, bx, by, bz, 4.0, freq, amp, pan, 0.02)

        # ── LIGHTS ────────────────────────────────────────────────────────────
        clear_lights()
        add_light(sin(FR*0.006)*4.0, 0.0-5.0, ZC,  0.8, 0.7, 0.55,  2.0, 18.0)
        add_light(0.0-3.5, 0.0-2.5, ZC-3.5,  0.4, 0.5, 0.9,  0.9, 12.0)
        add_light(bx, by + 1.0, bz,  0.6, 0.3, 0.8,  0.6, 8.0)

        # ── CAMERA POSITION (on string, orbiting) ──────────────────────────────
        # Calculate camera position on sphere around ball
        bind cam_x = bx + cam_dist * cos(cam_pitch) * sin(cam_orbit)
        bind cam_y = by + cam_dist * sin(cam_pitch)
        bind cam_z = bz + cam_dist * cos(cam_pitch) * cos(cam_orbit)

        # Look direction: from camera toward ball
        bind look_dx = bx - cam_x
        bind look_dy = by - cam_y
        bind look_dz = bz - cam_z
        bind look_len = sqrt(look_dx*look_dx + look_dy*look_dy + look_dz*look_dz)

        if look_len > 0.01 {
            bind look_dx = look_dx / look_len
            bind look_dy = look_dy / look_len
            bind look_dz = look_dz / look_len
        }

        # Convert direction to camera angles
        # Yaw: angle in XZ plane
        bind cam_yaw = 0.0 - atan2(look_dz, look_dx) + 1.5708
        bind cry = cos(cam_yaw)
        bind sry = sin(cam_yaw)

        # Pitch: angle up/down
        bind cam_horiz_len = sqrt(look_dx*look_dx + look_dz*look_dz)
        bind cam_pitch_angle = 0.0 - atan2(look_dy, cam_horiz_len)
        bind crx = cos(cam_pitch_angle)
        bind srx = sin(cam_pitch_angle)

        set_camera(cry, sry, crx, srx)
        set_camera_pos(cam_x, cam_y, cam_z)
        set_zdist(150.0)

        # ── OCCLUSION DETECTION (for fade) ─────────────────────────────────────
        bind cam_to_ball_dist = sqrt((bx-cam_x)*(bx-cam_x) + (by-cam_y)*(by-cam_y) + (bz-cam_z)*(bz-cam_z))

        # ── DRAW TRAY BOUNDARY & SOLID GROUND ─────────────────────────────────
        # Solid ground plane (MASSIVE - 8x)
        set_color(45, 38, 65)
        cube(0.0, 4.8, ZC,  148.0, 4.8, 148.0,  0.0, 0.0, 0.0,  0)

        # Ground grid pattern
        set_color(60, 50, 85)
        bind gx = 0.0 - 140.0
        while gx < 140.0 {
            draw_line_3d(gx, 5.0, ZC - 140.0,  gx, 5.0, ZC + 140.0)
            bind gx = gx + 20.0
        }
        bind gz = 0.0 - 140.0
        while gz < 140.0 {
            draw_line_3d(0.0 - 140.0, 5.0, ZC + gz,  140.0, 5.0, ZC + gz)
            bind gz = gz + 20.0
        }

        # Tray walls (solid + wireframe) - MASSIVE
        # North wall
        set_color(100, 85, 140)
        cube(0.0, 48.0, ZC + 148.0,  148.0, 48.0, 4.0,  0.0, 0.0, 0.0,  0)
        set_color(80, 70, 120)
        draw_wireframe_box(0.0, 48.0, ZC + 148.0,  148.0, 48.0, 4.0,  80, 70, 120)
        # South wall
        set_color(100, 85, 140)
        cube(0.0, 48.0, ZC - 148.0,  148.0, 48.0, 4.0,  0.0, 0.0, 0.0,  0)
        set_color(80, 70, 120)
        draw_wireframe_box(0.0, 48.0, ZC - 148.0,  148.0, 48.0, 4.0,  80, 70, 120)
        # East wall
        set_color(110, 95, 150)
        cube(148.0, 48.0, ZC,  4.0, 48.0, 148.0,  0.0, 0.0, 0.0,  0)
        set_color(80, 70, 120)
        draw_wireframe_box(148.0, 48.0, ZC,  4.0, 48.0, 148.0,  80, 70, 120)
        # West wall
        set_color(110, 95, 150)
        cube(0.0 - 148.0, 48.0, ZC,  4.0, 48.0, 148.0,  0.0, 0.0, 0.0,  0)
        set_color(80, 70, 120)
        draw_wireframe_box(0.0 - 148.0, 48.0, ZC,  4.0, 48.0, 148.0,  80, 70, 120)
        # Ceiling
        set_color(70, 60, 100)
        cube(0.0, 0.0 - 48.0, ZC,  148.0, 4.0, 148.0,  0.0, 0.0, 0.0,  0)
        set_color(80, 70, 120)
        draw_wireframe_box(0.0, 0.0 - 48.0, ZC,  148.0, 4.0, 148.0,  80, 70, 120)

        # ── H³ BOOST ───────────────────────────────────────────────────────────
        bind blen = sqrt(bx_move*bx_move + bz_move*bz_move)
        bind dx = 0.0
        bind dz = 0.0
        if blen > 0.00001 { bind dx = bx_move / blen   bind dz = bz_move / blen }
        bind v = blen

        bind ep = exp(v)
        bind em = exp((0.0 - v))
        bind ch = (ep + em) / 2.0
        bind sh = (ep - em) / 2.0
        bind nsh = 0.0 - sh

        # ── UPDATE ROOMS & DRAW ────────────────────────────────────────────────
        bind nrx = list_new()
        bind nry = list_new()
        bind nrz = list_new()
        bind nrw = list_new()
        bind i = 0

        while i < NROOMS {
            bind px = list_get(rx, i)
            bind py = list_get(ry, i)
            bind pz = list_get(rz, i)
            bind pw = list_get(rw, i)

            bind dot = dx*px + dz*pz
            bind nx = px + (ch - 1.0)*dx*dot + nsh*dx*pw
            bind ny = py
            bind nz = pz + (ch - 1.0)*dz*dot + nsh*dz*pw
            bind nw = nsh*dot + ch*pw

            bind nn = sqrt(nw*nw - nx*nx - ny*ny - nz*nz)
            if nn > 0.0001 { bind nx = nx / nn   bind ny = ny / nn   bind nz = nz / nn   bind nw = nw / nn }

            bind nrx = list_push(nrx, nx)
            bind nry = list_push(nry, ny)
            bind nrz = list_push(nrz, nz)
            bind nrw = list_push(nrw, nw)

            # ── DRAW MAZE ──────────────────────────────────────────────────────
            bind bx2 = nx / (1.0 + nw)
            bind by2 = ny / (1.0 + nw)
            bind bz2 = nz / (1.0 + nw)
            bind rr = bx2*bx2 + by2*by2 + bz2*bz2
            bind conf = 1.0 - rr

            if conf > 0.02 {
                bind wx = bx2 * SCALE
                bind wy = by2 * SCALE
                bind wz = ZC + bz2 * SCALE

                # Occlusion fade: check if room is between camera and ball
                bind cam_to_room_dist = sqrt((wx-cam_x)*(wx-cam_x) + (wy-cam_y)*(wy-cam_y) + (wz-cam_z)*(wz-cam_z))
                bind is_occluding = 0
                if cam_to_room_dist < cam_to_ball_dist - 0.5 { bind is_occluding = 1 }

                bind rt = list_get(rtype, i)
                bind hue = hash01(rt, 1.0)
                bind col_r = int(sin(hue * 6.28 + FR * 0.002) * 40.0 + 100.0)
                bind col_g = int(sin(hue * 6.28 + FR * 0.002 + 2.094) * 50.0 + 110.0)
                bind col_b = int(sin(hue * 6.28 + FR * 0.002 + 4.189) * 60.0 + 140.0)

                # Fade geometry that's occluding (blend towards background)
                if is_occluding > 0 {
                    bind col_r = int(col_r * 0.3 + 1.0 * 0.7)
                    bind col_g = int(col_g * 0.3 + 1.0 * 0.7)
                    bind col_b = int(col_b * 0.3 + 6.0 * 0.7)
                }

                if i == 0 {
                    # ── CENTRE ATRIUM (MASSIVE - 8x) with grid pattern ──────────
                    set_color(col_r, col_g, col_b)
                    bind gx = 0
                    while gx < 16 {
                        draw_line_3d(wx - 80.0, wy, wz - 80.0 + gx * 10.0,  wx + 80.0, wy, wz - 80.0 + gx * 10.0)
                        bind gx = gx + 1
                    }
                    bind gx = 0
                    while gx < 16 {
                        draw_line_3d(wx - 80.0 + gx * 10.0, wy, wz - 80.0,  wx - 80.0 + gx * 10.0, wy, wz + 80.0)
                        bind gx = gx + 1
                    }

                    set_color(col_r - 20, col_g - 20, col_b + 30)
                    bind mrad = 8.0
                    while mrad < 72.0 {
                        draw_line_3d(wx, wy, wz - mrad,  wx + mrad * 0.866, wy, wz - mrad * 0.5)
                        draw_line_3d(wx + mrad * 0.866, wy, wz - mrad * 0.5,  wx + mrad * 0.866, wy, wz + mrad * 0.5)
                        draw_line_3d(wx + mrad * 0.866, wy, wz + mrad * 0.5,  wx, wy, wz + mrad)
                        draw_line_3d(wx, wy, wz + mrad,  wx - mrad * 0.866, wy, wz + mrad * 0.5)
                        draw_line_3d(wx - mrad * 0.866, wy, wz + mrad * 0.5,  wx - mrad * 0.866, wy, wz - mrad * 0.5)
                        draw_line_3d(wx - mrad * 0.866, wy, wz - mrad * 0.5,  wx, wy, wz - mrad)
                        bind mrad = mrad + 8.0
                    }
                } else {
                    # ── SPOKES & ALCOVES ───────────────────────────────────────
                    bind spoke_idx = i - 1
                    bind spoke_angle = spoke_idx * 0.7854
                    bind spoke_dx = cos(spoke_angle)
                    bind spoke_dz = sin(spoke_angle)

                    bind hw_len = SPOKE_L * conf
                    bind hw_cx = wx + spoke_dx * hw_len * 0.5
                    bind hw_cz = wz + spoke_dz * hw_len * 0.5

                    # Hallway with prominent solid fill (walls darker, interior lighter)
                    bind hall_col_r = col_r - 15
                    bind hall_col_g = col_g - 15
                    bind hall_col_b = col_b + 10
                    if is_occluding > 0 {
                        bind hall_col_r = int(hall_col_r * 0.3 + 1.0 * 0.7)
                        bind hall_col_g = int(hall_col_g * 0.3 + 1.0 * 0.7)
                        bind hall_col_b = int(hall_col_b * 0.3 + 6.0 * 0.7)
                    }
                    set_color(hall_col_r, hall_col_g, hall_col_b)
                    cube(hw_cx, wy, hw_cz,  HALLWAY_W * conf, HALLWAY_H * conf, hw_len * 0.5,  0.0, 0.0, 0.0,  0)

                    bind alcove_cx = wx + spoke_dx * hw_len
                    bind alcove_cz = wz + spoke_dz * hw_len

                    # Alcove with bright solid fill
                    bind alcove_col_r = col_r + 20
                    bind alcove_col_g = col_g + 10
                    bind alcove_col_b = col_b - 10
                    if is_occluding > 0 {
                        bind alcove_col_r = int(alcove_col_r * 0.3 + 1.0 * 0.7)
                        bind alcove_col_g = int(alcove_col_g * 0.3 + 1.0 * 0.7)
                        bind alcove_col_b = int(alcove_col_b * 0.3 + 6.0 * 0.7)
                    }
                    set_color(alcove_col_r, alcove_col_g, alcove_col_b)
                    cube(alcove_cx, wy, alcove_cz,  1.6 * conf, 2.0 * conf, 1.6 * conf,  0.0, 0.0, 0.0,  0)

                    # Archway entrance (bright cyan/blue fill)
                    bind arch_col_r = col_r - 40
                    bind arch_col_g = col_g + 60
                    bind arch_col_b = col_b + 80
                    if is_occluding > 0 {
                        bind arch_col_r = int(arch_col_r * 0.3 + 1.0 * 0.7)
                        bind arch_col_g = int(arch_col_g * 0.3 + 1.0 * 0.7)
                        bind arch_col_b = int(arch_col_b * 0.3 + 6.0 * 0.7)
                    }
                    set_color(arch_col_r, arch_col_g, arch_col_b)
                    bind arch_x = wx + spoke_dx * (hw_len - 1.3 * conf)
                    bind arch_z = wz + spoke_dz * (hw_len - 1.3 * conf)
                    arch(arch_x, wy, arch_z,  HALLWAY_W * conf * 0.8, HALLWAY_H * conf * 0.7, 0.4 * conf,  spoke_angle, 0.0, 0.0,  0,  10, 0.18)

                    set_color(col_r + 20, col_g - 30, col_b + 50)
                    bind deco_x = alcove_cx
                    bind deco_z = alcove_cz
                    bind deco_rad = 9.6 * conf
                    bind deco_angle = 0
                    while deco_angle < 6.28 {
                        bind next_angle = deco_angle + 0.39
                        draw_line_3d(deco_x + deco_rad * cos(deco_angle), wy - 8.0, deco_z + deco_rad * sin(deco_angle),  deco_x + deco_rad * cos(next_angle), wy - 8.0, deco_z + deco_rad * sin(next_angle))
                        bind deco_angle = next_angle
                    }
                }
            }

            bind i = i + 1
        }

        bind rx = nrx
        bind ry = nry
        bind rz = nrz
        bind rw = nrw

        # ── BALL (CHAKRA) ──────────────────────────────────────────────────────
        bind ball_hue = hash01(speed, FR * 0.01) * 6.28
        vtex_chakra(bx, by, bz,  1,0,0,  0,1,0,  6, BALL_R,  FR * 0.04, ball_hue)

        # Shadow & indicators
        set_color(50, 40, 100)
        draw_line_3d(bx - BALL_R, 0.2, bz,  bx + BALL_R, 0.2, bz)
        draw_line_3d(bx, 0.2, bz - BALL_R,  bx, 0.2, bz + BALL_R)

        set_color(100, 200, 255)
        draw_line_3d(bx, by, bz,  bx + vx * 0.25, by + vy_phys * 0.25, bz + vz * 0.25)

        if charge > 0.01 {
            bind cf = charge / 88.0
            set_color(255, int(200 - cf * 150.0), 40)
            draw_line_3d(bx, by, bz, bx, by - cf * 16.0, bz)
        }

        present()
        bind FR = FR + 1
    }
}
