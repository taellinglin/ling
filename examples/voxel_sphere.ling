# ════════════════════════════════════════════════════════════════════════════════════
# 🎮 VOXEL SPHERE — Simple Build-on-Blocks World 🎮
# ════════════════════════════════════════════════════════════════════════════════════
#
# Controls:
#   WASD      - Move around the voxel sphere
#   SPACE     - Jump over blocks
#   Arrow Keys - Rotate camera view
#   Can walk on the sphere of blocks!
#
# ════════════════════════════════════════════════════════════════════════════════════

bind PI = 3.14159265

# Block types
bind DIRT = 1
bind GRASS = 2

fn draw_block(x, y, z, block_type) {
    # Set color based on type
    if block_type == GRASS {
        set_color(34, 139, 34)
    } else {
        set_color(139, 69, 19)
    }

    # Draw cube outline
    bind s = 0.5
    draw_line_3d(x - s, y - s, z + s, x + s, y - s, z + s)
    draw_line_3d(x + s, y - s, z + s, x + s, y + s, z + s)
    draw_line_3d(x + s, y + s, z + s, x - s, y + s, z + s)
    draw_line_3d(x - s, y + s, z + s, x - s, y - s, z + s)

    draw_line_3d(x - s, y - s, z - s, x + s, y - s, z - s)
    draw_line_3d(x + s, y - s, z - s, x + s, y + s, z - s)
    draw_line_3d(x + s, y + s, z - s, x - s, y + s, z - s)
    draw_line_3d(x - s, y + s, z - s, x - s, y - s, z - s)

    draw_line_3d(x - s, y - s, z - s, x - s, y - s, z + s)
    draw_line_3d(x + s, y - s, z - s, x + s, y - s, z + s)
    draw_line_3d(x + s, y + s, z - s, x + s, y + s, z + s)
    draw_line_3d(x - s, y + s, z - s, x - s, y + s, z + s)
}

bind start = do {
    open_fullscreen("🎮 Voxel Sphere")
    capture_mouse()
    set_ambient(0.5)

    # Build initial sphere of blocks
    # Start with a hardcoded seed of blocks to avoid empty array concat issues
    bind blocks = [
        [-3.0, -2.0, -3.0, DIRT],
        [-3.0, -2.0, -2.0, DIRT],
        [-2.0, -2.0, -3.0, DIRT],
        [-2.0, -2.0, -2.0, GRASS],
        [-1.0, -2.0, -1.0, GRASS],
        [0.0, -2.0, 0.0, GRASS],
        [0.0, -1.0, 0.0, GRASS],
        [1.0, -2.0, 1.0, DIRT],
        [2.0, -2.0, 3.0, DIRT],
        [3.0, -2.0, 3.0, DIRT],
        [-3.0, 0.0, -3.0, DIRT],
        [-2.0, 0.0, -2.0, DIRT],
        [-1.0, 0.0, -1.0, GRASS],
        [0.0, 0.0, 0.0, GRASS],
        [1.0, 0.0, 1.0, GRASS],
        [2.0, 0.0, 2.0, DIRT],
        [3.0, 0.0, 3.0, DIRT],
        [-3.0, 1.0, -3.0, DIRT],
        [-2.0, 1.0, -2.0, DIRT],
        [-1.0, 1.0, -1.0, DIRT]
    ]

    # Player state
    bind player_x = 0.0
    bind player_y = 4.0
    bind player_z = 8.0
    bind player_vy = 0.0
    bind grounded = 0

    # Camera state
    bind cam_yaw = 0.0
    bind cam_pitch = 0.3

    # Game state
    bind time = 0
    bind gravity = 30.0

    while window_is_open() {
        # Sky color
        fill(135, 206, 235)

        # Gravity
        bind player_vy = player_vy + gravity * 0.016

        # Movement input
        if key_down("w") {
            bind player_x = player_x + cos(cam_yaw) * 0.5
            bind player_z = player_z + sin(cam_yaw) * 0.5
        }
        if key_down("s") {
            bind player_x = player_x - cos(cam_yaw) * 0.5
            bind player_z = player_z - sin(cam_yaw) * 0.5
        }
        if key_down("d") {
            bind player_x = player_x + sin(cam_yaw) * 0.5
            bind player_z = player_z - cos(cam_yaw) * 0.5
        }
        if key_down("a") {
            bind player_x = player_x - sin(cam_yaw) * 0.5
            bind player_z = player_z + cos(cam_yaw) * 0.5
        }

        # Jump
        if key_down("space") {
            if grounded > 0 {
                bind player_vy = -15.0
                bind grounded = 0
            }
        }

        # Update height
        bind player_y = player_y + player_vy * 0.016

        # Ground collision - simplified
        bind grounded = 0
        if player_y <= 0.0 {
            bind grounded = 1
            bind player_y = 0.0
            bind player_vy = 0.0
        }

        # Block placement (disabled for now due to array concat limitations)
        # if key_down("e") { ... }

        # Camera control
        if key_down("left") { bind cam_yaw = cam_yaw - 0.05 }
        if key_down("right") { bind cam_yaw = cam_yaw + 0.05 }
        if key_down("up") { bind cam_pitch = cam_pitch + 0.03 }
        if key_down("down") { bind cam_pitch = cam_pitch - 0.03 }

        if cam_pitch > 1.5 { bind cam_pitch = 1.5 }
        if cam_pitch < -1.5 { bind cam_pitch = -1.5 }

        bind cam_x = player_x + cos(cam_yaw) * cos(cam_pitch) * 12.0
        bind cam_y = player_y + 2.0 + sin(cam_pitch) * 12.0
        bind cam_z = player_z + sin(cam_yaw) * cos(cam_pitch) * 12.0

        set_camera_pos(cam_x, cam_y, cam_z)

        # Render all blocks (start with 20, grows as player places)
        bind i = 0
        while i < 20 {
            bind block = blocks[i]
            draw_block(block[0], block[1], block[2], block[3])
            bind i = i + 1
        }

        # Draw player
        set_color(255, 0, 0)
        draw_line_3d(player_x - 0.3, player_y, player_z, player_x + 0.3, player_y, player_z)
        draw_line_3d(player_x, player_y - 0.3, player_z, player_x, player_y + 0.3, player_z)

        if time % 60 == 0 {
            print("🎮 Voxel Sphere | WASD: move | SPACE: jump | E: place | Arrows: look")
        }

        # Render frame (using Thai keyword since English version not in lexicon)
        แสดงผล()
        bind time = time + 1
    }
}
