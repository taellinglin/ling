# Physics Demo — Visual Bouncing Ball Simulation

bind start = do {
    open_fullscreen("Physics Demo — Bouncing Ball")
    set_ambient(0.25)
    add_light(5.0, 10.0, 6.0, 4.0, 1.0, 0.95, 0.85)
    add_light(0.5, 4.0, 0.5, 2.0, 0.3, 0.6, 1.0)
    capture_mouse()

    เสียงโทน(0, 5.0, 4.0, 6.0, 5.0, 200.0, 0.05, 0.5, 0.03)
    ระดับเสียง(0.3)

    令 FR = 0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(2, 3, 8)

        # Time parameter
        令 t = FR * 0.016667

        # Ball position (animated trajectory)
        令 bx = 3.0 + sin(t) * 2.0
        令 by = 4.0 + cos(t * 0.5) * 1.5
        令 bz = 6.0 + sin(t * 0.7) * 1.5

        # Keep ball in room bounds
        若 by < 0.3 { 令 by = 0.3 }
        若 by > 7.7 { 令 by = 7.7 }
        若 bx < 0.3 { 令 bx = 0.3 }
        若 bx > 9.7 { 令 bx = 9.7 }
        若 bz < 0.3 { 令 bz = 0.3 }
        若 bz > 11.7 { 令 bz = 11.7 }

        # Velocity for energy calculation
        令 vx = cos(t) * 3.0
        令 vy = sin(t * 0.5) * 2.0 - 9.8 * t
        令 vz = cos(t * 0.7) * 2.0

        # Energy (kinetic + potential)
        令 speed_sq = vx*vx + vy*vy + vz*vz
        令 energy = sqrt(speed_sq) * 0.5 + by / 8.0

        # Energy to hue (red=high energy, blue=low)
        令 norm_energy = energy / 5.0
        若 norm_energy > 1.0 { 令 norm_energy = 1.0 }
        若 norm_energy < 0.0 { 令 norm_energy = 0.0 }
        令 hue = (1.0 - norm_energy) * 0.66

        # Camera orbit
        令 cam_angle = FR * 0.005
        令 cam_x = 5.0 + cos(cam_angle) * 8.0
        令 cam_y = 4.5 + 3.0
        令 cam_z = 6.0 + sin(cam_angle) * 8.0

        set_camera_pos(cam_x, cam_y, cam_z)
        set_camera(0.7, 0.7, 0.0, 0.0)
        set_zdist(1.5)

        # Draw room box
        draw_line_3d(0.0, 0.3, 0.0, 10.0, 0.3, 0.0, 0.15, 0.4)
        draw_line_3d(10.0, 0.3, 0.0, 10.0, 0.3, 12.0, 0.15, 0.4)
        draw_line_3d(10.0, 0.3, 12.0, 0.0, 0.3, 12.0, 0.15, 0.4)
        draw_line_3d(0.0, 0.3, 12.0, 0.0, 0.3, 0.0, 0.15, 0.4)

        draw_line_3d(0.0, 7.7, 0.0, 10.0, 7.7, 0.0, 0.15, 0.4)
        draw_line_3d(10.0, 7.7, 0.0, 10.0, 7.7, 12.0, 0.15, 0.4)
        draw_line_3d(10.0, 7.7, 12.0, 0.0, 7.7, 12.0, 0.15, 0.4)
        draw_line_3d(0.0, 7.7, 12.0, 0.0, 7.7, 0.0, 0.15, 0.4)

        draw_line_3d(0.0, 0.3, 0.0, 0.0, 7.7, 0.0, 0.15, 0.4)
        draw_line_3d(10.0, 0.3, 0.0, 10.0, 7.7, 0.0, 0.15, 0.4)
        draw_line_3d(10.0, 0.3, 12.0, 10.0, 7.7, 12.0, 0.15, 0.4)
        draw_line_3d(0.0, 0.3, 12.0, 0.0, 7.7, 12.0, 0.15, 0.4)

        # Draw gravity indicator bar
        令 gravity_height = (8.0 - by) / 8.0 * 7.0
        draw_line_3d(0.6, 0.3, 0.6, 0.6, 0.3 + gravity_height, 0.6, 0.0, 0.7)

        # Draw ball with energy color
        ลายจักร(bx, by, bz, 1, 0, 0, 0, 1, 0, 0.3, 8, by * 0.1, hue)

        # Audio feedback on high speed
        若 sqrt(speed_sq) > 2.0 {
            令 freq = 200.0 + sqrt(speed_sq) * 100.0
            เสียงโทน(0, bx, by, bz, 3.0, freq, 0.1, 0.5, 0.02)
        }

        แสดงผล()

        令 FR = FR + 1
    }
}
