# ════════════════════════════════════════════════════════════════════════════
# d-american-room.ling — The Grand Lodge of the Americas
#                          E Pluribus Unum · Out of Many, One
#
# A vast federal chamber fusing Masonic geometry, Great Seal heraldry,
# and Federal Reserve numerology into living light.
#
# ── CENTREPIECE: 13-Step Pyramid + Eye of Providence ────────────────────
#   Thirteen steps — original colonies, Great Seal steps, constellation.
#   Tier 6 radius = φ = 1.618 (the Golden Tier).
#   Floating capstone (tier 12) separated from the body — Annuit Coeptis.
#   Eye of Providence: 13-petal lotus + 72-segment radiant rings.
#
# ── AMERICAN EAGLE ──────────────────────────────────────────────────────
#   13-point star chest · 33-segment rings · φ-spiral wings (72 segments)
#   5-point head star (heraldic dexter) · 13-petal tail lotus
#
# ── HUB ROOM: Six Cultural Portals ─────────────────────────────────────
#   The American chamber is the geometric centre of the Ling multiverse.
#   Each portal glows in its home culture's hue and echoes its visual DNA:
#     🏮 Chinese   (left wall)    — taiji lotus + 8-spoke yang rings
#     ⛩  Japanese  (back, left)   — Enso 12-petal flower + silver rings
#     ☯  Korean    (back, ctr-L)  — hexagonal dancheong chakra + cyan
#     🌿 Vietnamese(back, ctr-R)  — Đông Sơn lotus + emerald wave rings
#     🌸 Sakohn    (back, right)  — Khmer prang spiral + Thai saffron
#     囍 Family    (right wall)   — double 囍 lotus with Ling's drift
#
# ── MASONIC CONSTANTS encoded as geometry parameters ────────────────────
#   1776  Year of Independence — camera + key-light oscillation period
#   1913  Federal Reserve Act  — rim-light oscillation period
#   13    Original colonies    — pyramid steps, spokes, petals, stars
#   33    Scottish Rite degrees — ring segment count (golden tier marker)
#   47    47th Problem of Euclid (3-4-5 triangle) — ring segment count
#   72    360°÷5 pentagram / 72 Names of God — eagle wing segments
#   φ     Golden ratio 1.618   — pyramid tier 6 radius, eagle wing radii
#
# ── AUDIO: Star-Spangled Banner, key of B♭ major ────────────────────────
#   B♭2 = 116.54 Hz  (SSB tonic)  ← identical to 灵 Ling's bridge note
#   D3  = 146.83 Hz  (major 3rd)  ← echoes 母 Mom (family room)
#   F3  = 174.61 Hz  (fifth)
#   E♭3 = 155.56 Hz  (subdominant 4th)
#   G3  = 196.00 Hz  (6th)        ← echoes 次 Younger child (family room)
#   C3  = 130.81 Hz               ← Chinese 宫 / Vietnamese oán root
#   G2  =  98.00 Hz               ← Sakohn khaen root (Isaan pentatonic)
#   Seven voices = seven rooms.  One chord: E Pluribus Unum.
#
# Camera: Majestic slow survey — full revolution every 1776 frames.
#
# Run:  ling run examples/3d-american-room.ling
# Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

ผูก W   = 9.0
ผูก H   = 4.5
ผูก FZ  = 16.0
ผูก NZ  = 1.4
ผูก PZ  = 8.0
ผูก PHI = 1.618    # φ — Masonic golden proportion
ผูก FM  = (NZ + FZ) / 2.0   # side-wall portal z midpoint


# ════════════════════════════════════════════════════════════════════════════
# COLOUR HELPERS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน col(t, p) {
    สีดินสอ(
        ไซน์(t + p)         * 127 + 128,
        ไซน์(t + p + 2.094) * 127 + 128,
        ไซน์(t + p + 4.189) * 127 + 128
    )
}

ฟังก์ชัน col_dim(t, p, b) {
    สีดินสอ(
        (ไซน์(t + p)         * 127 + 128) * b,
        (ไซน์(t + p + 2.094) * 127 + 128) * b,
        (ไซน์(t + p + 4.189) * 127 + 128) * b
    )
}


# ════════════════════════════════════════════════════════════════════════════
# EYE OF PROVIDENCE — Annuit Coeptis
# Floats above the 12th (separated) capstone tier.
# 13-petal lotus + 72-segment rings = "He has favoured our undertakings"
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_eye(FR, hd) {
    ผูก ey = 0 - H + 3.85
    # 13-petal lotus (original colonies = Providence's chosen)
    ลายดอกบัว(0, ey, PZ,  1,0,0,  0,0,1,  0.20, 0.54, 13,  FR, hd + 0.6)
    # 72-ray radiant rings — 72 Names of God / pentagram sacred number
    ลายวงซ้อน(0, ey, PZ,  1,0,0,  0,0,1,  4, 72,  0.70, 0.0,  FR, hd + 1.5)
    # 13-point star — Great Seal constellation
    ลายดาว(0, ey, PZ,  1,0,0,  0,0,1,  13, 0.88, 0.36, 0.04,  FR, hd + 0.0)
    # Providence corona — horizontal halo
    ลายดอก(0, ey, PZ,  1,0,0,  0,1,0,  1.08, 8,  FR, hd + 2.2)
    ลายวงซ้อน(0, ey, PZ,  1,0,0,  0,1,0,  2, 47,  1.32, 0.0,  FR, hd + 3.5)
}


# ════════════════════════════════════════════════════════════════════════════
# 13-STEP PYRAMID — MDCCLXXVI — 1776
#
# Step radii:  base=3.00 → apex=0.38,  decrement=(3.00−0.38)÷12=0.218
# Step heights: base y=−H+0.00 → tier 12 y=−H+3.20, Δy=0.267
# Step 6 radius = 1.618 = φ  (the Golden Tier — Masonic proportion emerges)
# 47-segment rings = 47th Problem of Euclid (Pythagoras' right triangle)
# Floating capstone: tier 12 raised to y=−H+3.50 (Annuit Coeptis gap)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_pyramid(FR, hd) {
    # Step 0 — 1776 base  (r=3.000)
    ลายจักร(0, 0-H+0.00, PZ,  1,0,0,  0,0,1,  3.000, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+0.00, PZ,  1,0,0,  0,0,1,  1, 47,  3.000, 0.0,  FR, hd+0.0)
    # Step 1   (r=2.782)
    ลายจักร(0, 0-H+0.27, PZ,  1,0,0,  0,0,1,  2.782, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+0.27, PZ,  1,0,0,  0,0,1,  1, 47,  2.782, 0.0,  FR, hd+0.4)
    # Step 2   (r=2.564)
    ลายจักร(0, 0-H+0.53, PZ,  1,0,0,  0,0,1,  2.564, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+0.53, PZ,  1,0,0,  0,0,1,  1, 47,  2.564, 0.0,  FR, hd+0.8)
    # Step 3   (r=2.346)
    ลายจักร(0, 0-H+0.80, PZ,  1,0,0,  0,0,1,  2.346, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+0.80, PZ,  1,0,0,  0,0,1,  1, 47,  2.346, 0.0,  FR, hd+1.2)
    # Step 4   (r=2.128)
    ลายจักร(0, 0-H+1.07, PZ,  1,0,0,  0,0,1,  2.128, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+1.07, PZ,  1,0,0,  0,0,1,  1, 47,  2.128, 0.0,  FR, hd+1.6)
    # Step 5   (r=1.910)
    ลายจักร(0, 0-H+1.33, PZ,  1,0,0,  0,0,1,  1.910, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+1.33, PZ,  1,0,0,  0,0,1,  1, 47,  1.910, 0.0,  FR, hd+2.0)
    # Step 6 — THE GOLDEN TIER  (r=φ=1.618)
    ลายจักร(0, 0-H+1.60, PZ,  1,0,0,  0,0,1,  PHI,   4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+1.60, PZ,  1,0,0,  0,0,1,  1, 47,  PHI,   0.0,  FR, hd+2.4)
    ลายวงซ้อน(0,  0-H+1.60, PZ,  1,0,0,  0,1,0,  1, 33,  PHI*1.22, 0.0,  FR, hd+4.8)  # 33° Scottish Rite
    # Step 7   (r=1.474)
    ลายจักร(0, 0-H+1.87, PZ,  1,0,0,  0,0,1,  1.474, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+1.87, PZ,  1,0,0,  0,0,1,  1, 47,  1.474, 0.0,  FR, hd+2.8)
    # Step 8   (r=1.256)
    ลายจักร(0, 0-H+2.13, PZ,  1,0,0,  0,0,1,  1.256, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+2.13, PZ,  1,0,0,  0,0,1,  1, 47,  1.256, 0.0,  FR, hd+3.2)
    # Step 9   (r=1.038)
    ลายจักร(0, 0-H+2.40, PZ,  1,0,0,  0,0,1,  1.038, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+2.40, PZ,  1,0,0,  0,0,1,  1, 47,  1.038, 0.0,  FR, hd+3.6)
    # Step 10  (r=0.820)
    ลายจักร(0, 0-H+2.67, PZ,  1,0,0,  0,0,1,  0.820, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+2.67, PZ,  1,0,0,  0,0,1,  1, 47,  0.820, 0.0,  FR, hd+4.0)
    # Step 11  (r=0.602)
    ลายจักร(0, 0-H+2.93, PZ,  1,0,0,  0,0,1,  0.602, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+2.93, PZ,  1,0,0,  0,0,1,  1, 47,  0.602, 0.0,  FR, hd+4.4)
    # Step 12 — floating capstone (r=0.384, raised: Annuit Coeptis gap)
    ลายจักร(0, 0-H+3.50, PZ,  1,0,0,  0,0,1,  0.384, 4,  FR, 1.2+hd)
    ลายวงซ้อน(0,  0-H+3.50, PZ,  1,0,0,  0,0,1,  1, 47,  0.384, 0.0,  FR, hd+4.8)

    draw_eye(FR, hd)
}


# ════════════════════════════════════════════════════════════════════════════
# AMERICAN EAGLE — E Pluribus Unum
# Body: 13-point star + 33-segment rings (strength + virtue)
# Wings: φ-spiral arms, 72 segments — two per wing like feather bundles
# Head:  5-point star (heraldic dexter — the bird looks right)
# Tail:  13-petal lotus (the arrows + olive branch = 13 each)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_eagle(FR, hd) {
    ผูก ey = 0.75
    ผูก ez = PZ - 0.8
    # Eagle breast — 13-point star + glory rings
    ลายดาว(0, ey, ez,  0,0,1,  0,1,0,  13, 1.12, 0.44, 0.04,  FR, hd + 0.5)
    ลายวงซ้อน(0, ey, ez,  0,0,1,  0,1,0,  2, 33,  1.40, 0.0,  FR, hd + 1.8)
    # Left wing — φ-spiral, 72 segments
    ลายเกลียว(0-3.8, ey, ez,  1,0,0,  0,1,0,  PHI*1.15, PHI*2.00, 72,  FR, hd + 0.0)
    ลายวงซ้อน(0-3.8, ey, ez,  1,0,0,  0,1,0,  1, 24,  PHI*0.88, 0.0,  FR, hd + 2.6)
    ลายดอกบัว(0-3.8, ey, ez,  1,0,0,  0,1,0,  PHI*0.30, PHI*0.65, 5,  FR, hd + 1.0)
    # Right wing — mirror (phase +π)
    ลายเกลียว( 3.8, ey, ez,  1,0,0,  0,1,0,  PHI*1.15, PHI*2.00, 72,  FR, hd + 3.14159)
    ลายวงซ้อน( 3.8, ey, ez,  1,0,0,  0,1,0,  1, 24,  PHI*0.88, 0.0,  FR, hd + 5.7)
    ลายดอกบัว( 3.8, ey, ez,  1,0,0,  0,1,0,  PHI*0.30, PHI*0.65, 5,  FR, hd + 4.1)
    # Eagle head — 5-point star (heraldic dexter)
    ลายดาว(0.85, ey+0.70, ez,  0,0,1,  0,1,0,  5, 0.54, 0.22, 0.03,  FR, hd + 1.2)
    # Tail — 13-petal lotus (arrows + olive branch: 13 + 13)
    ลายดอกบัว(0, ey-0.85, ez,  0,0,1,  0,1,0,  0.28, 0.88, 13,  FR, hd + 4.0)
}


# ════════════════════════════════════════════════════════════════════════════
# HUB PORTALS — Six cultural doorways around the American chamber
#
# Each portal echoes the centrepiece motif of its source room:
#   Chinese   → taiji-core lotus + 8-spoke yang chakra (Chinese room)
#   Japanese  → Enso 12-petal flower + jo-ha-kyū pace rings (Zen hall)
#   Korean    → 6-segment taegeuk + dancheong hexagonal rings (Hanok hall)
#   Vietnamese→ Đông Sơn 12-ray lotus + 5-element wave rings (Linh Đài)
#   Sakohn    → Khmer prang chakra + Sak Yant spiral (Choeng Chum)
#   Family    → double 囍 lotus with Ling's hue-drift (Family room)
#
# When the camera sweeps left it faces the Chinese portal; sweeping right
# it faces the Family portal — spatial audio reinforces each cultural voice.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_portal_chinese(FR, hd) {
    # Left wall — hue ~1.1-1.6 (taiji warm gold/amber)
    ลายจักร(0-W, 0, FM,  0,0,1,  0,1,0,  2.20, 8,  FR, hd + 1.1)
    ลายดอกบัว(0-W, 0, FM,  0,0,1,  0,1,0,  0.55, 1.75, 8,  FR, hd + 0.5)
    ลายวงซ้อน(0-W, 0, FM,  0,0,1,  0,1,0,  3, 24,  2.60, 0.0,  FR, hd + 1.6)
    ลายดาว(0-W, 0, FM,  0,0,1,  0,1,0,  8, 3.0, 1.2, 0.04,  FR, hd + 0.2)
}

ฟังก์ชัน draw_portal_japanese(FR, hd) {
    # Back wall, left quarter — hue ~4.8 (Enso silver-indigo, In-sen)
    ผูก px = 0 - W * 0.42
    ลายดอก(px, 0, FZ,  1,0,0,  0,1,0,  2.5, 12,  FR * 0.55, hd + 4.8)
    ลายวงซ้อน(px, 0, FZ,  1,0,0,  0,1,0,  3, 36,  2.9, 0.16,  FR * 0.20, hd + 4.4)
    ลายดอกบัว(px, 0, FZ,  1,0,0,  0,1,0,  0.45, 1.35, 6,  FR, hd + 5.6)
    ลายวงซ้อน(px, 0, FZ,  1,0,0,  0,1,0,  1, 24,  3.3, 0.0,  FR * 0.20, hd + 5.1)
}

ฟังก์ชัน draw_portal_korean(FR, hd) {
    # Back wall, left-centre — hue ~3.6 (dancheong cyan/taegeuk)
    ผูก px = 0 - W * 0.15
    ลายจักร(px, 0, FZ,  1,0,0,  0,1,0,  2.20, 6,  FR, hd + 3.6)
    ลายวงซ้อน(px, 0, FZ,  1,0,0,  0,1,0,  3, 6,  2.65, 0.524,  0-FR, hd + 5.1)
    ลายดอกบัว(px, 0, FZ,  1,0,0,  0,1,0,  0.38, 1.45, 4,  FR, hd + 4.0)
    ลายดอก(px, 0, FZ,  1,0,0,  0,1,0,  3.0, 6,  FR, hd + 3.2)
}

ฟังก์ชัน draw_portal_vietnamese(FR, hd) {
    # Back wall, right-centre — hue ~2.2 (Đông Sơn emerald/五行)
    ผูก px = W * 0.15
    ผูก 土 = FR * 0.12    # 五行 Earth time-stream (ultra-slow)
    ผูก 水 = FR * 0.45    # 五行 Water time-stream
    ลายดอกบัว(px, 0, FZ,  1,0,0,  0,1,0,  0.50, 1.65, 12,  水, hd + 2.2)
    ลายวงซ้อน(px, 0, FZ,  1,0,0,  0,1,0,  3, 32,  2.55, 0.22,  水, hd + 2.8)
    ลายดอก(px, 0, FZ,  1,0,0,  0,1,0,  3.1, 8,  土, hd + 1.9)
    vtex_hyperbolic_uv(px, 0, FZ,  1,0,0,  0,1,0,  2.8, 8, 16,  土, hd + 3.5)
}

ฟังก์ชัน draw_portal_sakohn(FR, hd) {
    # Back wall, right quarter — hue ~1.8 (Thai saffron/Khmer prang)
    ผูก px = W * 0.42
    ผูก ช้า = FR * 0.14    # Isaan ช้า slow time-stream (earth)
    ผูก กลาง = FR * 0.50  # Isaan mid time-stream (wind)
    ลายจักร(px, 0, FZ,  1,0,0,  0,1,0,  2.20, 4,  กลาง, hd + 1.8)
    ลายเกลียว(px, 0, FZ,  1,0,0,  0,1,0,  0.85, 2.35, 72,  กลาง, hd + 2.5)
    ลายวงซ้อน(px, 0, FZ,  1,0,0,  0,1,0,  2, 33,  2.7, 0.30,  ช้า, hd + 1.4)
    ลายดอกบัว(px, 0, FZ,  1,0,0,  0,1,0,  0.55, 1.60, 16,  กลาง, hd + 0.8)
}

ฟังก์ชัน draw_portal_family(FR, hd) {
    # Right wall — hue ~0.5-1.0 (囍 deep red-gold) with Ling's drift
    ผูก drift = ไซน์(FR * 0.0105) * 2.0   # Ling's ~600-frame breath
    ผูก hdl   = hd + 2.6 + drift         # shifts between Chinese gold and Korean teal
    # 囍 double lotus — Dad (lower/warm) + Mom (upper/jade)
    ลายดอกบัว(W, 0-0.4, FM,  0,0,1,  0,1,0,  0.55, 1.70, 8,  FR, hd + 0.5)
    ลายดอกบัว(W, 0+0.6, FM,  0,0,1,  0,1,0,  0.40, 1.25, 12, 0-FR, hd + 3.4)
    # Ling's ring — the hybrid child between them
    ลายวงซ้อน(W, 0.1, FM,  0,0,1,  0,1,0,  1, 32,  0.95, 0.0,  FR, hdl)
    # 囍 union rings
    ลายวงซ้อน(W, 0, FM,  0,0,1,  0,1,0,  3, 48,  2.50, 0.0,  FR, hd + 0.8)
    ลายดอก(W, 0, FM,  0,0,1,  0,1,0,  3.0, 12,  FR, hd + 1.6)
}

ฟังก์ชัน draw_hub_portals(FR, hd) {
    draw_portal_chinese(FR, hd)
    draw_portal_japanese(FR, hd)
    draw_portal_korean(FR, hd)
    draw_portal_vietnamese(FR, hd)
    draw_portal_sakohn(FR, hd)
    draw_portal_family(FR, hd)
}


# ════════════════════════════════════════════════════════════════════════════
# ROOM SURFACES
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_floor(FR, hd) {
    ผูก cy   = 0 - H
    ผูก fmid = FZ / 2
    # Masonic compass rose — 13-spoke (colonies) + 33-segment rings
    ลายจักร(0, cy, fmid,  1,0,0,  0,0,1,  7.2, 13,  FR, hd + 1.5)
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  4, 33,  6.6, 0.10,  FR, hd + 0.5)
    # Dollar yantra — 4-layer sacred geometry (Federal Reserve seal)
    ลายยันต์(0, cy, fmid,  1,0,0,  0,0,1,  4, 5.6,  FR, hd + 0.0)
    # Coin tessellation — the flow of Federal Reserve capital
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  20, 16,  0.46, 0.14, 4.0,  FR, hd + 2.0)
    # Enlightenment rational grid — the surveyor's township grid
    ลายตาราง(0, cy, fmid,  1,0,0,  0,0,1,  28, 24,  0.64, 0.64,  FR, hd + 3.2)
}

ฟังก์ชัน draw_ceiling(FR, hd) {
    ผูก cy   = H
    ผูก fmid = FZ / 2
    # Celestial dome — hyperbolic star-field (13 rings, 16 segments)
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  6.2, 13, 16,  FR, hd + 2.6)
    # Great Seal 13-star constellation ring
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  1, 13,  4.6, 0.0,  FR, hd + 0.8)
    # 50-state ring (modern flag — 50 stars in 6 staggered rows)
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  2, 50,  6.6, 0.06,  FR, hd + 1.2)
    # Great Seal glory star — 5-point at centre (the constellation Ophiuchus moment)
    ลายดาว(0, cy, fmid,  1,0,0,  0,0,1,  5, 2.6, 1.05, 0.06,  FR, hd + 0.0)
}

ฟังก์ชัน draw_back_wall(FR, hd) {
    # American mottoes in letter-rain — E Pluribus Unum, MDCCLXXVI, ANNUIT COEPTIS
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  24, 14,  0.64, 0.58,  0.014,  FR, hd + 1.8)
    # Great Seal back — olive branch + arrows star
    ลายดาว(0, 0, FZ,  1,0,0,  0,1,0,  13, 4.8, 1.9, 0.05,  FR, hd + 0.4)
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  3, 50,  5.4, 0.04,  FR, hd + 2.2)
}

ฟังก์ชัน draw_front_wall(FR, hd) {
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  24, 14,  0.64, 0.58,  0.010,  FR, hd + 0.0)
}

ฟังก์ชัน draw_left_wall(FR, hd) {
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(0-W, 0, fmid,  0,0,1,  0,1,0,  18, 14,  0.64, 0.58,  0.016,  FR, hd + 3.0)
}

ฟังก์ชัน draw_right_wall(FR, hd) {
    ผูก fmid = (NZ + FZ) / 2
    vtex_letter_rain(W, 0, fmid,  0,0,1,  0,1,0,  18, 14,  0.64, 0.58,  0.012,  FR, hd + 5.0)
}


# ════════════════════════════════════════════════════════════════════════════
# ECHO PASS — lighter version for temporal frame-fade smear
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก cy_f = 0 - H
    ผูก cy_c = H
    ผูก fm   = FZ / 2

    # Floor: compass + yantra (no expensive tessellation)
    ลายจักร(0, cy_f, fm,  1,0,0,  0,0,1,  7.2, 13,  FR, hd + 1.5)
    ลายวงซ้อน(0, cy_f, fm,  1,0,0,  0,0,1,  4, 33,  6.6, 0.10,  FR, hd + 0.5)
    ลายยันต์(0, cy_f, fm,  1,0,0,  0,0,1,  4, 5.6,  FR, hd + 0.0)

    # Ceiling: star rings + glory star
    ลายวงซ้อน(0, cy_c, fm,  1,0,0,  0,0,1,  2, 50,  6.6, 0.06,  FR, hd + 1.2)
    ลายดาว(0, cy_c, fm,  1,0,0,  0,0,1,  5, 2.6, 1.05, 0.06,  FR, hd + 0.0)

    # Back wall Great Seal
    ลายดาว(0, 0, FZ,  1,0,0,  0,1,0,  13, 4.8, 1.9, 0.05,  FR, hd + 0.4)
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  3, 50,  5.4, 0.04,  FR, hd + 2.2)

    # Pyramid: base, golden tier, capstone + eye
    ลายจักร(0, 0-H+0.00, PZ,  1,0,0,  0,0,1,  3.000, 4,  FR, 1.2+hd)
    ลายจักร(0, 0-H+1.60, PZ,  1,0,0,  0,0,1,  PHI,   4,  FR, 1.2+hd)
    ลายจักร(0, 0-H+3.50, PZ,  1,0,0,  0,0,1,  0.384, 4,  FR, 1.2+hd)
    draw_eye(FR, hd)

    # Eagle body
    ลายดาว(0, 0.75, PZ-0.8,  0,0,1,  0,1,0,  13, 1.12, 0.44, 0.04,  FR, hd + 0.5)
    ลายวงซ้อน(0, 0.75, PZ-0.8,  0,0,1,  0,1,0,  2, 33,  1.40, 0.0,  FR, hd + 1.8)

    # Portal silhouettes (rings only — cheap)
    ลายวงซ้อน(0-W, 0, FM,  0,0,1,  0,1,0,  3, 24,  2.60, 0.0,  FR, hd + 1.6)    # Chinese
    ลายวงซ้อน(W,   0, FM,  0,0,1,  0,1,0,  3, 48,  2.50, 0.0,  FR, hd + 0.8)    # Family
    ลายวงซ้อน(0-W*0.42, 0, FZ,  1,0,0,  0,1,0,  1, 24,  3.3, 0.0,  FR, hd + 5.1) # Japanese
    ลายวงซ้อน(0-W*0.15, 0, FZ,  1,0,0,  0,1,0,  2, 33,  2.7, 0.30,  FR, hd + 6.2) # Sakohn
}


# ════════════════════════════════════════════════════════════════════════════
# LIGHTS
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()
    # Torch of Liberty — warm gold key, orbits the Eye with 1776-frame period
    ผูก t1776 = FR * (1.0/1776) * 6.2832
    เพิ่มแสง(
        ไซน์(t1776) * 3.8,
        H - 0.4,
        โคไซน์(t1776) * 2.2 + PZ,
        1.0, 0.88, 0.40,
        3.5, 14.0
    )
    # Federal blue fill — cool authority from left (the Union)
    เพิ่มแสง(0-5.5, 1.5, PZ,  0.18, 0.32, 0.82,  1.6, 11.0)
    # Masonic red rim — vermilion from behind (the Republic), 1913-frame period
    ผูก t1913 = FR * (1.0/1913) * 6.2832
    เพิ่มแสง(
        ไซน์(t1913) * 4.2,
        0.2,
        0-โคไซน์(t1913) * 2.5 + PZ,
        0.88, 0.18, 0.10,
        1.2, 9.0
    )
    # Masonic white under-fill — the apron: pure white light from below
    เพิ่มแสง(0, 0-4.0, PZ,  0.80, 0.80, 0.80,  0.6, 8.0)
}


# ════════════════════════════════════════════════════════════════════════════
# AUDIO — E Pluribus Unum: Seven Rooms, One Chord
#
# The seven audio tones are spatially positioned at their portal locations.
# As the camera sweeps (1776-frame period), each room's tonal root rises in
# the mix — you literally hear each culture as you face its portal.
#
# B♭2 = 116.54 Hz — SSB tonic = 灵 Ling's bridge note (family room)
#                    The one frequency that spans all seven rooms.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot  x       y     z      w     freq      amp   lfo_hz  lfo_depth
    เสียงโทน(0,  0,      H,   PZ,   0.5,  116.54, 0.12, 0.14, 0.010)  # B♭2 SSB tonic = Ling/Eagle
    เสียงโทน(1,  0,   0-H,   PZ,   2.0,  146.83, 0.11, 0.12, 0.008)  # D3  SSB 3rd   (pyramid base)
    เสียงโทน(2,  0,      0,   FZ,   1.5,  174.61, 0.09, 0.20, 0.014)  # F3  SSB 5th   (back wall)
    เสียงโทน(3,  0,      0,  NZ,    1.5,  155.56, 0.08, 0.18, 0.012)  # E♭3 4th       (front wall)
    เสียงโทน(4,  0,      0,  FM,    2.0,  196.00, 0.08, 0.22, 0.016)  # G3  SSB 6th   (centre hall)
    เสียงโทน(5, 0-W,     0,  FM,    3.0,  130.81, 0.07, 0.15, 0.010)  # C3  Chinese 宫 (left portal)
    เสียงโทน(6,  W,      0,  FM,    3.0,   98.00, 0.07, 0.25, 0.018)  # G2  Sakohn khaen (right)
    ระดับเสียง(0.55)
}


# ════════════════════════════════════════════════════════════════════════════
# MAIN
# ════════════════════════════════════════════════════════════════════════════

ผูก สร้าง = ทำ {
    เปิดหน้าต่างเต็มจอ("The Grand Lodge of the Americas — E Pluribus Unum")
    ตั้งแสงรอบข้าง(0.06)

    init_audio()

    ผูก 帧 = 0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(2, 4, 20)    # deep federal navy-black

        # Camera: majestic slow survey — 1776-frame full revolution
        # At frame 1776 the sway returns exactly to centre.
        # The vertical nod uses the 1913 (Federal Reserve) period.
        ผูก t1776 = 帧 * (1.0/1776) * 6.2832
        ผูก t1913 = 帧 * (1.0/1913) * 6.2832
        ผูก ry    = ไซน์(t1776) * 0.24
        ผูก rx    = ไซน์(t1913) * 0.07
        ผูก cry   = โคไซน์(ry)   ผูก sry = ไซน์(ry)
        ผูก crx   = โคไซน์(rx)   ผูก srx = ไซน์(rx)
        ตั้งกล้อง(cry, sry, crx, srx)
        ผู้ฟัง(cry, sry, crx, srx)

        setup_lights(帧)

        # Temporal framefade — gold (+2.0) and federal blue (+1.0) echo trails
        draw_echo(帧 - 48, 2.0)
        draw_echo(帧 - 24, 1.0)

        # Current frame — full scene
        draw_floor(帧, 0.0)
        draw_ceiling(帧, 0.0)
        draw_front_wall(帧, 0.0)
        draw_back_wall(帧, 0.0)
        draw_left_wall(帧, 0.0)
        draw_right_wall(帧, 0.0)
        draw_pyramid(帧, 0.0)
        draw_eagle(帧, 0.0)
        draw_hub_portals(帧, 0.0)

        แสดงผล()
        ผูก 帧 = 帧 + 1
    }
}
