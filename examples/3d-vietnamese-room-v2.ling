# ════════════════════════════════════════════════════════════════════════════
# 3d-vietnamese-room-v2.ling — 靈臺五行殿  Linh Đài · Palace of Five Elements
#
#  v2: fixes vtex_yantra arg count (n_layers added to floor call).
#
#  Written in Chữ Hán (漢字) — the classical script of Vietnamese
#  scholarship before romanisation.  Variable names, frame counter, and
#  function names use Hán characters exactly as a Confucian scholar would
#  label the cosmos.
#
#  Ngũ Hành (五行 Five Transformations) time-streams:
#    土 = FR × 0.12   Thổ  — Earth / Địa  (ultra-slow resonance)
#    水 = FR × 0.45   Thuỷ — Water / Thuỷ (flowing medium)
#    金 = FR × 0.80   Kim  — Metal / Kim  (vibrating fast)
#    火 = FR × 1.50   Hoả  — Fire  / Hoả  (accelerating)
#    木 = FR × 2.20   Mộc  — Wood  / Mộc  (wildfire — hyper-speed)
#
#  Visual centrepiece: Đông Sơn bronze drum (東山鼓)
#    12-ray sun core  +  8 counter-rotating ring groups  +  4 Rồng spirals
#    +  THREE intersecting Poincaré discs forming a hyperdimensional orb
#
#  Thang âm oán (怨 Lament scale — C · E♭ · F · A♭ · B♭):
#    Nine sine tones in the melancholic Vietnamese oán pentatonic.
#    A♭3 / A3 beating at ~12 Hz = the DMT-throb resonance.
#    LFO 0.15–0.65 Hz = đàn bầu monochord microtonal vibrato.
#
#  Framefade: THREE chromatic echo passes (−96 · −48 · −24 frames).
#    Fast 木 elements (×2.20) create wide fan-ghosts; slow 土 (×0.12)
#    elements leave tight chromatic halos — both simultaneously visible.
#
#  Run:  ling run examples/3d-vietnamese-room-v2.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

令 W  = 10.0    # 幅  half-width
令 H  = 5.0     # 高  half-height
令 FZ = 18.0    # 遠壁 far-wall z
令 NZ = 1.6     # 近壁 near-wall z
令 PZ = 9.0     # 中軸 centre axis z
令 PR = 1.30    # 鼓半 drum-core radius


# ════════════════════════════════════════════════════════════════════════════
# 東山鼓  DONG SON DRUM  — central mandala
#   12-ray sun  ·  8 counter-rotating ring groups  ·  Bát Quái 8-spoke wheel
#   3 intersecting Poincaré discs  ·  4 Rồng dragon spirals
# ════════════════════════════════════════════════════════════════════════════

函 draw_鼓(FR, hd) {
    令 土 = FR * 0.12
    令 水 = FR * 0.45
    令 金 = FR * 0.80
    令 火 = FR * 1.50
    令 木 = FR * 2.20
    令 bob = sin(FR * 0.014) * 0.28

    # ── Sun centre: 12-ray star (12 tháng / 12 months of the lunar year) ──
    vtex_star(0, bob, PZ,   1,0,0,  0,0,1,  12, PR, PR * 0.44, 0.0,        火, hd)
    # Inner chrysanthemum — 16 petals (16 warriors of the Hùng kings)
    vtex_flower(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.58, 16,                木, hd + 1.0)
    # Central lotus (8-petal Bát Quái)
    vtex_lotus(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.22, PR * 0.56, 8,       水, hd + 4.2)

    # ── 8 concentric ring groups — Đông Sơn drum face ────────────────────
    # Alternate clockwise / counter-clockwise for counter-rotating shimmer
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  8, 64,  PR * 2.50, 0.0,        土, hd + 0.0)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  6, 64,  PR * 2.05, 0.0,        水, hd + 0.4)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  5, 64,  PR * 1.70, 0.0,      0-水, hd + 0.8)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  4, 64,  PR * 1.38, 0.0,        金, hd + 1.2)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  3, 64,  PR * 1.10, 0.0,      0-金, hd + 1.6)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  2, 64,  PR * 0.86, 0.0,        火, hd + 2.0)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  2, 64,  PR * 0.64, 0.0,      0-火, hd + 2.4)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  1, 64,  PR * 0.44, 0.0,        木, hd + 2.8)

    # ── Bát Quái 8-spoke wheel (Vietnamese geomancy) ─────────────────────
    vtex_chakra(0, bob, PZ,  1,0,0,  0,0,1,  PR * 1.85, 8,                 土, hd + 3.5)

    # ── Impossible geometry: 3 intersecting Poincaré discs ───────────────
    # Horizontal (XZ plane) — from above
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,0,1,  3.2, 8, 8,             金, hd + 6.5)
    # Vertical frontal (XY plane) — face-on
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,1,0,  3.2, 8, 8,             金, hd + 7.5)
    # Vertical lateral (YZ plane) — side-on
    vtex_hyperbolic_uv(0, bob, PZ,  0,0,1,  0,1,0,  3.2, 8, 8,             金, hd + 8.5)

    # ── XY-plane ring echo — drum face seen vertically ────────────────────
    vtex_rings(0, bob, PZ,  1,0,0,  0,1,0,  4, 64,  PR * 1.95, 0.0,        土, hd + 5.0)
    vtex_rings(0, bob, PZ,  1,0,0,  0,1,0,  3, 64,  PR * 1.50, 0.0,      0-水, hd + 1.5)

    # ── 4 Rồng dragon spiral arms (one per cardinal direction) ───────────
    vtex_spiral(0-4.5, 1.0, PZ-2.5,  1,0,0,  0,0,1,  3.2, 3.0, 80,        水, hd + 0.5)
    vtex_spiral( 4.5,  1.0, PZ-2.5,  1,0,0,  0,0,1,  3.2, 3.0, 80,        水, hd + 3.9)
    vtex_spiral(0-3.5, 1.0, PZ+3.0,  1,0,0,  0,0,1,  2.8, 2.6, 80,        金, hd + 1.8)
    vtex_spiral( 3.5,  1.0, PZ+3.0,  1,0,0,  0,0,1,  2.8, 2.6, 80,        金, hd + 5.3)
}


# ════════════════════════════════════════════════════════════════════════════
# 地  FLOOR  — kaolin earth, rippling (high amplitude = DMT warp)
# ════════════════════════════════════════════════════════════════════════════

函 draw_地(FR, hd) {
    令 cy   = 0 - H
    令 fmid = FZ / 2
    令 土   = FR * 0.12
    # Rippling kaolin — very high amplitude for a warped ground plane
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  22, 18,  0.70, 0.38, 5.5,  FR, hd + 2.0)
    # Bát Quái 8-ring floor mandala
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  8, 64,  5.5, 0.0,                  土, hd + 0.0)
    # 8-petal Sen lotus
    vtex_flower(0, cy, fmid,  1,0,0,  0,0,1,  2.2, 8,                           FR, hd + 1.5)
    # vtex_yantra: n_layers=4, max_r=4.8
    vtex_yantra(0, cy, fmid,  1,0,0,  0,0,1,  4, 4.8,                           FR, hd + 3.0)
    vtex_grid(0, cy, fmid,  1,0,0,  0,0,1,  28, 22,  0.68, 0.68,               FR, hd + 4.5)
}


# ════════════════════════════════════════════════════════════════════════════
# 天  CEILING  — celestial Poincaré firmament + 16-petal lotus
# ════════════════════════════════════════════════════════════════════════════

函 draw_天(FR, hd) {
    令 cy   = H
    令 fmid = FZ / 2
    令 土   = FR * 0.12
    令 水   = FR * 0.45
    # Dense hyperbolic firmament (20 circles × 20 rays — maximum density)
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  7.0, 20, 20,              FR, hd + 1.5)
    # 16-petal celestial lotus (heavenly Hoa Sen)
    vtex_flower(0, cy, fmid,  1,0,0,  0,0,1,  2.8, 16,                         FR, hd + 0.2)
    # 8-point Bát Quái star
    vtex_star(0, cy, fmid,   1,0,0,  0,0,1,  8, 4.2, 2.0, 0.0,                FR, hd + 4.0)
    # 3 outer concentric halos (土/水 pace — very slow overhead sweep)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  3, 64,  7.0, 0.0,                 土, hd + 5.0)
    vtex_rings(0, cy, fmid,  1,0,0,  0,0,1,  2, 64,  5.4, 0.0,                 水, hd + 2.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 牆  WALLS  — Chữ Nôm spirit-rain + hyperbolic portal on every face
# ════════════════════════════════════════════════════════════════════════════

函 draw_front_wall(FR, hd) {
    令 水 = FR * 0.45
    # Chữ Nôm glyph rain — entrance gate
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  28, 18,  0.62, 0.56,  0.018,  FR, hd + 2.0)
    # Front portal Poincaré (DMT entry — walking into fractals)
    vtex_hyperbolic_uv(0, 0, NZ,  1,0,0,  0,1,0,  5.5, 14, 14,                 水, hd + 0.8)
}

函 draw_back_wall(FR, hd) {
    令 土 = FR * 0.12
    令 火 = FR * 1.50
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  32, 20,  0.60, 0.54,  0.020,  FR, hd + 2.2)
    # Yantra innermost gate (deepest layer) — n_layers=4, max_r=5.0
    vtex_yantra(0, 0, FZ,  1,0,0,  0,1,0,  4, 5.0,                             FR, hd + 0.0)
    # 6-layer portal halo
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  6, 64,  5.8, 0.0,                   土, hd + 0.0)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  4, 64,  4.5, 0.0,                   火, hd + 1.0)
    # 8-point star-gate
    vtex_star(0, 0, FZ,   1,0,0,  0,1,0,  8, 5.2, 2.8, 0.0,                   火, hd + 3.5)
    vtex_flower(0, 0, FZ,  1,0,0,  0,1,0,  3.0, 8,                             火, hd + 2.0)
}

函 draw_left_wall(FR, hd) {
    令 cx   = 0 - W
    令 fmid = (NZ + FZ) / 2
    令 水   = FR * 0.45
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  22, 14,  0.66, 0.60,  0.016,  FR, hd + 3.5)
    vtex_hyperbolic_uv(cx, 0, fmid,  0,0,1,  0,1,0,  4.5, 12, 12,              水, hd + 1.2)
    vtex_rings(cx, 0, fmid,  0,0,1,  0,1,0,  3, 64,  3.8, 0.0,                 水, hd + 0.5)
}

函 draw_right_wall(FR, hd) {
    令 cx   = W
    令 fmid = (NZ + FZ) / 2
    令 水   = FR * 0.45
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  22, 14,  0.66, 0.60,  0.016,  FR, hd + 1.8)
    vtex_hyperbolic_uv(cx, 0, fmid,  0,0,1,  0,1,0,  4.5, 12, 12,              水, hd + 3.5)
    vtex_rings(cx, 0, fmid,  0,0,1,  0,1,0,  3, 64,  3.8, 0.0,                 水, hd + 2.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 殘像  THREE-LAYER ECHO PASS
#   The deepest echo trail of any room in this series.
#   Oldest echo (−96) is hue-shifted +3.0 → complementary colour ghost.
#   Fast 木 elements fan into wide colour arcs; slow 土 rings glow haloes.
# ════════════════════════════════════════════════════════════════════════════

函 draw_echo(FR, hd) {
    令 cy_f = 0 - H
    令 cy_c = H
    令 fm   = FZ / 2
    令 土   = FR * 0.12
    令 水   = FR * 0.45
    令 金   = FR * 0.80
    令 火   = FR * 1.50
    令 bob  = sin(FR * 0.014) * 0.28

    # Floor rings + grid
    vtex_rings(0, cy_f, fm,  1,0,0,  0,0,1,  8, 64,  5.5, 0.0,  土, hd + 0.0)
    vtex_grid(0, cy_f, fm,  1,0,0,  0,0,1,  28, 22,  0.68, 0.68,  FR, hd + 4.5)

    # Ceiling lotus + outer halo
    vtex_flower(0, cy_c, fm,  1,0,0,  0,0,1,  2.8, 16,  FR, hd + 0.2)
    vtex_rings(0, cy_c, fm,  1,0,0,  0,0,1,  3, 64,  7.0, 0.0,  土, hd + 5.0)

    # Back portal
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  6, 64,  5.8, 0.0,  土, hd + 0.0)
    vtex_rings(0, 0, FZ,  1,0,0,  0,1,0,  4, 64,  4.5, 0.0,  火, hd + 1.0)

    # Drum — outer rings + hyperdimensional discs + star
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  8, 64,  PR * 2.50, 0.0,  土, hd + 0.0)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  5, 64,  PR * 1.70, 0.0,  0-水, hd + 0.8)
    vtex_rings(0, bob, PZ,  1,0,0,  0,0,1,  3, 64,  PR * 1.10, 0.0,  0-金, hd + 1.6)
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,0,1,  3.2, 8, 8,        金, hd + 6.5)
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,1,0,  3.2, 8, 8,        金, hd + 7.5)
    vtex_hyperbolic_uv(0, bob, PZ,  0,0,1,  0,1,0,  3.2, 8, 8,        金, hd + 8.5)
    vtex_star(0, bob, PZ,   1,0,0,  0,0,1,  12, PR, PR * 0.44, 0.0,   火, hd + 0.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 照明  LIGHTS
#   Jade-green lantern (đèn lồng ngọc) · crimson lacquer · DMT violet ·
#   gold amber overhead (đèn vàng)
# ════════════════════════════════════════════════════════════════════════════

函 setup_lights(FR) {
    clear_lights()
    # Jade-green paper lantern — slow orbit (phosphorescent jungle)
    add_light(
        sin(FR * 0.0055) * 4.0,
        3.5,
        cos(FR * 0.0055) * 2.5 + PZ,
        0.10, 0.88, 0.42,
        2.8, 14.0
    )
    # Crimson lacquer accent — son mài đỏ (Vietnamese red)
    add_light(
        sin(FR * 0.0042) * 3.0,
        0.5,
        0-cos(FR * 0.0042) * 2.0 + PZ,
        0.88, 0.12, 0.06,
        1.0, 10.0
    )
    # Electric violet — DMT hyperspace under-glow
    add_light(0, 0-4.2, PZ,  0.45, 0.0, 0.90,  1.5, 12.0)
    # Gold amber overhead
    add_light(0, 4.8, PZ,  0.94, 0.72, 0.10,  0.8, 9.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 音樂  AUDIO — Thang âm oán (怨 Lament mode)
#   Scale: C · E♭ · F · A♭ · B♭  (root C3 = 130.81 Hz)
#   A♭3 (207.65 Hz) beating with A3 (220.00 Hz) = 12.35 Hz DMT-throb
#   LFO 0.15–0.65 Hz = đàn bầu monochord microtonal vibrato
# ════════════════════════════════════════════════════════════════════════════

函 init_audio() {
    # slot   x       y     z       w     freq     amp   lfo_hz  depth
    audio_tone(0,  0,   0-H,  PZ,  1.8,   65.41, 0.13, 0.15, 0.010) # C2  sub-bass (土)
    audio_tone(1,  0,   0-H,  FZ,  2.2,  130.81, 0.14, 0.18, 0.012) # C3  ground
    audio_tone(2, 0-W,  0,    PZ,  2.0,  155.56, 0.10, 0.22, 0.014) # E♭3 left (minor 3rd)
    audio_tone(3,  W,   0,    PZ,  2.0,  174.61, 0.10, 0.28, 0.014) # F3  right (4th)
    audio_tone(4,  0,   H,    PZ,  0.6,  207.65, 0.08, 0.32, 0.015) # A♭3 ceiling (beating)
    audio_tone(5,  0,   H,    PZ,  0.6,  220.00, 0.07, 0.32, 0.015) # A3  beat-pair → 12 Hz throb
    audio_tone(6,  0,   0,    FZ,  1.4,  233.08, 0.09, 0.38, 0.018) # B♭3 portal (min 7th)
    audio_tone(7,  0,   0,    PZ,  0.8,  261.63, 0.07, 0.45, 0.020) # C4  drum octave
    audio_tone(8, 0-4.5, 1.0, PZ-2.5, 3.2, 311.13, 0.06, 0.65, 0.028) # E♭4 Rồng dragon (木)
    audio_volume(0.62)
}


# ════════════════════════════════════════════════════════════════════════════
# 開始  MAIN
# ════════════════════════════════════════════════════════════════════════════

令 启 = 执 {
    เปิดหน้าต่างเต็มจอ("Linh Đài — 靈臺五行殿 — Palace of Five Elements")
    capture_mouse()
    set_ambient(0.04)

    init_audio()

    令 靈 = 0    # 靈 = linh · spirit-frame counter

    令 cam_px = 0.0
    令 cam_py = 0.0
    令 cam_pz = 0.0
    令 cam_zdist = 2.0
    令 cam_ry_off = 0.0
    令 cam_rx_off = 0.0
    令 cam_idle = 0
    令 cam_manual = 0
    令 cam_ry_snap = 0.0
    令 cam_rx_snap = 0.0

    循 หน้าต่างเปิดอยู่() {
        เติม(6, 0, 10)   # deep DMT violet-indigo

        # Camera: moderate sway — more active than Japanese, less than Thai
        # Horizontal ±0.24 rad, period ~2600 frames
        # Vertical   ±0.10 rad, period ~3900 frames
        令 ry  = sin(靈 * 0.00048) * 0.24
        令 rx  = sin(靈 * 0.00032) * 0.10
        令 mdx = mouse_dx()
        令 mdy = mouse_dy()
        令 any_input = 0
        若 key_down("w")      { 令 any_input = 1 }
        若 key_down("s")      { 令 any_input = 1 }
        若 key_down("a")      { 令 any_input = 1 }
        若 key_down("d")      { 令 any_input = 1 }
        若 key_down("space")  { 令 any_input = 1 }
        若 key_down("lshift") { 令 any_input = 1 }
        若 key_down("left")   { 令 any_input = 1 }
        若 key_down("right")  { 令 any_input = 1 }
        若 key_down("up")     { 令 any_input = 1 }
        若 key_down("down")   { 令 any_input = 1 }
        若 mdx * mdx + mdy * mdy > 0.25 { 令 any_input = 1 }
        若 any_input == 1 { 令 cam_manual = 1; 令 cam_idle = 0 }
        若 cam_manual == 1 {
            令 cam_idle = cam_idle + 1
            若 cam_idle > 300 { 令 cam_manual = 0; 令 cam_idle = 0 }
        }
        若 cam_manual == 1 {
            令 cam_ry_off = cam_ry_off + mdx * 0.0022
            令 cam_rx_off = cam_rx_off + mdy * 0.0022
            若 cam_rx_off > 3.14159  { 令 cam_rx_off = 3.14159 }
            若 cam_rx_off < -3.14159 { 令 cam_rx_off = -3.14159 }
            若 key_down("left")  { 令 cam_ry_off = cam_ry_off - 0.018 }
            若 key_down("right") { 令 cam_ry_off = cam_ry_off + 0.018 }
            若 key_down("up")    { 令 cam_rx_off = cam_rx_off - 0.018 }
            若 key_down("down")  { 令 cam_rx_off = cam_rx_off + 0.018 }
            令 fwd_x = sin(cam_ry_snap + cam_ry_off)
            令 fwd_z = cos(cam_ry_snap + cam_ry_off)
            令 rgt_x = cos(cam_ry_snap + cam_ry_off)
            令 rgt_z = 0.0 - sin(cam_ry_snap + cam_ry_off)
            令 spd = 0.12
            若 key_down("w") { 令 cam_px = cam_px + fwd_x * spd; 令 cam_pz = cam_pz + fwd_z * spd }
            若 key_down("s") { 令 cam_px = cam_px - fwd_x * spd; 令 cam_pz = cam_pz - fwd_z * spd }
            若 key_down("a") { 令 cam_px = cam_px - rgt_x * spd; 令 cam_pz = cam_pz - rgt_z * spd }
            若 key_down("d") { 令 cam_px = cam_px + rgt_x * spd; 令 cam_pz = cam_pz + rgt_z * spd }
            若 key_down("space")  { 令 cam_py = cam_py + spd }
            若 key_down("lshift") { 令 cam_py = cam_py - spd }
            若 key_pressed("numpad+") { 令 cam_zdist = cam_zdist + 0.5 }
            若 key_pressed("numpad-") { 令 cam_zdist = cam_zdist - 0.5; 若 cam_zdist < 0.5 { 令 cam_zdist = 0.5 } }
        }
        若 cam_manual == 0 {
            令 cam_ry_snap = ry
            令 cam_rx_snap = rx
            令 cam_ry_off = cam_ry_off * 0.97
            令 cam_rx_off = cam_rx_off * 0.97
            令 cam_px = cam_px * 0.97
            令 cam_py = cam_py * 0.97
            令 cam_pz = cam_pz * 0.97
        }
        令 cry = cos(cam_ry_snap + cam_ry_off)   令 sry = sin(cam_ry_snap + cam_ry_off)
        令 crx = cos(cam_rx_snap + cam_rx_off)   令 srx = sin(cam_rx_snap + cam_rx_off)
        set_camera(cry, sry, crx, srx)
        set_camera_pos(cam_px, cam_py, cam_pz)
        set_zdist(cam_zdist)
        audio_listener(cry, sry, crx, srx)

        setup_lights(靈)

        # Three echo passes — widest comet trails in the series
        # Oldest: hue+3.0 (near-complementary colour ghost)
        # Middle: hue+2.0 (warm/cool shift)
        # Recent: hue+1.0 (subtle chromatic fringe)
        draw_echo(靈 - 96, 3.0)
        draw_echo(靈 - 48, 2.0)
        draw_echo(靈 - 24, 1.0)

        draw_地(靈, 0.0)
        draw_天(靈, 0.0)
        draw_front_wall(靈, 0.0)
        draw_back_wall(靈, 0.0)
        draw_left_wall(靈, 0.0)
        draw_right_wall(靈, 0.0)
        draw_鼓(靈, 0.0)

        แสดงผล()
        令 靈 = 靈 + 1
    }
}
