# ════════════════════════════════════════════════════════════════════════════
# 3d-vietnamese-room-v2.ling — 靈臺五行殿  Linh Đài · Palace of Five Elements
#
#  v2: fixes vtex_yantra arg count (n_layers added to floor call).
#
#  Written in Chữ Hán (漢字) — the classical script of Vietnamese
#  scholarship before romanisation.  Variable names, frame counter, and
#  function names use Hán characters exactly as a Confucian scholar would
#  label the cosmos.
#
#  Ngũ Hành (五行 Five Transformations) time-streams:
#    土 = FR × 0.12   Thổ  — Earth / Địa  (ultra-slow resonance)
#    水 = FR × 0.45   Thuỷ — Water / Thuỷ (flowing medium)
#    金 = FR × 0.80   Kim  — Metal / Kim  (vibrating fast)
#    火 = FR × 1.50   Hoả  — Fire  / Hoả  (accelerating)
#    木 = FR × 2.20   Mộc  — Wood  / Mộc  (wildfire — hyper-speed)
#
#  Visual centrepiece: Đông Sơn bronze drum (東山鼓)
#    12-ray sun core  +  8 counter-rotating ring groups  +  4 Rồng spirals
#    +  THREE intersecting Poincaré discs forming a hyperdimensional orb
#
#  Thang âm oán (怨 Lament scale — C · E♭ · F · A♭ · B♭):
#    Nine sine tones in the melancholic Vietnamese oán pentatonic.
#    A♭3 / A3 beating at ~12 Hz = the DMT-throb resonance.
#    LFO 0.15–0.65 Hz = đàn bầu monochord microtonal vibrato.
#
#  Framefade: THREE chromatic echo passes (−96 · −48 · −24 frames).
#    Fast 木 elements (×2.20) create wide fan-ghosts; slow 土 (×0.12)
#    elements leave tight chromatic halos — both simultaneously visible.
#
#  Run:  ling run examples/3d-vietnamese-room-v2.ling
#  Quit: Escape or close window
# ════════════════════════════════════════════════════════════════════════════

ผูก W  = 10.0    # 幅  half-width
ผูก H  = 5.0     # 高  half-height
ผูก FZ = 18.0    # 遠壁 far-wall z
ผูก NZ = 1.6     # 近壁 near-wall z
ผูก PZ = 9.0     # 中軸 centre axis z
ผูก PR = 1.30    # 鼓半 drum-core radius


# ════════════════════════════════════════════════════════════════════════════
# 東山鼓  DONG SON DRUM  — central mandala
#   12-ray sun  ·  8 counter-rotating ring groups  ·  Bát Quái 8-spoke wheel
#   3 intersecting Poincaré discs  ·  4 Rồng dragon spirals
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_鼓(FR, hd) {
    ผูก 土 = FR * 0.12
    ผูก 水 = FR * 0.45
    ผูก 金 = FR * 0.80
    ผูก 火 = FR * 1.50
    ผูก 木 = FR * 2.20
    ผูก bob = ไซน์(FR * 0.014) * 0.28

    # ── Sun centre: 12-ray star (12 tháng / 12 months of the lunar year) ──
    ลายดาว(0, bob, PZ,   1,0,0,  0,0,1,  12, PR, PR * 0.44, 0.0,        火, hd)
    # Inner chrysanthemum — 16 petals (16 warriors of the Hùng kings)
    ลายดอกไม้(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.58, 16,                木, hd + 1.0)
    # Central lotus (8-petal Bát Quái)
    ลายดอกบัว(0, bob, PZ,  1,0,0,  0,0,1,  PR * 0.22, PR * 0.56, 8,       水, hd + 4.2)

    # ── 8 concentric ring groups — Đông Sơn drum face ────────────────────
    # Alternate clockwise / counter-clockwise for counter-rotating shimmer
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  8, 64,  PR * 2.50, 0.0,        土, hd + 0.0)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  6, 64,  PR * 2.05, 0.0,        水, hd + 0.4)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  5, 64,  PR * 1.70, 0.0,      0-水, hd + 0.8)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  4, 64,  PR * 1.38, 0.0,        金, hd + 1.2)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  3, 64,  PR * 1.10, 0.0,      0-金, hd + 1.6)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  2, 64,  PR * 0.86, 0.0,        火, hd + 2.0)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  2, 64,  PR * 0.64, 0.0,      0-火, hd + 2.4)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  1, 64,  PR * 0.44, 0.0,        木, hd + 2.8)

    # ── Bát Quái 8-spoke wheel (Vietnamese geomancy) ─────────────────────
    ลายจักร(0, bob, PZ,  1,0,0,  0,0,1,  PR * 1.85, 8,                 土, hd + 3.5)

    # ── Impossible geometry: 3 intersecting Poincaré discs ───────────────
    # Horizontal (XZ plane) — from above
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,0,1,  3.2, 8, 8,             金, hd + 6.5)
    # Vertical frontal (XY plane) — face-on
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,1,0,  3.2, 8, 8,             金, hd + 7.5)
    # Vertical lateral (YZ plane) — side-on
    vtex_hyperbolic_uv(0, bob, PZ,  0,0,1,  0,1,0,  3.2, 8, 8,             金, hd + 8.5)

    # ── XY-plane ring echo — drum face seen vertically ────────────────────
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,1,0,  4, 64,  PR * 1.95, 0.0,        土, hd + 5.0)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,1,0,  3, 64,  PR * 1.50, 0.0,      0-水, hd + 1.5)

    # ── 4 Rồng dragon spiral arms (one per cardinal direction) ───────────
    ลายเกลียว(0-4.5, 1.0, PZ-2.5,  1,0,0,  0,0,1,  3.2, 3.0, 80,        水, hd + 0.5)
    ลายเกลียว( 4.5,  1.0, PZ-2.5,  1,0,0,  0,0,1,  3.2, 3.0, 80,        水, hd + 3.9)
    ลายเกลียว(0-3.5, 1.0, PZ+3.0,  1,0,0,  0,0,1,  2.8, 2.6, 80,        金, hd + 1.8)
    ลายเกลียว( 3.5,  1.0, PZ+3.0,  1,0,0,  0,0,1,  2.8, 2.6, 80,        金, hd + 5.3)
}


# ════════════════════════════════════════════════════════════════════════════
# 地  FLOOR  — kaolin earth, rippling (high amplitude = DMT warp)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_地(FR, hd) {
    ผูก cy   = 0 - H
    ผูก fmid = FZ / 2
    ผูก 土   = FR * 0.12
    # Rippling kaolin — very high amplitude for a warped ground plane
    vtex_tessellated(0, cy, fmid,  1,0,0,  0,0,1,  22, 18,  0.70, 0.38, 5.5,  FR, hd + 2.0)
    # Bát Quái 8-ring floor mandala
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  8, 64,  5.5, 0.0,                  土, hd + 0.0)
    # 8-petal Sen lotus
    ลายดอกไม้(0, cy, fmid,  1,0,0,  0,0,1,  2.2, 8,                           FR, hd + 1.5)
    # vtex_yantra: n_layers=4, max_r=4.8
    ลายยันต์(0, cy, fmid,  1,0,0,  0,0,1,  4, 4.8,                           FR, hd + 3.0)
    ลายตาราง(0, cy, fmid,  1,0,0,  0,0,1,  28, 22,  0.68, 0.68,               FR, hd + 4.5)
}


# ════════════════════════════════════════════════════════════════════════════
# 天  CEILING  — celestial Poincaré firmament + 16-petal lotus
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_天(FR, hd) {
    ผูก cy   = H
    ผูก fmid = FZ / 2
    ผูก 土   = FR * 0.12
    ผูก 水   = FR * 0.45
    # Dense hyperbolic firmament (20 circles × 20 rays — maximum density)
    vtex_hyperbolic_uv(0, cy, fmid,  1,0,0,  0,0,1,  7.0, 20, 20,              FR, hd + 1.5)
    # 16-petal celestial lotus (heavenly Hoa Sen)
    ลายดอกไม้(0, cy, fmid,  1,0,0,  0,0,1,  2.8, 16,                         FR, hd + 0.2)
    # 8-point Bát Quái star
    ลายดาว(0, cy, fmid,   1,0,0,  0,0,1,  8, 4.2, 2.0, 0.0,                FR, hd + 4.0)
    # 3 outer concentric halos (土/水 pace — very slow overhead sweep)
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  3, 64,  7.0, 0.0,                 土, hd + 5.0)
    ลายวงซ้อน(0, cy, fmid,  1,0,0,  0,0,1,  2, 64,  5.4, 0.0,                 水, hd + 2.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 牆  WALLS  — Chữ Nôm spirit-rain + hyperbolic portal on every face
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_front_wall(FR, hd) {
    ผูก 水 = FR * 0.45
    # Chữ Nôm glyph rain — entrance gate
    vtex_letter_rain(0, 0, NZ,  1,0,0,  0,1,0,  28, 18,  0.62, 0.56,  0.018,  FR, hd + 2.0)
    # Front portal Poincaré (DMT entry — walking into fractals)
    vtex_hyperbolic_uv(0, 0, NZ,  1,0,0,  0,1,0,  5.5, 14, 14,                 水, hd + 0.8)
}

ฟังก์ชัน draw_back_wall(FR, hd) {
    ผูก 土 = FR * 0.12
    ผูก 火 = FR * 1.50
    vtex_letter_rain(0, 0, FZ,  1,0,0,  0,1,0,  32, 20,  0.60, 0.54,  0.020,  FR, hd + 2.2)
    # Yantra innermost gate (deepest layer) — n_layers=4, max_r=5.0
    ลายยันต์(0, 0, FZ,  1,0,0,  0,1,0,  4, 5.0,                             FR, hd + 0.0)
    # 6-layer portal halo
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  6, 64,  5.8, 0.0,                   土, hd + 0.0)
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  4, 64,  4.5, 0.0,                   火, hd + 1.0)
    # 8-point star-gate
    ลายดาว(0, 0, FZ,   1,0,0,  0,1,0,  8, 5.2, 2.8, 0.0,                   火, hd + 3.5)
    ลายดอกไม้(0, 0, FZ,  1,0,0,  0,1,0,  3.0, 8,                             火, hd + 2.0)
}

ฟังก์ชัน draw_left_wall(FR, hd) {
    ผูก cx   = 0 - W
    ผูก fmid = (NZ + FZ) / 2
    ผูก 水   = FR * 0.45
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  22, 14,  0.66, 0.60,  0.016,  FR, hd + 3.5)
    vtex_hyperbolic_uv(cx, 0, fmid,  0,0,1,  0,1,0,  4.5, 12, 12,              水, hd + 1.2)
    ลายวงซ้อน(cx, 0, fmid,  0,0,1,  0,1,0,  3, 64,  3.8, 0.0,                 水, hd + 0.5)
}

ฟังก์ชัน draw_right_wall(FR, hd) {
    ผูก cx   = W
    ผูก fmid = (NZ + FZ) / 2
    ผูก 水   = FR * 0.45
    vtex_letter_rain(cx, 0, fmid,  0,0,1,  0,1,0,  22, 14,  0.66, 0.60,  0.016,  FR, hd + 1.8)
    vtex_hyperbolic_uv(cx, 0, fmid,  0,0,1,  0,1,0,  4.5, 12, 12,              水, hd + 3.5)
    ลายวงซ้อน(cx, 0, fmid,  0,0,1,  0,1,0,  3, 64,  3.8, 0.0,                 水, hd + 2.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 殘像  THREE-LAYER ECHO PASS
#   The deepest echo trail of any room in this series.
#   Oldest echo (−96) is hue-shifted +3.0 → complementary colour ghost.
#   Fast 木 elements fan into wide colour arcs; slow 土 rings glow haloes.
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน draw_echo(FR, hd) {
    ผูก cy_f = 0 - H
    ผูก cy_c = H
    ผูก fm   = FZ / 2
    ผูก 土   = FR * 0.12
    ผูก 水   = FR * 0.45
    ผูก 金   = FR * 0.80
    ผูก 火   = FR * 1.50
    ผูก bob  = ไซน์(FR * 0.014) * 0.28

    # Floor rings + grid
    ลายวงซ้อน(0, cy_f, fm,  1,0,0,  0,0,1,  8, 64,  5.5, 0.0,  土, hd + 0.0)
    ลายตาราง(0, cy_f, fm,  1,0,0,  0,0,1,  28, 22,  0.68, 0.68,  FR, hd + 4.5)

    # Ceiling lotus + outer halo
    ลายดอกไม้(0, cy_c, fm,  1,0,0,  0,0,1,  2.8, 16,  FR, hd + 0.2)
    ลายวงซ้อน(0, cy_c, fm,  1,0,0,  0,0,1,  3, 64,  7.0, 0.0,  土, hd + 5.0)

    # Back portal
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  6, 64,  5.8, 0.0,  土, hd + 0.0)
    ลายวงซ้อน(0, 0, FZ,  1,0,0,  0,1,0,  4, 64,  4.5, 0.0,  火, hd + 1.0)

    # Drum — outer rings + hyperdimensional discs + star
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  8, 64,  PR * 2.50, 0.0,  土, hd + 0.0)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  5, 64,  PR * 1.70, 0.0,  0-水, hd + 0.8)
    ลายวงซ้อน(0, bob, PZ,  1,0,0,  0,0,1,  3, 64,  PR * 1.10, 0.0,  0-金, hd + 1.6)
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,0,1,  3.2, 8, 8,        金, hd + 6.5)
    vtex_hyperbolic_uv(0, bob, PZ,  1,0,0,  0,1,0,  3.2, 8, 8,        金, hd + 7.5)
    vtex_hyperbolic_uv(0, bob, PZ,  0,0,1,  0,1,0,  3.2, 8, 8,        金, hd + 8.5)
    ลายดาว(0, bob, PZ,   1,0,0,  0,0,1,  12, PR, PR * 0.44, 0.0,   火, hd + 0.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 照明  LIGHTS
#   Jade-green lantern (đèn lồng ngọc) · crimson lacquer · DMT violet ·
#   gold amber overhead (đèn vàng)
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()
    # Jade-green paper lantern — slow orbit (phosphorescent jungle)
    เพิ่มแสง(
        ไซน์(FR * 0.0055) * 4.0,
        3.5,
        โคไซน์(FR * 0.0055) * 2.5 + PZ,
        0.10, 0.88, 0.42,
        2.8, 14.0
    )
    # Crimson lacquer accent — son mài đỏ (Vietnamese red)
    เพิ่มแสง(
        ไซน์(FR * 0.0042) * 3.0,
        0.5,
        0-โคไซน์(FR * 0.0042) * 2.0 + PZ,
        0.88, 0.12, 0.06,
        1.0, 10.0
    )
    # Electric violet — DMT hyperspace under-glow
    เพิ่มแสง(0, 0-4.2, PZ,  0.45, 0.0, 0.90,  1.5, 12.0)
    # Gold amber overhead
    เพิ่มแสง(0, 4.8, PZ,  0.94, 0.72, 0.10,  0.8, 9.0)
}


# ════════════════════════════════════════════════════════════════════════════
# 音樂  AUDIO — Thang âm oán (怨 Lament mode)
#   Scale: C · E♭ · F · A♭ · B♭  (root C3 = 130.81 Hz)
#   A♭3 (207.65 Hz) beating with A3 (220.00 Hz) = 12.35 Hz DMT-throb
#   LFO 0.15–0.65 Hz = đàn bầu monochord microtonal vibrato
# ════════════════════════════════════════════════════════════════════════════

ฟังก์ชัน init_audio() {
    # slot   x       y     z       w     freq     amp   lfo_hz  depth
    เสียง(0,  0,   0-H,  PZ,  1.8,   65.41, 0.13, 0.15, 0.010) # C2  sub-bass (土)
    เสียง(1,  0,   0-H,  FZ,  2.2,  130.81, 0.14, 0.18, 0.012) # C3  ground
    เสียง(2, 0-W,  0,    PZ,  2.0,  155.56, 0.10, 0.22, 0.014) # E♭3 left (minor 3rd)
    เสียง(3,  W,   0,    PZ,  2.0,  174.61, 0.10, 0.28, 0.014) # F3  right (4th)
    เสียง(4,  0,   H,    PZ,  0.6,  207.65, 0.08, 0.32, 0.015) # A♭3 ceiling (beating)
    เสียง(5,  0,   H,    PZ,  0.6,  220.00, 0.07, 0.32, 0.015) # A3  beat-pair → 12 Hz throb
    เสียง(6,  0,   0,    FZ,  1.4,  233.08, 0.09, 0.38, 0.018) # B♭3 portal (min 7th)
    เสียง(7,  0,   0,    PZ,  0.8,  261.63, 0.07, 0.45, 0.020) # C4  drum octave
    เสียง(8, 0-4.5, 1.0, PZ-2.5, 3.2, 311.13, 0.06, 0.65, 0.028) # E♭4 Rồng dragon (木)
    ระดับเสียง(0.62)
}


# ════════════════════════════════════════════════════════════════════════════
# 開始  MAIN
# ════════════════════════════════════════════════════════════════════════════

ผูก สร้าง = ทำ {
    เปิดหน้าต่างเต็มจอ("Linh Đài — 靈臺五行殿 — Palace of Five Elements")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.04)

    init_audio()

    ผูก 靈 = 0    # 靈 = linh · spirit-frame counter

    ผูก cam_px = 0.0
    ผูก cam_py = 0.0
    ผูก cam_pz = 0.0
    ผูก cam_zdist = 2.0
    ผูก cam_ry_off = 0.0
    ผูก cam_rx_off = 0.0
    ผูก cam_idle = 0
    ผูก cam_manual = 0
    ผูก cam_ry_snap = 0.0
    ผูก cam_rx_snap = 0.0

    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(6, 0, 10)   # deep DMT violet-indigo

        # Camera: moderate sway — more active than Japanese, less than Thai
        # Horizontal ±0.24 rad, period ~2600 frames
        # Vertical   ±0.10 rad, period ~3900 frames
        ผูก ry  = ไซน์(靈 * 0.00048) * 0.24
        ผูก rx  = ไซน์(靈 * 0.00032) * 0.10
        ผูก mdx = mouse_dx()
        ผูก mdy = mouse_dy()
        ผูก any_input = 0
        ถ้า key_down("w")      { ผูก any_input = 1 }
        ถ้า key_down("s")      { ผูก any_input = 1 }
        ถ้า key_down("a")      { ผูก any_input = 1 }
        ถ้า key_down("d")      { ผูก any_input = 1 }
        ถ้า key_down("space")  { ผูก any_input = 1 }
        ถ้า key_down("lshift") { ผูก any_input = 1 }
        ถ้า key_down("left")   { ผูก any_input = 1 }
        ถ้า key_down("right")  { ผูก any_input = 1 }
        ถ้า key_down("up")     { ผูก any_input = 1 }
        ถ้า key_down("down")   { ผูก any_input = 1 }
        ถ้า mdx * mdx + mdy * mdy > 0.25 { ผูก any_input = 1 }
        ถ้า any_input == 1 { ผูก cam_manual = 1; ผูก cam_idle = 0 }
        ถ้า cam_manual == 1 {
            ผูก cam_idle = cam_idle + 1
            ถ้า cam_idle > 300 { ผูก cam_manual = 0; ผูก cam_idle = 0 }
        }
        ถ้า cam_manual == 1 {
            ผูก cam_ry_off = cam_ry_off + mdx * 0.0022
            ผูก cam_rx_off = cam_rx_off + mdy * 0.0022
            ถ้า cam_rx_off > 3.14159  { ผูก cam_rx_off = 3.14159 }
            ถ้า cam_rx_off < -3.14159 { ผูก cam_rx_off = -3.14159 }
            ถ้า key_down("left")  { ผูก cam_ry_off = cam_ry_off - 0.018 }
            ถ้า key_down("right") { ผูก cam_ry_off = cam_ry_off + 0.018 }
            ถ้า key_down("up")    { ผูก cam_rx_off = cam_rx_off - 0.018 }
            ถ้า key_down("down")  { ผูก cam_rx_off = cam_rx_off + 0.018 }
            ผูก fwd_x = ไซน์(cam_ry_snap + cam_ry_off)
            ผูก fwd_z = โคไซน์(cam_ry_snap + cam_ry_off)
            ผูก rgt_x = โคไซน์(cam_ry_snap + cam_ry_off)
            ผูก rgt_z = 0.0 - ไซน์(cam_ry_snap + cam_ry_off)
            ผูก spd = 0.12
            ถ้า key_down("w") { ผูก cam_px = cam_px + fwd_x * spd; ผูก cam_pz = cam_pz + fwd_z * spd }
            ถ้า key_down("s") { ผูก cam_px = cam_px - fwd_x * spd; ผูก cam_pz = cam_pz - fwd_z * spd }
            ถ้า key_down("a") { ผูก cam_px = cam_px - rgt_x * spd; ผูก cam_pz = cam_pz - rgt_z * spd }
            ถ้า key_down("d") { ผูก cam_px = cam_px + rgt_x * spd; ผูก cam_pz = cam_pz + rgt_z * spd }
            ถ้า key_down("space")  { ผูก cam_py = cam_py + spd }
            ถ้า key_down("lshift") { ผูก cam_py = cam_py - spd }
            ถ้า key_pressed("numpad+") { ผูก cam_zdist = cam_zdist + 0.5 }
            ถ้า key_pressed("numpad-") { ผูก cam_zdist = cam_zdist - 0.5; ถ้า cam_zdist < 0.5 { ผูก cam_zdist = 0.5 } }
        }
        ถ้า cam_manual == 0 {
            ผูก cam_ry_snap = ry
            ผูก cam_rx_snap = rx
            ผูก cam_ry_off = cam_ry_off * 0.97
            ผูก cam_rx_off = cam_rx_off * 0.97
            ผูก cam_px = cam_px * 0.97
            ผูก cam_py = cam_py * 0.97
            ผูก cam_pz = cam_pz * 0.97
        }
        ผูก cry = โคไซน์(cam_ry_snap + cam_ry_off)   ผูก sry = ไซน์(cam_ry_snap + cam_ry_off)
        ผูก crx = โคไซน์(cam_rx_snap + cam_rx_off)   ผูก srx = ไซน์(cam_rx_snap + cam_rx_off)
        ตั้งกล้อง(cry, sry, crx, srx)
        ตั้งตำแหน่งกล้อง(cam_px, cam_py, cam_pz)
        ตั้งระยะห่าง(cam_zdist)
        ผู้ฟัง(cry, sry, crx, srx)

        setup_lights(靈)

        # Three echo passes — widest comet trails in the series
        # Oldest: hue+3.0 (near-complementary colour ghost)
        # Middle: hue+2.0 (warm/cool shift)
        # Recent: hue+1.0 (subtle chromatic fringe)
        draw_echo(靈 - 96, 3.0)
        draw_echo(靈 - 48, 2.0)
        draw_echo(靈 - 24, 1.0)

        draw_地(靈, 0.0)
        draw_天(靈, 0.0)
        draw_front_wall(靈, 0.0)
        draw_back_wall(靈, 0.0)
        draw_left_wall(靈, 0.0)
        draw_right_wall(靈, 0.0)
        draw_鼓(靈, 0.0)

        แสดงผล()
        ผูก 靈 = 靈 + 1
    }
}
