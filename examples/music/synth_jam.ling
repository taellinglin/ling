# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SYNTH JAM — arpeggiate a scale through GM instruments synthesized from .ling
# patches. No audio file needed: every note is generated by the ling-music synth.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind start = do {
    open_window(900, 520)
    bind ui = font_load("assets/fonts/Orbitron.ttf", 600.0)
    if ui < 0.0 { bind ui = font_load("../../assets/fonts/Orbitron.ttf", 600.0) }
    music_volume(0.7)

    # four GM instruments, synthesized from patch files
    bind piano  = music_patch("instruments/grand_piano.ling")
    bind rhodes = music_patch("instruments/rhodes_ep.ling")
    bind bass   = music_patch("instruments/synth_bass.ling")
    bind lead   = music_patch("instruments/square_lead.ling")

    bind scale = [0.0, 2.0, 4.0, 7.0, 9.0, 12.0, 9.0, 7.0]   # major pentatonic up/down
    bind lastStep = 0.0 - 1.0
    bind curNote = 60.0
    bind curInst = 0.0

    while window_is_open() {
        bind t = time_now()
        bind step = floor(t * 4.0)        # 4 notes / second

        if step > lastStep {
            bind lastStep = step
            bind idx = step - floor(step / 8.0) * 8.0       # step % 8
            bind block = floor(step / 8.0)
            bind inst = block - floor(block / 4.0) * 4.0    # rotate instrument every bar
            bind curInst = inst
            bind root = 48.0 + (block - floor(block / 8.0) * 8.0) * 2.0
            bind curNote = root + scale[idx]
            bind which = piano
            if inst > 0.5 { bind which = rhodes }
            if inst > 1.5 { bind which = bass }
            if inst > 2.5 { bind which = lead }
            music_note(which, curNote, 0.13, 0.9)
            # a soft bass note on the downbeat
            if idx < 0.5 { music_note(bass, root - 12.0, 0.18, 0.7) }
        }

        # ── visuals ──
        set_color(8, 10, 16)
        fill()
        set_blend(1)
        set_color(0, 220, 255)
        if ui < 0.0 { ui_text(40.0, 22.0, 24.0, "SYNTH JAM") } else { font_text_fill(ui, 40.0, 22.0, 28.0, "SYNTH JAM") }

        # instrument name
        bind iname = "GRAND PIANO"
        if curInst > 0.5 { bind iname = "RHODES EP" }
        if curInst > 1.5 { bind iname = "SYNTH BASS" }
        if curInst > 2.5 { bind iname = "SQUARE LEAD" }
        set_color(60, 255, 180)
        if ui < 0.0 { ui_text(40.0, 70.0, 16.0, iname) } else { font_text_fill(ui, 40.0, 70.0, 18.0, iname) }

        # a little keyboard: 24 keys, light the current note
        bind k = 0.0
        while k < 24.0 {
            bind kx = 60.0 + k * 32.0
            bind midi = 48.0 + k
            bind active = 0.0
            if midi > curNote - 0.5 { if midi < curNote + 0.5 { bind active = 1.0 } }
            if active > 0.5 { ui_bar(kx, 360.0, 28.0, 120.0, 1.0, 1.0, 255.0, 200.0, 60.0) } else { ui_bar(kx, 360.0, 28.0, 120.0, 1.0, 1.0, 30.0, 46.0, 78.0) }
            bind k = k + 1.0
        }

        # current note name + a spinning 3-D gauge that pulses with the beat
        set_color(190, 235, 255)
        if ui < 0.0 { } else { font_text_fill(ui, 60.0, 300.0, 22.0, music_note_name(music_hz(curNote))) }
        bind pulse = sin(t * 8.0) * 0.5 + 0.5
        ui_gauge3d(800.0, 120.0, 56.0, pulse, t * 1.5)

        set_blend(0)
        present()
    }
}
