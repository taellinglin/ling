ผูก W = 14.0
ผูก H = 9.0
ผูก FZ = 24.0
ผูก center_x = 0.0
ผูก center_z = FZ * 0.45
ผูก FC4 = 261.63

ผูก F1_m_a = 730
ผูก F2_m_a = 1090
ผูก F3_m_a = 2440
ผูก F1_m_o = 570
ผูก F2_m_o = 840
ผูก F3_m_o = 2410
