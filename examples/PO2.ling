ผูก F2_m_e = 1840
ผูก F3_m_e = 2480
ผูก F1_m_i = 310
ผูก F2_m_i = 2790
ผูก F3_m_i = 2960
ผูก F1_m_u = 310
ผูก F2_m_u = 870
ผูก F3_m_u = 2240
ผูก F1_m_v = 310
ผูก F2_m_v = 2000
ผูก F3_m_v = 2640

