ผูก F3_f_v = 3590

ฟังก์ชัน sm2_hash(cx ry a b) {
    ผูก p = cx * 2166136261.0 + ry * 16777619.0
    ผูก s = ไซน์(p * 0.0000031 + a) * 0.5 + 0.5
    ผูก c = โคไซน์(p * 0.0000059 - b) * 0.5 + 0.5
    s * 0.618 + c * 0.382
}

ฟังก์ชัน init_audio() {
    เสียงโทน(0 0 0 center_z 8.0 FC4 0.22 0.000 0.000)
    เสียงโทน(1 -4.0 1.5 center_z 3.0 F1_m_a 0.12 0.000 0.000)
    เสียงโทน(2 -4.0 1.5 center_z 3.0 F2_m_a 0.12 0.000 0.000)
    เสียงโทน(3 -4.0 1.5 center_z 3.0 F3_m_a 0.08 0.000 0.000)
    เสียงโทน(4 4.0 1.5 center_z 3.0 F1_f_a 0.12 0.000 0.000)
    เสียงโทน(5 4.0 1.5 center_z 3.0 F2_f_a 0.12 0.000 0.000)
    เสียงโทน(6 4.0 1.5 center_z 3.0 F3_f_a 0.08 0.000 0.000)
    ระดับเสียง(0.55)
}

ฟังก์ชัน update_vowel(voice vowel breath) {
    ถ้า voice == "yang" {
        ถ้า vowel == "a" {
            730 * (1 + (breath-0.5)*0.15)
            1090 * (1 + (breath-0.5)*0.15)
            2440 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "o" {
            570 * (1 + (breath-0.5)*0.15)
            840 * (1 + (breath-0.5)*0.15)
            2410 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "e" {
            500 * (1 + (breath-0.5)*0.15)
            1840 * (1 + (breath-0.5)*0.15)
            2480 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "i" {
            310 * (1 + (breath-0.5)*0.15)
            2790 * (1 + (breath-0.5)*0.15)
            2960 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "u" {
            310 * (1 + (breath-0.5)*0.15)
            870 * (1 + (breath-0.5)*0.15)
            2240 * (1 + (breath-0.5)*0.08)
        }
        มิฉะนั้น {
            310 * (1 + (breath-0.5)*0.15)
            2000 * (1 + (breath-0.5)*0.15)
            2640 * (1 + (breath-0.5)*0.08)
        }
    } มิฉะนั้น {
        ถ้า vowel == "a" {
            860 * (1 + (breath-0.5)*0.15)
            1286 * (1 + (breath-0.5)*0.15)
            2880 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "o" {
            673 * (1 + (breath-0.5)*0.15)
            991 * (1 + (breath-0.5)*0.15)
            2840 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "e" {
            590 * (1 + (breath-0.5)*0.15)
            2171 * (1 + (breath-0.5)*0.15)
            2930 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "i" {
            366 * (1 + (breath-0.5)*0.15)
            3292 * (1 + (breath-0.5)*0.15)
            3490 * (1 + (breath-0.5)*0.08)
        }
        ถ้า vowel == "u" {
            366 * (1 + (breath-0.5)*0.15)
            1027 * (1 + (breath-0.5)*0.15)
            3040 * (1 + (breath-0.5)*0.08)
        }
        มิฉะนั้น {
            366 * (1 + (breath-0.5)*0.15)
            2360 * (1 + (breath-0.5)*0.15)
            3590 * (1 + (breath-0.5)*0.08)
        }
    }
}

ฟังก์ชัน audio_tone_update(slot freq amp) { }

ฟังก์ชัน draw_doll_eye(x y z is_left is_male blink pupil_dilate gaze_x gaze_y hue FR) {
    ผูก eye_width = 0.52
    ผูก eye_height = 0.38
    ถ้า is_male == 1 {
        eye_height = eye_height * 0.92
    } มิฉะนั้น {
        eye_height = eye_height * 1.08
    }
    ผูก open = 1.0 - blink
    ถ้า is_male == 1 {
        vtex_hyperbolic_uv(x y z-0.05 1 0 0 0 1 0 eye_width*1.2 4 6 FR*0.02 hue+3.8)
        ลายวงซ้อน(x y-0.08 z-0.05 0 1 0 1 0 0 2 4 eye_width*1.1 0.02 FR*0.01 hue+3.5)
    } มิฉะนั้น {
        ลายดอก(x y z-0.05 1 0 0 0 1 0 eye_width*1.15 6 FR*0.03 hue+4.0)
        ลายจักร(x y-0.05 z-0.05 1 0 0 0 1 0 eye_width*1.0 1 FR*0.01 hue+3.8)
    }
    ผูก eyeball_r = eye_width * 0.48 * open
    ลายจักร(x y z 1 0 0 0 1 0 eyeball_r 32 FR*0.05 hue+5.5)
    ผูก iris_r = eyeball_r * 0.65
    ผูก iris_hue = hue+4.2
    ถ้า is_male == 0 {
        iris_hue = hue+5.8
    }
    ลายดอกบัว(x + gaze_x*0.12 y + gaze_y*0.08 z+0.02 1 0 0 0 1 0 iris_r*0.7 iris_r 8 FR*0.08 iris_hue)
    ผูก pupil_r = iris_r * (0.35 + pupil_dilate * 0.15)
    ลายจักร(x + gaze_x*0.15 y + gaze_y*0.10 z+0.04 1 0 0 0 1 0 pupil_r 1 FR*0.10 hue+2.0)
    ลายจักร(x + 0.12 + gaze_x*0.08 y + 0.10 + gaze_y*0.06 z+0.06 1 0 0 0 1 0 pupil_r*0.28 1 FR*0.15 hue+7.0)
    ถ้า open > 0.1 {
        ขณะที่ (ผูก i = 0; i < 14; i = i + 1) {
            ผูก angle = -1.2 + i * 0.18
            ผูก lash_len = 0.12
            ถ้า is_male == 1 {
                lash_len = lash_len * 0.85
            } มิฉะนั้น {
                lash_len = lash_len * 1.15
            }
            ผูก lx = x + โคไซน์(angle) * eye_width * 0.85
            ผูก ly = y + ไซน์(angle) * eye_height * 0.7 - 0.05
            ลายเกลียว(lx ly z+0.03 0 1 0 1 0 0 0.008 lash_len 3 FR*0.2 hue+4.5)
        }
        ขณะที่ (ผูก i = 0; i < 10; i = i + 1) {
            ผูก angle = 0.5 + i * 0.15
            ผูก lash_len = 0.07
            ถ้า is_male == 1 {
                lash_len = lash_len * 0.90
            } มิฉะนั้น {
                lash_len = lash_len * 1.10
            }
            ผูก lx = x + โคไซน์(angle) * eye_width * 0.75
            ผูก ly = y + ไซน์(angle) * eye_height * 0.6 + 0.03
            ลายเกลียว(lx ly z+0.02 0 1 0 1 0 0 0.006 lash_len 2 FR*0.18 hue+4.6)
        }
    }
    ผูก brow_y = y + 0.28
    ถ้า is_male == 1 {
        brow_y = brow_y * 0.90
    } มิฉะนั้น {
        brow_y = brow_y * 1.10
    }
    ถ้า is_male == 1 {
        vtex_hyperbolic_uv(x brow_y z-0.02 1 0 0 0 0 1 eye_width*1.2 3 5 FR*0.04 hue+3.2)
    } มิฉะนั้น {
        ลายดอก(x brow_y z-0.02 1 0 0 0 1 0 eye_width*1.1 5 FR*0.05 hue+3.5)
        ลายดาว(x brow_y-0.03 z-0.01 1 0 0 0 1 0 3 eye_width*0.9 eye_width*0.35 0.02 FR*0.06 hue+3.8)
    }
}

ฟังก์ชัน draw_yang_face(x y z hue FR breath blink pupil_dilate mouth_open vowel_shape) {
    vtex_hyperbolic_uv(x y z 1 0 0 0 1 0 1.8 6 8 FR*0.01 hue+1.5)
    ลายวงซ้อน(x y-0.15 z 1 0 0 0 1 0 2 6 1.6 0.03 FR*0.008 hue+1.2)
    vtex_hyperbolic_uv(x-0.65 y-0.35 z+0.02 0 1 0 1 0 0 0.45 3 4 FR*0.015 hue+1.0)
    vtex_hyperbolic_uv(x+0.65 y-0.35 z+0.02 0 1 0 1 0 0 0.45 3 4 FR*0.015 hue+1.0)
    vtex_hyperbolic_uv(x y+0.22 z+0.05 1 0 0 0 1 0 1.4 4 6 FR*0.012 hue+0.8)
    ลายเกลียว(x y-0.05 z+0.08 0 1 0 1 0 0 0.06 0.55 16 FR*0.03 hue+1.2)
    ลายจักร(x y-0.20 z+0.10 1 0 0 0 1 0 0.12 1 FR*0.04 hue+1.0)
    draw_doll_eye(x-0.48 y+0.10 z+0.04 1 1 blink pupil_dilate 0.02 breath*0.05 hue FR)
    draw_doll_eye(x+0.48 y+0.10 z+0.04 0 1 blink pupil_dilate -0.02 breath*0.05 hue FR)
    ผูก mouth_width = 0.45 + vowel_shape * 0.15
    ผูก mouth_height = 0.12 * mouth_open
    ผูก mouth_y = y - 0.38
    ลายดอกบัว(x mouth_y z+0.06 1 0 0 0 1 0 mouth_height*0.6 mouth_width 4 FR*0.08 hue+2.0)
    ลายวงซ้อน(x mouth_y z+0.05 1 0 0 0 1 0 1 8 mouth_width 0.02 FR*0.06 hue+1.8)
    ถ้า mouth_open > 0.1 {
        vtex_hyperbolic_uv(x mouth_y - mouth_height*0.5 z+0.03 1 0 0 0 1 0 mouth_width*0.8 3 4 FR*0.05 hue+1.5)
    }
}

ฟังก์ชัน draw_yin_face(x y z hue FR breath blink pupil_dilate mouth_open vowel_shape) {
    ลายดอก(x y z 1 0 0 0 1 0 1.75 12 FR*0.012 hue+2.5)
    vtex_hyperbolic_uv(x y z 1 0 0 0 1 0 1.6 8 10 FR*0.01 hue+2.2)
    ลายวงซ้อน(x-0.55 y-0.18 z+0.02 1 0 0 0 1 0 2 6 0.38 0.01 FR*0.02 hue+3.0)
    ลายวงซ้อน(x+0.55 y-0.18 z+0.02 1 0 0 0 1 0 2 6 0.38 0.01 FR*0.02 hue+3.0)
    ลายเกลียว(x y-0.08 z+0.07 0 1 0 1 0 0 0.04 0.42 12 FR*0.035 hue+2.8)
    ลายจักร(x y-0.22 z+0.09 1 0 0 0 1 0 0.08 1 FR*0.045 hue+2.5)
    draw_doll_eye(x-0.50 y+0.12 z+0.04 1 0 blink pupil_dilate 0.03 breath*0.06 hue FR)
    draw_doll_eye(x+0.50 y+0.12 z+0.04 0 0 blink pupil_dilate -0.03 breath*0.06 hue FR)
    ผูก mouth_width = 0.48 + vowel_shape * 0.18
    ผูก mouth_height = 0.14 * mouth_open
    ผูก mouth_y = y - 0.40
    ลายดอกบัว(x mouth_y z+0.06 1 0 0 0 1 0 mouth_height*0.7 mouth_width 6 FR*0.09 hue+3.2)
    ลายวงซ้อน(x mouth_y z+0.05 1 0 0 0 1 0 2 12 mouth_width 0.02 FR*0.07 hue+2.8)
    ลายดอก(x mouth_y-0.02 z+0.04 1 0 0 0 1 0 mouth_width*0.9 8 FR*0.08 hue+3.0)
    vtex_hyperbolic_uv(x mouth_y-0.06 z+0.03 1 0 0 0 1 0 mouth_width*0.7 3 4 FR*0.055 hue+2.6)
}

ฟังก์ชัน get_breath_phase(FR) {
    ผูก cycle_frame = FR % 180
    ผูก breath_strength = 0.0
    ผูก mouth_open = 0.0
    ผูก blink = 0.0
    ถ้า cycle_frame < 60 {
        breath_strength = cycle_frame / 60.0
        mouth_open = breath_strength * 0.6
    } ถ้า cycle_frame < 75 {
        breath_strength = 1.0
        mouth_open = 0.1
    } ถ้า cycle_frame < 135 {
        ผูก exhale_t = (cycle_frame - 75) / 60.0
        breath_strength = 1.0 - exhale_t
        mouth_open = 0.3 + exhale_t * 0.4
    } มิฉะนั้น {
        breath_strength = 0.0
        mouth_open = 0.0
    }
    ผูก blink_at = 0
    ถ้า cycle_frame < 3 {
        blink_at = 1
    }
    ถ้า cycle_frame > 57 && cycle_frame < 63 {
        blink_at = 1
    }
    ถ้า cycle_frame > 72 && cycle_frame < 78 {
        blink_at = 1
    }
    ถ้า cycle_frame > 132 && cycle_frame < 138 {
        blink_at = 1
    }
    ผูก random_blink = 0
    ถ้า sm2_hash(FR 0 0.1 0.2) > 0.98 {
        random_blink = 1
    }
    blink_at + random_blink
    breath_strength
    mouth_open
}

ฟังก์ชัน get_current_vowel(FR) {
    ผูก vowel_index = (FR / 180) % 6
    ผูก vowels = ["a", "o", "e", "i", "u", "ü"]
    vowels[vowel_index]
}

ฟังก์ชัน get_vowel_shape(vowel) {
    ถ้า vowel == "a" {
        0.9
    } ถ้า vowel == "o" {
        0.7
    } ถ้า vowel == "e" {
        0.5
    } ถ้า vowel == "i" {
        0.3
    } ถ้า vowel == "u" {
        0.4
    } ถ้า vowel == "ü" {
        0.6
    } มิฉะนั้น {
        0.5
    }
}

ฟังก์ชัน draw_lissajous_formants(FR hd current_vowel breath_strength) {
    ผูก f1 = 0
    ผูก f2 = 0
    ผูก f3 = 0
    ถ้า current_vowel == "a" {
        f1 = 730
        f2 = 1090
        f3 = 2440
    }
    ถ้า current_vowel == "o" {
        f1 = 570
        f2 = 840
        f3 = 2410
    }
    ถ้า current_vowel == "e" {
        f1 = 500
        f2 = 1840
        f3 = 2480
    }
    ถ้า current_vowel == "i" {
        f1 = 310
        f2 = 2790
        f3 = 2960
    }
    ถ้า current_vowel == "u" {
        f1 = 310
        f2 = 870
        f3 = 2240
    }
    ถ้า current_vowel == "ü" {
        f1 = 310
        f2 = 2000
        f3 = 2640
    }
    ผูก px = -3.0 + (f2 - 800) / 2500 * 6.0
    ผูก py = -2.0 + (f1 - 300) / 600 * 5.0
    ผูก size = 0.3 + (f3 - 2200) / 1400 * 0.7
    ผูก t = FR * 0.008
    ผูก lx = px + ไซน์(t * 2.0) * size * 0.4 * breath_strength
    ผูก ly = py + โคไซน์(t * 3.0) * size * 0.4 * breath_strength
    ผูก lz = center_z - 1.0 + ไซน์(t * 1.7) * 0.8
    ลายดาว(lx ly lz 1 0 0 0 1 0 4 size*1.2 size*0.48 0.03 FR*0.12 hd+4.0)
    ลายวงซ้อน(lx ly lz 1 0 0 0 1 0 2 8 size*0.8 0.02 FR*0.08 hd+3.5)
    vtex_hyperbolic_uv(lx ly lz 1 0 0 0 1 0 size 3 5 FR*0.06 hd+4.2)
    ขณะที่ (ผูก i = 1; i <= 8; i = i + 1) {
        ผูก trail_t = FR * 0.008 - i * 0.12
        ผูก trail_lx = px + ไซน์(trail_t * 2.0) * size * 0.4 * breath_strength
        ผูก trail_ly = py + โคไซน์(trail_t * 3.0) * size * 0.4 * breath_strength
        ลายจักร(trail_lx trail_ly lz - i*0.03 1 0 0 0 1 0 size*0.15 1 FR*0.1 hd+4.5 - i*0.2)
    }
    vtex_hyperbolic_uv(-4.0 py center_z-0.5 0 1 0 1 0 0 0.08 1 2 FR*0.02 hd+3.0)
    vtex_hyperbolic_uv(px -3.0 center_z-0.5 1 0 0 0 1 0 0.08 1 2 FR*0.02 hd+3.2)
    ลายวงซ้อน(px py center_z-1.2 1 0 0 0 0 1 1 6 size*0.5 0.0 FR*0.04 hd+3.8)
}

ฟังก์ชัน draw_meditation_ground(FR hd) {
    ผูก gy = 0 - 4.5
    ผูก gz = FZ * 0.50
    vtex_hyperbolic_uv(0 gy gz 1 0 0 0 0 1 10.0 8 12 FR*0.015 hd+2.0)
    vtex_tessellated(0 gy gz 1 0 0 0 0 1 24 18 0.35 0.12 4.0 FR hd+2.5)
    ลายดอกบัว(0 gy+0.5 gz-1.0 1 0 0 0 0 1 0.48 1.60 8 FR hd+1.0)
    ลายวงซ้อน(0 gy+0.5 gz-1.0 1 0 0 0 0 1 4 8 2.20 0.06 FR*0.02 hd+1.5)
}

ฟังก์ชัน setup_lights(FR) {
    ล้างแสง()
    เพิ่มแสง(0 0 center_z-1.0 0.85 0.72 0.48 3.5 14.0)
    เพิ่มแสง(-4.2 1.2 center_z-0.5 0.72 0.68 0.58 2.8 10.0)
    เพิ่มแสง(4.2 1.2 center_z-0.5 0.82 0.70 0.55 2.8 10.0)
    เพิ่มแสง(0 2.5 center_z+1.0 0.35 0.40 0.55 1.5 18.0)
}

ผูก สร้าง = ทำ {
    เปิดหน้าต่างเต็มจอ("หลิง หยิน-หยาง")
    capture_mouse()
    ตั้งแสงรอบข้าง(0.06)
    init_audio()
    ผูก 帧 = 0
    ตั้งกล้อง(0.0 0.0 1.0 0.0)
    ตั้งตำแหน่งกล้อง(0.0 0.0 -8.0)
    ตั้งระยะห่าง(2.0)
    ขณะที่ หน้าต่างเปิดอยู่() {
        เติม(1 2 8)
        ผูก hd = 帧 * 0.055
        ผูก blink_trigger breath_strength mouth_open = get_breath_phase(帧)
        ผูก current_vowel = get_current_vowel(帧)
        ผูก vowel_shape = get_vowel_shape(current_vowel)
        ผูก pupil_dilate = 0.3 + breath_strength * 0.2
        ผูก f1_m f2_m f3_m = update_vowel("yang" current_vowel breath_strength)
        audio_tone_update(1 f1_m 0.12 * breath_strength)
        audio_tone_update(2 f2_m 0.12 * breath_strength)
        audio_tone_update(3 f3_m 0.08 * breath_strength)
        ผูก f1_f f2_f f3_f = update_vowel("yin" current_vowel breath_strength)
        audio_tone_update(4 f1_f 0.12 * breath_strength)
        audio_tone_update(5 f2_f 0.12 * breath_strength)
        audio_tone_update(6 f3_f 0.08 * breath_strength)
        setup_lights(帧)
        draw_meditation_ground(帧 hd)
        draw_yang_face(-4.2 0.8 center_z-0.8 hd 帧 breath_strength blink_trigger pupil_dilate mouth_open vowel_shape)
        draw_yin_face(4.2 0.8 center_z-0.8 hd 帧 breath_strength blink_trigger pupil_dilate mouth_open vowel_shape)
        draw_lissajous_formants(帧 hd current_vowel breath_strength)
        ผูก breath_particles = 20 + breath_strength * 40
        ขณะที่ (ผูก i = 0; i < breath_particles; i = i + 1) {
            ผูก px = -3.0 + sm2_hash(i 帧*0.01 0.0 0.0) * 6.0
            ผูก py = -2.0 + (breath_strength * 5.0) + sm2_hash(i+100 帧*0.02 0.0 0.0) * 2.0
            ผูก sz = center_z - 1.0 + sm2_hash(i+200 帧*0.015 0.0 0.0) * 1.5
            ลายจักร(px py sz 1 0 0 0 1 0 0.04 + breath_strength*0.06 1 帧*0.1 hd+6.0)
        }
        ลายจักร(0 1.8 center_z-1.2 1 0 0 0 1 0 0.35 1 帧*0.1 hd+5.5)
        ลายวงซ้อน(0 1.8 center_z-1.2 1 0 0 0 1 0 2 6 0.65 0.02 帧*0.08 hd+5.0)
        ผูก cycle_frame = 帧 % 180
        ถ้า cycle_frame < 60 {
            vtex_hyperbolic_uv(0 -1.0 + breath_strength*3 center_z-1.5 1 0 0 0 1 0 1.2 3 5 帧*0.06 hd+6.5)
        } ถ้า cycle_frame < 75 {
            ลายดอกบัว(0 1.2 center_z-1.5 1 0 0 0 1 0 0.32 1.10 8 帧 hd+7.0)
        } ถ้า cycle_frame < 135 {
            vtex_hyperbolic_uv(0 2.0 - breath_strength*1.5 center_z-1.3 1 0 0 0 1 0 1.5 * breath_strength 4 7 帧*0.1 hd+5.8)
        } มิฉะนั้น {
            ลายจักร(0 -0.5 center_z-1.5 1 0 0 0 1 0 0.15 1 帧*0.05 hd+4.5)
        }
        แสดงผล()
        ผูก 帧 = 帧 + 1
    }
}