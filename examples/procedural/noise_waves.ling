# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Noise Waves — flowing multicolor wave lines driven by fbm noise over time.
# Demonstrates: fbm · smoothstep · lerp · time_now · draw_line
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind start = do {
    open_window(1024, 600)
    set_blend(1)
    while window_is_open() {
        bind t = time_now()
        set_color(10, 8, 18)
        fill()

        bind layer = 0.0
        while layer < 7.0 {
            bind baseY = 80.0 + layer * 70.0
            bind hue = layer / 7.0 + t * 0.05
            set_color((sin(hue*6.283)*0.5+0.5)*180.0+50.0, (sin(hue*6.283+2.094)*0.5+0.5)*180.0+50.0, (sin(hue*6.283+4.188)*0.5+0.5)*180.0+50.0)
            # sweep a polyline of fbm samples across the width
            bind x = 0.0
            bind py = baseY
            while x < 1024.0 {
                bind n = fbm(x * 0.004 + t * 0.3, layer * 1.7, 4.0, layer)
                bind y = baseY + lerp(0.0-40.0, 40.0, smoothstep(0.0, 1.0, n*0.5+0.5))
                if x > 0.5 { draw_line(x - 16.0, py, x, y) }
                bind py = y
                bind x = x + 16.0
            }
            bind layer = layer + 1.0
        }
        present()
    }
}
