# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Additive Glow — pulsing additive discs, orbiters, outlines and lerp corners.
# Demonstrates: draw_circle · draw_disc · set_blend · perlin · lerp
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bind start = do {
    open_window(800, 600)
    bind cx = 400.0
    bind cy = 300.0
    while window_is_open() {
        bind t = time_now()
        set_color(5, 5, 10)
        fill()
        set_blend(1)

        # pulsing filled rings
        set_color(255, 0, 255)  draw_disc(cx, cy, 50.0  + perlin(t*0.5, 0.0, 0.0) * 30.0)
        set_color(0, 255, 255)  draw_disc(cx, cy, 100.0 + perlin(t*0.3, 1.0, 0.0) * 40.0)
        set_color(255, 255, 0)  draw_disc(cx, cy, 150.0 + perlin(t*0.4, 2.0, 0.0) * 35.0)

        # six orbiters around the centre
        bind i = 0.0
        while i < 6.0 {
            bind a = i * 6.28318 / 6.0 + t * 2.0
            bind ox = cx + cos(a) * 200.0
            bind oy = cy + sin(a) * 200.0
            bind hue = i / 6.0 + t * 0.1
            set_color((sin(hue*6.283)*0.5+0.5)*255.0, (sin(hue*6.283+2.094)*0.5+0.5)*255.0, (sin(hue*6.283+4.188)*0.5+0.5)*255.0)
            draw_disc(ox, oy, 15.0)
            bind i = i + 1.0
        }

        # concentric outlines + a pulsing one
        set_color(0, 200, 100)
        draw_circle(cx, cy, 50.0)  draw_circle(cx, cy, 100.0)
        draw_circle(cx, cy, 150.0) draw_circle(cx, cy, 200.0)
        set_color(255, 100, 200)
        draw_circle(cx, cy, 250.0 + perlin(t*0.6, 3.0, 0.0) * 50.0)

        # lerp-coloured corner accents
        set_color(lerp(100.0, 255.0, sin(t*0.7)*0.5+0.5), 50.0, 150.0)
        draw_disc(50.0, 50.0, 25.0)
        set_color(100.0, lerp(100.0, 200.0, cos(t*0.7)*0.5+0.5), 255.0)
        draw_disc(750.0, 50.0, 25.0)
        set_color(lerp(50.0, 255.0, sin(t*0.5+1.0)*0.5+0.5), 200.0, 100.0)
        draw_disc(50.0, 550.0, 25.0)
        set_color(100.0, lerp(150.0, 255.0, cos(t*0.5+1.5)*0.5+0.5), 200.0)
        draw_disc(750.0, 550.0, 25.0)

        set_blend(0)
        present()
    }
}
